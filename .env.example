# Public URL for the deployed Supabase Edge Function.
# The form remains disabled when this value is empty.
PUBLIC_STORY_SUBMISSION_URL=https://fmxiyfhncvhnwzwipnxu.supabase.co/functions/v1/submit-reader-story

# Public browser configuration for the protected editorial administration.
# The anon/publishable key is designed for browser use; never use the service-role key here.
PUBLIC_SUPABASE_URL=https://fmxiyfhncvhnwzwipnxu.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key
PUBLIC_STORY_ADMIN_URL=https://fmxiyfhncvhnwzwipnxu.supabase.co/functions/v1/admin-story-submissions

# Private Supabase Edge Function secrets (never expose these as PUBLIC_*):
# RESEND_API_KEY=re_...
# EDITORIAL_NOTIFICATION_EMAIL=hyde@hyde.dk
