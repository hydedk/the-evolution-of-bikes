---
import EnglishHeader from './EnglishHeader.astro';
import EnglishFooter from './EnglishFooter.astro';
import OptimizedImage from './OptimizedImage.astro';
import RelatedDiscovery from './RelatedDiscovery.astro';
import { stories } from '../data/stories';
import { englishStories } from '../data/english';
import { approvedStories20261102 as scheduledStories } from '../data/approvedStories20261102';
import { scheduledStoryAdditions } from '../data/scheduledStoryAdditions';

type StorySlug = keyof typeof scheduledStories;
type Props = { slug: StorySlug; language?: 'da' | 'en' };
const { slug, language = 'da' } = Astro.props;
const story = scheduledStories[slug];
const copy = story[language];
const shareImage = story.image;
const imageAlt = language === 'da' ? story.hero.altDa : story.hero.altEn;
const imageCredit = language === 'da' ? story.hero.captionDa : story.hero.captionEn;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const daPath = `/historier/${slug}/`;
const enPath = `/en/stories/${slug}/`;
const canonicalPath = language === 'da' ? daPath : enPath;
const canonical = new URL(`${base}${canonicalPath}`, Astro.site).toString();
const daUrl = new URL(`${base}${daPath}`, Astro.site).toString();
const enUrl = new URL(`${base}${enPath}`, Astro.site).toString();
const periodPath = language === 'da' ? `/perioder/${story.period}/` : `/en/periods/${story.period}/`;
const localizedYear = language === 'en' ? story.year.replaceAll('’erne','s') : story.year;
const preferred = {"alfonsina-strada-giro-1924":"eugene-christophe-smedjen-1913","pino-cerami-sene-sejre":"jacques-moujica-1949-1950","sadelpindens-diameter-staalrammer":"drillium-vaegtbesparelse","thorvald-ellegaard-fra-fangel-til-verdensbanerne":"banecykling-ellegaard-1912","wattmaaleren-flyttede-laboratoriet-ud-paa-vejen":"polar-pulsmaaler-traening","coppi-koblet-lugano-1951":"coppi-bartali-et-delt-italien","forgaffelbygning-foer-1950":"krankboksmuffen-foer-1950","kay-werner-sagde-nej-til-par-nummer-et":"par-nummer-syv","vito-di-tano-cykelcross":"keetie-van-oosten-hage"};
const related = (language === 'da' ? stories : englishStories).find(s => s.slug === preferred[slug]);
const needsCompactTitle = copy.title.length > 31;
const caption = (img) => language === 'da' ? img.captionDa : img.captionEn;
const credit = (img) => language === 'da' ? img.creditDa : img.creditEn;
const alt = (img) => language === 'da' ? img.altDa : img.altEn;
---
<!doctype html>
<html lang={language}>
  <head>
    <meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/>
    <title>{copy.title} | The Evolution of Bikes</title><meta name="description" content={copy.description}/>
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="da" href={daUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={daUrl} />
    <meta property="og:type" content="article" />
    <meta property="og:locale" content={language === 'da' ? 'da_DK' : 'en_GB'} />
    <meta property="og:site_name" content="The Evolution of Bikes" />
    <meta property="og:title" content={copy.title} />
    <meta property="og:description" content={copy.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(shareImage.src, Astro.site).toString()} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={copy.title} />
    <meta name="twitter:description" content={copy.description} />
    <meta name="twitter:image" content={new URL(shareImage.src, Astro.site).toString()} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <script type="application/ld+json" set:html={JSON.stringify({ '@context':'https://schema.org', '@type':'Article', headline:copy.title, description:copy.description, inLanguage:language, mainEntityOfPage:canonical, image:new URL(shareImage.src, Astro.site).toString() })} />
    <link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Libre+Caslon+Display&display=swap" rel="stylesheet"/><link rel="stylesheet" href={`${base}/styles/global.css`}/>
  </head>
  <body>
  {language === 'en' ? <EnglishHeader current="stories" danishPath={daPath}/> : <header class="site-header"><a class="brand" href={`${base}/`} aria-label="The Evolution of Bikes, forside"><span class="brand-mark">E<span>B</span></span><span>The Evolution<br/>of Bikes</span></a><nav aria-label="Hovedmenu"><a href={`${base}/historier/`} aria-current="page">Historier</a><a href={`${base}/perioder/`}>Perioder</a><a href={`${base}/cykler/`}>Cykler</a><a href={`${base}/om/`}>Om</a></nav><div class="header-tools"><strong>DA</strong><span>/</span><a class="language-switch" href={`${base}${enPath}`} lang="en" hreflang="en">EN</a><a class="header-story-link" href={`${base}/fortael-din-historie/`}>Fortæl din historie</a></div></header>}
  <main>
    <article>
      <header class:list={['hero', {
        'portrait-hero': true,
        'compact-title': needsCompactTitle,
        'batch-title': 'portrait' in story
      }]}>
        <div class="hero-copy">
          <p class="eyebrow">{localizedYear} · {language === 'da' ? 'Historie' : 'Story'}</p>
          <h1>{copy.title}</h1>
          <p class="deck">{copy.deck}</p>
        </div>
        <figure>
          <OptimizedImage src={story.image} alt={imageAlt} widths={[640,960,1280]} sizes="(max-width: 850px) 100vw, 50vw" loading="eager" fetchpriority="high" />
          <figcaption>{imageCredit}{credit(story.hero) && !imageCredit.includes(credit(story.hero)) && <> · {credit(story.hero)}</>}{story.hero.source && <> · <a href={story.hero.source}>{language === 'da' ? 'Billedside' : 'Image record'}</a></>}{story.hero.licenseUrl ? <> · <a href={story.hero.licenseUrl}>{story.hero.license}</a></> : story.hero.license && <> · {story.hero.license}</>}</figcaption>
        </figure>
      </header>
      <div class="article-grid">
        <aside>
          <span>{localizedYear}</span>
          <a href={`${base}${periodPath}`}>{language === 'da' ? 'Se perioden' : 'Explore the period'} →</a>
        </aside>
        <div class="body">
          {copy.blocks.map((block, index) => <>
            {block.heading ? <h2>{block.text}</h2> : <p>{block.text}</p>}
            {story.images.filter(img => img.after === index).map(img => <figure class="article-visual"><OptimizedImage src={img.image} alt={alt(img)} widths={[640,960,1280]} sizes="(max-width: 850px) 100vw, 760px"/><figcaption>{caption(img)}{credit(img) && !caption(img).includes(credit(img)) && <> · {credit(img)}</>}{img.source && <> · <a href={img.source}>{language === 'da' ? 'Billedside' : 'Image record'}</a></>}{img.licenseUrl && <> · <a href={img.licenseUrl}>{img.license}</a></>}</figcaption></figure>)}
          </>)}
          {story.images.some(img => img.after < 0) && <section><h2>{language === 'da' ? 'Flere billeder' : 'More images'}</h2>{story.images.filter(img => img.after < 0).map(img => <figure class="article-visual"><OptimizedImage src={img.image} alt={alt(img)} widths={[480,768,1024]} sizes="(max-width: 850px) 100vw, 760px"/><figcaption>{caption(img)}{credit(img) && !caption(img).includes(credit(img)) && <> · {credit(img)}</>}{img.source && <> · <a href={img.source}>{language === 'da' ? 'Billedside' : 'Image record'}</a></>}{img.licenseUrl && <> · <a href={img.licenseUrl}>{img.license}</a></>}</figcaption></figure>)}</section>}

        </div>
      </div>
    </article>
    {related && <section class="relevant-story"><h2>{language === 'da' ? 'Læs også' : 'Read also'}</h2><a href={base + (language === 'da' ? '/historier/' : '/en/stories/') + related.slug + '/'}>{related.title} →</a></section>}
    <RelatedDiscovery currentSlug={slug} language={language} />
  </main>
  {language === 'en' ? <EnglishFooter/> : <footer><div class="brand footer-brand"><span class="brand-mark">E<span>B</span></span><span>The Evolution<br/>of Bikes</span></div><p>En personlig samling af vintagecykler,<br/>historier, mærker og komponenter.</p><p class="copyright">© {new Date().getFullYear()} The Evolution of Bikes</p></footer>}
  </body>
</html>
<style>
.hero.portrait-hero figure{justify-content:center;align-items:center;min-height:0;padding:2rem 0}.hero.portrait-hero figure :global(picture){display:block;width:100%;max-width:596px;height:auto}.hero.portrait-hero figure :global(img){width:100%;height:auto;object-fit:contain}.hero.portrait-hero figcaption{width:100%;box-sizing:border-box;margin-top:1rem}.hero.portrait-hero{min-height:0}.hero.portrait-hero .hero-copy{padding:clamp(2rem,5vw,4rem)}

  .relevant-story{max-width:760px;margin:0 auto;padding:0 1.25rem}.relevant-story a{color:var(--rust)}
  main{background:var(--paper)} article{max-width:1440px;margin:auto}.hero{display:grid;grid-template-columns:1fr 1fr;min-height:760px}.hero-copy{display:flex;flex-direction:column;justify-content:center;padding:clamp(3rem,7vw,8rem)}.eyebrow{color:var(--rust);font-size:.78rem;font-weight:700;letter-spacing:.13em;text-transform:uppercase}.hero h1{max-width:760px;margin:.8rem 0 1.6rem;font:400 clamp(3.2rem,6.3vw,7rem)/.95 'Libre Caslon Display',serif}.deck{max-width:650px;font-size:clamp(1.05rem,1.6vw,1.35rem);line-height:1.65}.hero figure{display:flex;min-width:0;flex-direction:column;margin:0;background:#d8d8cf}.hero figure :global(picture),.hero figure :global(img){width:100%;height:100%;object-fit:cover}.hero figcaption{padding:.7rem 1rem;font-size:.72rem;line-height:1.35;background:#ded8ca}.article-grid{display:grid;grid-template-columns:minmax(160px,1fr) minmax(0,760px) minmax(160px,1fr);gap:2rem;padding:clamp(4rem,8vw,8rem) 1.5rem}.article-grid aside{display:flex;flex-direction:column;gap:1rem;color:var(--rust);font-size:.78rem;letter-spacing:.08em;text-transform:uppercase}.article-grid aside a{color:inherit}.body{grid-column:2}.body section+section{margin-top:4rem}.body h2{margin:0 0 1.5rem;font:400 clamp(2rem,4vw,3.25rem)/1.05 'Libre Caslon Display',serif}.body p{font-size:1.08rem;line-height:1.8}.article-visual{margin:2.5rem 0 4rem}.article-visual :global(picture),.article-visual :global(img){display:block;width:100%;height:auto}.article-visual figcaption{padding:.8rem 0;border-bottom:1px solid var(--line);color:#5d584e;font-size:.78rem;line-height:1.5}.sources{border-top:1px solid var(--line);padding-top:2rem}.sources a{color:var(--rust)}.sources .note{font-size:.85rem;color:#5d584e}@media(max-width:850px){.hero{grid-template-columns:1fr;min-height:0}.hero-copy{padding:5rem 1.25rem 3rem}.hero figure{min-height:480px}.article-grid{grid-template-columns:1fr;padding:4rem 1.25rem}.article-grid aside,.body{grid-column:1}.article-grid aside{flex-direction:row;justify-content:space-between}.body p{font-size:1rem}.article-visual{margin:2rem 0 3rem}}@media(max-width:520px){.hero h1{font-size:3rem}.hero figure{min-height:360px}}
.body>h2{margin-top:3rem}.body>p{white-space:pre-line}.hero figure :global(img){max-height:780px}:global(.brand-mark){display:flex;align-items:center;justify-content:center}
  .hero.compact-title h1{max-width:100%;font-size:clamp(2.65rem,4.15vw,4.7rem);line-height:.98;overflow-wrap:anywhere;hyphens:manual}
  .hero.compact-title .hero-copy{padding-inline:clamp(2rem,5vw,5rem)}
  .hero.batch-title h1{hyphens:manual;overflow-wrap:normal}
</style>
