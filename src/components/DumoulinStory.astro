---
import EnglishHeader from './EnglishHeader.astro';
import EnglishFooter from './EnglishFooter.astro';
import OptimizedImage from './OptimizedImage.astro';
import RelatedDiscovery from './RelatedDiscovery.astro';
import hero from '../assets/stories/dumoulin-naturpause-giro-2017/tom-dumoulin-giro-2017-stage-16.jpg';

const { language = 'da' } = Astro.props;
const en = language === 'en';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const slug = 'dumoulin-naturpause-giro-2017';
const daUrl = `https://teob.dk/historier/${slug}/`;
const enUrl = `https://teob.dk/en/stories/${slug}/`;
const canonical = en ? enUrl : daUrl;
const title = en ? 'The comfort break that nearly cost Dumoulin the Giro' : 'Naturpausen der næsten kostede Dumoulin Giroen';
const description = en
  ? 'Tom Dumoulin stopped with stomach trouble on stage 16 of the 2017 Giro, lost 2:18 and kept the pink jersey by 31 seconds.'
  : 'Tom Dumoulin måtte standse med maveproblemer på Giroens 16. etape i 2017, tabte 2.18 og beholdt førertrøjen med 31 sekunder.';
const copy = en ? {
  eyebrow: 'Giro d’Italia · 2017',
  deck: 'The pink jersey stopped beside the road. His rivals continued towards the Umbrail Pass, and Tom Dumoulin had to chase the Giro on his own.',
  lead: 'It did not happen on the Stelvio itself. After the second passage of the pass, on the road towards the final climb to the Umbrail Pass, Dumoulin suddenly pulled over.',
  sections: [
    ['A day with no easy kilometres', ['Stage 16 ran 222 kilometres from Rovetta to Bormio, across the Mortirolo, the Stelvio and the Umbrail Pass. Dumoulin started in the maglia rosa with a useful lead over Nairo Quintana and Vincenzo Nibali.', 'Then his stomach decided that the race plan was no longer relevant. He stopped, put down the bicycle and dealt with the problem beside the road. There was no team car solution for this one.']],
    ['How long should they wait?', ['The favourites initially eased, but the race was not neutralised. Attacks resumed and Dumoulin was left to chase alone. The discussion began immediately: should rivals wait when the race leader’s problem is neither a crash nor a mechanical failure?', 'There was no rule that could settle the question for them. Nibali and Quintana rode their race. Dumoulin rode a long, rather exposed time trial towards Bormio.']],
    ['Thirty-one seconds left', ['Vincenzo Nibali won the stage ahead of Mikel Landa. Dumoulin finished 13th, 2 minutes and 18 seconds behind. He still held the pink jersey, but only by 31 seconds over Quintana.', 'He later lost the lead, then recovered it in the final time trial to Milan. He became the first Dutch winner of the Giro d’Italia. The roadside stop did not cost him the race. It came close enough.']],
  ],
  quote: 'No directeur sportif could plan this one away.',
  facts: [['222 km', 'stage distance'], ['2:18', 'lost on the stage'], ['31 sec.', 'lead after the finish'], ['1st', 'final Giro position']],
} : {
  eyebrow: 'Giro d’Italia · 2017',
  deck: 'Den lyserøde førertrøje stod stille i vejkanten. Rivalerne fortsatte mod Umbrailpasset, og Tom Dumoulin måtte jage sin Giro alene.',
  lead: 'Det skete ikke på selve Stelvio. Efter den anden passage af passet, på vej mod den sidste stigning til Umbrailpasset, drejede Dumoulin pludselig ind til siden.',
  sections: [
    ['En dag uden lette kilometer', ['16. etape gik 222 kilometer fra Rovetta til Bormio over Mortirolo, Stelvio og Umbrailpasset. Dumoulin startede i den lyserøde førertrøje med et brugbart forspring til Nairo Quintana og Vincenzo Nibali.', 'Så besluttede maven, at løbsplanen ikke længere var relevant. Han standsede, lagde cyklen og ordnede problemet i vejkanten. Den kunne sportsdirektøren ikke lige løse fra bilen.']],
    ['Hvor længe skal man vente?', ['Favoritterne satte først farten ned, men løbet blev ikke neutraliseret. Angrebene begyndte igen, og Dumoulin måtte jage alene. Diskussionen kom med det samme: Skal rivalerne vente, når den førendes problem hverken er et styrt eller en mekanisk fejl?', 'Der fandtes ingen regel, som kunne afgøre det for dem. Nibali og Quintana kørte deres løb. Dumoulin kørte en lang og temmelig ubeskyttet enkeltstart mod Bormio.']],
    ['Enogtredive sekunder tilbage', ['Vincenzo Nibali vandt etapen foran Mikel Landa. Dumoulin kom ind som nummer 13, 2 minutter og 18 sekunder efter. Han beholdt førertrøjen, men nu kun med 31 sekunder til Quintana.', 'Senere mistede han føringen og vandt den tilbage på den afsluttende enkeltstart til Milano. Han blev den første hollandske vinder af Giro d’Italia. Stoppet kostede ham ikke løbet. Men det var tæt nok på.']],
  ],
  quote: 'Den kunne sportsdirektøren ikke planlægge sig ud af.',
  facts: [['222 km', 'etapens distance'], ['2.18', 'tabt på etapen'], ['31 sek.', 'føring efter mål'], ['Nr. 1', 'slutplacering i Giroen']],
};
---
<!doctype html><html lang={language}><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><title>{title} · The Evolution of Bikes</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><link rel="alternate" hreflang="da" href={daUrl}/><link rel="alternate" hreflang="en" href={enUrl}/><link rel="alternate" hreflang="x-default" href={daUrl}/><meta property="og:type" content="article"/><meta property="og:locale" content={en?'en_GB':'da_DK'}/><meta property="og:site_name" content="The Evolution of Bikes"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={new URL(hero.src, canonical).href}/><meta property="og:image:alt" content={en?'Tom Dumoulin in the pink jersey during the 2017 Giro d’Italia':'Tom Dumoulin i den lyserøde førertrøje under Giro d’Italia 2017'}/><meta name="twitter:card" content="summary_large_image"/><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Libre+Caslon+Display&display=swap" rel="stylesheet"/><link rel="stylesheet" href={`${base}/styles/global.css`}/></head><body>
{en?<EnglishHeader current="stories" danishPath={`/historier/${slug}/`}/>:<header class="site-header"><a class="brand" href={`${base}/`} aria-label="The Evolution of Bikes, forside"><span class="brand-mark">E<span>B</span></span><span>The Evolution<br/>of Bikes</span></a><nav aria-label="Hovedmenu"><a href={`${base}/historier/`} aria-current="page">Historier</a><a href={`${base}/perioder/`}>Perioder</a><a href={`${base}/cykler/`}>Cykler</a><a href={`${base}/om/`}>Om</a></nav><div class="header-tools"><strong>DA</strong><span>/</span><a href={`${base}/en/stories/${slug}/`}>EN</a><a class="header-story-link" href={`${base}/fortael-din-historie/`}>Fortæl din historie</a></div></header>}
<main><article class="story"><header class="story-hero"><p class="section-label">{copy.eyebrow}</p><h1>{title}</h1><p>{copy.deck}</p></header><figure class="hero"><OptimizedImage src={hero} alt={en?'Tom Dumoulin wearing the pink jersey after stage 16 of the 2017 Giro d’Italia':'Tom Dumoulin i den lyserøde førertrøje efter 16. etape af Giro d’Italia 2017'} widths={[480,768,1100,1536]} sizes="(max-width:800px) 92vw,900px" loading="eager" fetchpriority="high"/><figcaption>{en?'Tom Dumoulin still in pink after stage 16 on 23 May 2017. Photograph: Filip Bossuyt, CC BY 2.0, via Wikimedia Commons.':'Tom Dumoulin stadig i lyserødt efter 16. etape den 23. maj 2017. Foto: Filip Bossuyt, CC BY 2.0, via Wikimedia Commons.'}</figcaption></figure><div class="story-copy"><p class="lead">{copy.lead}</p>{copy.sections.map(([heading,paragraphs])=><section><h2>{heading}</h2>{paragraphs.map((p)=><p>{p}</p>)}</section>)}</div><aside class="pull-quote"><p>{copy.quote}</p></aside><section class="fact-strip">{copy.facts.map(([value,label])=><div><strong>{value}</strong><span>{label}</span></div>)}</section><section class="period-sources"><p class="section-label">{en?'Sources and image note':'Kilder og billednote'}</p><div><ul><li><a href="https://www.cyclingnews.com/races/giro-ditalia-2017/stage-16/results/" target="_blank" rel="noopener noreferrer">Cyclingnews: {en?'stage 16 result and report':'resultat og referat fra 16. etape'}</a></li><li><a href="https://www.theguardian.com/sport/2017/may/23/tom-dumoulin-retains-giro-ditalia-lead-movistar-push-comfort-break-stage-16" target="_blank" rel="noopener noreferrer">The Guardian, 23 May 2017</a></li><li><a href="https://commons.wikimedia.org/wiki/File:Giro_d%27Italia_2017,_dumoulin_(34343448193)_(cropped).jpg" target="_blank" rel="noopener noreferrer">Wikimedia Commons: Filip Bossuyt, CC BY 2.0</a></li></ul><p>{en?'The photograph was taken after the stage and does not show the roadside stop itself.':'Fotografiet er taget efter etapen og viser ikke selve stoppet i vejkanten.'}</p></div></section><RelatedDiscovery currentSlug={slug} language={language}/><nav class="era-bottom-nav"><a href={`${base}/${en?'en/stories':'historier'}/`}>← {en?'All stories':'Alle historier'}</a><a href={`${base}/${en?'en/periods':'perioder'}/2010-2019/`}>{en?'The 2010–2019 period':'Perioden 2010–2019'} →</a></nav></article></main>{en?<EnglishFooter/>:<footer><div class="brand footer-brand"><span class="brand-mark">E<span>B</span></span><span>The Evolution<br/>of Bikes</span></div><p>En personlig samling af vintagecykler,<br/>historier, mærker og komponenter.</p><p class="copyright">© {new Date().getFullYear()} The Evolution of Bikes</p></footer>}</body></html>
<style>.story-hero{max-width:1100px;margin:auto;padding:5rem 1.5rem 3rem}.story-hero h1{font:400 clamp(3.2rem,7vw,6.7rem)/.97 'Libre Caslon Display',serif;margin:.7rem 0 1.8rem}.story-hero>p:last-child{max-width:790px;font-size:1.25rem;line-height:1.65}.hero{max-width:980px;margin:0 auto 4rem;padding:0 1.5rem}.hero :global(img){display:block;width:100%;height:auto;max-height:780px;object-fit:contain}.hero figcaption{margin-top:.75rem;color:#625e55;font-size:.84rem;line-height:1.55}.story-copy{max-width:760px;margin:auto;padding:0 1.5rem 3rem;font-size:1.08rem;line-height:1.82}.lead{font:1.75rem/1.45 'Libre Caslon Display',serif}.story-copy h2{font:400 clamp(2rem,4vw,3rem)/1.15 'Libre Caslon Display',serif;margin:3.2rem 0 1rem}.pull-quote{max-width:1000px;margin:1rem auto 5rem;padding:3.5rem 1.5rem;border-block:1px solid var(--line)}.pull-quote p{max-width:860px;margin:auto;font:400 clamp(2rem,4.5vw,4rem)/1.1 'Libre Caslon Display',serif}.fact-strip{display:grid;grid-template-columns:repeat(4,1fr);max-width:1180px;margin:0 auto 5rem;padding:0 1.5rem;gap:1px}.fact-strip div{display:flex;min-height:170px;flex-direction:column;justify-content:space-between;background:#ecd9dd;padding:1.4rem}.fact-strip strong{font:400 clamp(2.3rem,4vw,4rem)/1 'Libre Caslon Display',serif}.fact-strip span{font-size:.82rem}.period-sources{max-width:1000px;margin:auto}.period-sources li{overflow-wrap:anywhere}@media(max-width:800px){.story-hero{padding-top:2.5rem}.fact-strip{grid-template-columns:1fr 1fr}.fact-strip div{min-height:145px}}@media(max-width:480px){.story-hero h1{font-size:2.75rem;overflow-wrap:break-word}.fact-strip{grid-template-columns:1fr}}</style>
