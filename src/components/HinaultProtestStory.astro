---
import EnglishHeader from './EnglishHeader.astro';
import EnglishFooter from './EnglishFooter.astro';
import OptimizedImage from './OptimizedImage.astro';
import RelatedDiscovery from './RelatedDiscovery.astro';
import hero from '../assets/stories/hinault-arbejderprotest-paris-nice-1984/bernard-hinault-1982.jpg';
import tour1978 from '../assets/stories/hinault-arbejderprotest-paris-nice-1984/bernard-hinault-1978.jpg';

const { language = 'da' } = Astro.props;
const en = language === 'en';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const slug = 'hinault-arbejderprotest-paris-nice-1984';
const daUrl = `https://teob.dk/historier/${slug}/`;
const enUrl = `https://teob.dk/en/stories/${slug}/`;
const canonical = en ? enUrl : daUrl;
const title = en ? 'When Hinault rode into a workers’ protest' : 'Da Hinault kørte ind i arbejderprotesten';
const description = en
  ? 'Paris–Nice met a road blockade by La Ciotat shipyard workers in 1984. Bernard Hinault was knocked down, got up and struck a demonstrator.'
  : 'Paris–Nice mødte en vejblokade af værftsarbejdere fra La Ciotat i 1984. Bernard Hinault blev væltet, rejste sig og slog ud efter en demonstrant.';
const ogImage = new URL(hero.src, canonical).href;
const copy = en ? {
  eyebrow: 'Cycling and society · 1984',
  deck: 'The shipyard workers wanted the race to stop. Bernard Hinault wanted the road cleared. For a few minutes, Paris–Nice became part of an industrial dispute.',
  lead: 'On 12 March 1984, the fifth stage of Paris–Nice ran straight into a road blockade mounted by shipyard workers from La Ciotat.',
  sections: [
    ['A race on a working road', ['The stage from Miramas to La Seyne-sur-Mer covered 174.5 kilometres. Near La Ciotat, striking shipyard workers occupied the road to draw attention to their dispute. French shipbuilding was in deep trouble, and the country’s major yards faced decisions about jobs and survival.', 'A professional race brought cameras, officials and an audience. That made the road useful to the protesters. It also meant that riders, race vehicles and demonstrators were soon pressed into the same narrow space.']],
    ['Hinault gets back up', ['Archive film shows Hinault being brought down in the crowd. He gets to his feet, pushes forward and strikes a demonstrator before others intervene. A contemporary report in El País described the same confrontation: Hinault tried to punch a man who had attempted to knock him from the bicycle.', 'The scene is usually remembered as proof of Hinault’s temper. Fair enough. But the workers were not extras in a story about a famous rider. They had chosen the race precisely because it could make their conflict visible.']],
    ['The race resumes', ['The blockade did not decide the sporting result. Eddy Planckaert won the stage, Sean Kelly finished second and took the race lead, while Hinault was third on the day. Kelly later won Paris–Nice, with Hinault third overall.', 'The result sheet is tidy. The film is not. It shows how little separates a sealed-off sporting event from the places and people through which it passes.']],
  ],
  quote: 'The clenched fist is easy to remember. The reason the workers stood in the road needs another moment.',
  endHeading: 'What the camera caught',
  end: ['There is no need to turn the confrontation into a heroic tale. A rider was knocked down. He got up and hit back. Workers used the race to be seen, and the race carried on.', 'That is enough. Paris–Nice passed La Ciotat in 1984, but for a few minutes it could not pass around the argument already taking place there.'],
  facts: [['12 March', 'the day of the confrontation'], ['174.5 km', 'the fifth stage'], ['3rd', 'Hinault on the stage'], ['3rd', 'Hinault overall']],
} : {
  eyebrow: 'Cykling og samfund · 1984',
  deck: 'Værftsarbejderne ville standse løbet. Bernard Hinault ville have vejen fri. I nogle minutter blev Paris–Nice en del af en arbejdskonflikt.',
  lead: 'Den 12. marts 1984 kørte femte etape af Paris–Nice direkte ind i en vejblokade med værftsarbejdere fra La Ciotat.',
  sections: [
    ['Et cykelløb på en arbejdsvej', ['Etapen fra Miramas til La Seyne-sur-Mer var 174,5 kilometer lang. Ved La Ciotat gik strejkende værftsarbejdere ud på vejen for at gøre deres konflikt synlig. Fransk skibsbygning var i alvorlige vanskeligheder, og landets store værfter stod over for beslutninger om arbejdspladser og overlevelse.', 'Et professionelt cykelløb havde kameraer, officials og et publikum med sig. Det gjorde vejen brugbar for demonstranterne. Det betød også, at ryttere, løbsbiler og arbejdere hurtigt stod klemt sammen på ganske lidt asfalt.']],
    ['Hinault rejser sig', ['Arkivoptagelserne viser, at Hinault bliver bragt til jorden i menneskemængden. Han rejser sig, går frem og slår ud efter en demonstrant, før andre griber ind. En samtidig artikel i El País beskrev samme sammenstød: Hinault forsøgte at slå en mand, der havde villet vælte ham af cyklen.', 'Scenen bliver gerne brugt som bevis på Hinaults temperament. Det kan den såmænd godt bære. Men arbejderne var ikke statister i en historie om en berømt rytter. De havde valgt løbet, netop fordi det kunne gøre deres konflikt synlig.']],
    ['Løbet fortsætter', ['Blokaden afgjorde ikke etapen. Eddy Planckaert vandt, Sean Kelly blev nummer to og overtog føringen, mens Hinault kom ind som nummer tre. Kelly vandt senere Paris–Nice, og Hinault sluttede som nummer tre samlet.', 'Resultatlisten er pæn og ordentlig. Det er filmoptagelserne ikke. De viser, hvor lidt der egentlig skiller et afspærret sportsarrangement fra de steder og mennesker, det bevæger sig igennem.']],
  ],
  quote: 'Den knyttede næve er let at huske. Grunden til, at arbejderne stod på vejen, kræver et øjeblik mere.',
  endHeading: 'Det kameraet fangede',
  end: ['Der er ingen grund til at gøre sammenstødet til en heltehistorie. En rytter blev væltet. Han rejste sig og slog igen. Arbejderne brugte løbet til at blive set, og løbet fortsatte.', 'Det er sådan set nok. Paris–Nice passerede La Ciotat i 1984, men i nogle minutter kunne løbet ikke køre uden om den konflikt, der allerede fandtes der.'],
  facts: [['12. marts', 'dagen for sammenstødet'], ['174,5 km', 'femte etape'], ['Nr. 3', 'Hinault på etapen'], ['Nr. 3', 'Hinault samlet']],
};
---
<!doctype html><html lang={language}><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><title>{title} · The Evolution of Bikes</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><link rel="alternate" hreflang="da" href={daUrl}/><link rel="alternate" hreflang="en" href={enUrl}/><link rel="alternate" hreflang="x-default" href={daUrl}/><meta property="og:type" content="article"/><meta property="og:locale" content={en?'en_GB':'da_DK'}/><meta property="og:site_name" content="The Evolution of Bikes"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={ogImage}/><meta property="og:image:alt" content={en?'Portrait of Bernard Hinault in 1982':'Portræt af Bernard Hinault i 1982'}/><meta name="twitter:card" content="summary_large_image"/><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Libre+Caslon+Display&display=swap" rel="stylesheet"/><link rel="stylesheet" href={`${base}/styles/global.css`}/></head><body>
{en?<EnglishHeader current="stories" danishPath={`/historier/${slug}/`}/>:<header class="site-header"><a class="brand" href={`${base}/`} aria-label="The Evolution of Bikes, forside"><span class="brand-mark">E<span>B</span></span><span>The Evolution<br/>of Bikes</span></a><nav aria-label="Hovedmenu"><a href={`${base}/historier/`} aria-current="page">Historier</a><a href={`${base}/perioder/`}>Perioder</a><a href={`${base}/cykler/`}>Cykler</a><a href={`${base}/om/`}>Om</a></nav><div class="header-tools"><strong>DA</strong><span>/</span><a href={`${base}/en/stories/${slug}/`}>EN</a><a class="header-story-link" href={`${base}/fortael-din-historie/`}>Fortæl din historie</a></div></header>}
<main><article class="story"><header class="story-hero"><p class="section-label">{copy.eyebrow}</p><h1>{title}</h1><p>{copy.deck}</p></header><figure class="hero"><OptimizedImage src={hero} alt={en?'Bernard Hinault during the Tour of the Netherlands in 1982':'Bernard Hinault under Holland Rundt i 1982'} widths={[480,768,1100,1536]} sizes="(max-width:800px) 90vw,760px" loading="eager" fetchpriority="high"/><figcaption>{en?'Bernard Hinault in 1982, two years before the confrontation at Paris–Nice. Photograph: Marcel Antonisse/Anefo, Nationaal Archief, CC0.':'Bernard Hinault i 1982, to år før sammenstødet i Paris–Nice. Foto: Marcel Antonisse/Anefo, Nationaal Archief, CC0.'}</figcaption></figure>
<div class="story-copy"><p class="lead">{copy.lead}</p>{copy.sections.map(([heading,paragraphs])=><section><h2>{heading}</h2>{paragraphs.map((paragraph)=><p>{paragraph}</p>)}</section>)}</div><aside class="pull-quote"><p>{copy.quote}</p></aside><div class="portrait-row"><figure><OptimizedImage src={tour1978} alt={en?'Bernard Hinault after winning the 1978 Tour de France':'Bernard Hinault efter sejren i Tour de France 1978'} widths={[480,768,1100]} sizes="(max-width:760px) 88vw,430px"/><figcaption>{en?'Hinault after winning the 1978 Tour de France. Photograph: Anefo/Nationaal Archief, CC BY-SA 3.0 NL.':'Hinault efter sejren i Tour de France 1978. Foto: Anefo/Nationaal Archief, CC BY-SA 3.0 NL.'}</figcaption></figure><div><h2>{copy.endHeading}</h2>{copy.end.map((paragraph)=><p>{paragraph}</p>)}</div></div><section class="fact-strip">{copy.facts.map(([value,label])=><div><strong>{value}</strong><span>{label}</span></div>)}</section>
<section class="period-sources"><p class="section-label">{en?'Sources and image notes':'Kilder og billednoter'}</p><div><ul><li><a href="https://www.youtube.com/watch?v=S8sSprvMMXg" target="_blank" rel="noopener noreferrer">INA: {en?'archive film from the confrontation':'arkivoptagelser fra sammenstødet'}</a></li><li><a href="https://elpais.com/diario/1984/03/13/deportes/447980411_850215.html" target="_blank" rel="noopener noreferrer">El País, 13 March 1984</a></li><li><a href="https://www.procyclingstats.com/race/paris-nice/1984/stage-5" target="_blank" rel="noopener noreferrer">ProCyclingStats: Paris–Nice 1984, stage 5</a></li><li><a href="https://www.senat.fr/comptes-rendus-seances/5eme/pdf/1984/11/s19841128_3741_3779.pdf" target="_blank" rel="noopener noreferrer">Sénat: {en?'French shipbuilding debate, 1984':'debat om fransk skibsbygning, 1984'}</a></li></ul><p>{en?'The photographs show Hinault in 1978 and 1982; neither depicts the protest. The event itself is documented by contemporary film and reporting.':'Fotografierne viser Hinault i 1978 og 1982; ingen af dem viser protesten. Selve hændelsen er dokumenteret med samtidige filmoptagelser og presseomtale.'}</p><p><strong>{en?'Alternative illustration:':'Alternativ illustration:'}</strong> {en?'A clearly labelled illustration could show a professional peloton stopped by shipyard workers on a southern French road in March 1984, with period bicycles, race cars and work clothes, sober documentary treatment, no invented logos and no identifiable fabricated faces.':'En tydeligt mærket illustration kan vise et professionelt cykelfelt standset af værftsarbejdere på en sydfransk landevej i marts 1984, med tidstypiske cykler, løbsbiler og arbejdstøj, nøgtern dokumentarisk stil, uden opdigtede logoer og uden genkendelige, opfundne ansigter.'}</p></div></section><RelatedDiscovery currentSlug={slug} language={language}/><nav class="era-bottom-nav"><a href={`${base}/${en?'en/stories':'historier'}/`}>← {en?'All stories':'Alle historier'}</a><a href={`${base}/${en?'en/periods':'perioder'}/1980-1989/`}>{en?'The 1980–1989 period':'Perioden 1980–1989'} →</a></nav></article></main>{en?<EnglishFooter/>:<footer><div class="brand footer-brand"><span class="brand-mark">E<span>B</span></span><span>The Evolution<br/>of Bikes</span></div><p>En personlig samling af vintagecykler,<br/>historier, mærker og komponenter.</p><p class="copyright">© {new Date().getFullYear()} The Evolution of Bikes</p></footer>}</body></html>
<style>.story-hero{max-width:1100px;margin:auto;padding:5rem 1.5rem 3rem}.story-hero h1{font:400 clamp(3.2rem,7.6vw,7rem)/.96 'Libre Caslon Display',serif;margin:.7rem 0 1.8rem}.story-hero>p:last-child{max-width:780px;font-size:1.25rem;line-height:1.65}.hero{max-width:820px;margin:0 auto 4rem;padding:0 1.5rem}.hero :global(img),.portrait-row :global(img){display:block;width:100%;height:auto;max-height:820px;object-fit:contain}.hero figcaption,.portrait-row figcaption{margin-top:.75rem;color:#625e55;font-size:.84rem;line-height:1.55}.story-copy{max-width:760px;margin:auto;padding:0 1.5rem 3rem;font-size:1.08rem;line-height:1.82}.lead{font:1.75rem/1.45 'Libre Caslon Display',serif}.story-copy h2,.portrait-row h2{font:400 clamp(2rem,4vw,3rem)/1.15 'Libre Caslon Display',serif;margin:3.2rem 0 1rem}.pull-quote{max-width:1000px;margin:1rem auto 5rem;padding:3.5rem 1.5rem;border-block:1px solid var(--line)}.pull-quote p{max-width:860px;margin:auto;font:400 clamp(2rem,4.5vw,4rem)/1.1 'Libre Caslon Display',serif}.portrait-row{display:grid;grid-template-columns:minmax(280px,430px) minmax(300px,520px);align-items:center;gap:clamp(2rem,6vw,6rem);max-width:1100px;margin:0 auto 5rem;padding:0 1.5rem;font-size:1.05rem;line-height:1.78}.portrait-row figure{margin:0}.portrait-row h2{margin-top:0}.fact-strip{display:grid;grid-template-columns:repeat(4,1fr);max-width:1180px;margin:0 auto 5rem;padding:0 1.5rem;gap:1px}.fact-strip div{display:flex;min-height:170px;flex-direction:column;justify-content:space-between;background:#d9ded4;padding:1.4rem}.fact-strip strong{font:400 clamp(2.3rem,4vw,4rem)/1 'Libre Caslon Display',serif}.fact-strip span{font-size:.82rem}.period-sources{max-width:1000px;margin:auto}.period-sources li{overflow-wrap:anywhere}@media(max-width:800px){.story-hero{padding-top:2.5rem}.portrait-row{grid-template-columns:1fr}.fact-strip{grid-template-columns:1fr 1fr}.fact-strip div{min-height:145px}}@media(max-width:480px){.fact-strip{grid-template-columns:1fr}}</style>
