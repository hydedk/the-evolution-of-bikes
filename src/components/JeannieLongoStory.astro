<!doctype html><html lang={language}><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><title>{title} · The Evolution of Bikes</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><link rel="alternate" hreflang="da" href={daUrl}/><link rel="alternate" hreflang="en" href={enUrl}/><link rel="alternate" hreflang="x-default" href={daUrl}/><meta property="og:type" content="article"/><meta property="og:locale" content={en?'en_GB':'da_DK'}/><meta property="og:site_name" content="The Evolution of Bikes"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={ogImage}/><meta name="twitter:card" content="summary_large_image"/><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Libre+Caslon+Display&display=swap" rel="stylesheet"/><link rel="stylesheet" href={`${base}/styles/global.css`}/></head><body>
{en?<EnglishHeader current="stories" danishPath={`/historier/${slug}/`}/>:<header class="site-header"><a class="brand" href={`${base}/`} aria-label="The Evolution of Bikes, forside"><span class="brand-mark">E<span>B</span></span><span>The Evolution<br/>of Bikes</span></a><nav aria-label="Hovedmenu"><a href={`${base}/historier/`} aria-current="page">Historier</a><a href={`${base}/perioder/`}>Perioder</a><a href={`${base}/cykler/`}>Cykler</a><a href={`${base}/om/`}>Om</a></nav><div class="header-tools"><strong>DA</strong><span>/</span><a href={`${base}/en/stories/${slug}/`}>EN</a><a class="header-story-link" href={`${base}/fortael-din-historie/`}>Fortæl din historie</a></div></header>}
<main><article class="longo-story"><header class="story-hero"><p class="section-label">{copy.eyebrow}</p><h1>{title}</h1><p>{copy.deck}</p></header><figure class="story-image"><OptimizedImage src={podium} alt={en?'Jeannie Longo on the podium at the 2011 French championships':'Jeannie Longo på podiet ved de franske mesterskaber i 2011'} widths={[480,768,1100,1534]} sizes="(max-width:800px) 88vw,650px" loading="eager" fetchpriority="high"/><figcaption>{en?'Jeannie Longo at the 2011 French championships, two days after the time trial. Photograph: Thomas Ducroquet, Wikimedia Commons, CC BY-SA 3.0.':'Jeannie Longo ved de franske mesterskaber i 2011, to dage efter enkeltstarten. Foto: Thomas Ducroquet, Wikimedia Commons, CC BY-SA 3.0.'}</figcaption></figure>
<div class="story-copy"><p class="lead">{copy.lead}</p>{copy.sections.map(([heading,paragraphs])=><section><h2>{heading}</h2>{paragraphs.map((paragraph)=><p>{paragraph}</p>)}</section>)}</div><aside class="pull-quote"><p>{copy.quote}</p></aside><div class="portrait-row"><figure><OptimizedImage src={grenoble} alt={en?'Jeannie Longo with a bicycle at the Grenoble Six Day in 2011':'Jeannie Longo med cykel ved seksdagesløbet i Grenoble i 2011'} widths={[480,768,1100,1365]} sizes="(max-width:760px) 88vw,430px"/><figcaption>{en?'Jeannie Longo at the Grenoble Six Day later in 2011. Photograph: Kyro, Wikimedia Commons, CC BY-SA 3.0.':'Jeannie Longo ved seksdagesløbet i Grenoble senere i 2011. Foto: Kyro, Wikimedia Commons, CC BY-SA 3.0.'}</figcaption></figure><div><h2>{copy.endHeading}</h2>{copy.end.map((paragraph)=><p>{paragraph}</p>)}</div></div><section class="fact-strip">{copy.facts.map(([value,label])=><div><strong>{value}</strong><span>{label}</span></div>)}</section>
<section class="period-sources"><p class="section-label">{en?'Sources and image notes':'Kilder og billednoter'}</p><div><ul><li><a href="https://structures.ffc.fr/app/uploads/sites/4/2023/10/PalmaresCDFmaj2024_CLM.pdf" target="_blank" rel="noopener noreferrer">Fédération Française de Cyclisme: {en?'French time trial champions':'franske mestre i enkeltstart'}</a></li><li><a href="https://www.cyclingnews.com/news/58th-national-championship-title-for-longo/" target="_blank" rel="noopener noreferrer">Cyclingnews: {en?'result and time gaps':'resultat og tidsforskelle'}, 23 June 2011</a></li><li><a href="https://www.uci.org/article/the-history-and-the-records-of-road-s-rainbow-jersey/3Qvg8Z7qJQeieqj8EYNoCd" target="_blank" rel="noopener noreferrer">UCI: {en?'Longo’s road and time trial world titles':'Longos VM-titler på landevej og enkeltstart'}</a></li><li><a href="https://commons.wikimedia.org/wiki/File:Jeannie_Longo_CN2011.JPG" target="_blank" rel="noopener noreferrer">Wikimedia Commons: Thomas Ducroquet</a></li><li><a href="https://commons.wikimedia.org/wiki/File:Jeannie_Longo_-_6_jours_de_Grenoble_2011.jpg" target="_blank" rel="noopener noreferrer">Wikimedia Commons: Kyro</a></li></ul><p>{en?'The photographs are contemporary portraits from 2011, but do not show the time trial itself. Published totals for Longo’s national titles vary with the method of counting, so that number is not used as the story’s central fact.':'Fotografierne er samtidige portrætter fra 2011, men viser ikke selve enkeltstarten. Det ofte citerede samlede antal franske titler afhænger af opgørelsesmetoden og bruges derfor ikke som historiens bærende tal.'}</p><p><strong>{en?'Alternative illustration:':'Alternativ illustration:'}</strong> {en?'A clearly labelled illustration could show a mature French time trial rider low over the bars on a coastal course in 2011, in side view with stopwatch graphics and without sponsor logos or invented spectators.':'En tydeligt mærket illustration kan vise en moden fransk enkeltstartsrytter lavt over styret på en kystnær rute i 2011, set fra siden med stopur-grafik og uden sponsorlogoer eller opdigtede tilskuere.'}</p></div></section><nav class="era-bottom-nav"><a href={`${base}/${en?'en/stories':'historier'}/`}>← {en?'All stories':'Alle historier'}</a><a href={`${base}/${en?'en/periods':'perioder'}/2010-2019/`}>{en?'The 2010–2019 period':'Perioden 2010–2019'} →</a></nav></article></main>{en?<EnglishFooter/>:<footer><div class="brand footer-brand"><span class="brand-mark">E<span>B</span></span><span>The Evolution<br/>of Bikes</span></div><p>En personlig samling af vintagecykler,<br/>historier, mærker og komponenter.</p><p class="copyright">© {new Date().getFullYear()} The Evolution of Bikes</p></footer>}</body></html>
<style>.story-hero{max-width:1100px;margin:auto;padding:5rem 1.5rem 3rem}.story-hero h1{font:400 clamp(3.3rem,8vw,7.2rem)/.94 'Libre Caslon Display',serif;margin:.7rem 0 1.8rem}.story-hero>p:last-child{max-width:760px;font-size:1.25rem;line-height:1.65}.story-image{max-width:700px;margin:0 auto 4rem;padding:0 1.5rem}.story-image :global(img),.portrait-row :global(img){display:block;width:100%;height:auto;max-height:800px;object-fit:contain}.story-image figcaption,.portrait-row figcaption{margin-top:.75rem;color:#625e55;font-size:.84rem;line-height:1.55}.story-copy{max-width:760px;margin:auto;padding:0 1.5rem 3rem;font-size:1.08rem;line-height:1.82}.lead{font:1.75rem/1.45 'Libre Caslon Display',serif}.story-copy h2,.portrait-row h2{font:400 clamp(2rem,4vw,3rem)/1.15 'Libre Caslon Display',serif;margin:3.2rem 0 1rem}.pull-quote{max-width:1000px;margin:1rem auto 5rem;padding:3.5rem 1.5rem;border-block:1px solid var(--line)}.pull-quote p{max-width:860px;margin:auto;font:400 clamp(2rem,4.5vw,4rem)/1.1 'Libre Caslon Display',serif}.portrait-row{display:grid;grid-template-columns:minmax(280px,430px) minmax(300px,520px);align-items:center;gap:clamp(2rem,6vw,6rem);max-width:1100px;margin:0 auto 5rem;padding:0 1.5rem;font-size:1.05rem;line-height:1.78}.portrait-row figure{margin:0}.portrait-row h2{margin-top:0}.fact-strip{display:grid;grid-template-columns:repeat(4,1fr);max-width:1180px;margin:0 auto 5rem;padding:0 1.5rem;gap:1px}.fact-strip div{display:flex;min-height:170px;flex-direction:column;justify-content:space-between;background:#dbe2e7;padding:1.4rem}.fact-strip strong{font:400 clamp(2.3rem,4vw,4rem)/1 'Libre Caslon Display',serif}.fact-strip span{font-size:.82rem}.period-sources{max-width:1000px;margin:auto}.period-sources li{overflow-wrap:anywhere}@media(max-width:800px){.story-hero{padding-top:2.5rem}.portrait-row{grid-template-columns:1fr}.fact-strip{grid-template-columns:1fr 1fr}.fact-strip div{min-height:145px}}@media(max-width:480px){.fact-strip{grid-template-columns:1fr}}</style>
