---
import EnglishHeader from './EnglishHeader.astro';
import EnglishFooter from './EnglishFooter.astro';
import OptimizedImage from './OptimizedImage.astro';
import RelatedDiscovery from './RelatedDiscovery.astro';
import hero from '../assets/stories/kund-rindboel-tempoproeve-1983/elverdam-mod-vendepunkt.jpg';
import returnPhoto from '../assets/stories/kund-rindboel-tempoproeve-1983/elverdam-hjemad.jpg';

const { language = 'da' } = Astro.props;
const en = language === 'en';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const slug = 'kund-rindboel-tempoproeve-1983';
const daUrl = `https://teob.dk/historier/${slug}/`;
const enUrl = `https://teob.dk/en/stories/${slug}/`;
const canonical = en ? enUrl : daUrl;
const title = en ? 'Kund Rindbøl’s time trial on the old main road' : 'Kund Rindbøls tempoprøve på den gamle hovedvej';
const description = en
  ? 'A reader remembers a 30-kilometre time trial on the old road between Holbæk and Roskilde on 17 September 1983.'
  : 'En læser husker en 30 kilometer lang enkeltstart på den gamle hovedvej mellem Holbæk og Roskilde den 17. september 1983.';
const copy = en ? {
  eyebrow: 'Reader story · 1983',
  deck: 'Thirty kilometres, one rider at a time and a main road still open to ordinary traffic. Two private photographs preserve a Danish time trial as it looked from the verge.',
  lead: 'His mother is waiting at the top of Elverdam hill. A lorry is coming the other way, spectators stand by the road, and the rider has his head down in the wind.',
  sections: [
    ['Towards the turn', ['The date in the rider’s notes is 17 September 1983. The event is described as DBC’s 30-kilometre individual time trial on the old main road between Holbæk and Roskilde. The first photograph was taken on the outward leg at Elverdam.', 'There are no closed roads or crowd barriers. The white edge line is the rider’s narrow workplace. Cars and a lorry use the same road, while his mother stands on the cycle path with an encouraging call ready.']],
    ['A minute between riders', ['The account says that all classes started in one combined prize field, much as they had in the earlier Fagerhult Sprinterderby at Undløse. More than one hundred riders took part, sent away individually.', 'He started as number two. That meant there were few backs to aim for. On the return from the turn, he caught the Gladsaxe rider who had started one minute ahead. After that, he recalls, the final fifteen kilometres offered no one else to chase.']],
    ['54 × 14 on Elverdam hill', ['In the second photograph he is riding home with the wind behind him and working a 54 × 14 gear. The small detail tells almost as much as the result: a large chainring, a small sprocket and a position held against the clock on an ordinary Danish road.', 'According to his later recollection, he finished fifteenth, 2 minutes 53 seconds behind winner Jesper Skibby. He remembered being 21 and 18 seconds behind John Helleskov and Klaus Møller in the two places immediately ahead. Those figures come from the rider’s own account; an official result sheet has not yet been located.']],
  ],
  quote: 'The stopwatch measured the ride. The photographs kept the road, the traffic and his mother’s place at the roadside.',
  endHeading: 'What remains',
  end: ['A local time trial rarely leaves a large archive. Here, two photographs and a few precise memories do the work: the date, the gearing, the minute to the rider in front and the autumn colours above the road.', 'They also show a form of racing that belonged closely to everyday traffic. The course was not a separate arena. It was the main road, borrowed for half an hour at a time.'],
  facts: [['17 Sep.', '1983'], ['30 km', 'individual time trial'], ['54 × 14', 'remembered gear'], ['15th', 'remembered placing']],
} : {
  eyebrow: 'Læserhistorie · 1983',
  deck: 'Tredive kilometer, én rytter ad gangen og en hovedvej, der stadig var åben for almindelig trafik. To private fotografier viser en dansk enkeltstart fra rabatten.',
  lead: 'Hans mor står klar på toppen af Elverdamsbakken. En lastbil kommer imod ham, tilskuere står langs vejen, og rytteren har hovedet nede i modvinden.',
  sections: [
    ['På vej mod vendepunktet', ['Datoen i rytterens egne noter er 17. september 1983. Løbet beskriver han som DBC’s 30 kilometer lange enkeltstart på den gamle hovedvej mellem Holbæk og Roskilde. Det første fotografi er taget på udturen ved Elverdammen.', 'Der er ingen afspærring og ingen publikumshegn. Den hvide kantlinje er rytterens smalle arbejdsplads. Biler og en lastbil bruger samme vej, mens hans mor står på cykelstien med et opmuntrende tilråb klar.']],
    ['Et minut mellem rytterne', ['Ifølge erindringen startede alle klasser i én samlet præmierække, sådan som de også havde gjort i løbets mangeårige forgænger, Fagerhults Sprinterderby i Undløse. Mere end hundrede ryttere blev sendt af sted enkeltvis.', 'Han startede som nummer to. Derfor var der ikke mange rygge at sigte efter. På hjemvejen fra vendepunktet hentede han Gladsaxe-rytteren, der var startet et minut før. Derefter var der, som han husker det, ingen at køre efter på de sidste femten kilometer.']],
    ['54 × 14 på Elverdamsbakken', ['På det andet fotografi er han på vej hjem med vinden i ryggen og arbejder på gearingen 54 × 14. Den lille oplysning fortæller næsten lige så meget som resultatet: en stor klinge, et lille tandhjul og en position, der skulle holdes mod uret på en almindelig dansk landevej.', 'I den senere erindring blev det til en 15.-plads, 2 minutter og 53 sekunder efter vinderen, Jesper Skibby. Han huskede desuden 21 og 18 sekunder op til John Helleskov og Klaus Møller på de to nærmeste pladser. Tallene stammer fra rytterens egen beretning; en officiel resultatliste er endnu ikke fundet.']],
  ],
  quote: 'Stopuret målte turen. Fotografierne bevarede vejen, trafikken og morens plads i rabatten.',
  endHeading: 'Det, der blev tilbage',
  end: ['En lokal enkeltstart efterlader sjældent et stort arkiv. Her gør to fotografier og nogle få præcise erindringer arbejdet: datoen, gearingen, minuttet til manden foran og efterårsfarverne over vejen.', 'De viser også en form for cykelløb, der lå tæt på hverdagens trafik. Ruten var ikke en særskilt arena. Den var hovedvejen, lånt en halv time ad gangen.'],
  facts: [['17. sep.', '1983'], ['30 km', 'enkeltstart'], ['54 × 14', 'husket gearing'], ['Nr. 15', 'husket placering']],
};
---
<!doctype html><html lang={language}><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><title>{title} · The Evolution of Bikes</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><link rel="alternate" hreflang="da" href={daUrl}/><link rel="alternate" hreflang="en" href={enUrl}/><link rel="alternate" hreflang="x-default" href={daUrl}/><meta property="og:type" content="article"/><meta property="og:locale" content={en?'en_GB':'da_DK'}/><meta property="og:site_name" content="The Evolution of Bikes"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={new URL(hero.src, canonical).href}/><meta property="og:image:alt" content={en?'Rider in a 30-kilometre time trial at Elverdam in 1983':'Rytter i en 30 kilometer lang enkeltstart ved Elverdammen i 1983'}/><meta name="twitter:card" content="summary_large_image"/><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Libre+Caslon+Display&display=swap" rel="stylesheet"/><link rel="stylesheet" href={`${base}/styles/global.css`}/></head><body>
{en?<EnglishHeader current="stories" danishPath={`/historier/${slug}/`}/>:<header class="site-header"><a class="brand" href={`${base}/`} aria-label="The Evolution of Bikes, forside"><span class="brand-mark">E<span>B</span></span><span>The Evolution<br/>of Bikes</span></a><nav aria-label="Hovedmenu"><a href={`${base}/historier/`} aria-current="page">Historier</a><a href={`${base}/perioder/`}>Perioder</a><a href={`${base}/cykler/`}>Cykler</a><a href={`${base}/om/`}>Om</a></nav><div class="header-tools"><strong>DA</strong><span>/</span><a href={`${base}/en/stories/${slug}/`}>EN</a><a class="header-story-link" href={`${base}/fortael-din-historie/`}>Fortæl din historie</a></div></header>}
<main><article class="story"><header class="story-hero"><p class="section-label">{copy.eyebrow}</p><h1>{title}</h1><p>{copy.deck}</p></header><figure class="hero"><OptimizedImage src={hero} alt={en?'A time trial rider passes his mother and oncoming traffic at Elverdam in 1983':'En enkeltstartsrytter passerer sin mor og den modkørende trafik ved Elverdammen i 1983'} widths={[480,768,1100,1536]} sizes="(max-width:800px) 92vw,980px" loading="eager" fetchpriority="high"/><figcaption>{en?'Towards the turn at Elverdam on 17 September 1983. Private photograph.':'På vej mod vendepunktet ved Elverdammen den 17. september 1983. Privatfoto.'}</figcaption></figure>
<div class="story-copy"><p class="lead">{copy.lead}</p>{copy.sections.slice(0,2).map(([heading,paragraphs])=><section><h2>{heading}</h2>{paragraphs.map((paragraph)=><p>{paragraph}</p>)}</section>)}</div><aside class="pull-quote"><p>{copy.quote}</p></aside><div class="photo-row"><figure><OptimizedImage src={returnPhoto} alt={en?'The same rider on the return from the turn in the 1983 time trial':'Samme rytter på hjemvejen fra vendepunktet under enkeltstarten i 1983'} widths={[480,768,1100]} sizes="(max-width:760px) 90vw,520px"/><figcaption>{en?'Homeward on Elverdam hill, with the rider’s mother at the roadside. Private photograph.':'På vej hjem over Elverdamsbakken med rytterens mor i rabatten. Privatfoto.'}</figcaption></figure><div><h2>{copy.sections[2][0]}</h2>{copy.sections[2][1].map((paragraph)=><p>{paragraph}</p>)}</div></div><section class="fact-strip">{copy.facts.map(([value,label])=><div><strong>{value}</strong><span>{label}</span></div>)}</section><div class="story-copy conclusion"><section><h2>{copy.endHeading}</h2>{copy.end.map((paragraph)=><p>{paragraph}</p>)}</section></div>
<section class="period-sources"><p class="section-label">{en?'Sources':'Kilder'}</p><div><ul><li>{en?'The rider’s later recollections and two private photographs.':'Rytterens senere erindringer og to private fotografier.'}</li><li><a href="https://lex.dk/Jesper_Skibby" target="_blank" rel="noopener noreferrer">Lex: Jesper Skibby</a></li></ul><p>{en?'The date, course and result details are presented as the rider remembered them.':'Dato, rute og resultatdetaljer er gengivet, sådan som rytteren huskede dem.'}</p></div></section><RelatedDiscovery currentSlug={slug} language={language}/><nav class="era-bottom-nav"><a href={`${base}/${en?'en/stories':'historier'}/`}>← {en?'All stories':'Alle historier'}</a><a href={`${base}/${en?'en/periods':'perioder'}/1980-1989/`}>{en?'The 1980–1989 period':'Perioden 1980–1989'} →</a></nav></article></main>{en?<EnglishFooter/>:<footer><div class="brand footer-brand"><span class="brand-mark">E<span>B</span></span><span>The Evolution<br/>of Bikes</span></div><p>En personlig samling af vintagecykler,<br/>historier, mærker og komponenter.</p><p class="copyright">© {new Date().getFullYear()} The Evolution of Bikes</p></footer>}</body></html>
<style>.story-hero{max-width:1100px;margin:auto;padding:5rem 1.5rem 3rem}.story-hero h1{font:400 clamp(3.1rem,7.4vw,6.8rem)/.97 'Libre Caslon Display',serif;margin:.7rem 0 1.8rem}.story-hero>p:last-child{max-width:780px;font-size:1.25rem;line-height:1.65}.hero{max-width:1040px;margin:0 auto 4rem;padding:0 1.5rem}.hero :global(img),.photo-row :global(img){display:block;width:100%;height:auto;max-height:820px;object-fit:contain}.hero figcaption,.photo-row figcaption{margin-top:.75rem;color:#625e55;font-size:.84rem;line-height:1.55}.story-copy{max-width:760px;margin:auto;padding:0 1.5rem 3rem;font-size:1.08rem;line-height:1.82}.story-copy h2,.photo-row h2{font:400 clamp(2rem,4vw,3rem)/1.15 'Libre Caslon Display',serif;margin:3.2rem 0 1rem}.lead{font:1.75rem/1.45 'Libre Caslon Display',serif}.pull-quote{max-width:1000px;margin:1rem auto 5rem;padding:3.5rem 1.5rem;border-block:1px solid var(--line)}.pull-quote p{max-width:860px;margin:auto;font:400 clamp(2rem,4.5vw,4rem)/1.1 'Libre Caslon Display',serif}.photo-row{display:grid;grid-template-columns:minmax(280px,520px) minmax(300px,520px);align-items:center;gap:clamp(2rem,6vw,6rem);max-width:1180px;margin:0 auto 5rem;padding:0 1.5rem;font-size:1.05rem;line-height:1.78}.photo-row figure{margin:0}.photo-row h2{margin-top:0}.fact-strip{display:grid;grid-template-columns:repeat(4,1fr);max-width:1180px;margin:0 auto 4rem;padding:0 1.5rem;gap:1px}.fact-strip div{display:flex;min-height:170px;flex-direction:column;justify-content:space-between;background:#d9ded4;padding:1.4rem}.fact-strip strong{font:400 clamp(2.3rem,4vw,4rem)/1 'Libre Caslon Display',serif}.fact-strip span{font-size:.82rem}.conclusion{padding-bottom:4rem}.period-sources{max-width:1000px;margin:auto}.period-sources li{overflow-wrap:anywhere}@media(max-width:800px){.story-hero{padding-top:2.5rem}.photo-row{grid-template-columns:1fr}.fact-strip{grid-template-columns:1fr 1fr}.fact-strip div{min-height:145px}}@media(max-width:480px){.fact-strip{grid-template-columns:1fr}}</style>
