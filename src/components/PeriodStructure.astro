  <header><p class="section-label">{en ? 'The common period model' : 'Periodens faste overblik'}</p><h2 id="period-model-title">{en ? `${decadeName} in three views` : `${decadeName} i tre bokse`}</h2></header>
  <div class="period-summary-boxes">{boxes.map(([title, text], index) => <article><span>0{index + 1}</span><h3>{title}</h3>{index === 2 ? <ul>{text.split('. ').map((line) => <li>{line.replace(/\.$/, '')}</li>)}</ul> : <p>{text}</p>}</article>)}</div>
  <div class="period-model-timeline"><header><p class="section-label">{en ? 'Selected events' : 'Udvalgte begivenheder'}</p><h2>{en ? 'A short timeline' : 'En kort tidslinje'}</h2></header><ol>{timeline.map(([year, text]) => <li><time>{year}</time><span>{text}</span></li>)}</ol></div>
  <div class="period-theme-sections"><header><p class="section-label">{en ? 'Seven fixed themes' : 'Syv faste temaer'}</p><h2>{en ? 'The decade, seen across the site' : 'Årtiet på tværs af hjemmesiden'}</h2></header>
    {themeIds.map((id, index) => {
      const theme = themes[id];
      const related = items.filter((item) => item.themes.includes(id)).slice(0, 4);
      return <section id={id} class="period-theme-row">
        <div><span>0{index + 1}</span><h3>{en ? theme.en : theme.da}</h3><p>{periodThemeCopy[id]}</p><a href={`${base}/${en ? 'en/themes' : 'tema'}/${id}/`}>{en ? 'Follow this theme through cycling history →' : 'Følg temaet gennem cykelhistorien →'}</a></div>
        <div class="period-theme-items">
          {related.length ? <>
            {related.map((item) => <a class:list={{ 'has-card-image': Boolean(item.image) }} style={item.image ? `--card-image: url('${base}${item.image}')` : undefined} href={`${base}${en ? item.englishUrl : item.canonicalUrl}`}><small>{itemType(item.type)} · {item.year}</small><strong>{item.title}</strong></a>)}
            {related.length % 2 === 1 && <div class="period-theme-placeholder" aria-hidden="true"><div class="brand period-card-brand"><span class="brand-mark">E<span>B</span></span><span>The Evolution<br/>of Bikes</span></div></div>}
          </> : <p>{en ? 'No published content has this as a primary or secondary theme yet.' : 'Der er endnu ikke udgivet indhold med temaet som primær eller sekundær mærkning.'}</p>}
        </div>
      </section>;
    })}
  </div>
</section>
