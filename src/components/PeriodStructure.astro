---
import { themes, themeIds, contentForPeriod, localizeContent } from '../data/taxonomy';
const { language = 'da', period = '1990-1999' } = Astro.props as { language?: 'da' | 'en'; period?: string };
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const en = language === 'en';
const items = localizeContent(contentForPeriod(period), language);
const itemType = (type: string) => en ? ({ historie: 'Story', cykel: 'Bicycle', komponent: 'Component' }[type] ?? type) : ({ historie: 'Historie', cykel: 'Cykel', komponent: 'Komponent' }[type] ?? type);
let boxes = en ? [
  ['The decade’s main development', 'Training, equipment and nutrition became more professional and more closely measured.'],
  ['What defined the period', 'Larger budgets, new materials, international television coverage and a growing doping shadow.'],
  ['Three changes to cycling', 'Integrated shift levers became standard. Carbon fibre gained ground. Training and fuelling became more scientific.'],
] : [
  ['Årtiets vigtigste udvikling', 'Professionaliseringen af træning, udstyr og ernæring ændrede cykelsporten.'],
  ['Det kendetegnede perioden', 'Større holdbudgetter, nye materialer, international tv-dækning og en voksende dopingskygge.'],
  ['Tre ting, der ændrede cyklingen', 'Integrerede gearskiftere blev normen. Kulfiber vandt frem. Træning og kost blev mere videnskabelig.'],
];
let timeline = en ? [['1990', 'Shimano introduces integrated brake and shift levers.'], ['1991', 'Miguel Indurain wins his first Tour de France.'], ['1992', 'Campagnolo launches Ergopower.'], ['1994', 'Indurain sets an hour record in Bordeaux.'], ['1996', 'Bjarne Riis wins the Tour.'], ['1997', 'The first L’Eroica is held in Tuscany.'], ['1998', 'The Festina affair brings raids and rider protests to the Tour.']] : [['1990', 'Shimano introducerer kombinerede bremse- og geargreb.'], ['1991', 'Miguel Indurain vinder sin første Tour de France.'], ['1992', 'Campagnolo lancerer Ergopower.'], ['1994', 'Indurain sætter timerekord i Bordeaux.'], ['1996', 'Bjarne Riis vinder Tour de France.'], ['1997', 'Det første L’Eroica køres i Toscana.'], ['1998', 'Festina-sagen udløser razziaer og rytterprotester i Touren.']];
let periodThemeCopy = en ? {
  'loeb-og-store-oejeblikke': 'Indurain controlled the Tour through long time trials, while Pantani changed races in the mountains. The Festina affair made the 1998 Tour a contest shaped as much by police raids and protests as by racing.',
  ryttere: 'Indurain, Rominger, Riis and Pantani represented very different ways of winning. Their results also belong to a decade whose medical culture later altered how those performances were understood.',
  teknik: 'Integrated shift and brake levers changed the rider’s position and timing. Aluminium grew common at the top level, carbon fibre gained ground, and deep-section wheels became a visible part of the racing bicycle.',
  'kost-traening-og-videnskab': 'Heart-rate monitors, laboratory testing and planned nutrition became more systematic. At the same time, EPO showed how sports medicine could be used for something rather different from rider health.',
  cykelkultur: 'International television made the largest races easier to follow across borders. L’Eroica, first held in 1997, also showed the beginning of a new interest in older bicycles and unpaved roads.',
  'samfund-og-tidsaand': 'Professional teams grew larger and more commercial. In 1998, customs officers, police investigators and legal proceedings moved into the Tour and changed the public discussion of the sport.',
  'menneskene-bag': 'Doctors, soigneurs, mechanics and team managers became part of increasingly specialised organisations. Their work shaped preparation, equipment and recovery, although it rarely appeared in the result sheet.',
} : {
  'loeb-og-store-oejeblikke': 'Indurain styrede Touren gennem de lange enkeltstarter, mens Pantani kunne ændre et løb i bjergene. Festina-sagen gjorde Touren i 1998 til et løb præget af både razziaer, protester og cykelløb.',
  ryttere: 'Indurain, Rominger, Riis og Pantani viste meget forskellige måder at vinde på. Resultaterne hører samtidig til et årti, hvor den medicinske kultur senere ændrede synet på præstationerne.',
  teknik: 'Kombinerede gear- og bremsegreb ændrede rytternes arbejdsstilling og timing. Aluminium blev almindeligt på topniveau, kulfiber vandt frem, og højprofilhjul blev en synlig del af racercyklen.',
  'kost-traening-og-videnskab': 'Pulsmålere, laboratorietest og planlagt ernæring blev mere systematisk. Samtidig viste EPO, at sportsmedicin også kunne bruges til noget ganske andet end rytternes sundhed.',
  cykelkultur: 'International tv-dækning gjorde de største løb lettere at følge på tværs af lande. L’Eroica, der blev kørt første gang i 1997, viste også en ny interesse for ældre cykler og grusveje.',
  'samfund-og-tidsaand': 'De professionelle hold blev større og mere kommercielle. I 1998 rykkede toldere, politi og retssager ind i Touren og ændrede den offentlige samtale om sporten.',
  'menneskene-bag': 'Læger, soigneurs, mekanikere og holdledere blev en del af stadig mere specialiserede organisationer. Deres arbejde prægede forberedelse, udstyr og restitution, selv om det sjældent stod i resultatlisten.',
};
if (period === '1900-1920') {
  boxes = en ? [
    ['The period’s main development', 'Road racing became a mass spectacle, and the Tour de France established the stage race as a recurring national story.'],
    ['What defined the period', 'Long distances, rough roads and strict rules made self-reliance part of both racing and its public image.'],
    ['Three changes to cycling', 'The Tour began in 1903. High mountains entered the route. The yellow leader’s jersey appeared in 1919.'],
  ] : [
    ['Periodens vigtigste udvikling', 'Landevejsløbet blev en folkelig begivenhed, og Tour de France gjorde etapeløbet til en tilbagevendende national fortælling.'],
    ['Det kendetegnede perioden', 'Lange distancer, dårlige veje og stramme regler gjorde selvhjulpenhed til en del af både løbet og dets offentlige billede.'],
    ['Tre ting, der ændrede cyklingen', 'Tour de France begyndte i 1903. De høje bjerge kom ind på ruten. Den gule førertrøje blev indført i 1919.'],
  ];
  timeline = en ? [
    ['1900', 'Track racing and long road races already draw large paying crowds.'],
    ['1903', 'The first Tour de France is held over six stages.'],
    ['1904', 'Spectator violence, nails and suspected cheating throw the Tour into crisis.'],
    ['1910', 'The Tour crosses the major Pyrenean passes for the first time.'],
    ['1912', 'Thorvald Ellegaard races the international sprint circuit as a six-time world champion.'],
    ['1913', 'Eugène Christophe repairs his broken fork in a forge; Christian Christensen becomes the first Dane to start the Tour.'],
    ['1919', 'The Tour returns after the war, and Christophe becomes the first wearer of the yellow jersey.'],
    ['1920', 'Philippe Thys becomes the Tour’s first three-time winner.'],
  ] : [
    ['1900', 'Banecykling og lange landevejsløb samler allerede et stort betalende publikum.'],
    ['1903', 'Det første Tour de France køres over seks etaper.'],
    ['1904', 'Tilskueruro, søm og mistanke om snyd bringer Touren i krise.'],
    ['1910', 'Touren krydser for første gang de store pas i Pyrenæerne.'],
    ['1912', 'Thorvald Ellegaard kører på den internationale sprintscene som seksdobbelt verdensmester.'],
    ['1913', 'Eugène Christophe reparerer sin knækkede forgaffel i en smedje; Christian Christensen bliver den første dansker i Touren.'],
    ['1919', 'Touren vender tilbage efter krigen, og Christophe bliver den første i den gule førertrøje.'],
    ['1920', 'Philippe Thys bliver Tourens første tredobbelte vinder.'],
  ];
  periodThemeCopy = en ? {
    'loeb-og-store-oejeblikke': 'The first Tour in 1903, the crisis of 1904, the Pyrenees in 1910 and the return after the First World War show a race still defining its route, rules and public role.',
    ryttere: 'Ellegaard was an international track star, Christophe became the image of persistence, and Christian Christensen travelled from a Danish dairy to the Tour without the protection of a major team.',
    teknik: 'The bicycle was mechanically simple but demanded practical knowledge. A puncture, a broken fork or a change of ratio had to be handled with tools, time and the rider’s own hands.',
    'kost-traening-og-videnskab': 'Food followed availability and experience rather than a common scientific plan. Coffee, alcohol, medicines and stimulants occupied a blurred field before international bans and laboratory tests.',
    cykelkultur: 'Newspapers turned races into serial stories, velodromes created professional stars, and roadside spectators made the bicycle part of modern popular culture.',
    'samfund-og-tidsaand': 'Industrial production, mass newspapers and new mobility helped cycling grow. The First World War interrupted the major races and marked both the riders and the landscapes when racing resumed.',
    'menneskene-bag': 'Editors and organisers such as Henri Desgrange created the rules, while Alphonse Steines found roads that could turn into stages. Their decisions shaped what the riders were asked to endure.',
  } : {
    'loeb-og-store-oejeblikke': 'Det første Tour i 1903, krisen i 1904, Pyrenæerne i 1910 og genstarten efter Første Verdenskrig viser et løb, der stadig var ved at definere sin rute, sine regler og sin offentlige rolle.',
    ryttere: 'Ellegaard var international banestjerne, Christophe blev billedet på stædighed, og Christian Christensen rejste fra et dansk mejeri til Touren uden et stort holds beskyttelse.',
    teknik: 'Cyklen var mekanisk enkel, men krævede praktisk kunnen. En punktering, en knækket forgaffel eller et skift af udveksling måtte klares med værktøj, tid og rytterens egne hænder.',
    'kost-traening-og-videnskab': 'Kosten fulgte adgang og erfaring frem for en fælles videnskabelig plan. Kaffe, alkohol, medicin og stimulanser lå i et uklart felt før internationale forbud og laboratoriekontrol.',
    cykelkultur: 'Aviserne gjorde løbene til føljetoner, velodromerne skabte professionelle stjerner, og publikum langs vejene gjorde cyklen til en del af den moderne massekultur.',
    'samfund-og-tidsaand': 'Industriproduktion, masseaviser og ny mobilitet gav cyklingen vækst. Første Verdenskrig afbrød de store løb og prægede både ryttere og landskaber, da sporten begyndte igen.',
    'menneskene-bag': 'Redaktører og arrangører som Henri Desgrange skabte reglerne, mens Alphonse Steines fandt veje, der kunne blive til etaper. Deres beslutninger formede det, rytterne blev sat til at udholde.',
  };
}
if (period === '1920-1930') {
  boxes = en ? [
    ['The decade’s main development', 'Stage racing grew into a European mass spectacle while teams, manufacturers and organisers became more structured.'],
    ['What defined the period', 'Enormous distances, damaged roads and strict rules existed alongside factory teams, race cars and a rapidly growing press audience.'],
    ['Three changes to cycling', 'The Tour first started outside Paris. Practical gear systems continued to develop. Specialist frame builders became part of racing culture.'],
  ] : [
    ['Årtiets vigtigste udvikling', 'Etapeløbene blev europæiske massebegivenheder, mens hold, fabrikanter og arrangører fik en mere fast organisation.'],
    ['Det kendetegnede perioden', 'Enorme distancer, nedslidte veje og stramme regler fandtes side om side med fabrikshold, løbsbiler og et voksende avispublikum.'],
    ['Tre ting, der ændrede cyklingen', 'Touren startede for første gang uden for Paris. Praktiske gearsystemer blev videreudviklet. Specialiserede rammebyggere blev en del af løbskulturen.'],
  ];
  timeline = en ? [
    ['1920', 'Peter Schrøder begins building bicycles in Copenhagen.'],
    ['1921', 'Léon Scieur wins the Tour de France.'],
    ['1923', 'Henri Suter wins both the Tour of Flanders and Paris–Roubaix.'],
    ['1924', 'Alfonsina Strada starts the Giro and continues to Milan outside the classification.'],
    ['1925', 'Alfredo Binda wins the Giro at his first attempt.'],
    ['1926', 'The longest Tour in history covers 5,745 kilometres; Lucien Buysse wins.'],
    ['1927', 'Binda wins twelve Giro stages; Tullio Campagnolo’s frozen wheel change becomes part of company lore.'],
    ['1929', 'Binda wins eight Giro stages in succession and takes his fourth overall victory.'],
  ] : [
    ['1920', 'Peter Schrøder begynder at bygge cykler i København.'],
    ['1921', 'Léon Scieur vinder Tour de France.'],
    ['1923', 'Henri Suter vinder både Flandern Rundt og Paris–Roubaix.'],
    ['1924', 'Alfonsina Strada starter Giroen og fortsætter til Milano uden for klassementet.'],
    ['1925', 'Alfredo Binda vinder Giroen ved sit første forsøg.'],
    ['1926', 'Historiens længste Tour køres over 5.745 kilometer; Lucien Buysse vinder.'],
    ['1927', 'Binda vinder tolv Giro-etaper; Campagnolos fastfrosne hjulskift bliver senere en del af firmaets oprindelsesfortælling.'],
    ['1929', 'Binda vinder otte Giro-etaper i træk og tager sin fjerde samlede sejr.'],
  ];
  periodThemeCopy = en ? {
    'loeb-og-store-oejeblikke': 'The 1926 Tour stretched across 5,745 kilometres, while the classics and the Giro developed their own stars and recurring dramas. Distance was still one of the organisers’ strongest instruments. ',
    ryttere: 'Alfonsina Strada challenged the boundaries of the Giro. Binda’s victories made dominance itself a problem, while Bottecchia and Buysse embodied the decade’s stage-race champions.',
    teknik: 'Reversible rear wheels still offered two ratios, but freewheels and early gear systems were spreading. Frames, wooden rims, tubular tyres and hand-built details made the racing bicycle both refined and demanding.',
    'kost-traening-og-videnskab': 'Riders ate according to availability, habit and experience. Coffee, alcohol, medicines and stimulants belonged to a poorly defined field, and later anecdotes must be separated from documented practice.',
    cykelkultur: 'Newspapers, roadside crowds and portraits with prized bicycles made cycling part of everyday modern culture. The racing cyclist became both worker and public figure.',
    'samfund-og-tidsaand': 'Europe still carried the damage of the First World War. Industry recovered, mass media expanded and international races offered a shared spectacle across national borders.',
    'menneskene-bag': 'Frame builders such as Peter Schrøder, mechanics, officials and newspaper organisers shaped the sport away from the finish line. Their choices determined the machines, rules and routes.',
  } : {
    'loeb-og-store-oejeblikke': 'Touren i 1926 strakte sig over 5.745 kilometer, mens klassikerne og Giroen udviklede deres egne stjerner og tilbagevendende dramaer. Distancen var stadig et af arrangørernes stærkeste virkemidler.',
    ryttere: 'Alfonsina Strada udfordrede Giroens grænser. Bindas sejre gjorde selve dominansen til et problem, mens Bottecchia og Buysse blev årtiets store etapeløbsryttere.',
    teknik: 'Vendbare baghjul gav fortsat to udvekslinger, men friløb og tidlige gearsystemer bredte sig. Stel, træfælge, ringdæk og håndbyggede detaljer gjorde racercyklen både raffineret og krævende.',
    'kost-traening-og-videnskab': 'Rytterne spiste efter adgang, vane og erfaring. Kaffe, alkohol, medicin og stimulanser lå i et uklart felt, og senere anekdoter må holdes adskilt fra dokumenteret praksis.',
    cykelkultur: 'Aviser, publikum langs vejen og portrætter med den kostbare cykel gjorde cyklingen til en del af den moderne hverdagskultur. Cykelrytteren blev både arbejder og offentlig person.',
    'samfund-og-tidsaand': 'Europa bar stadig sporene efter Første Verdenskrig. Industrien kom i gang, massemedierne voksede, og de internationale løb skabte et fælles skuespil på tværs af landegrænser.',
    'menneskene-bag': 'Rammebyggere som Peter Schrøder, mekanikere, officials og avisernes arrangører formede sporten uden for målstregen. Deres valg bestemte maskiner, regler og ruter.',
  };
}
if (period === '1930-1939') {
  boxes = en ? [
    ['The decade’s main development', 'The racing bicycle moved from stopping to change ratio towards practical gear changes made while riding.'],
    ['What defined the period', 'National teams, the publicity caravan and new stage races made cycling more organised, commercial and politically visible.'],
    ['Three changes to cycling', 'The Tour introduced national teams. The first Vuelta was held. Derailleurs were admitted to the Tour.'],
  ] : [
    ['Årtiets vigtigste udvikling', 'Racercyklen bevægede sig fra stop og hjulvending til et praktisk gearskifte, som kunne udføres under kørslen.'],
    ['Det kendetegnede perioden', 'Nationalhold, reklamekaravanen og nye etapeløb gjorde cykelsporten mere organiseret, kommerciel og politisk synlig.'],
    ['Tre ting, der ændrede cyklingen', 'Touren indførte nationalhold. Den første Vuelta blev kørt. Udvendige gear blev tilladt i Touren.'],
  ];
  timeline = en ? [
    ['1930', 'The Tour replaces trade teams with national selections and launches its official publicity caravan.'],
    ['1930', 'The Giro pays Alfredo Binda not to start after four overall victories in the 1920s.'],
    ['1933', 'Tullio Campagnolo establishes the company that grows from his wheel-release patents.'],
    ['1935', 'The first Vuelta a España is held; Gustaaf Deloor wins.'],
    ['1935', 'Romain Maes leads the Tour from the first stage to Paris.'],
    ['1937', 'Derailleurs are admitted to the Tour; Roger Lapébie wins with Super Champion.'],
    ['1938', 'Gino Bartali wins his first Tour de France.'],
    ['1939', 'Sylvère Maes wins the final Tour before the Second World War.'],
  ] : [
    ['1930', 'Touren erstatter firmaholdene med nationalhold og indfører sin officielle reklamekaravane.'],
    ['1930', 'Giroen betaler Alfredo Binda for ikke at stille op efter fire samlede sejre i 1920’erne.'],
    ['1933', 'Tullio Campagnolo grundlægger virksomheden, der voksede ud af hans patenter på hurtigudløseren.'],
    ['1935', 'Den første Vuelta a España køres; Gustaaf Deloor vinder.'],
    ['1935', 'Romain Maes fører Touren fra første etape til Paris.'],
    ['1937', 'Udvendige gear tillades i Touren; Roger Lapébie vinder med Super Champion.'],
    ['1938', 'Gino Bartali vinder sit første Tour de France.'],
    ['1939', 'Sylvère Maes vinder den sidste Tour før Anden Verdenskrig.'],
  ];
  periodThemeCopy = en ? {
    'loeb-og-store-oejeblikke': 'The first Vuelta, Romain Maes in yellow from start to finish and the last Tour before the war made the decade far more than a technical interlude.',
    ryttere: 'Binda’s dominance became an organisational problem, Bartali emerged as Italy’s great stage-race rider, and the Deloor brothers carried the first two Vueltas back to Belgium.',
    teknik: 'Quick-release hubs shortened wheel changes, while Super Champion finally brought the derailleur into the Tour. The Wonder Saint-Étienne shows the transition in metal and cable.',
    'kost-traening-og-videnskab': 'Food and drink still followed habit, availability and individual experience. Later stories about alcohol, tobacco and stimulants must be separated from documented daily practice.',
    cykelkultur: 'The publicity caravan turned the road before the riders into a travelling advertising show. Toy cyclists later brought the spectacle into homes and onto pavements.',
    'samfund-og-tidsaand': 'National teams made flags and politics more visible in sport. The Spanish Civil War interrupted the new Vuelta, while the 1939 Tour became the last before a far larger interruption.',
    'menneskene-bag': 'Desgrange and his organisation changed the Tour’s economy and team structure. Inventors such as Lucien Juy changed what riders could do without stopping.',
  } : {
    'loeb-og-store-oejeblikke': 'Den første Vuelta, Romain Maes i gult fra start til mål og den sidste Tour før krigen gjorde årtiet til andet end et teknisk mellemspil.',
    ryttere: 'Bindas dominans blev et organisatorisk problem, Bartali trådte frem som Italiens store etapeløbsrytter, og Deloor-brødrene tog de to første Vuelta-sejre med til Belgien.',
    teknik: 'Hurtigudløseren forkortede hjulskiftet, mens Super Champion endelig førte det udvendige gear ind i Touren. Wonder Saint-Étienne viser overgangen i metal og kabel.',
    'kost-traening-og-videnskab': 'Mad og drikke fulgte fortsat vane, adgang og den enkelte rytters erfaring. Senere fortællinger om alkohol, tobak og stimulanser må holdes adskilt fra dokumenteret daglig praksis.',
    cykelkultur: 'Reklamekaravanen gjorde vejen foran rytterne til et omrejsende reklameshow. Små cykelfigurer førte siden løbet ind i hjemmet og ud på fortovet.',
    'samfund-og-tidsaand': 'Nationalholdene gjorde flag og politik mere synlige i sporten. Den spanske borgerkrig afbrød den nye Vuelta, og Touren i 1939 blev den sidste før en langt større afbrydelse.',
    'menneskene-bag': 'Desgrange og hans organisation ændrede Tourens økonomi og holdstruktur. Opfindere som Lucien Juy ændrede det, rytterne kunne gøre uden at standse.',
  };
}
if (period === '1940-1949') {
  boxes = en ? [
    ['The decade’s main development', 'War interrupted the international calendar. After 1945, races, teams and bicycle production had to be assembled again.'],
    ['What defined the period', 'Shortages, occupation and closed borders were followed by reconstruction, renewed rivalries and cycling’s return as mass entertainment.'],
    ['Three changes to cycling', 'The grand tours disappeared and returned. The Cambio Corsa made shifting possible while riding. Coppi completed the first Giro–Tour double.'],
  ] : [
    ['Årtiets vigtigste udvikling', 'Krigen afbrød den internationale kalender. Efter 1945 skulle løb, hold og cykelproduktion samles igen.'],
    ['Det kendetegnede perioden', 'Mangel, besættelse og lukkede grænser blev afløst af genopbygning, nye rivaliseringer og cykelsportens tilbagekomst som folkeforlystelse.'],
    ['Tre ting, der ændrede cyklingen', 'De store rundture forsvandt og vendte tilbage. Cambio Corsa gjorde gearskift under kørsel muligt. Coppi tog den første Giro–Tour-double.'],
  ];
  timeline = en ? [
    ['1940', 'Fausto Coppi wins the Giro d’Italia at the age of twenty.'],
    ['1942', 'The six-stage Circuit de France attempts to replace the absent Tour.'],
    ['1943', 'Coppi is captured in North Africa; Bartali begins courier work after the German occupation of Italy.'],
    ['1946', 'The Giro returns; Bartali wins ahead of Coppi.'],
    ['1947', 'Jean Robic overturns the Tour on its final stage.'],
    ['1948', 'Bartali wins the Tour ten years after his first victory.'],
    ['1949', 'Coppi becomes the first rider to win the Giro and Tour in the same season.'],
    ['1949', 'Campagnolo introduces the single-lever Paris–Roubaix gear.'],
  ] : [
    ['1940', 'Fausto Coppi vinder Giro d’Italia som 20-årig.'],
    ['1942', 'Det seks etaper lange Circuit de France forsøger at erstatte den fraværende Tour.'],
    ['1943', 'Coppi tages til fange i Nordafrika; Bartali begynder sit kurérarbejde efter den tyske besættelse af Italien.'],
    ['1946', 'Giroen vender tilbage; Bartali vinder foran Coppi.'],
    ['1947', 'Jean Robic vender Touren på løbets sidste etape.'],
    ['1948', 'Bartali vinder Touren ti år efter sin første sejr.'],
    ['1949', 'Coppi bliver den første, der vinder Giroen og Touren i samme sæson.'],
    ['1949', 'Campagnolo introducerer det enarmede Paris–Roubaix-gear.'],
  ];
  periodThemeCopy = en ? {
    'loeb-og-store-oejeblikke': 'The grand tours vanished during the war. Their return produced Robic’s final-day victory in 1947, Bartali’s comeback in 1948 and Coppi’s Giro–Tour double in 1949.',
    ryttere: 'Bartali’s courier work and Coppi’s captivity belonged to lives larger than the result sheet. When racing returned, both men became central to Italy’s sporting reconstruction.',
    teknik: 'Cambio Corsa and the Paris–Roubaix gear still moved the rear wheel during a shift. The Stella Veneta from 1947 makes this demanding transition visible.',
    'kost-traening-og-videnskab': 'Rationing made access to food part of the conditions. After the war, military amphetamine stocks entered civilian life and sport, but precise anecdotes require careful sourcing.',
    cykelkultur: 'Where fuel and public transport were scarce, the bicycle remained practical transport as well as sporting equipment. Racing returned to crowds hungry for ordinary public life.',
    'samfund-og-tidsaand': 'Occupation, persecution and reconstruction shaped every part of the decade. Cycling could serve propaganda, clandestine work and, later, a renewed shared calendar.',
    'menneskene-bag': 'Couriers, mechanics, organisers and families kept cycling’s networks alive. Their work explains how the sport survived years without its familiar international races.',
  } : {
    'loeb-og-store-oejeblikke': 'De store rundture forsvandt under krigen. Genkomsten gav Robics sidste-etape-sejr i 1947, Bartalis comeback i 1948 og Coppis Giro–Tour-double i 1949.',
    ryttere: 'Bartalis kurérarbejde og Coppis fangenskab hørte til liv, der var større end resultatlisten. Da løbene vendte tilbage, blev de begge centrale i Italiens sportslige genopbygning.',
    teknik: 'Cambio Corsa og Paris–Roubaix-gearet flyttede stadig baghjulet under et gearskift. Stella Veneta fra 1947 gør dette krævende mellemtrin synligt.',
    'kost-traening-og-videnskab': 'Rationering gjorde adgangen til mad til en del af vilkårene. Efter krigen fandt militære lagre af amfetamin vej til civilsamfund og sport, men de præcise anekdoter kræver forsigtige kilder.',
