---
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import OptimizedImage from './OptimizedImage.astro';
import { contentForPeriod, localizeContent } from '../data/taxonomy';
import hero from '../assets/stories/paris-brest-paris-1891/depart-le-petit-journal-1891.jpg';
import terront from '../assets/stories/paris-brest-paris-1891/terront-le-petit-journal-1891.jpg';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = new URL(`${base}/de/epochen/1800-1899/`, Astro.site).toString();
const title = 'Bis 1899: Die Pionierjahre des Radsports';
const description = 'Vom Sicherheitsfahrrad und Luftreifen bis zu Paris–Brest–Paris, frühen Sechstagerennen und Major Taylor: die Pionierjahre des Radsports bis 1899.';
const periodItems = localizeContent(contentForPeriod('1800-1899'), 'da');
const timeline = [
  ['1869','Paris–Rouen gehört zu den ersten großen Rennen von Stadt zu Stadt.'],
  ['1885','Das Rover-Sicherheitsfahrrad verbindet Kettenantrieb und zwei ähnlich große Räder.'],
  ['1888','John Boyd Dunlop lässt einen praktischen Luftreifen patentieren.'],
  ['1891','Charles Terront gewinnt das erste Paris–Brest–Paris über 1.200 Kilometer.'],
  ['1891','Im Madison Square Garden werden Sechstagerennen veranstaltet.'],
  ['1892','Das erste Lüttich–Bastogne–Lüttich wird für Amateure veranstaltet.'],
  ['1896','Paris–Roubaix findet zum ersten Mal statt.'],
  ['1899','Major Taylor wird in Montreal Sprintweltmeister.'],
];
const periodThemes = [
  ['loeb-og-store-oejeblikke','Rennen und große Momente','Paris–Brest–Paris, Lüttich–Bastogne–Lüttich und Paris–Roubaix machten lange Strecken, schlechte Straßen und die Haltbarkeit des Materials zu Teilen des Wettbewerbs.'],
  ['ryttere','Fahrer','Charles Terront, Major Taylor und die Sechstagespezialisten gehörten zu einer Generation, die die Rolle des Athleten und ihre Arbeitsweisen erst entwickeln musste.'],
  ['teknik','Technik','Sicherheitsfahrrad, Kettenantrieb und Luftreifen schufen die Grundform des Fahrrads. Bremsen, Freiläufe und brauchbare Gangschaltungen waren noch offene Fragen.'],
  ['kost-traening-og-videnskab','Ernährung, Training und Wissenschaft','Essen, Aufputschmittel und Erholung richteten sich nach Erfahrung, Gewohnheiten und Gerüchten. Die heutigen Grenzen zwischen Ernährung, Medizin und Doping gab es noch nicht.'],
  ['cykelkultur','Fahrradkultur','Das Fahrrad wurde Verkehrsmittel, Statussymbol und Mittelpunkt eines Zuschauersports. Zeitungen veranstalteten Rennen, und die Radrennbahnen brachten das Publikum dicht an die Fahrer heran.'],
  ['samfund-og-tidsaand','Gesellschaft und Zeitgeist','Die industrielle Fertigung machte das Fahrrad für mehr Menschen zugänglich. Herkunft, Geschlecht und Rassismus bestimmten jedoch mit, wer unter welchen Bedingungen teilnehmen konnte.'],
  ['menneskene-bag','Menschen hinter den Kulissen','Veranstalter, Zeitungsredakteure, Erfinder, Schrittmacher und Mechaniker schufen Strecken, Maschinen und das Geschehen rund um die Fahrer.'],
];
const translations = { da: '/perioder/1800-1899/', en: '/en/periods/1800-1899/', de: '/de/epochen/1800-1899/' };
---
<!doctype html><html lang="de"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/>
<title>{title} · The Evolution of Bikes</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/>
{Object.entries(translations).map(([lang,path]) => <link rel="alternate" hreflang={lang} href={new URL(`${base}${path}`, Astro.site).toString()}/>)}
<link rel="alternate" hreflang="x-default" href={new URL(`${base}${translations.da}`, Astro.site).toString()}/>
<meta property="og:type" content="article"/><meta property="og:locale" content="de_DE"/><meta property="og:site_name" content="The Evolution of Bikes"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={new URL(hero.src,Astro.site).toString()}/><meta property="og:image:alt" content="Zeitgenössische Illustration des Starts von Paris–Brest–Paris 1891"/><meta name="twitter:card" content="summary_large_image"/>
<script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'Article',headline:title,description,inLanguage:'de',mainEntityOfPage:canonical,image:new URL(hero.src,Astro.site).toString()})}/>
<link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Libre+Caslon+Display&display=swap" rel="stylesheet"/><link rel="stylesheet" href={`${base}/styles/global.css`}/></head>
<body><SiteHeader lang="de" current="periods" translations={translations}/><main><article class="wildwest-page">
  <header class="wildwest-hero"><div><p class="section-label">Von den ersten Rennen bis 1899</p><h1>Die wilden <em>Pionierjahre</em> des Radsports</h1></div><p>Das Sicherheitsfahrrad war neu, die Straßen waren schlecht, und Regeln entstanden oft erst nach dem Rennen. Trotzdem wurde das Fahrrad rasch zum Verkehrsmittel, Industrieprodukt und Mittelpunkt eines Zuschauersports.</p></header>
  <figure class="decade1920-hero-image"><OptimizedImage src={hero} alt="Zeitgenössische Illustration: Zuschauer und Fahrer beim Start von Paris–Brest–Paris 1891" loading="eager" fetchpriority="high"/><figcaption>Der Start von Paris–Brest–Paris vor dem Gebäude von <em>Le Petit Journal</em> im Jahr 1891. Zeitgenössische Illustration aus der Zeitungsbeilage, gemeinfrei, via Wikimedia Commons.</figcaption></figure>
  <section class="period-summary" aria-label="Die Epoche im Überblick">
    <div><h2>Die wichtigste Entwicklung</h2><p>Sicherheitsfahrrad, Luftreifen und Kettenantrieb machten das Fahrrad zum Verkehrsmittel und schufen die Grundlage für eine Industrie und einen organisierten Sport.</p></div>
    <div><h2>Was die Zeit prägte</h2><p>Straßenrennen, Bahnrennen und frühe Sechstagerennen stellten Fahrer und Material auf die Probe. Feste Regeln, Mannschaftswagen und Sportwissenschaft fehlten noch.</p></div>
    <div><h2>Drei Veränderungen</h2><p>Zwei ähnlich große Räder lösten das Hochrad ab. Luftreifen erleichterten lange Fahrten. Zeitungen machten aus Rennen öffentliche Ereignisse.</p></div>
  </section>
  <section class="period-model" aria-labelledby="period-model-title">
    <header><p class="section-label">Die Epoche im Überblick</p><h2 id="period-model-title">Von den ersten Rennen bis 1899</h2></header>
    <div class="period-model-timeline"><header><p class="section-label">Ausgewählte Ereignisse</p><h2>Eine kurze Zeitleiste</h2></header><ol>{timeline.map(([year,text]) => <li><time>{year}</time><span>{text}</span></li>)}</ol></div>
    <div class="period-theme-sections"><header><p class="section-label">Sieben feste Themen</p><h2>Die Epoche aus verschiedenen Blickwinkeln</h2></header>
      {periodThemes.map(([id,label,text],index) => {
        const related = periodItems.filter(item => item.themes.includes(id)).slice(0,4);
        return <section id={id} class="period-theme-row"><div><span>0{index+1}</span><h3>{label}</h3><p>{text}</p><a href={`${base}/tema/${id}/`} lang="da">Dieses Thema durch die Fahrradgeschichte verfolgen (auf Dänisch) →</a></div><div class="period-theme-items">{related.length ? related.map(item => <a href={`${base}${item.canonicalUrl}`} lang="da"><small>{({historie:'Geschichte',cykel:'Fahrrad',komponent:'Komponente'}[item.type] ?? item.type)} · {item.year} · auf Dänisch</small><strong>{item.title}</strong></a>) : <p>Zu diesem Thema sind noch keine Inhalte dieser Epoche veröffentlicht.</p>}</div></section>;
      })}
    </div>
  </section>
  <section class="wildwest-lead"><p class="section-label">Vor den großen Rundfahrten</p><p>Radrennen begannen nicht mit der Tour de France. Schon vor 1900 gab es lange, von Zeitungen organisierte Straßenrennen, volle Radrennbahnen, Berufsspezialisten und eine Fahrradindustrie, die durch Erfindungen und Fehlschläge lernte.</p></section>
  <section class="wildwest-copy"><div><p class="section-label">Von Stadt zu Stadt</p><h2>Auch die Straße war ein Gegner</h2></div><div><p>Frühe Straßenrennen führten von einer Stadt zur anderen. Paris–Rouen von 1869 zählt häufig zu den ersten großen Veranstaltungen. In den 1890er-Jahren folgten Paris–Brest–Paris, Lüttich–Bastogne–Lüttich und Paris–Roubaix.</p><p>Die Strecken führten über Schotter, Wagenrillen und lose Steine. Regen verwandelte Straßen in Schlamm. Eine Reifenpanne kostete weit mehr Zeit als ein heutiger Laufradwechsel. Der Fahrer musste wach bleiben, den Weg finden und sein Fahrrad wieder fahrtüchtig machen.</p><p>Die Zeitungen waren keine neutralen Beobachter. Sie veranstalteten Rennen, um Nachrichten zu schaffen und Auflage zu machen. Fahrer, Fahrrad und Presse wurden Teile desselben neuen Schauspiels.</p></div></section>
  <section class="wildwest-copy dark"><div><p class="section-label">Die Radrennbahn</p><h2>Sechs Tage mit wenig Schlaf</h2></div><div><p>Die ersten Sechstagerennen waren Einzelwettbewerbe. Ein Fahrer legte in sechs Tagen möglichst viele Runden zurück, oft 18 bis 20 Stunden am Tag. Die Zuschauer kamen und gingen, während er unter elektrischem Licht weiterfuhr.</p><p>Schlafmangel gehörte zur Vorstellung. Berichte erzählen von Fahrern, die halluzinierten, Schlangenlinien fuhren oder von der Bahn geführt werden mussten. Teddy Hale gewann 1896 das große Rennen im Madison Square Garden nach mehr als 3.000 Kilometern. Die Leistung wurde bewundert; zugleich galt das Format manchen als brutale Unterhaltung.</p><p>Später wurde das Sechstagerennen zum Wettbewerb für Zweiermannschaften. Sanft wurde der Sport dadurch nicht. Aber die Fahrer konnten sich wenigstens abwechseln.</p></div></section>
  <section class="wildwest-copy"><div><p class="section-label">Das Fahrrad nimmt Gestalt an</p><h2>Zwei gleich große Räder und Luft im Reifen</h2></div><div><p>In den 1880er-Jahren setzte sich das Sicherheitsfahrrad mit Kettenantrieb zum Hinterrad und zwei ähnlich großen Rädern durch. Seine Grundform ähnelt noch heute dem Fahrrad. Gegenüber dem Hochrad mit seiner großen Sturzhöhe war das ein erheblicher Fortschritt.</p><p>Der Luftreifen machte schlechte Straßen für Fahrer und Material erträglicher. Bremsen, Freiläufe, Ketten und Übersetzungen entwickelten sich weiter. Manche Lösungen bewährten sich, andere verschwanden schnell wieder.</p><p>Starre Antriebe waren verbreitet: Solange das Hinterrad rollte, drehten sich auch die Pedale. Praktikable Gangschaltungen lagen noch in der Zukunft. Bei einem langen Rennen konnte ein Schraubenschlüssel deshalb fast so wichtig sein wie ein guter Sprint.</p></div></section>
  <figure class="decade1920-wide"><OptimizedImage src={terront} alt="Charles Terront mit seinem Sicherheitsfahrrad nach Paris–Brest–Paris 1891" widths={[480,760,1100]} sizes="(max-width: 800px) 100vw, 80vw"/><figcaption>Charles Terront mit seinem Fahrrad auf dem Titelblatt von <em>Le Petit Journal</em> nach dem Sieg von 1891. Illustration von Henri Meyer, gemeinfrei.</figcaption></figure>
  <section class="wildwest-copy rust"><div><p class="section-label">Essen, Medizin und Überzeugung</p><h2>Man hielt den Körper mit dem in Gang, was man kannte</h2></div><div><p>Sporternährung gab es noch nicht als eigene Disziplin. Die Fahrer aßen gewöhnliche, oft schwere Kost und tranken Kaffee, Kakao, Bier oder Wein. Bei sehr langen Rennen kam es zunächst darauf an, überhaupt etwas zu sich zu nehmen und weiterzufahren.</p><p>Für Aufputsch- und Schmerzmittel gab es keine Verbotsliste. Koffein, Alkohol und stärkere Substanzen lagen in einem unscharfen Bereich zwischen Medizin, Wachhalten und Überzeugung. Spätere Berichte nennen Kokain, Strychnin und Äther. Die Praktiken waren jedoch unterschiedlich; viele Einzelheiten sind erst für die ersten Jahrzehnte nach 1900 besser belegt.</p><p>Die Grenze zwischen Betreuung und Leistungssteigerung verlief jedenfalls anders als jene, die der Sport später zu ziehen versuchte.</p></div></section>
  <section class="wildwest-copy"><div><p class="section-label">1899</p><h2>Major Taylor gewann trotz der Widerstände</h2></div><div><p>Marshall »Major« Taylor wurde 1899 in Montreal Sprintweltmeister. Er war 20 Jahre alt und gehörte zu den ersten schwarzen Weltmeistern im internationalen Sport.</p><p>Das Ergebnis erzählt nur einen Teil seiner Geschichte. Taylor wurde von Rennbahnen ausgeschlossen, bedroht, angegriffen und in Rennen absichtlich behindert. Er gewann, während Teile dieses Sports versuchten, ihn fernzuhalten.</p><p>Am Ende des Jahrhunderts war der Radsport bereits international, kommerziell und technisch experimentierfreudig. Zugleich trug er die Ungleichheiten seiner Zeit mit sich. Beides begleitete ihn ins neue Jahrhundert.</p></div></section>
  <section class="period-feature"><div><p class="section-label">Geschichten aus der Epoche</p><h2>Auf dem Fahrrad selbstständig werden</h2><p>Frances Willards eigene Erfahrungen zeigen, was das Fahrrad abseits der Rennbahn bedeuten konnte.</p></div><div class="period-feature-links"><a href={`${base}/de/geschichten/frances-willard-gladys/`}><span>Geschichte · 1890er-Jahre</span><strong>Frances Willard wollte selbst das Gleichgewicht halten</strong><b>Geschichte lesen →</b></a><a href={`${base}/historier/paris-brest-paris-1891-charles-terront/`} lang="da"><span>Weitere Geschichte · auf Dänisch</span><strong>Charles Terront und das erste Paris–Brest–Paris</strong><b>Auf Dänisch lesen →</b></a></div></section>
  <section class="period-basis"><h2>Grundlage dieser Fassung</h2><p>Die deutsche Fassung folgt dem bestehenden <a href={`${base}/perioder/1800-1899/`} lang="da">dänischen Epochenüberblick</a> und seiner <a href={`${base}/en/periods/1800-1899/`} lang="en">englischen Fassung</a>. Paris–Rouen wird entsprechend der <a href="https://www.uci.org/article/about-road-cycling/3R0Ls046rySKwc4fjq5yVc">Darstellung der UCI</a> auf 1869 datiert. Zur Datierung der Sechstagerennen im Madison Square Garden ab 1891 siehe die <a href="https://ehistory.osu.edu/exhibitions/ghosts-garden">Ausstellung des Department of History der Ohio State University</a>.</p></section>
  <nav class="wildwest-next" aria-label="Weitere Epochen auf Dänisch"><a href={`${base}/perioder/`}>← Alle Epochen (auf Dänisch)</a><a href={`${base}/perioder/1900-1920/`}>Nächste Epoche: 1900–1919 (auf Dänisch) →</a></nav>
</article></main><SiteFooter lang="de"/></body></html>
<style>.period-basis{max-width:1000px;margin:3rem auto;padding:0 1.5rem;line-height:1.7}.period-basis a{color:var(--rust)}.decade1920-wide figcaption{color:#4d493f}.decade1920-wide figcaption,.decade1920-hero-image figcaption{font-size:.8125rem;line-height:1.5}.period-summary{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:2rem;max-width:1200px;margin:3rem auto;padding:0 1.5rem}.period-summary h2{font-size:1.4rem}.period-summary p{line-height:1.7}@media(max-width:760px){.period-summary{grid-template-columns:1fr}}</style>
