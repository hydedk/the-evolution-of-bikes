---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL
  ?? 'https://fmxiyfhncvhnwzwipnxu.supabase.co';
const anonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? '';
const adminUrl = import.meta.env.PUBLIC_STORY_ADMIN_URL
  ?? `${supabaseUrl}/functions/v1/admin-story-submissions`;
const configured = Boolean(anonKey);
---
<!doctype html>
<html lang="da">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <meta name="robots" content="noindex,nofollow,noarchive" />
  <meta name="description" content="Privat administration af indsendte historier og kommentarer." />
  <title>Indsendelser · Administration</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Libre+Caslon+Display&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href={`${base}/styles/global.css`} />
</head>
<body class="admin-body" data-supabase-url={supabaseUrl} data-anon-key={anonKey} data-admin-url={adminUrl}>
  <header class="admin-header">
    <a class="brand" href={`${base}/`} aria-label="The Evolution of Bikes, forside"><span class="brand-mark">E<span>B</span></span><span>The Evolution<br />of Bikes</span></a>
    <p>Redaktion · indsendelser</p>
    <button id="sign-out" class="admin-link-button" type="button" hidden>Log ud</button>
  </header>

  <main class="admin-main">
    <section id="login-view" class="admin-login" aria-labelledby="login-title">
      <p class="section-label">Privat område</p>
      <h1 id="login-title">Redaktionel<br /><em>indbakke</em></h1>
      <p>Log ind for at gennemgå historier, kommentarer, billeder og kontaktoplysninger.</p>
      {!configured && <div class="admin-alert"><strong>Login er ikke koblet til endnu.</strong><span>Den offentlige Supabase-nøgle skal tilføjes til sidens byggeindstillinger.</span></div>}
      <form id="login-form" class="admin-login-form">
        <label>E-mail<input name="email" type="email" autocomplete="username" required /></label>
        <label>Adgangskode<input name="password" type="password" autocomplete="current-password" required /></label>
        <p id="login-status" class="admin-form-status" aria-live="polite"></p>
        <button type="submit" disabled={!configured}>Log ind</button>
      </form>
      <div id="recovery-view" class="admin-recovery" hidden>
        <h2>Vælg en ny adgangskode</h2>
        <p>Indtast den adgangskode, du fremover vil bruge til administrationen.</p>
        <form id="recovery-form" class="admin-login-form">
          <label>Ny adgangskode<input name="password" type="password" autocomplete="new-password" minlength="8" required /></label>
          <label>Gentag adgangskoden<input name="password_confirm" type="password" autocomplete="new-password" minlength="8" required /></label>
          <p id="recovery-status" class="admin-form-status" aria-live="polite"></p>
          <button type="submit" disabled={!configured}>Gem ny adgangskode</button>
        </form>
      </div>
    </section>

    <section id="admin-view" class="admin-workspace" hidden aria-labelledby="workspace-title">
      <header class="admin-workspace-header">
        <div><p class="section-label">Redaktionel indbakke</p><h1 id="workspace-title">Indsendelser</h1></div>
        <p id="record-count" aria-live="polite">Henter indsendelser…</p>
      </header>

      <div class="admin-type-tabs" role="tablist" aria-label="Type indsendelse">
        <button type="button" role="tab" data-type="story" aria-selected="true">Historier <span id="story-count"></span></button>
        <button type="button" role="tab" data-type="comment" aria-selected="false">Kommentarer <span id="comment-count"></span></button>
      </div>

      <section class="admin-status-overview" aria-labelledby="status-overview-title">
        <h2 id="status-overview-title">Status for historier</h2>
        <div id="status-counts" class="admin-status-counts"></div>
      </section>

      <div class="admin-toolbar">
        <label class="admin-search"><span>Søg</span><input id="story-search" type="search" placeholder="Titel, navn, sted eller e-mail" /></label>
        <label><span>Status</span><select id="status-filter"><option value="">Alle statusser</option></select></label>
        <button id="refresh-stories" class="admin-secondary-button" type="button">Opdatér</button>
      </div>

      <p id="workspace-status" class="admin-form-status" aria-live="polite"></p>
      <div class="admin-columns">
        <nav id="submission-list" class="admin-submission-list" aria-label="Indsendelser"></nav>
        <article id="submission-detail" class="admin-detail">
          <div class="admin-empty"><span aria-hidden="true">↙</span><h2>Vælg en indsendelse</h2><p>Indhold, kontaktoplysninger og redaktionelle noter vises her.</p></div>
        </article>
      </div>
    </section>
  </main>

  <template id="detail-template">
    <div class="admin-detail-content">
      <header class="admin-detail-header"><div><p class="detail-date"></p><h2 class="detail-title"></h2><p class="detail-place"></p></div><span class="detail-status"></span></header>
      <section class="admin-detail-section"><h3 class="detail-content-heading">Læserens original</h3><p class="original-note">Originalen bevares uændret, også når historien bearbejdes.</p><div class="detail-story"></div></section>
      <section class="admin-detail-section detail-images-section"><h3>Billeder <span class="detail-image-count"></span></h3><div class="detail-images"></div><p class="detail-image-notes"></p></section>
      <section class="admin-detail-section"><h3>Indsender</h3><dl class="detail-contact"></dl><div class="detail-consents"></div></section>
      <form class="admin-editor-form">
        <section class="admin-detail-section"><h3>Redaktionelt arbejde</h3><div class="admin-story-editor" hidden><label>Redaktionel titel<input name="editorial_title" maxlength="140" placeholder="Lad feltet stå tomt, indtil arbejdet begynder" /></label><label>Redigeret historie<textarea name="editorial_story" rows="16" minlength="20" maxlength="40000" placeholder="Arbejdskopien skrives her. Læserens original ovenfor ændres ikke."></textarea></label></div><div class="admin-comment-editor" hidden><label>Navn<input name="submitter_name" maxlength="160" /></label><label>Kommentar<textarea name="story" rows="8" minlength="20" maxlength="20000"></textarea></label></div><div class="admin-editor-grid"><label>Status<select name="status"></select></label><label>Kanonisk adresse<input name="canonical_url" type="url" placeholder="https://teob.dk/historier/…" /></label></div><label>Interne noter<textarea name="internal_notes" rows="8" placeholder="Kilder, faktatjek, aftaler, manglende oplysninger og næste skridt…"></textarea></label><div class="admin-save-row"><p class="admin-save-status" aria-live="polite"></p><button type="submit">Gem ændringer</button></div></section>
      </form>
      <section class="admin-detail-section admin-technical"><h3>Registrering</h3><dl class="detail-technical"></dl></section>
    </div>
  </template>

<script>
  const statusLabels = {
    'modtaget': 'Modtaget', 'foerste-kontrol': 'Under behandling', 'under-research': 'Research',
    'kladde': 'Redigeres', 'klar-til-godkendelse': 'Klar til udgivelse', 'godkendt': 'Godkendt',
    'udgivet': 'Udgivet', 'afvist': 'Afvist', 'afventer-svar': 'Afventer læser', 'trukket-tilbage': 'Trukket tilbage',
  };
  const creditLabels = { name: 'Navn må vises', anonymous: 'Ønsker anonymitet', ask: 'Aftal kreditering først' };
  const body = document.body;
  const config = { supabaseUrl: body.dataset.supabaseUrl, anonKey: body.dataset.anonKey, adminUrl: body.dataset.adminUrl };
  const loginView = document.querySelector('#login-view');
  const adminView = document.querySelector('#admin-view');
  const loginForm = document.querySelector('#login-form');
  const loginStatus = document.querySelector('#login-status');
  const recoveryView = document.querySelector('#recovery-view');
  const recoveryForm = document.querySelector('#recovery-form');
  const recoveryStatus = document.querySelector('#recovery-status');
  const signOut = document.querySelector('#sign-out');
  const workspaceStatus = document.querySelector('#workspace-status');
  const list = document.querySelector('#submission-list');
  const detail = document.querySelector('#submission-detail');
  const count = document.querySelector('#record-count');
  const typeTabs = [...document.querySelectorAll('[data-type]')];
  const storyCount = document.querySelector('#story-count');
  const commentCount = document.querySelector('#comment-count');
  const statusOverviewTitle = document.querySelector('#status-overview-title');
  const statusCounts = document.querySelector('#status-counts');
  const search = document.querySelector('#story-search');
  const filter = document.querySelector('#status-filter');
  const storageKey = 'teob-admin-session';
  let submissions = [];
  let selectedId = null;
  let activeType = 'story';

  const dateTime = (value) => value ? new Intl.DateTimeFormat('da-DK', { dateStyle: 'medium', timeStyle: 'short' }).format(new Date(value)) : '—';
  const fileSize = (bytes) => bytes ? `${(bytes / 1024 / 1024).toFixed(1).replace('.', ',')} MB` : '';
  const session = () => { try { return JSON.parse(sessionStorage.getItem(storageKey) || 'null'); } catch { return null; } };
  const setSession = (value) => value ? sessionStorage.setItem(storageKey, JSON.stringify(value)) : sessionStorage.removeItem(storageKey);
  const addText = (parent, tag, label, value) => { const term = document.createElement(tag); term.textContent = label; const description = document.createElement(tag === 'dt' ? 'dd' : 'span'); description.textContent = value || '—'; parent.append(term, description); };
  const option = (value, label) => { const item = document.createElement('option'); item.value = value; item.textContent = label; return item; };

  Object.entries(statusLabels).forEach(([value, label]) => filter?.append(option(value, label)));

  async function refreshSession(current) {
    if (!current?.refresh_token) return null;
    const response = await fetch(`${config.supabaseUrl}/auth/v1/token?grant_type=refresh_token`, {
      method: 'POST', headers: { apikey: config.anonKey, 'content-type': 'application/json' },
      body: JSON.stringify({ refresh_token: current.refresh_token }),
    });
    if (!response.ok) return null;
    const next = await response.json(); setSession(next); return next;
  }

  async function adminFetch(options = {}, retry = true) {
    let current = session();
    if (!current?.access_token) throw new Error('Log ind for at fortsætte.');
    const response = await fetch(config.adminUrl, {
      ...options,
      headers: { apikey: config.anonKey, authorization: `Bearer ${current.access_token}`, 'content-type': 'application/json', ...(options.headers || {}) },
    });
    if (response.status === 401 && retry) {
      current = await refreshSession(current);
      if (current) return adminFetch(options, false);
    }
    const result = await response.json().catch(() => ({}));
    if (!response.ok) throw new Error(result.error || 'Forbindelsen til administrationen mislykkedes.');
    return result;
  }

  function showLogin(message = '') {
    adminView.hidden = true; loginView.hidden = false; signOut.hidden = true; setSession(null);
    loginStatus.textContent = message;
  }

  async function showWorkspace() {
    loginView.hidden = true; adminView.hidden = false; signOut.hidden = false;
    filter.value = 'modtaget';
    await loadSubmissions();
  }

  async function loadSubmissions() {
    workspaceStatus.textContent = 'Henter indsendelser…';
    try {
      const result = await adminFetch(); submissions = result.submissions || [];
      workspaceStatus.textContent = ''; renderList();
      if (selectedId && submissions.some((item) => item.id === selectedId)) renderDetail(selectedId);
    } catch (error) {
      workspaceStatus.textContent = error instanceof Error ? error.message : 'Indsendelserne kunne ikke hentes.';
      if (/Log ind|adgang/.test(workspaceStatus.textContent)) showLogin(workspaceStatus.textContent);
    }
  }

  function filteredSubmissions() {
    const query = search.value.trim().toLocaleLowerCase('da');
    return submissions.filter((item) => (item.submission_type || 'story') === activeType && (!filter.value || item.status === filter.value) && (!query ||
      [item.title, item.editorial_title, item.place, item.period, item.submitter_name, item.submitter_email, item.story, item.editorial_story]
        .some((value) => String(value || '').toLocaleLowerCase('da').includes(query))));
  }

  function renderList() {
    const visible = filteredSubmissions(); list.replaceChildren();
    const stories = submissions.filter((item) => (item.submission_type || 'story') === 'story');
    const comments = submissions.filter((item) => item.submission_type === 'comment');
    storyCount.textContent = `(${stories.length})`; commentCount.textContent = `(${comments.length})`;
    typeTabs.forEach((tab) => tab.setAttribute('aria-selected', String(tab.dataset.type === activeType)));
    const activeSubmissions = activeType === 'comment' ? comments : stories;
    const typeTotal = activeSubmissions.length;
    renderStatusCounts(activeSubmissions);
    const noun = activeType === 'comment' ? (typeTotal === 1 ? 'kommentar' : 'kommentarer') : (typeTotal === 1 ? 'historie' : 'historier');
    count.textContent = `${visible.length} af ${typeTotal} ${noun}`;
    if (!visible.length) { const empty = document.createElement('p'); empty.className = 'admin-list-empty'; empty.textContent = `Ingen ${noun} matcher søgningen.`; list.append(empty); return; }
    visible.forEach((item) => {
      const button = document.createElement('button'); button.type = 'button'; button.className = 'admin-submission-card';
      button.dataset.selected = String(item.id === selectedId); button.addEventListener('click', () => renderDetail(item.id));
      const top = document.createElement('span'); top.className = 'admin-card-top';
      const status = document.createElement('span'); status.className = `admin-status status-${item.status}`; status.textContent = statusLabels[item.status] || item.status;
      const date = document.createElement('time'); date.dateTime = item.created_at; date.textContent = dateTime(item.created_at);
      const title = document.createElement('strong'); title.textContent = item.title;
      const meta = document.createElement('span'); meta.textContent = [item.submitter_name, item.place, item.period].filter(Boolean).join(' · ');
      const images = document.createElement('span'); images.className = 'admin-card-images'; images.textContent = activeType === 'comment' ? 'Kommentar' : (item.images?.length ? `${item.images.length} ${item.images.length === 1 ? 'billede' : 'billeder'}` : 'Ingen billeder');
      top.append(status, date); button.append(top, title, meta, images); list.append(button);
    });
  }

  function renderStatusCounts(activeSubmissions) {
    statusOverviewTitle.textContent = activeType === 'comment' ? 'Status for kommentarer' : 'Status for historier';
    statusCounts.replaceChildren();
    const totals = activeSubmissions.reduce((result, item) => {
      result[item.status] = (result[item.status] || 0) + 1;
      return result;
    }, {});
    const choices = [['', 'Alle'], ...Object.entries(statusLabels)];
    choices.forEach(([value, label]) => {
      const button = document.createElement('button');
      button.type = 'button';
      button.className = value ? `admin-status-count status-${value}` : 'admin-status-count status-all';
      button.dataset.selected = String(filter.value === value);
      button.setAttribute('aria-pressed', String(filter.value === value));
      const number = document.createElement('strong'); number.textContent = String(value ? (totals[value] || 0) : activeSubmissions.length);
      const text = document.createElement('span'); text.textContent = label;
      button.append(number, text);
      button.addEventListener('click', () => { filter.value = value; renderList(); });
      statusCounts.append(button);
      if (value) {
        const filterOption = [...filter.options].find((item) => item.value === value);
        if (filterOption) filterOption.textContent = `${label} (${totals[value] || 0})`;
      }
    });
    filter.options[0].textContent = `Alle statusser (${activeSubmissions.length})`;
  }

  function renderDetail(id) {
    const item = submissions.find((entry) => entry.id === id); if (!item) return;
    selectedId = id; renderList(); detail.replaceChildren();
    const fragment = document.querySelector('#detail-template').content.cloneNode(true);
    fragment.querySelector('.detail-date').textContent = `Modtaget ${dateTime(item.created_at)}`;
    fragment.querySelector('.detail-title').textContent = item.title;
    fragment.querySelector('.detail-place').textContent = [item.place, item.period].filter(Boolean).join(' · ');
    fragment.querySelector('.detail-content-heading').textContent = item.submission_type === 'comment' ? 'Kommentaren' : 'Læserens original';
    fragment.querySelector('.original-note').hidden = item.submission_type === 'comment';
    const statusBadge = fragment.querySelector('.detail-status'); statusBadge.className = `detail-status admin-status status-${item.status}`; statusBadge.textContent = statusLabels[item.status] || item.status;
    const storyContent = fragment.querySelector('.detail-story'); storyContent.textContent = item.story;
    const imageSection = fragment.querySelector('.detail-images-section');
    imageSection.hidden = item.submission_type === 'comment';
    fragment.querySelector('.detail-image-count').textContent = `(${item.images?.length || 0})`;
    const imageGrid = fragment.querySelector('.detail-images');
    if (item.images?.length) item.images.forEach((image) => {
      const figure = document.createElement('figure'); const link = document.createElement('a'); link.href = image.url || '#'; link.target = '_blank'; link.rel = 'noopener';
      const img = document.createElement('img'); img.src = image.url || ''; img.alt = image.original_name; img.loading = 'lazy'; img.setAttribute('data-no-lightbox', '');
      const caption = document.createElement('figcaption'); caption.textContent = `${image.original_name} · ${fileSize(image.size_bytes)}`;
      if (!image.url) { link.removeAttribute('href'); img.alt = 'Billedet kunne ikke åbnes'; }
      link.append(img); figure.append(link, caption); imageGrid.append(figure);
    }); else { const empty = document.createElement('p'); empty.textContent = 'Der blev ikke indsendt billeder.'; imageGrid.append(empty); }
    const imageNotes = fragment.querySelector('.detail-image-notes'); imageNotes.textContent = item.image_notes || ''; imageNotes.hidden = !item.image_notes;
    const contact = fragment.querySelector('.detail-contact'); addText(contact, 'dt', 'Navn', item.submitter_name); addText(contact, 'dt', 'E-mail', item.submitter_email); addText(contact, 'dt', 'Kreditering', creditLabels[item.credit_preference] || item.credit_preference); const contactName = contact.querySelector('dd');
    const consents = fragment.querySelector('.detail-consents'); ['Rettigheder bekræftet', 'Redaktionel tilladelse', 'Privatliv accepteret'].forEach((text) => { const badge = document.createElement('span'); badge.textContent = `✓ ${text}`; consents.append(badge); });
    const form = fragment.querySelector('.admin-editor-form'); const statusSelect = form.elements.status;
    Object.entries(statusLabels).forEach(([value, label]) => statusSelect.append(option(value, label))); statusSelect.value = item.status;
    const commentEditor = form.querySelector('.admin-comment-editor');
    commentEditor.hidden = item.submission_type !== 'comment';
    const storyEditor = form.querySelector('.admin-story-editor');
    storyEditor.hidden = item.submission_type !== 'story';
    form.elements.editorial_title.value = item.editorial_title || '';
    form.elements.editorial_story.value = item.editorial_story || '';
    form.elements.submitter_name.value = item.submitter_name || '';
    form.elements.story.value = item.story || '';
    form.elements.canonical_url.value = item.canonical_url || ''; form.elements.internal_notes.value = item.internal_notes || '';
    form.addEventListener('submit', async (event) => {
      event.preventDefault(); const saveStatus = form.querySelector('.admin-save-status'); const button = form.querySelector('button[type="submit"]');
      button.disabled = true; saveStatus.textContent = 'Gemmer…';
      try {
        const changes = { id: item.id, status: statusSelect.value, canonical_url: form.elements.canonical_url.value, internal_notes: form.elements.internal_notes.value };
        if (item.submission_type === 'story') { changes.editorial_title = form.elements.editorial_title.value; changes.editorial_story = form.elements.editorial_story.value; }
        if (item.submission_type === 'comment') { changes.submitter_name = form.elements.submitter_name.value; changes.story = form.elements.story.value; }
        const result = await adminFetch({ method: 'PATCH', body: JSON.stringify(changes) });
        Object.assign(item, result.submission); saveStatus.textContent = `Gemt ${dateTime(item.updated_at)}`; renderList(); statusBadge.textContent = statusLabels[item.status]; statusBadge.className = `detail-status admin-status status-${item.status}`; storyContent.textContent = item.story; contactName.textContent = item.submitter_name;
      } catch (error) { saveStatus.textContent = error instanceof Error ? error.message : 'Ændringerne kunne ikke gemmes.'; }
      finally { button.disabled = false; }
    });
    const technical = fragment.querySelector('.detail-technical'); addText(technical, 'dt', 'Type', item.submission_type === 'comment' ? 'Kommentar' : 'Historie'); addText(technical, 'dt', 'Indsendelsesnummer', item.id); addText(technical, 'dt', 'Vilkår', item.terms_version); addText(technical, 'dt', 'Senest ændret', dateTime(item.updated_at)); addText(technical, 'dt', 'Udgivet', dateTime(item.published_at));
    detail.append(fragment); detail.scrollTo({ top: 0, behavior: 'smooth' });
  }

  typeTabs.forEach((tab) => tab.addEventListener('click', () => {
    activeType = tab.dataset.type;
    selectedId = null;
    search.value = '';
    filter.value = 'modtaget';
    detail.innerHTML = `<div class="admin-empty"><span aria-hidden="true">↙</span><h2>Vælg en ${activeType === 'comment' ? 'kommentar' : 'historie'}</h2><p>Indhold, kontaktoplysninger og redaktionelle noter vises her.</p></div>`;
    renderList();
  }));

  loginForm?.addEventListener('submit', async (event) => {
    event.preventDefault(); const button = loginForm.querySelector('button'); button.disabled = true; loginStatus.textContent = 'Logger ind…';
    const data = new FormData(loginForm);
    try {
      const response = await fetch(`${config.supabaseUrl}/auth/v1/token?grant_type=password`, { method: 'POST', headers: { apikey: config.anonKey, 'content-type': 'application/json' }, body: JSON.stringify({ email: data.get('email'), password: data.get('password') }) });
      const result = await response.json().catch(() => ({})); if (!response.ok) throw new Error('E-mail eller adgangskode er forkert.');
      setSession(result); loginForm.reset(); loginStatus.textContent = ''; await showWorkspace();
    } catch (error) { loginStatus.textContent = error instanceof Error ? error.message : 'Login mislykkedes.'; }
    finally { button.disabled = !config.anonKey; }
  });

  const authHash = new URLSearchParams(window.location.hash.slice(1));
  const recoveryToken = authHash.get('type') === 'recovery' ? authHash.get('access_token') : '';
  const authError = authHash.get('error_description');

  if (recoveryToken) {
    loginForm.hidden = true;
    recoveryView.hidden = false;
  } else if (authError) {
    loginStatus.textContent = `Linket kunne ikke bruges: ${authError.replaceAll('+', ' ')}`;
    history.replaceState(null, '', window.location.pathname);
  }

  recoveryForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const button = recoveryForm.querySelector('button');
    const data = new FormData(recoveryForm);
    const password = String(data.get('password') || '');
    const confirmation = String(data.get('password_confirm') || '');
    if (password !== confirmation) {
      recoveryStatus.textContent = 'De to adgangskoder er ikke ens.';
      return;
    }
    button.disabled = true;
    recoveryStatus.textContent = 'Gemmer den nye adgangskode…';
    try {
      const response = await fetch(`${config.supabaseUrl}/auth/v1/user`, {
        method: 'PUT',
        headers: { apikey: config.anonKey, authorization: `Bearer ${recoveryToken}`, 'content-type': 'application/json' },
        body: JSON.stringify({ password }),
      });
      const result = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(result.msg || result.message || 'Adgangskoden kunne ikke gemmes. Bed om et nyt link.');
      history.replaceState(null, '', window.location.pathname);
      setSession(null);
      recoveryForm.reset();
      recoveryView.hidden = true;
      loginForm.hidden = false;
      loginStatus.textContent = 'Adgangskoden er gemt. Du kan nu logge ind.';
    } catch (error) {
      recoveryStatus.textContent = error instanceof Error ? error.message : 'Adgangskoden kunne ikke gemmes.';
    } finally {
      button.disabled = !config.anonKey;
    }
  });
  signOut?.addEventListener('click', () => showLogin('Du er logget ud.'));
  document.querySelector('#refresh-stories')?.addEventListener('click', loadSubmissions);
  search?.addEventListener('input', renderList); filter?.addEventListener('change', renderList);
  if (config.anonKey && session()?.access_token) showWorkspace();
</script>

<style>
  .admin-body { min-height: 100vh; background: #ebe6da; color: var(--ink); }
  .admin-header { min-height: 92px; display: flex; align-items: center; gap: 32px; padding: 18px clamp(22px, 4vw, 64px); border-bottom: 1px solid var(--line); background: var(--paper); }
