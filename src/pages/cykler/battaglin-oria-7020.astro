import OptimizedImage from '../../components/OptimizedImage.astro';
import hero from '../../assets/bikes/battaglin-oria-7020/complete-drive-side.webp';
import tubing from '../../assets/bikes/battaglin-oria-7020/oria-7020-label.webp';
import signature from '../../assets/bikes/battaglin-oria-7020/giovanni-signature.webp';
import rim from '../../assets/bikes/battaglin-oria-7020/atlanta-1996-rim.webp';
import cockpit from '../../assets/bikes/battaglin-oria-7020/cockpit.webp';
import drivetrain from '../../assets/bikes/battaglin-oria-7020/ultegra-drivetrain.webp';
import badge from '../../assets/bikes/battaglin-oria-7020/head-badge.webp';
import paint from '../../assets/bikes/battaglin-oria-7020/top-tube-paint.webp';
const heroSocial = new URL(hero.src, Astro.site ?? Astro.url).href;
---
<!doctype html><html lang="da"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content="Battaglin Oria 7020 fra anden halvdel af 1990’erne: italiensk aluminiumsracer med Shimano Ultegra og Campagnolo Atlanta 1996-fælge."/><link rel="canonical" href="https://teob.dk/cykler/battaglin-oria-7020/"/><link rel="alternate" hreflang="da" href="https://teob.dk/cykler/battaglin-oria-7020/"/><link rel="alternate" hreflang="en" href="https://teob.dk/en/bikes/battaglin-oria-7020/"/><link rel="alternate" hreflang="x-default" href="https://teob.dk/cykler/battaglin-oria-7020/"/><meta property="og:type" content="article"/><meta property="og:title" content="Battaglin Oria 7020 · The Evolution of Bikes"/><meta property="og:description" content="En italiensk aluminiumsracer, hvor stærk 1990’er-lakering møder synlig og let aflæselig mekanik."/><meta property="og:image" content={heroSocial}/><meta name="twitter:card" content="summary_large_image"/><title>Battaglin Oria 7020 · The Evolution of Bikes</title><link rel="stylesheet" href={`${base}/styles/global.css`}/></head><body>
<header class="site-header"><a class="brand" href={`${base}/`} aria-label="The Evolution of Bikes, forside"><span class="brand-mark">E<span>B</span></span><span>The Evolution<br/>of Bikes</span></a><nav aria-label="Hovedmenu"><a href={`${base}/historier/`}>Historier</a><a href={`${base}/perioder/`}>Perioder</a><a href={`${base}/cykler/`} aria-current="page">Cykler</a><a href={`${base}/om/`}>Om</a></nav><div class="header-tools"><strong aria-current="page">DA</strong><span aria-hidden="true">/</span><a class="language-switch" href={`${base}/en/bikes/battaglin-oria-7020/`} lang="en" hreflang="en">EN</a><a class="header-story-link" href={`${base}/fortael-din-historie/`}>Fortæl din historie</a></div></header>
<main class="atala-page">
<header class="quick-hero"><p class="section-label">I samlingen · Italien · ca. 1996–1998</p><h1>Battaglin<br/><em>Oria 7020</em></h1><p>En italiensk aluminiumsracer fra den del af 1990’erne, hvor store svejsede rør, integrerede geargreb og farvestærk lakering stod side om side.</p></header>
<figure class="quick-pass battaglin-hero"><OptimizedImage src={hero} alt="Blå Battaglin-racer i aluminium set fra højre side" loading="eager" fetchpriority="high"/><figcaption>Battaglin-cyklen set fra drivsiden. Stellets mærkater, Ultegra-delene og Atlanta 1996-fælgene placerer opbygningen tydeligt i 1990’erne. Foto: The Evolution of Bikes.</figcaption></figure>
<section class="atala-facts" aria-label="Nøgleoplysninger"><div><strong>ca. 1996–1998</strong><span>Sandsynlig periode</span></div><div><strong>Oria 7020</strong><span>Dobbeltkonificeret aluminium</span></div><div><strong>Ultegra</strong><span>Shimano gear og bremser</span></div><div><strong>Atlanta 1996</strong><span>Campagnolo-fælge</span></div></section>
<section class="atala-opening"><p class="section-label">En cykel, der ikke gemmer sig</p><p>Den blå bundfarve er kun begyndelsen. Gule, røde og rosa felter løber hen over rørene, mens Battaglin-navnet står stort på både over-, skrå- og kæderør. Under lakken ligger et stel, der viser et afgørende skifte: den klassiske italienske racer var blevet svejset i aluminium.</p></section>
<section class="atala-story"><div><p class="section-label">Marostica, 1981</p><h2>Rytterens navn kom på skrårøret</h2></div><div><p>Giovanni Battaglin vandt både Vuelta a España og Giro d’Italia i 1981. Efter sæsonen begyndte han at bygge cykler under eget navn i hjembyen Marostica i Veneto.</p><p>Mærket blev først kendt for stålrammer. Carrera-holdets resultater i 1980’erne, herunder Stephen Roches store 1987-sæson, gav navnet international rækkevidde. Senere fulgte forsøg med lettere materialer som aluminium og kulfiber.</p><p>Denne cykel tilhører den periode. Giovannis signatur er lagt på stellet, men cyklen er ikke udstyret som et minde om fortiden. Den er bygget med datidens moderne materialer og betjening.</p></div></section>
<section class="atala-details"><figure><OptimizedImage src={tubing} alt="Mærkat med teksten Aluminium 7020 Oria Double Butted på Battaglin-stellet"/><figcaption>Stelmærkaten angiver Oria 7020 aluminium og dobbeltkonificerede rør. Det er cyklens sikreste materialeoplysning.</figcaption></figure><figure><OptimizedImage src={signature} alt="Gul Giovanni Battaglin-signatur på det blå stel"/><figcaption>Giovanni Battaglins signatur forbinder cyklen med rytteren, der grundlagde mærket efter sin Giro–Vuelta-double.</figcaption></figure><figure><OptimizedImage src={badge} alt="Battaglin-logo på cyklens blå kronrør"/><figcaption>Det enkle kronrørsmærke står næsten stille midt i lakeringens mange farver.</figcaption></figure></section>
<section class="atala-components"><div><p class="section-label">Aluminium i 1990’erne</p><h2>Store rør og synlige svejsninger</h2></div><div><p>7020 er en varmebehandlelig aluminiumlegering, som blev anvendt til lette, stive racerstel. Oria-mærkaten beskriver rørene som dobbeltkonificerede: godset er tykkere ved samlingerne og tyndere på midten, hvor belastningen er mindre.</p><p>Rørene er større end på en traditionel stålramme. Det øger deres modstand mod bøjning og vrid uden at kræve samme vægtykkelse hele vejen. Samlingerne er TIG-svejsede og står som en synlig del af konstruktionen.</p><p>Forgaflen er derimod i metal og har et klassisk, slankt udtryk. Cyklen befinder sig dermed midt mellem to formsprog: den gamle racers proportioner og aluminiumsårenes større profiler.</p></div></section>
<section class="atala-details"><figure><OptimizedImage src={paint} alt="Battaglin-navn og flerfarvet lakering på cyklens overrør"/><figcaption>Lakeringen gør rørenes størrelse tydelig og giver cyklen et umiskendeligt 1990’er-udtryk.</figcaption></figure><figure><OptimizedImage src={cockpit} alt="Styr og Shimano Ultegra-greb på Battaglin-raceren"/><figcaption>Ultegra STI-greb samler gearskift og bremsebetjening ved styret. Kablerne ligger stadig åbent foran cyklen.</figcaption></figure><figure><OptimizedImage src={rim} alt="Campagnolo Atlanta 1996-fælg med Grand Prix-dæk"/><figcaption>Campagnolo Atlanta 1996 er modellens navn, knyttet til værtsbyen for OL. Mærkningen hjælper med dateringen, men beviser ikke alene stellets årgang.</figcaption></figure></section>
<section class="atala-story"><div><p class="section-label">Opbygningen i samlingen</p><h2>Italiensk stel, japansk gruppe</h2></div><div><p>Geargreb, forskifter, bagskifter, bremser og kranksæt bærer Shimano Ultegra-navnet. Kombinationen var almindelig på gode europæiske racercykler: et italiensk stel kunne uden videre få en japansk gruppe, hvis den passede til ejerens budget og brug.</p><p>Kranksættet har to klinger, og bagskifteren arbejder på en tæt kassette til landevejskørsel. Fælgbremserne, den gevindskårne kronrørsløsning og den traditionelle frempind gør cyklen mekanisk overskuelig.</p><p>Hjulene er bygget med Campagnolo Atlanta 1996-fælge. De er en del af Campagnolos serie opkaldt efter olympiske værtsbyer. Her står de sølvfarvede profiler som en rolig kontrast til stellets farver.</p></div></section>
<section class="atala-detail-pair"><figure><OptimizedImage src={drivetrain} alt="Shimano Ultegra-kranksæt og bagskifter på Battaglin-raceren"/><figcaption>Ultegra-opbygningen kan aflæses direkte på kranksæt, forskifter og bagskifter.</figcaption></figure><div><p class="section-label">Datering</p><h2>En sandsynlig periode, ikke et sikkert modelår</h2><p>Der er ikke fundet et stelnummer eller et samtidigt katalog, som sikkert fastslår model og år. Derfor dateres cyklen forsigtigt til cirka 1996–1998 ud fra steltype, grafik og opbygning.</p><p>Atlanta 1996-navnet henviser til OL-byen og fælgmodellen; det skal ikke læses som et produktionsstempel for hele cyklen. Tilsvarende er “Wing” ikke brugt som sikkert modelnavn, fordi det ikke står på den bevarede cykel.</p></div></section>
<section class="koga-specs"><div><p class="section-label">Cyklen i samlingen</p><h2>Kort specifikation</h2></div><dl><div><dt>Producent</dt><dd>Battaglin</dd></div><div><dt>Betegnelse</dt><dd>Oria 7020</dd></div><div><dt>Datering</dt><dd>ca. 1996–1998, sandsynlig</dd></div><div><dt>Stel</dt><dd>Oria 7020 aluminium, double butted</dd></div><div><dt>Forgaffel</dt><dd>Metal, gevindskåret styrfitting</dd></div><div><dt>Gear og bremser</dt><dd>Shimano Ultegra</dd></div><div><dt>Hjul</dt><dd>Campagnolo Atlanta 1996-fælge</dd></div><div><dt>Status</dt><dd>I samlingen</dd></div></dl></section>
<section class="atala-closing"><p>Battaglin-cyklen viser ikke blot, at aluminium blev lettere og stivere. Den viser også, hvordan en italiensk producent gjorde det nye materiale til sit eget: med rytterens signatur, store bogstaver og en lakering, der lader teknik og temperament fylde lige meget.</p><div class="bike-bottom-nav"><a href={`${base}/cykler/`}>← Tilbage til cyklerne</a><a href={`${base}/perioder/1990-1999/`}>Se perioden 1990–1999 →</a></div></section>
</main><footer><div class="brand footer-brand"><span class="brand-mark">E<span>B</span></span><span>The Evolution<br/>of Bikes</span></div><p>En personlig samling af vintagecykler,<br/>historier, mærker og komponenter.</p><p class="copyright">© {new Date().getFullYear()} The Evolution of Bikes</p></footer><style>.quick-pass.battaglin-hero img{width:min(100%,960px);height:auto;max-height:72vh;aspect-ratio:auto;object-fit:contain}</style></body></html>
