---
const base = import.meta.env.BASE_URL;
const bikes = [
  { year: '1947', place: 'Conegliano, Italien', title: 'Stella Veneta', text: 'En italiensk racer med Campagnolo Cambio Corsa — gearet, der krævede to lange stænger, balance og en ganske bestemt rækkefølge.', image: `${base}/images/bikes/stella-veneta/hero.webp`, href: `${base}/cykler/stella-veneta/` },
  { year: '1983-model', place: 'Holland / Japan', title: 'Koga-Miyata Gentsracer-Aero', status: 'Tidligere i samlingen', text: 'En sølvgrøn stålcykel med Shimano 600 AX og Dyna-Drive fra aerodynamikkens første store komponentforsøg.', image: `${base}/images/bikes/koga-miyata-gentsracer-aero/hero-right-side.jpg`, href: `${base}/cykler/koga-miyata-gentsracer-aero/` },
  { year: 'ca. 1978–1982', place: 'Italien', title: 'Atala Sanremo', status: 'Tidligere i samlingen', text: 'En rødlakeret italiensk racer med Campagnolo, Gipiemme og et navn, der trækker tråde tilbage til Giroens begyndelse.', image: `${base}/images/bikes/atala-sanremo/hero.webp`, href: `${base}/cykler/atala-sanremo/` },
  { year: 'ca. 1919', place: 'Toulouse, Frankrig', title: 'Cycles France-Sport', text: 'Cyklen, der ventede næsten 100 år i en lade — med et navn i messing og en flyer skjult i styret.', image: `${base}/images/bikes/cycles-france-sport/hero.webp`, href: `${base}/cykler/cycles-france-sport/` },
  { year: '1937', place: 'Saint-Étienne, Frankrig', title: 'Wonder Saint-Étienne', text: 'Monsieur Pauberts racer til landevej og bane, bevaret med købskvittering, original lak og Super Champion Course.', image: `${base}/images/bikes/wonder-saint-etienne/hero.webp`, href: `${base}/cykler/wonder-saint-etienne/` },
];
---
<!doctype html><html lang="da"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><meta name="description" content="Cyklerne i The Evolution of Bikes — dokumenterede racercykler, teknik og ejerhistorier." /><title>Cykler i samlingen · The Evolution of Bikes</title><link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin /><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Libre+Caslon+Display&display=swap" rel="stylesheet" /><link rel="stylesheet" href={`${base}/styles/global.css`} /></head><body>
<header class="site-header"><a class="brand" href={`${base}/`}><span class="brand-mark">E<span>B</span></span><span>The Evolution<br />of Bikes</span></a><nav aria-label="Hovedmenu"><a href={`${base}/historier/`}>Historier</a><a href={`${base}/perioder/`}>Perioder</a><a href={`${base}/cykler/`} aria-current="page">Cykler</a><a href={`${base}/komponenter/`}>Komponenter</a><a href={`${base}/om/`}>Om</a></nav></header>
<main><header class="archive-hero"><p class="section-label">Samlingen</p><h1>Cyklerne</h1><p>Hver cykel dokumenteres med dens teknik, restaurering og de menneskelige spor, som stadig følger med den. Enkelte cykler er ikke længere i samlingen, men deres historier er bevaret her.</p></header><section class="bike-archive">{bikes.map((bike) => <a href={bike.href}><img src={bike.image} alt={bike.title} /><div>{bike.status && <small>{bike.status}</small>}<span>{bike.year} · {bike.place}</span><h2>{bike.title}</h2><p>{bike.text}</p><b>Se cyklen →</b></div></a>)}</section></main>
<footer><div class="brand footer-brand"><span class="brand-mark">E<span>B</span></span><span>The Evolution<br />of Bikes</span></div><p>En personlig samling af vintagecykler,<br />historier, mærker og komponenter.</p><p class="copyright">© {new Date().getFullYear()} The Evolution of Bikes</p></footer></body></html>
