---
import { bikes } from '../../data/bikes';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const bikeCards = bikes.map((bike) => ({ ...bike, image: `${base}/${bike.image}`, href: `${base}/cykler/${bike.slug}/` }));
---
<!doctype html><html lang="da"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><meta name="description" content="Cyklerne i The Evolution of Bikes — dokumenterede racercykler, teknik og ejerhistorier." /><title>Cykler i samlingen · The Evolution of Bikes</title><link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin /><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Libre+Caslon+Display&display=swap" rel="stylesheet" /><link rel="stylesheet" href={`${base}/styles/global.css`} /></head><body>
<header class="site-header"><a class="brand" href={`${base}/`}><span class="brand-mark">E<span>B</span></span><span>The Evolution<br />of Bikes</span></a><nav aria-label="Hovedmenu"><a href={`${base}/historier/`}>Historier</a><a href={`${base}/perioder/`}>Perioder</a><a href={`${base}/cykler/`} aria-current="page">Cykler</a><a href={`${base}/komponenter/`}>Komponenter</a><a href={`${base}/om/`}>Om</a></nav><div class="header-tools"><strong>DA</strong><span>/</span><a class="language-switch" href={`${base}/en/bikes/`} lang="en">EN</a><a class="header-story-link" href={`${base}/fortael-din-historie/`}>Fortæl din historie</a></div></header>
<main><header class="archive-hero"><p class="section-label">Samlingen</p><h1>Cyklerne</h1><p>Hver cykel dokumenteres med dens teknik, restaurering og de menneskelige spor, som stadig følger med den. Enkelte cykler er ikke længere i samlingen, men deres historier er bevaret her.</p></header><section class="bike-archive">{bikeCards.map((bike) => <a href={bike.href}><img src={bike.image} alt={bike.title} /><div>{bike.status && <small>{bike.status}</small>}<span>{bike.year} · {bike.place}</span><h2>{bike.title}</h2><p>{bike.text}</p><b>Se cyklen →</b></div></a>)}</section></main>
<footer><div class="brand footer-brand"><span class="brand-mark">E<span>B</span></span><span>The Evolution<br />of Bikes</span></div><p>En personlig samling af vintagecykler,<br />historier, mærker og komponenter.</p><p class="copyright">© {new Date().getFullYear()} The Evolution of Bikes</p></footer></body></html>
