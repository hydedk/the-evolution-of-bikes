---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
import OptimizedImage from '../../components/OptimizedImage.astro';
import hero from '../../assets/bikes/principia-evolution/complete-drive-side.jpg';
import rearBrake from '../../assets/bikes/principia-evolution/rear-brake-seat-cluster.jpg';
import tubing from '../../assets/bikes/principia-evolution/aluminium-tubing-label.jpg';
import frontBrake from '../../assets/bikes/principia-evolution/dura-ace-front-brake.jpg';
import cockpit from '../../assets/bikes/principia-evolution/cockpit.jpg';
import downTube from '../../assets/bikes/principia-evolution/down-tube.jpg';
import evolution from '../../assets/bikes/principia-evolution/evolution-stay.jpg';
import denmark from '../../assets/bikes/principia-evolution/principia-of-denmark.jpg';
import drivetrain from '../../assets/bikes/principia-evolution/dura-ace-drivetrain.jpg';
import fork from '../../assets/bikes/principia-evolution/weave-carbon-fork.jpg';
const heroSocial = new URL(hero.src, Astro.site ?? Astro.url).href;
---
<!doctype html><html lang="da"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content="Principia Evolution fra 2007: dansk aluminiumsracer med formede rør, WEAVE-kulfibergaffel og Shimano Dura-Ace-komponenter."/><meta property="og:type" content="article"/><meta property="og:title" content="Principia Evolution 2007 · The Evolution of Bikes"/><meta property="og:description" content="En dansk aluminiumsracer fra tiden, hvor stivhed i forhold til vægt var Principias faste målestok."/><meta property="og:image" content={heroSocial}/><meta name="twitter:card" content="summary_large_image"/><title>Principia Evolution 2007 · The Evolution of Bikes</title><link rel="stylesheet" href={`${base}/styles/global.css`}/></head><body>
<header class="site-header"><a class="brand" href={`${base}/`} aria-label="The Evolution of Bikes, forside"><span class="brand-mark">E<span>B</span></span><span>The Evolution<br/>of Bikes</span></a><nav aria-label="Hovedmenu"><a href={`${base}/historier/`}>Historier</a><a href={`${base}/perioder/`}>Perioder</a><a href={`${base}/cykler/`} aria-current="page">Cykler</a><a href={`${base}/om/`}>Om</a></nav><a class="header-story-link" href={`${base}/fortael-din-historie/`}>Fortæl din historie</a></header>
<main class="atala-page">
<header class="quick-hero"><p class="section-label">I samlingen · Danmark · 2007</p><h1>Principia<br/><em>Evolution</em></h1><p>En dansk aluminiumsracer bygget omkring store, formede rør og Principias gamle målestok: mest mulig stivhed for så lidt vægt som muligt.</p></header>
<figure class="quick-pass"><OptimizedImage src={hero} alt="Bronzefarvet Principia Evolution fra 2007 set fra højre side" loading="eager" fetchpriority="high"/><figcaption>Principia Evolution set fra drivsiden. Aluminiumsstellet er kombineret med kulfibergaffel og Shimano-komponenter. Foto: The Evolution of Bikes.</figcaption></figure>
<section class="atala-facts" aria-label="Nøgleoplysninger"><div><strong>2007</strong><span>Oplyst årgang</span></div><div><strong>Aluminium</strong><span>Formede, svejsede rør</span></div><div><strong>Dura-Ace</strong><span>Bremser og geardele</span></div><div><strong>WEAVE</strong><span>Kulfiberforgaffel</span></div></section>
<section class="atala-opening"><p class="section-label">Store rør, klart formål</p><p>Det første, man lægger mærke til, er rørene. Omkring kronrør og krank er profilerne gjort store og formede for at begrænse vrid, når rytteren træder hårdt eller lægger cyklen ind i et sving. Principia gjorde forholdet mellem stivhed og vægt til et arbejdsprincip: STW, stiffness to weight.</p></section>
<section class="atala-story"><div><p class="section-label">Aalborg, 1990</p><h2>Tre triatleter begyndte selv</h2></div><div><p>Principia begyndte i Aalborg i 1990. Tre unge triatleter havde ikke råd til de amerikanske aluminiumsrammer, de gerne ville køre på. De begyndte derfor at file, tilpasse og svejse deres egne rør i en kælder i Himmerlandsgade.</p><p>Principia arbejdede tidligt med 7020-aluminium. På denne Evolution angiver mærkaten imidlertid “Principia Magnum aluminium tubing”. Uden et samtidigt modelkatalog sidestilles betegnelsen ikke automatisk med 7020.</p><p>De store aluminiumsrør blev mærkets kendetegn. Formen havde et praktisk formål: mere materiale langt fra rørets centrum gav større modstand mod bøjning og vrid.</p></div></section>
<section class="atala-details"><figure><OptimizedImage src={downTube} alt="Det store formede skrårør på Principia Evolution"/><figcaption>Det brede skrårør samler kræfterne mellem kronrør og krankområde.</figcaption></figure><figure><OptimizedImage src={tubing} alt="Mærkat for Principia Magnum-aluminiumsrør"/><figcaption>Mærkaten beskriver Principia Magnum-rørene som konificerede, CNC-bearbejdede og TIG-svejsede.</figcaption></figure><figure><OptimizedImage src={denmark} alt="Teksten Principia of Denmark på cyklens sadelrør"/><figcaption>“Principia of Denmark” står på sadelrøret. Mærkaten omtaler design i Danmark, men dokumenterer ikke i sig selv produktionsstedet.</figcaption></figure></section>
<section class="atala-components"><div><p class="section-label">Cyklen fra 2007</p><h2>Aluminium med kulfiber foran</h2></div><div><p>Evolution kombinerer aluminiumsstellet med en WEAVE C24T monocoque-kulfibergaffel. Det var en almindelig materialeblanding på gode landevejscykler i 2000’erne.</p><p>Dura-Ace kan aflæses på bremser og bagskifter. Kranksættet er derimod mærket Shimano Ultegra. Det er derfor mere præcist at beskrive cyklen som en opbygning med Dura-Ace-dele end som en komplet Dura-Ace-gruppe.</p><p>Fælgbremser og udvendige kabler gør teknikken synlig. Cyklen står lige før elektroniske gear, skjulte kabler og skivebremser ændrede den moderne racers udseende.</p></div></section>
<section class="atala-details"><figure><OptimizedImage src={frontBrake} alt="Shimano Dura-Ace-forbremse på Principia Evolution"/><figcaption>Dura-Ace-fælgbremsen arbejder direkte på forhjulets aluminiumsside.</figcaption></figure><figure><OptimizedImage src={fork} alt="Mærkning på WEAVE C24T monocoque-kulfibergaffel"/><figcaption>Forgaflen er mærket WEAVE C24T full monocoque carbon.</figcaption></figure><figure><OptimizedImage src={cockpit} alt="Styr, frempind og kronrør på Principia Evolution"/><figcaption>En separat frempind og synlige kabler gør fronten let at aflæse og justere.</figcaption></figure></section>
<section class="atala-story"><div><p class="section-label">Fra Aalborg til eksport</p><h2>Rammerne kom ud at køre</h2></div><div><p>Principia voksede hurtigt i 1990’erne, især gennem det tyske marked. Mærket leverede også cykler til Team Chicky World, Team Acceptcard, Team Fakta og Linda McCartney Racing Team.</p><p>På en Principia vandt australieren David McKenzie 7. etape af Giro d’Italia i 2000 efter 164 kilometer alene i front. Et lille dansk rammemærke var nået ind i international professionel cykling.</p><p>Efter skiftende ejerforhold kom Principia i 2006 under HF Christiansen. Denne cykel er dateret til 2007 og står dermed tæt på overgangen.</p></div></section>
<section class="atala-details"><figure><OptimizedImage src={rearBrake} alt="Bremsebro og bagbremse på Principia Evolution"/><figcaption>Formede rør og en kraftig bremsebro præger bagenden.</figcaption></figure><figure><OptimizedImage src={drivetrain} alt="Dura-Ace-bagskifter og Ultegra-kranksæt på Principia Evolution"/><figcaption>Dura-Ace-bagskifteren sidder sammen med et Ultegra-kranksæt.</figcaption></figure><figure><OptimizedImage src={evolution} alt="Evolution-modelnavnet på Principia-cyklens bagstel"/><figcaption>Evolution-navnet er lagt diskret langs bagstellet.</figcaption></figure></section>
<section class="koga-specs"><div><p class="section-label">Cyklen i samlingen</p><h2>Kort specifikation</h2></div><dl><div><dt>Producent</dt><dd>Principia</dd></div><div><dt>Model</dt><dd>Evolution</dd></div><div><dt>Årgang</dt><dd>2007, oplyst</dd></div><div><dt>Stel</dt><dd>Principia Magnum aluminium tubing</dd></div><div><dt>Forgaffel</dt><dd>WEAVE C24T monocoque-kulfiber</dd></div><div><dt>Gear og bremser</dt><dd>Shimano Dura-Ace-dele</dd></div><div><dt>Kranksæt</dt><dd>Shimano Ultegra</dd></div><div><dt>Status</dt><dd>I samlingen</dd></div></dl></section>
<section class="atala-story period-sources"><div><p class="section-label">Kilder</p><h2>Grundlag</h2></div><div><p><a href="https://principia.dk/om/historie">Principia: Historien om Principia</a> · cyklen, dens mærkater og ejerens oplysninger i The Evolution of Bikes-samlingen.</p><p>Dateringen er oplyst af ejeren. Komponenterne er beskrevet efter de synlige mærkninger. Producentens historik er en senere virksomhedsfortælling og bruges til de overordnede oplysninger om mærket.</p></div></section>
<section class="atala-closing"><p>Evolution viser, hvor langt Principias oprindelige idé kunne strækkes. De store svejsede aluminiumsrør er stadig udgangspunktet, mens kulfibergaffel og 2000’ernes komponenter placerer cyklen langt fra kælderens første triatlonrammer.</p><div class="bike-bottom-nav"><a href={`${base}/cykler/`}>← Tilbage til cyklerne</a><a href={`${base}/perioder/2000-2009/`}>Se perioden 2000–2009 →</a></div></section>
</main><footer><div class="brand footer-brand"><span class="brand-mark">E<span>B</span></span><span>The Evolution<br/>of Bikes</span></div><p>En personlig samling af vintagecykler,<br/>historier, mærker og komponenter.</p><p class="copyright">© {new Date().getFullYear()} The Evolution of Bikes</p></footer></body></html>
