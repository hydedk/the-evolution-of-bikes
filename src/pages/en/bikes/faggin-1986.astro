import EnglishHeader from '../../../components/EnglishHeader.astro'; import EnglishFooter from '../../../components/EnglishFooter.astro'; const base=import.meta.env.BASE_URL.replace(/\/$/,''); const images=`${base}/images/bikes/faggin-1986`;
