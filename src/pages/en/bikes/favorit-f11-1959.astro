import stem from '../../../assets/stories/favorit-f11-srbinko/favorit-frempind.jpg';
import leftSide from '../../../assets/stories/favorit-f11-srbinko/restaureret-venstreside.jpg';
import driveDetail from '../../../assets/stories/favorit-f11-srbinko/ramme-og-drivlinje.jpg';
