const gallery = [
  [leftSide, 'The completed F11 seen from the left.', 'The restored gold Favorit F11 seen from the left'],
  [driveDetail, 'Frame, chainset and drivetrain.', 'Detail of the gold frame, chainset and drivetrain'],
  [frontHub, 'The front hub with wing nuts.', 'Chromed front hub with wing nuts'],
  [rimLabel, 'The Favorit label on the rim.', 'Worn Favorit label on the bicycle rim'],
  [partsTable, 'The original parts laid out during the work.', 'Handlebar, chainset, pedals, brake levers and other Favorit parts on a table'],
  [disassembled, 'The bicycle was dismantled into its individual components.', 'The Favorit bicycle components dismantled during restoration'],
  [found, 'The bicycle before restoration.', 'The dusty gold Favorit racing bicycle before restoration'],
  [ownerBike, 'Stefan Đurić with the restored bicycle.', 'Stefan Đurić standing with the completed Favorit F11'],
  [receipt, 'The original receipt dated 1 December 1960.', 'Original purchase receipt for the Favorit bicycle'],
