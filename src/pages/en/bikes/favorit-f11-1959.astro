import found from '../../../assets/stories/favorit-f11-srbinko/fundtilstand.jpg';
import ownerBike from '../../../assets/stories/favorit-f11-srbinko/stefan-med-cyklen.jpg';
import receipt from '../../../assets/stories/favorit-f11-srbinko/koebskvittering-korrekt.jpg';
