---
import EnglishHeader from '../../../components/EnglishHeader.astro'; import EnglishFooter from '../../../components/EnglishFooter.astro'; import { englishBikes as bikes } from '../../../data/english'; const base=import.meta.env.BASE_URL.replace(/\/$/,'');
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content="Bicycles in the collection — documented racing bicycles, mechanics and ownership stories."/><title>Bicycles in the collection · The Evolution of Bikes</title><link rel="stylesheet" href={`${base}/styles/global.css`}/><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Libre+Caslon+Display&display=swap" rel="stylesheet"/></head><body><EnglishHeader current="bikes" danishPath="/cykler/"/><main><header class="archive-hero"><p class="section-label">The collection</p><h1>The bicycles</h1><p>Each bicycle is documented through its mechanics, restoration and the human traces that remain. Some are no longer in the collection, but their stories are preserved here.</p></header><section class="bike-archive">{bikes.map(b=><a href={`${base}/cykler/${b.slug}/`} lang="da"><img src={`${base}/${b.image}`} alt={b.title}/><div>{b.status&&<small>{b.status}</small>}<span>{b.year} · {b.place}</span><h2>{b.title}</h2><p>{b.text}</p><b>View in Danish →</b></div></a>)}</section></main><EnglishFooter/></body></html>
