---
import EnglishHeader from '../../../components/EnglishHeader.astro'; import EnglishFooter from '../../../components/EnglishFooter.astro'; import { englishBikes } from '../../../data/english'; const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const yearNumber=(year:string)=>Number(year.match(/\d{4}/)?.[0]??Number.MAX_SAFE_INTEGER); const bikes=[...englishBikes].sort((a,b)=>yearNumber(a.year)-yearNumber(b.year));
const translated=new Set(['bernardi-ca-1980','faggin-1986','scapin-k6','gios-super-record','rossin-record','schroder-1965','asmussen-super-prestige','colnago-super-thron','colnago-1993-tange-prestige','giame','stella-veneta','koga-miyata-gentsracer-aero','atala-sanremo','cycles-france-sport','wonder-saint-etienne']);
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content="Bicycles in the collection — documented racing bicycles, mechanics and ownership stories."/><title>Bicycles in the collection · The Evolution of Bikes</title><link rel="stylesheet" href={`${base}/styles/global.css`}/><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Libre+Caslon+Display&display=swap" rel="stylesheet"/></head><body><EnglishHeader current="bikes" danishPath="/cykler/"/><main><header class="archive-hero"><p class="section-label">The collection</p><h1>The bicycles</h1><p>Each bicycle is documented through its mechanics, restoration and the human traces that remain. Some are no longer in the collection, but their stories are preserved here.</p></header><section class="bike-archive">{bikes.map(b=>{const en=translated.has(b.slug);return <a href={`${base}/${en?'en/bikes':'cykler'}/${b.slug}/`} lang={en?'en':'da'}><img src={`${base}/${b.image}`} alt={b.title}/><div>{b.status&&<small>{b.status}</small>}<span>{b.year} · {b.place}</span><h2>{b.title}</h2><p>{b.text}</p><b>{en?'View the bicycle →':'View in Danish →'}</b></div></a>})}</section></main><EnglishFooter/></body></html>

