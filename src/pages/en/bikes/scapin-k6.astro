import heroImage from '../../../assets/bikes/scapin-k6/complete-drive-side.jpg'; import frontWheel from '../../../assets/bikes/scapin-k6/front-wheel.jpg'; import frameProfile from '../../../assets/bikes/scapin-k6/frame-profile.jpg'; import cockpit from '../../../assets/bikes/scapin-k6/cockpit.jpg'; import frameAndFrontWheel from '../../../assets/bikes/scapin-k6/frame-and-front-wheel.jpg'; import cockpitAngle from '../../../assets/bikes/scapin-k6/cockpit-angle.jpg'; import rearDerailleur from '../../../assets/bikes/scapin-k6/rear-derailleur.jpg'; import crankset from '../../../assets/bikes/scapin-k6/crankset.jpg';
