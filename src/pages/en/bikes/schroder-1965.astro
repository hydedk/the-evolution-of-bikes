import EnglishFooter from '../../../components/EnglishFooter.astro';
import OptimizedImage from '../../../components/OptimizedImage.astro';
import heroImage from '../../../assets/bikes/schroder-1965/complete-drive-side.jpg';
import rearDerailleur from '../../../assets/bikes/schroder-1965/rear-derailleur.jpg';
import cableGuide from '../../../assets/bikes/schroder-1965/cable-guide.jpg';
import rearBrake from '../../../assets/bikes/schroder-1965/rear-brake-and-frame.jpg';
import headBadge from '../../../assets/bikes/schroder-1965/head-badge-and-front-brake.jpg';
import frontDerailleur from '../../../assets/bikes/schroder-1965/front-derailleur.jpg';
