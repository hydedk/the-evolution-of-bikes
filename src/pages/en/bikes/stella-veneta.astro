import EnglishHeader from '../../../components/EnglishHeader.astro'; import EnglishFooter from '../../../components/EnglishFooter.astro'; const base=import.meta.env.BASE_URL.replace(/\/$/,''); const images=`${base}/images/bikes/stella-veneta`;
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content="A 1947 Stella Veneta with Campagnolo Cambio Corsa and two gear levers beside the rear wheel."/><meta property="og:image" content="https://teob.dk/images/bikes/stella-veneta/hero.webp"/><title>Stella Veneta 1947 · The Evolution of Bikes</title><link rel="stylesheet" href={`${base}/styles/global.css`}/></head><body><EnglishHeader current="bikes" danishPath="/cykler/stella-veneta/"/><main class="atala-page"><header class="quick-hero"><p class="section-label">In the collection · Conegliano · 1947</p><h1>Stella<br/><em>Veneta</em></h1><p>A bicycle from shifting’s awkward transition: two long levers, a moving axle and a manoeuvre requiring practice.</p></header><figure class="quick-pass"><img src={`${images}/hero.webp`} alt="Red 1947 Stella Veneta"/><figcaption>The Cambio Corsa levers sit beside the right rear stay. Photo: The Evolution of Bikes.</figcaption></figure><section class="atala-story"><div><h2>A small marque from Veneto</h2></div><div><p>Ferdinando Michelin established Stella Veneta in Conegliano in 1936 after the division of Ciclo Piave. MICHE later grew from the same family environment.</p></div></section><section class="atala-details"><figure><img src={`${images}/cambio-side.webp`} alt="Cambio Corsa levers"/><figcaption>The long lever releases the axle; the short one guides the chain.</figcaption></figure><figure><img src={`${images}/cambio-rear.webp`} alt="Cambio Corsa from behind"/><figcaption>The chain guide beside the sprockets.</figcaption></figure><figure><img src={`${images}/drawing.webp`} alt="Cambio Corsa drawing"/><figcaption>Lever, guide, hub and dropouts formed one system.</figcaption></figure></section><section class="atala-components"><div><h2>Reach back. Release. Move the chain.</h2></div><div><p>The rider opened the quick release, guided the chain, pedalled the wheel into position and locked the axle again—all while moving.</p><p>“Suicide gear” is a later nickname, not Campagnolo’s term. Skilled riders used it safely, but it demanded balance and timing. Bartali won the 1948 Tour on a Cambio Corsa-equipped bicycle.</p></div></section><section class="atala-closing"><p>No click or spring completed the shift. The rider performed the mechanics.</p><div class="bike-bottom-nav"><a href={`${base}/en/bikes/`}>← Back</a><a href={`${base}/komponenter/campagnolo-cambio-corsa/`} lang="da">Cambio Corsa in Danish →</a></div></section></main><EnglishFooter/></body></html>
