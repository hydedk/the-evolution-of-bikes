import EnglishHeader from '../../../components/EnglishHeader.astro'; import EnglishFooter from '../../../components/EnglishFooter.astro'; const base=import.meta.env.BASE_URL.replace(/\/$/,''); const images=`${base}/images/bikes/wonder-saint-etienne`; const facts=[['Year','1937'],['Marque','Wonder'],['Origin','Saint-Étienne, France'],['First owner','Monsieur Paubert, Vannes'],['Gearing','Super Champion Course'],['Use','Road and track'],['Restoration','Original paint and patina retained'],['Documentation','Original purchase receipt']];
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content="Monsieur Paubert’s documented 1937 Wonder racing bicycle from Saint-Étienne, bought in Vannes."/><title>Wonder Saint-Étienne 1937 · The Evolution of Bikes</title><link rel="stylesheet" href={`${base}/styles/global.css`}/></head><body><EnglishHeader current="bikes" danishPath="/cykler/wonder-saint-etienne/"/><main><article class="wonder-page">
<header class="wonder-hero"><div class="bike-kicker"><a href={`${base}/en/bikes/`}>← Bicycles in the collection</a><span>France · 1937</span></div><h1>Wonder<br/><em>Saint-Étienne</em></h1><p>A French racer for road and track, with a family history, original receipt and almost nine decades of marks in its paint.</p></header>
<figure class="wonder-main-image"><img src={`${images}/hero.webp`} alt="Restored 1937 Wonder Saint-Étienne racing bicycle"/><figcaption>After sympathetic restoration, with original paint and patina preserved.</figcaption></figure>
<section class="wonder-opening"><p class="section-label">A known beginning</p><div><p>Monsieur Paubert bought the bicycle in Vannes in 1937. Before the war he rode some road and track races.</p><p>Many old racing bicycles have lost the names of those who used them. Here the owner’s name and purchase document remain with the machine.</p></div></section>
<dl class="bike-facts wonder-facts" aria-label="Wonder bicycle facts">{facts.map(([label,value])=><div><dt>{label}</dt><dd>{value}</dd></div>)}</dl>
<section class="wonder-provenance"><div class="wonder-copy"><p class="section-label">Provenance</p><h2>A name on the receipt</h2><p>The bicycle was bought from Monsieur Paubert’s grandson together with its original 1937 receipt, issued by M. Rio of La Madeleine in Vannes, a Wonder dealer.</p><p>The document binds bicycle, place and owner together and gives it unusually strong provenance.</p></div><figure><img src={`${images}/receipt.webp`} alt="Original 1937 receipt naming Monsieur Paubert" loading="lazy"/><figcaption>The original receipt from Vannes.</figcaption></figure></section>
<section class="wonder-before"><figure><img src={`${images}/before.webp`} alt="Wonder bicycle with a later gear system before restoration" loading="lazy"/><figcaption>At purchase, with a later gear system dating from around 1947.</figcaption></figure><div class="wonder-copy"><p class="section-label">As found</p><h2>Ten years too modern</h2><p>The later mechanism was a visible chapter in its working life, but did not match its original 1937 equipment.</p><p>Period-correct parts took several years to find. The mechanics were returned towards their 1937 form while paint, transfers and marks of use were retained.</p></div></section>
<section class="wonder-component"><div class="wonder-copy"><p class="section-label">Super Champion Course</p><h2>Shifting before the rear derailleur</h2><p>Oscar Egg introduced the Champion system in the early 1930s, followed by Super Champion. Here a chain guide at the rear wheel works with a separate tensioner near the chainset.</p><p>The rider moved the chain with a frame lever and a brief backward movement of the pedals. It was far from modern indexed shifting, but an important step towards the familiar derailleur.</p></div><div class="wonder-detail-grid"><figure><img src={`${images}/drivetrain.webp`} alt="Super Champion Course chain guide" loading="lazy"/><figcaption>The system and its special rear end.</figcaption></figure><figure><img src={`${images}/shifter.webp`} alt="Gear lever and chain tensioner" loading="lazy"/><figcaption>Separate control and tensioner.</figcaption></figure></div></section>
<section class="wonder-era"><p class="section-label">1937</p><blockquote>The year derailleurs were admitted to the Tour de France.</blockquote><div><p>The Tour permitted gear systems for the first time in 1937. Super Champion was selected and Roger Lapébie won using the system. Paubert’s Wonder dates from the year shifting gained acceptance on cycling’s largest stage.</p><p>The Oscar Egg/Super Champion rear end could be arranged for road gears or a fixed track hub, allowing one frame to serve two disciplines.</p></div></section>
<section class="wonder-details"><figure><img src={`${images}/cockpit.webp`} alt="Wonder handlebar, bottle and brake levers" loading="lazy"/><figcaption>A period cockpit.</figcaption></figure><figure><img src={`${images}/bottle.webp`} alt="Bottle and cockpit detail" loading="lazy"/><figcaption>Details preserved as part of the whole.</figcaption></figure></section>
<section class="wonder-brand-history"><div><p class="section-label">The marque</p><h2>From the bicycle city of Saint-Étienne</h2></div><div><p>Jules Ravat made Wonder bicycles in Saint-Étienne, one of France’s principal centres of cycle manufacture. The Wonder name was registered there in 1910.</p><p>Collector archives report production of about 40,000 bicycles a year and around 1,200 employees by 1926. Paubert’s racer came from a large maker, yet survived as a deeply personal example.</p></div></section>
<section class="wonder-sources"><p class="section-label">Sources and notes</p><ul><li>Collection receipt and ownership history.</li><li><a href="https://archives.saint-etienne.fr/histoires-stephanoises-1/tranches-dhistoire/sport/a-bicyclette-1">Saint-Étienne municipal archives</a>.</li><li><a href="https://httpcyclomotosloire.e-monsite.com/pages/marque-en-a/wonder.html">Historical Wonder/Jules Ravat register</a>.</li><li><a href="https://velo.outsideonline.com/road/road-racing/how-tour-de-france-embraced-derailleurs/">Velo on derailleurs in the 1937 Tour</a>.</li></ul></section>
