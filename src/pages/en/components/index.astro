---
import EnglishHeader from '../../../components/EnglishHeader.astro'; import EnglishFooter from '../../../components/EnglishFooter.astro'; const base=import.meta.env.BASE_URL.replace(/\/$/,''); const items=[['1946','Campagnolo Cambio Corsa','Two levers, a loose rear wheel and a gear change that demanded both nerve and balance.','images/components/campagnolo-cambio-corsa/two-levers.webp','campagnolo-cambio-corsa'],['1967','Campagnolo Valentino','When Campagnolo tried to build for riders outside the elite.','images/components/campagnolo-valentino/bagskifter.jpg','campagnolo-valentino'],['1978','Shimano 600 EX Arabesque','Japanese precision dressed for the European racing bicycle.','images/components/shimano-600-ex-arabesque/group-illustration.webp','shimano-600-ex-arabesque']];
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content="Components and inventions that changed the racing bicycle and the way riders used it."/><title>Components · The Evolution of Bikes</title><link rel="stylesheet" href={`${base}/styles/global.css`}/><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Libre+Caslon+Display&display=swap" rel="stylesheet"/></head><body><EnglishHeader current="components" danishPath="/komponenter/"/><main><header class="archive-hero"><p class="section-label">Mechanics with a story</p><h1>Components</h1><p>Not a complete catalogue, but selected parts, inventions and mechanical stepping stones that changed the way people rode.</p></header><section class="component-archive">{items.map(([year,title,text,image,slug])=><a href={`${base}/en/components/${slug}/`}><img src={`${base}/${image}`} alt={title}/><div><span>{year}</span><h2>{title}</h2><p>{text}</p><b>Read about the component →</b></div></a>)}</section></main><EnglishFooter/></body></html>
