---
import EnglishHeader from '../../components/EnglishHeader.astro'; import EnglishFooter from '../../components/EnglishFooter.astro'; import { englishStories as stories, englishBikes as bikes } from '../../data/english'; const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const translatedBikes=new Set(['bernardi-ca-1980','faggin-1986','scapin-k6','gios-super-record','asmussen-super-prestige','colnago-super-thron','giame','stella-veneta']); const items=[...stories.map(s=>({...s,label:'Random story',action:'Read the story',link:`${base}/en/stories/${s.slug}/`,image:`${base}/${s.image}`,lang:'en'})),...bikes.map(b=>{const en=translatedBikes.has(b.slug);return {...b,label:'Random bicycle',action:en?'View the bicycle':'View in Danish',link:`${base}/${en?'en/bikes':'cykler'}/${b.slug}/`,image:`${base}/${b.image}`,lang:en?'en':'da'}})]; const fallback=items[0];
const gateways=[['01','The stories','Stories and anecdotes','Odd moments, overlooked riders and the stories that result lists leave out.','images/stories/aldo-bini/aldo-bini-archive.webp','stories'],['02','Racing and cultural history','Periods','Explore the races, people, roads and cycling culture decade by decade.','images/periods/1900-1920/wild-west/track-racing.webp','periods'],['03','The physical archive','Bicycles in the collection','The bicycles are an entrance to their period, former owners and the craft that preserved them.','images/bikes/wonder-saint-etienne/hero.webp','bikes'],['04','Mechanics that mattered','Components','Selected inventions and mechanical stepping stones that changed the way people rode.','images/components/campagnolo-cambio-corsa/two-levers.webp','components']];
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content="A personal collection of vintage bicycles, cycling stories, marques and components."/><meta property="og:image" content="https://teob.dk/og.png"/><title>The Evolution of Bikes · Vintage bicycles and cycling stories</title><link rel="stylesheet" href={`${base}/styles/global.css`}/><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Libre+Caslon+Display&display=swap" rel="stylesheet"/></head><body><EnglishHeader danishPath="/"/><main><section class="hero home-hero"><div class="home-hero-copy"><p class="eyebrow">Vintage cycling told through bicycles, races and people</p><h1>Come for the bicycles.<br/><em>Stay for the stories.</em></h1><p class="hero-copy">A living archive of cycling culture — from hand-built steel frames and daring mechanics to the riders, helpers and moments that result lists leave out.</p><div class="home-hero-actions"><a class="button" href={fallback.link} data-random-hero-button lang="da">{fallback.action} <span>→</span></a><a class="home-hero-archive-link" href={`${base}/en/stories/`}>Browse all stories</a></div></div><a class="home-hero-feature" href={fallback.link} data-random-hero-card lang="da"><img src={fallback.image} alt="" data-random-hero-image/><span class="home-hero-feature-shade"></span><span class="home-hero-feature-copy"><small data-random-hero-label>{fallback.label} · {fallback.year}</small><strong data-random-hero-title>{fallback.title}</strong><i data-random-hero-action>{fallback.action} <span>→</span></i></span></a></section>
<section class="home-gateways" aria-label="Four ways into the archive"><header><p class="section-label">Four ways into the archive</p><h2>What are you curious about?</h2></header><div>{gateways.map(([n,l,t,x,img,slug])=><a class="home-gateway" href={`${base}/en/${slug}/`}><img src={`${base}/${img}`} alt="" loading="lazy"/><span class="home-gateway-number">{n}</span><p>{l}</p><h3>{t}</h3><b>{x}</b><i>Explore →</i></a>)}</div></section>
<section class="newsletter"><div class="newsletter-copy"><p class="section-label">News from the archive</p><h2>Cycling stories<br/><em>in your inbox</em></h2><p>An occasional newsletter with new stories, bicycles from the collection and other finds from the archive.</p></div><form class="newsletter-form" method="POST" action="https://d8a86a3c.sibforms.com/serve/MUIFADT4GimLPx-wUsPWGgzKniP3fmzWsIS3HGOXDetusA5iI6foT2aohA8UlGqsNu2d0333p3yeqd9dkDi9hinLAE1AcLHf8YkXVeVB78XyU2tMlBmS73zjH1jUSVzhKUE5i0x-T1W00SLk0Vy0qLacrlE2xGPCim7_RlC5-uBsXMIKTkT3ueUSUoVpnsCnLtj6eqhf6y2x8PHxvA==" target="newsletter-response"><label for="en-email">Your email address</label><div class="newsletter-field-row"><input id="en-email" name="EMAIL" type="email" required placeholder="name@example.com"/><button type="submit">Subscribe →</button></div><label class="newsletter-consent"><input type="checkbox" name="OPT_IN" value="1" required/><span>I agree to receive newsletters from The Evolution of Bikes and have read the <a href={`${base}/privatliv/`} lang="da">privacy policy (in Danish)</a>.</span></label><p class="newsletter-note">You can unsubscribe at any time. Subscription is handled by Brevo.</p><input type="hidden" name="locale" value="en"/><input type="hidden" name="html_type" value="simple"/></form><iframe name="newsletter-response" title="Newsletter subscription response" hidden></iframe></section><section class="story"><p class="section-label">From the archive</p><blockquote>“The interesting thing is not only how old a bicycle is, but which roads it has travelled and who has looked after it.”</blockquote></section></main><EnglishFooter/>
<script define:vars={{items}}>const card=document.querySelector('[data-random-hero-card]'),button=document.querySelector('[data-random-hero-button]');if(card&&button){const i=items[Math.floor(Math.random()*items.length)];card.href=i.link;button.href=i.link;card.lang=i.lang;button.lang=i.lang;button.firstChild.textContent=i.action+' ';card.querySelector('[data-random-hero-image]').src=i.image;card.querySelector('[data-random-hero-label]').textContent=i.label+' · '+i.year;card.querySelector('[data-random-hero-title]').textContent=i.title;card.querySelector('[data-random-hero-action]').firstChild.textContent=i.action+' '}</script></body></html>
