---
import EnglishHeader from '../../components/EnglishHeader.astro';
import EnglishFooter from '../../components/EnglishFooter.astro';
import { englishStories as stories, englishBikes as bikes } from '../../data/english';
import { englishBikeSlugs, englishStorySlugs } from '../../data/availableRoutes';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const homepageCopy: Record<string, [string, string]> = {
  'yvonne-reynders-kulcykel-og-verdensmesterskaber': ['When the coal had been delivered, training began', 'Yvonne Reynders combined work delivering coal with training and became a multiple world champion on road and track.'],
  'tourens-taxaregning-1926': ['When the Tour had to pay the taxi fare', 'Three riders disappeared from a car in Luchon, according to a story passed down from the race. The driver instead took his bill to the Tour officials.'],
};
const toCard = (story) => {
  const translated = englishStorySlugs.has(story.slug);
  const localCopy = homepageCopy[story.slug];
  return {
    ...story,
    title: localCopy?.[0] ?? story.title,
    text: localCopy?.[1] ?? story.text,
    imageUrl: typeof story.image === 'string' ? `${base}/${story.image}` : story.image.src,
    link: `${base}/${translated ? 'en/stories' : 'historier'}/${story.slug}/`,
    language: translated ? 'en' : 'da',
    action: translated ? 'Read the story' : 'Read in Danish',
  };
};

const storyCards = stories.map(toCard);
const leadStory = storyCards[0];
const latestStories = storyCards.slice(1, 4);
const startHereSlugs = [
  'snyd-soem-tour-de-france-1904',
  'peppino-drali-bianchi-ved-filebaenken',
  'soigneuren-og-maden-i-1970erne',
];
const startHere = startHereSlugs.map((slug) => storyCards.find((story) => story.slug === slug)).filter(Boolean);
const rotatingBikes = bikes.filter((bike) => !bike.status).map((bike) => {
  const translated = englishBikeSlugs.has(bike.slug);
  return {
    ...bike,
    link: `${base}/${translated ? 'en/bikes' : 'cykler'}/${bike.slug}/`,
    language: translated ? 'en' : 'da',
  };
});
const featuredBike = rotatingBikes[0] ?? bikes[0];

const themes = [
  ['Races and defining moments', 'Drama on the road, the track and at the finish line.', 'loeb-og-store-oejeblikke'],
  ['Riders of the period', 'Champions, domestiques and people the results almost forgot.', 'ryttere'],
  ['Bicycles and technical change', 'Gears, frames and solutions that changed the way people rode.', 'teknik'],
  ['Food, training and science', 'From steak and cognac to laboratories, sports drink and heart-rate monitors.', 'kost-traening-og-videnskab'],
  ['Cycling culture', 'Clubs, crowds, fashion and the bicycle in everyday life.', 'cykelkultur'],
  ['Society and its time', 'War, media, sponsors and the changes cycling carried with it.', 'samfund-og-tidsaand'],
  ['People behind the racing', 'Mechanics, soigneurs, organisers and others beyond the podium.', 'menneskene-bag'],
];

const periods = [
  ['Before 1900', 'The first races', '1800-1899'], ['1900', 'The pioneers', '1900-1920'],
  ['1920', 'Steel and dust', '1920-1930'], ['1930', 'Gears and popular spectacle', '1930-1939'],
  ['1940', 'War and restart', '1940-1949'], ['1950', 'Heroes and teams', '1950-1959'],
  ['1960', 'Speed and change', '1960-1969'], ['1970', 'Tradition in transition', '1970-1979'],
  ['1980', 'Data and aerodynamics', '1980-1989'], ['1990', 'New materials', '1990-1999'],
  ['2000', 'Carbon and crises', '2000-2009'], ['2010', 'The digital bicycle', '2010-2019'],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="A personal collection of historic racing bicycles and stories about riders, races, workshops and cycling's technical development." />
    <link rel="canonical" href="https://teob.dk/en/" />
    <link rel="alternate" hreflang="da" href="https://teob.dk/" />
    <link rel="alternate" hreflang="en" href="https://teob.dk/en/" />
    <link rel="alternate" hreflang="x-default" href="https://teob.dk/" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:site_name" content="The Evolution of Bikes" />
    <meta property="og:title" content="Cycling history follows many tracks | The Evolution of Bikes" />
    <meta property="og:description" content="Historic racing bicycles and stories about riders, races, workshops and the mechanical choices that changed the bicycle." />
    <meta property="og:url" content="https://teob.dk/en/" />
    <meta property="og:image" content="https://teob.dk/og.png" />
    <meta property="og:image:alt" content="The Evolution of Bikes – cycling stories and historic racing bicycles" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Cycling history follows many tracks | The Evolution of Bikes" />
    <meta name="twitter:description" content="Historic racing bicycles and stories about riders, races, workshops and the mechanical choices that changed the bicycle." />
    <meta name="twitter:image" content="https://teob.dk/og.png" />
    <title>Cycling history follows many tracks | The Evolution of Bikes</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Libre+Caslon+Display&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href={`${base}/styles/global.css`} />
  </head>
  <body class="editorial-home-draft">
    <EnglishHeader danishPath="/" />

    <main>
      <section class="draft-lead" aria-labelledby="draft-lead-title">
        <div class="draft-lead-intro">
          <p class="eyebrow">Come for the bicycles. Stay for the stories.</p>
          <h1 id="draft-lead-title">Cycling history<br /><em>follows many tracks.</em></h1>
          <p>Here a personal collection of historic racing bicycles meets the stories of the riders, races and workshops that shaped them. We follow the tracks from the first dusty roads to carbon, electronics and modern training.</p>
          <p>Move through history decade by decade, follow seven themes across time – or look closely at a bicycle and the small mechanical choices that changed it along the way.</p>
          <a href={`${base}/en/stories/`}>Explore all stories →</a>
        </div>
        <a class="draft-lead-story" href={leadStory.link} lang={leadStory.language}>
          <img src={leadStory.imageUrl} alt="" fetchpriority="high" />
          <span class="draft-lead-overlay" aria-hidden="true"></span>
          <span class="draft-lead-story-copy"><small>Today's main story · {leadStory.year}</small><strong>{leadStory.title}</strong><p>{leadStory.text}</p><i>{leadStory.action} →</i></span>
        </a>
      </section>

      <section class="draft-latest" aria-labelledby="draft-latest-title">
        <header><div><p class="section-label">New from the archive</p><h2 id="draft-latest-title">Three new stories</h2></div><p>New stories are published regularly. Here are three more paths into the archive.</p></header>
        <div class="draft-story-row">
          {latestStories.map((story, index) => (
            <a class="draft-story-card" href={story.link} lang={story.language}><span class="draft-card-index">0{index + 1}</span><img src={story.imageUrl} alt="" loading="lazy" /><small>{story.year}</small><h3>{story.title}</h3><p>{story.text}</p><i>{story.action} →</i></a>
          ))}
        </div>
      </section>

      <aside class="draft-manifesto" aria-label="About the collection">
        <span aria-hidden="true">“</span>
        <blockquote>The interesting thing is not only how old a bicycle is — but which roads it has travelled, where it comes from, and who has ridden it!</blockquote>
      </aside>

      <section class="draft-start" aria-labelledby="draft-start-title">
        <header><div><p class="section-label">New here?</p><h2 id="draft-start-title">Begin with three stories</h2></div><p>Three different sides of cycling history: the race, the person and the mechanical detail.</p></header>
        <div>
          {startHere.map((story) => (
            <a href={story.link} lang={story.language}><img src={story.imageUrl} alt="" loading="lazy" /><span><small>{story.year}</small><h3>{story.title}</h3><p>{story.text}</p><i>{story.action} →</i></span></a>
          ))}
        </div>
      </section>

      <section class="draft-periods" aria-labelledby="draft-periods-title">
        <header><div><p class="section-label">The long view</p><h2 id="draft-periods-title">Travel through time</h2></div><p>The periods bring together the races, bicycles and culture from which the stories grew.</p></header>
        <div>{periods.map(([year, label, slug]) => <a href={`${base}/en/periods/${slug}/`}><strong>{year}</strong><span>{label}</span></a>)}</div>
      </section>

      <section class="draft-themes" aria-labelledby="draft-themes-title">
        <header><div><p class="section-label">Follow a thread</p><h2 id="draft-themes-title">Seven themes through cycling history</h2></div><p>See the same question change from decade to decade – from food in the peloton to the technology beneath the rider.</p></header>
        <div class="draft-theme-grid">
          {themes.map(([title, text, key], index) => (
            <a href={`${base}/en/themes/${key}/`}><small>{String(index + 1).padStart(2, '0')}</small><h3>{title}</h3><p>{text}</p><i>Follow the theme →</i></a>
          ))}
        </div>
      </section>

      <section class="draft-bike">
        <div class="draft-bike-image"><img id="draft-rotating-bike-image" src={`${base}/${featuredBike.image}`} alt={featuredBike.title} loading="lazy" /></div>
        <div class="draft-bike-copy"><p class="section-label">From the collection</p><p id="draft-rotating-bike-meta" class="draft-bike-meta">{featuredBike.year} · {featuredBike.place}</p><h2 id="draft-rotating-bike-title">{featuredBike.title}</h2><p id="draft-rotating-bike-text">{featuredBike.text}</p><a id="draft-rotating-bike-link" href={featuredBike.link} lang={featuredBike.language}>View the bicycle and its story →</a><a class="draft-quiet-link" href={`${base}/en/bikes/`}>Browse the collection</a></div>
      </section>

      <section class="draft-return">
        <p class="section-label">There is always another track</p><h2>One story leads to the next.</h2><p>Return to the archive, choose a period – or begin with a bicycle from the collection.</p><div><a href={`${base}/en/stories/`}>All stories →</a><a href={`${base}/en/periods/`}>All periods →</a></div>
      </section>
    </main>

    <EnglishFooter />
    <script is:inline define:vars={{ rotatingBikes, base }}>
      const threeDays = 3 * 24 * 60 * 60 * 1000;
      const bike = rotatingBikes[Math.floor(Date.now() / threeDays) % rotatingBikes.length];
      const image = document.querySelector('#draft-rotating-bike-image');
      const meta = document.querySelector('#draft-rotating-bike-meta');
      const title = document.querySelector('#draft-rotating-bike-title');
      const text = document.querySelector('#draft-rotating-bike-text');
      const link = document.querySelector('#draft-rotating-bike-link');
      if (bike && image && meta && title && text && link) {
        image.src = `${base}/${bike.image}`;
        image.alt = bike.title;
        meta.textContent = `${bike.year} · ${bike.place}`;
        title.textContent = bike.title;
        text.textContent = bike.text;
        link.href = bike.link;
        link.lang = bike.language;
      }
    </script>
  </body>
</html>
