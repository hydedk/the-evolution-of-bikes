---
import EnglishHeader from '../../components/EnglishHeader.astro'; import EnglishFooter from '../../components/EnglishFooter.astro'; import { englishStories as stories, englishBikes as bikes } from '../../data/english'; import { englishBikeSlugs, englishStorySlugs } from '../../data/availableRoutes'; const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const items=stories.map(s=>{const en=englishStorySlugs.has(s.slug);return {...s,label:'Story from the archive',action:en?'Read the story':'Read in Danish',link:`${base}/${en?'en/stories':'historier'}/${s.slug}/`,image:typeof s.image==='string'?`${base}/${s.image}`:s.image.src,lang:en?'en':'da'}}); const fallback=items[0];
const latestStories=items.slice(0,3);
const featuredBike=bikes.find(b=>b.slug==='asmussen-super-prestige')??bikes[0];
const featuredBikeEnglish=englishBikeSlugs.has(featuredBike.slug);
const themes=[
  {label:'Odd moments from the races',text:'Wrong turns, strange rules and decisions that no finish photo could settle.',image:items.find(s=>s.slug==='paris-roubaix-1949-to-vindere')?.image,link:`${base}/en/stories/?theme=race`},
  {label:'People beyond the podium',text:'Riders, mechanics and helpers who kept the race moving.',image:items.find(s=>s.slug==='christine-lueber-tour-2015')?.image,link:`${base}/en/stories/?theme=people`},
  {label:'Mechanics with consequences',text:'Inventions, failures and workshop solutions that changed the way people rode.',image:items.find(s=>s.slug==='colnago-magni-pedalarm-1955')?.image,link:`${base}/en/stories/?theme=mechanics`},
];
const periods=[['1890','The pioneers','1900-1920'],['1920','New races','1920-1930'],['1930','Between the wars','1930-1939'],['1940','War and return','1940-1949'],['1950','Heroes and teams','1950-1959'],['1960','Speed and change','1960-1969'],['1970','Steel and great races','1970-1979'],['1980','Aerodynamics','1980-1989'],['1990','New materials','1990-1999'],['2000','Modern cycling','2000-2009'],['2010','New stories','2010-2019']];
const gateways=[['01','The stories','Stories','Odd moments, overlooked riders and mechanics that had consequences.','images/stories/aldo-bini/aldo-bini-archive.webp','stories'],['02','The physical archive','Bicycles','The bicycles in the collection, their former owners and the craft that preserved them.','images/bikes/wonder-saint-etienne/hero.webp','bikes'],['03','The long view','Periods','Explore the races, people, roads and cycling culture decade by decade.','images/periods/1900-1920/wild-west/track-racing.webp','periods']];
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content="A personal collection of vintage bicycles, cycling stories, marques and components."/><meta property="og:image" content="https://teob.dk/og.png"/><title>The Evolution of Bikes · Vintage bicycles and cycling stories</title><link rel="stylesheet" href={`${base}/styles/global.css`}/><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Libre+Caslon+Display&display=swap" rel="stylesheet"/></head><body><EnglishHeader danishPath="/"/><main><section class="hero home-hero"><div class="home-hero-copy"><p class="eyebrow">Vintage cycling told through bicycles, races and people</p><h1>Come for the bicycles.<br/><em>Stay for the stories.</em></h1><p class="hero-copy">A living archive of cycling culture — from hand-built steel frames and daring mechanics to the riders, helpers and moments that result lists leave out.</p><div class="home-hero-actions"><a class="button" href={fallback.link} data-random-hero-button>{fallback.action} <span>→</span></a><a class="home-hero-archive-link" href={`${base}/en/stories/`}>Browse all stories</a></div></div><a class="home-hero-feature" href={fallback.link} data-random-hero-card><img src={fallback.image} alt="" data-random-hero-image/><span class="home-hero-feature-shade"></span><span class="home-hero-feature-copy"><small data-random-hero-label>{fallback.label} · {fallback.year}</small><strong data-random-hero-title>{fallback.title}</strong><i data-random-hero-action>{fallback.action} <span>→</span></i></span></a></section>
<section class="home-gateways" aria-label="Three ways into the site"><header><p class="section-label">Three ways in</p><h2>Where would you like to begin?</h2></header><div>{gateways.map(([n,l,t,x,img,slug])=><a class="home-gateway" href={`${base}/en/${slug}/`}><img src={`${base}/${img}`} alt="" loading="lazy"/><span class="home-gateway-number">{n}</span><p>{l}</p><h3>{t}</h3><b>{x}</b><i>Explore →</i></a>)}</div></section>
<section class="home-latest" aria-labelledby="latest-title"><header><p class="section-label">New reading</p><h2 id="latest-title">The latest stories</h2><a href={`${base}/en/stories/`}>Browse all stories →</a></header><div class="home-card-grid">{latestStories.map(story=><a class="home-story-card" href={story.link} lang={story.lang}><span class="home-story-card-image"><img src={story.image} alt="" loading="lazy"/></span><small>{story.year}</small><h3>{story.title}</h3><p>{story.text}</p><i>{story.action} →</i></a>)}</div></section>
<section class="home-themes" aria-labelledby="themes-title"><header><p class="section-label">Three kinds of stories</p><h2 id="themes-title">Find your way into the stories</h2></header><div>{themes.map(theme=><a class="home-theme" href={theme.link}>{theme.image&&<img src={theme.image} alt="" loading="lazy"/>}<span><h3>{theme.label}</h3><p>{theme.text}</p><i>Browse the theme →</i></span></a>)}</div></section>
<section class="home-bike-feature"><div><img src={`${base}/${featuredBike.image}`} alt={featuredBike.title} loading="lazy"/></div><div><p class="section-label">A bicycle from the collection</p><p class="home-bike-year">{featuredBike.year} · {featuredBike.place}</p><h2>{featuredBike.title}</h2><p>{featuredBike.text}</p><a class="text-link" lang={featuredBikeEnglish?'en':'da'} href={`${base}/${featuredBikeEnglish?'en/bikes':'cykler'}/${featuredBike.slug}/`}>View the bicycle →</a><a class="quiet-link" href={`${base}/en/bikes/`}>Browse all bicycles</a></div></section>
<section class="home-timeline" aria-labelledby="timeline-title"><header><p class="section-label">Travel through time</p><h2 id="timeline-title">Cycling history decade by decade</h2><a href={`${base}/en/periods/`}>Browse all periods →</a></header><div class="home-timeline-track">{periods.map(([year,label,slug])=><a href={`${base}/en/periods/${slug}/`}><strong>{year}</strong><span>{label}</span></a>)}</div></section>
<section class="featured-bike" data-random-story><div class="featured-bike-image"><img src={fallback.image} alt={fallback.title} loading="lazy" data-random-story-image/></div><div class="featured-bike-copy"><p class="section-label">A random story from the archive</p><p class="featured-year" data-random-story-year>{fallback.year}</p><h2 data-random-story-title>{fallback.title}</h2><p data-random-story-text>{fallback.text}</p><a class="text-link" href={fallback.link} data-random-story-link>{fallback.action} →</a></div></section>
<section class="newsletter"><div class="newsletter-copy"><p class="section-label">News from the archive</p><h2>Cycling stories<br/><em>in your inbox</em></h2><p>An occasional newsletter with new stories, bicycles from the collection and other finds from the archive.</p></div><form class="newsletter-form" method="POST" action="https://d8a86a3c.sibforms.com/serve/MUIFADT4GimLPx-wUsPWGgzKniP3fmzWsIS3HGOXDetusA5iI6foT2aohA8UlGqsNu2d0333p3yeqd9dkDi9hinLAE1AcLHf8YkXVeVB78XyU2tMlBmS73zjH1jUSVzhKUE5i0x-T1W00SLk0Vy0qLacrlE2xGPCim7_RlC5-uBsXMIKTkT3ueUSUoVpnsCnLtj6eqhf6y2x8PHxvA==" target="newsletter-response"><label for="en-email">Your email address</label><div class="newsletter-field-row"><input id="en-email" name="EMAIL" type="email" required placeholder="name@example.com"/><button type="submit">Subscribe →</button></div><label class="newsletter-consent"><input type="checkbox" name="OPT_IN" value="1" required/><span>I agree to receive newsletters from The Evolution of Bikes and have read the <a href={`${base}/en/privacy/`}>privacy policy </a>.</span></label><p class="newsletter-note">You can unsubscribe at any time. Subscription is handled by Brevo.</p><input type="hidden" name="locale" value="en"/><input type="hidden" name="html_type" value="simple"/></form><iframe name="newsletter-response" title="Newsletter subscription response" hidden></iframe></section><section class="story"><p class="section-label">From the archive</p><blockquote>“The interesting thing is not only how old a bicycle is — but which roads it has travelled, where it comes from, and who has ridden it!”</blockquote></section></main><EnglishFooter/>
<script define:vars={{items}}>const choose=(key)=>{let previous=null;try{previous=localStorage.getItem(key)}catch{}const pool=items.filter(i=>i.slug!==previous),item=pool[Math.floor(Math.random()*pool.length)];try{localStorage.setItem(key,item.slug)}catch{}return item};const card=document.querySelector('[data-random-hero-card]'),button=document.querySelector('[data-random-hero-button]');if(card&&button&&items.length){const i=choose('eob-en-last-hero');card.href=i.link;button.href=i.link;card.lang=i.lang;button.lang=i.lang;button.firstChild.textContent=i.action+' ';card.querySelector('[data-random-hero-image]').src=i.image;card.querySelector('[data-random-hero-label]').textContent=i.label+' · '+i.year;card.querySelector('[data-random-hero-title]').textContent=i.title;card.querySelector('[data-random-hero-action]').firstChild.textContent=i.action+' '}const section=document.querySelector('[data-random-story]');if(section&&items.length){const i=choose('eob-en-last-random');section.querySelector('[data-random-story-image]').src=i.image;section.querySelector('[data-random-story-image]').alt=i.title;section.querySelector('[data-random-story-year]').textContent=i.year;section.querySelector('[data-random-story-title]').textContent=i.title;section.querySelector('[data-random-story-text]').textContent=i.text;section.querySelector('[data-random-story-link]').href=i.link;section.querySelector('[data-random-story-link]').textContent=i.action+' →'}</script></body></html>
