import EnglishHeader from '../../../components/EnglishHeader.astro'; import EnglishFooter from '../../../components/EnglishFooter.astro'; import { englishStories } from '../../../data/english'; const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const relatedStories=englishStories.filter(s=>s.periods.includes('1900-1920')); const facts=[['1903','The first Tour de France'],['1910','The Tourmalet enters the race'],['1919','The first yellow leader’s jersey'],['5,560 km','Tour de France 1919'],['482 km','Longest stage in 1919'],['18:54:07','Jean Alavoine’s winning time']];
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content="1900 to the 1920s: pioneers, endurance and the Tour de France during cycle racing’s hard youth."/><meta property="og:image" content="https://teob.dk/images/periods/1900-1920/rytter-velodrom.webp"/><title>1900 to the 1920s · Pioneers and endurance · The Evolution of Bikes</title><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Libre+Caslon+Display&display=swap" rel="stylesheet"/><link rel="stylesheet" href={`${base}/styles/global.css`}/></head><body><EnglishHeader current="periods" danishPath="/perioder/1900-1920/"/><main><article class="era-page">
<header class="era-hero"><div class="era-heading"><p class="section-label">1900 to the 1920s</p><h1>Pioneers and<br/><em>endurance</em></h1></div><p class="era-deck">A time when the bicycle was simple, the roads unforgiving, and riders had to bring both body and machine all the way home themselves.</p></header>
<figure class="era-main-image"><img src={`${base}/images/periods/1900-1920/rytter-velodrom.webp`} alt="Exhausted Tour de France rider standing beside his bicycle on a velodrome"/><figcaption>A rider after the ordeal — dust, spare parts and tyres were carried on the body. Archive photograph from the Tour de France of the period.</figcaption></figure>
<section class="era-opening"><p class="section-label">Tour de France</p><p>The Tour de France of this period was a brutal test of both people and machines. Riders often started before dawn and continued through darkness, cold, dust and rain on roads that in many places consisted of gravel or cobbles.</p></section>
<section class="period-feature"><div><p class="section-label">Related stories</p><h2>When cycle racing was a Wild West on two wheels</h2><p>Before rules, support cars and team radios, cycle racing was a travelling experiment in speed, endurance and ingenuity. From here, you can continue to the period’s individual stories.</p></div><div class="period-feature-links">{relatedStories.map(s=><a href={`${base}/en/stories/${s.slug}/`}><span>Related story · {s.year}</span><strong>{s.title}</strong><b>Read the story →</b></a>)}</div></section>
<section class="era-facts" aria-label="Facts about the period">{facts.map(([n,l])=><div><strong>{n}</strong><span>{l}</span></div>)}</section>
<section class="era-story"><div class="era-copy"><p class="section-label">The race returns</p><h2>5,560 kilometres through a country marked by war</h2><p>The 1919 Tour was the first after the First World War. It ran from 29 June to 27 July over 15 stages and a total of 5,560 kilometres. The field consisted largely of former soldiers, and the race passed through a France that still bore clear traces of the war.</p><p>The longest stage ran from Les Sables-d’Olonne to Bayonne: 482 kilometres in one day. Jean Alavoine won after 18 hours, 54 minutes and 7 seconds in the saddle — a distance and riding time that seem almost inconceivable today.</p></div><figure class="map-figure"><img src={`${base}/images/periods/1900-1920/tour-1920-kort.webp`} alt="Historical map of the 15 stages of the 1920 Tour de France" loading="lazy"/><figcaption>Map of the 15 stages of the 1920 Tour de France. It gives a total distance of 5,519 kilometres.</figcaption></figure></section>
<section class="yellow-jersey"><p class="section-label">A new colour makes history</p><blockquote>The yellow jersey was born in 1919.</blockquote><p>Eugène Christophe became the first rider to wear the yellow leader’s jersey. He received it in the morning before the stage from Grenoble to Geneva. The colour made the race leader visible to the public — and later became the Tour de France’s strongest symbol.</p></section>
<section class="era-gallery"><figure class="gallery-tall"><img src={`${base}/images/periods/1900-1920/rytter-ved-maal.webp`} alt="Exhausted and battered cyclist being helped at the finish" loading="lazy"/><figcaption>The finish could look more like a rescue operation than a sporting triumph.</figcaption></figure><figure><img src={`${base}/images/periods/1900-1920/tourmalet.webp`} alt="Albert Dejonghe riding on a gravel road at the Tourmalet" loading="lazy"/><figcaption>Archive photograph identified as Albert Dejonghe on the Tourmalet.</figcaption></figure><figure><img src={`${base}/images/periods/1900-1920/ryttere-hviler.webp`} alt="Henri Colle and Charles Parel resting with their bicycles" loading="lazy"/><figcaption>Archive photograph identified as Henri Colle and Charles Parel during a rest.</figcaption></figure></section>
<section class="mechanics-section"><div><p class="section-label">Rider and mechanic</p><h2>No support car.<br/>No quick assistance.</h2></div><div class="mechanics-copy"><p>Riders had to deal with punctures and mechanical failures themselves. The rules of the time required them to finish on the same bicycle and carry out repairs without assistance. Spare parts, tools and extra tyres therefore had to be carried on the bicycle or over the shoulders.</p><p>Changing gear was equally physical. Many bicycles had a reversible rear wheel with one sprocket on each side. Before a climb, the rider had to stop, loosen the rear wheel, turn it around, tighten the chain and continue in the lower gear.</p><p>The bicycle of the period was thus a sporting tool that also demonstrated ingenuity, workmanship and almost inconceivable endurance.</p></div></section>
<figure class="era-wide-photo"><img src={`${base}/images/periods/1900-1920/jean-rossius-1920.webp`} alt="Jean Rossius and a helper beside a racing bicycle during the 1920 Tour de France" loading="lazy"/><figcaption>Archive photograph identified as Jean Rossius at the 1920 Tour de France. The bicycle shows its sparse equipment and carried supplies.</figcaption></figure>
<section class="thys-section"><p class="section-label">1920</p><div><h2>Philippe Thys makes history</h2><p>Belgian Philippe Thys won the Tour de France in 1920. After victories in 1913 and 1914, he became its first three-time winner. His result connects the pioneers before the war with the new generation that resumed cycle racing after 1918.</p><a class="text-link" href={`${base}/cykler/cycles-france-sport/`} lang="da">View the collection’s bicycle from the period (in Danish) <span aria-hidden="true">→</span></a></div></section>
<section class="period-sources"><p class="section-label">Sources and image notes</p><div><p>Historical data has been checked against the Tour de France’s historical material and contemporary race results. The images come from the collection’s archive; where identity cannot be documented directly, the caption reflects the archive’s identification.</p><ul><li><a href="https://www.letour.fr/en/news/2019/life-in-yellow/1275993">Tour de France: Life in Yellow</a></li><li><a href="https://netstorage.lequipe.fr/ASO/cycling_tdf/guide-historique-v3.pdf">Tour de France: historical guide</a></li><li><a href="https://www.cyclingranking.com/races/1919/tour-de-france/stages/stage-5">Result, stage 5 in 1919</a></li></ul></div></section>
<nav class="era-bottom-nav" aria-label="Further navigation"><a href={`${base}/en/`}>← Back to the home page</a><a href={`${base}/cykler/cycles-france-sport/`} lang="da">Next: Cycles France-Sport (in Danish) →</a></nav></article></main><EnglishFooter/></body></html>
