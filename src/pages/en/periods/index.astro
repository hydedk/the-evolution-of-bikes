---
import EnglishHeader from '../../../components/EnglishHeader.astro';
import EnglishFooter from '../../../components/EnglishFooter.astro';
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const definitions = [
  ['1900–1920s','Pioneers and endurance','The Tour de France begins, the yellow jersey gets its colour, and riders struggle with roads, darkness and mechanics.','1900-1920','rytter-velodrom.webp'],
  ['1920–1929','Cycle racing’s hard golden age','Enormous Tour stages, primitive mountain roads, reversible rear wheels and riders acting as their own mechanics.','1920-1930','mountain-stop.webp'],
  ['1930–1939','When the racing bicycle became modern','National teams, the publicity caravan, the first Vuelta and gear changes without reversing the rear wheel.','1930-1939','romain-maes-cannes-1935.jpg'],
  ['1940–1949','When war closed the roads','The grand tours disappeared and returned to a Europe marked by war, reconstruction and new mechanical solutions.','1940-1949','efterkrigsfelt-illustration.jpg'],
  ['1950–1959','When cycle racing entered the living room','Modern derailleurs, new mountain stages, radio and television made the sport faster, more international and more visible.','1950-1959','felt-og-filmhold-illustration.jpg'],
  ['1960–1969','When the racing bicycle found its modern form','Anquetil against Poulidor, Fredborg on the track, lighter steel bicycles and the difficult beginnings of doping control.','1960-1969','anquetil-poulidor-paris-1964.webp'],
  ['1970–1979','Between the Cannibal and the Badger','Steel frames, friction shifting and a professional peloton moving from Merckx’s dominance towards Hinault’s new order.','1970-1979','felt-illustration.jpg'],
  ['1980–1989','When the bicycle became a laboratory','Steel frames, clipless pedals, indexed gears and radical time-trial bicycles met in a decade of closer measurement.','1980-1989','teknisk-brydningstid-illustration.webp'],
  ['1990–1999','When shifting moved to the handlebars','Indurain, Pantani and Riis, integrated shifters, new frame materials and the Festina affair in 1998.','1990-1999','galibier-1993.jpg'],
  ['2000–2009','When cycling became a control room','Specialisation, carbon, power measurement and electronic gears met cancelled victories, raids and fading trust.','2000-2009','allos-2000.webp'],
  ['2010–2019','When the computer took over the bicycle','Team Sky, marginal gains, carbon and electronic gears shaped a decade in which even a planned Tour could still end on foot.','2010-2019','wiggins-2012.webp'],
];
const periodCards = definitions.map(([years,title,text,id,image]) => ({ years,title,text,id,image:`${base}/images/periods/${id}/${image}` }));
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content="Cycle racing and cycling culture told period by period, with links to the stories from each era."/><title>Periods · The Evolution of Bikes</title><link rel="stylesheet" href={`${base}/styles/global.css`}/></head><body><EnglishHeader current="periods" danishPath="/perioder/"/><main>
<header class="archive-hero periods-archive-hero"><p class="section-label">The larger, connected history</p><h1>Periods</h1><p>Each chapter gives a chronological view of racing, roads, rules, mechanics and culture.</p></header>
<section class="periods-archive">{periodCards.map((period) => <article class="period-overview"><a class="period-overview-main" href={`${base}/en/periods/${period.id}/`}><img src={period.image} alt={`Illustration from ${period.years}`}/><div><span>{period.years}</span><h2>{period.title}</h2><p>{period.text}</p><b>Read the period →</b></div></a></article>)}</section>
<section class="period-search-intro"><p class="section-label">Follow a subject through time</p><h2>Explore the seven themes</h2><p>The theme pages connect the periods without turning this chronological overview into another large archive.</p><a href={`${base}/en/themes/`}>Go to themes and search →</a></section>
</main><EnglishFooter/></body></html>
