---
import EnglishHeader from '../../components/EnglishHeader.astro';
import EnglishFooter from '../../components/EnglishFooter.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const submissionUrl = import.meta.env.PUBLIC_STORY_SUBMISSION_URL ?? 'https://fmxiyfhncvhnwzwipnxu.supabase.co/functions/v1/submit-reader-story';
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content="Submit your own story about a bicycle, rider, workshop or a memorable experience."/><title>Share your story · The Evolution of Bikes</title><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Libre+Caslon+Display&display=swap" rel="stylesheet"/><link rel="stylesheet" href={`${base}/styles/global.css`}/></head>
<body><EnglishHeader danishPath="/fortael-din-historie/"/><main><article class="reader-story-page"><header class="reader-story-hero"><p class="section-label">Our readers' stories</p><h1>Share your<br/><em>story</em></h1><p>Do you have a story about a bicycle, a rider, a workshop or an experience on the road? Send us what you know. It may be a finished story or simply a set of notes.</p></header><div class="reader-story-layout">
<form class="reader-story-form" aria-describedby="form-status" data-submission-url={submissionUrl}><label class="form-honeypot" aria-hidden="true">Website<input name="website" tabindex="-1" autocomplete="off"/></label>
<fieldset><legend>The story</legend><label>Title <span>required</span><input name="title" required maxlength="140" autocomplete="off"/></label><div class="form-pair"><label>Where did it take place? <span>required</span><input name="place" required maxlength="160"/></label><label>Year or period <small>optional</small><input name="period" maxlength="80" placeholder="For example, around 1978"/></label></div><label>Your story or notes <span>required</span><textarea name="story" required minlength="20" rows="12" placeholder="Write down everything you remember. We will help research, structure and write the story."></textarea></label></fieldset>
<fieldset><legend>About you</legend><div class="form-pair"><label>Name <span>required</span><input name="name" required autocomplete="name"/></label><label>Email <span>required</span><input name="email" type="email" required autocomplete="email"/></label></div><label>How may we use your name? <select name="credit" required><option value="">Select</option><option value="name">My name may appear with the story</option><option value="anonymous">I would like to remain anonymous</option><option value="ask">Please agree it with me first</option></select></label></fieldset>
<fieldset><legend>Images</legend><p class="field-help">You may select up to 8 JPG, PNG or WebP images, with a maximum of 10 MB per image.</p><label class="file-field">Choose images<input id="story-images" name="images" type="file" accept="image/jpeg,image/png,image/webp" multiple/></label><p id="file-summary" class="file-summary" aria-live="polite">No images selected.</p><label>Information about the images <small>optional</small><textarea name="image_notes" rows="4" placeholder="Who or what is shown? When was the photograph taken, and who took it?"></textarea></label></fieldset>
<fieldset class="consents"><legend>Permission and privacy</legend><label><input name="rights_confirmed" value="yes" type="checkbox" required/> I own the rights to the material or have permission to share it.</label><label><input name="editorial_consent" value="yes" type="checkbox" required/> The Evolution of Bikes may research, edit and possibly publish the material. A submission does not guarantee publication.</label><label><input name="privacy_consent" value="yes" type="checkbox" required/> I accept that my name, email, text and images will be processed as described in the privacy information. The email address is never published.</label></fieldset>
<p class="form-privacy-link"><span>How we protect your information</span><a href={`${base}/en/privacy/`}>Read about privacy and your rights <span aria-hidden="true">→</span></a></p><div id="form-status" class="form-notice" aria-live="polite">{submissionUrl ? <><strong>Ready to submit.</strong> The material is stored privately and reviewed before any publication.</> : <><strong>The form is being prepared.</strong> Submission will open when private, secure storage has been connected and tested.</>}</div><button type="submit" disabled={!submissionUrl}>Send the story</button></form>
<aside class="reader-story-aside"><p class="section-label">What happens next?</p><ol><li><strong>We read the material</strong><span>The submission is not displayed publicly.</span></li><li><strong>We research the story</strong><span>Names, dates and technical details are checked.</span></li><li><strong>We write a draft</strong><span>Memories and uncertain information are clearly identified.</span></li><li><strong>The owner approves it</strong><span>The story is published only after separate approval.</span></li></ol><p>We may contact you if we need more information about the story or the images.</p></aside></div></article></main><EnglishFooter/>
<script>
const input=document.querySelector('#story-images');const summary=document.querySelector('#file-summary');const form=document.querySelector('.reader-story-form');const status=document.querySelector('#form-status');
input?.addEventListener('change',()=>{const files=Array.from(input.files??[]);const invalid=files.filter(file=>file.size>10*1024*1024);if(files.length>8||invalid.length){input.value='';summary.textContent=files.length>8?'Select no more than 8 images.':'At least one image is larger than 10 MB.';return;}summary.textContent=files.length?`${files.length} ${files.length===1?'image selected':'images selected'}.`:'No images selected.';});
form?.addEventListener('submit',async(event)=>{event.preventDefault();const endpoint=form.dataset.submissionUrl;const button=form.querySelector('button[type="submit"]');if(!endpoint||!(button instanceof HTMLButtonElement)||!(status instanceof HTMLElement))return;button.disabled=true;status.innerHTML='<strong>Sending the story…</strong> Please wait while the text and images are transferred securely.';try{const response=await fetch(endpoint,{method:'POST',body:new FormData(form)});const result=await response.json().catch(()=>({}));if(!response.ok)throw new Error(result.error||'The submission failed.');form.reset();if(summary)summary.textContent='No images selected.';status.innerHTML=`<strong>Thank you for your story.</strong> It has been received with reference ${result.id}. We will contact you if further information is needed.`;}catch(error){status.innerHTML=`<strong>The story was not sent.</strong> ${error instanceof Error?error.message:'Please try again later.'}`;button.disabled=false;}});
</script></body></html>
