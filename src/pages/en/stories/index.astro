---
import EnglishHeader from '../../../components/EnglishHeader.astro'; import EnglishFooter from '../../../components/EnglishFooter.astro'; import { englishStories as stories } from '../../../data/english';
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const translated = new Set(['cykelsportens-vilde-vesten', 'snyd-soem-tour-de-france-1904', 'alfonsina-strada-giro-1924', 'campagnolo-quick-release', 'alfredo-binda-giro-1930', 'da-gearene-kom-og-oel-narrede-feltet', 'soevnloeshed-smoer-og-kolde-oel', 'aldo-bini-maglia-nera-1948', 'da-michelin-navnet-blev-et-problem', 'wim-van-est-aubisque-1951', 'coppi-stelvio-1953', 'ivo-faltoni-mekaniker-giro-1954', 'den-hvide-oedemark-og-hoensefarmerens-toerst', 'anquetil-poulidor-puy-de-dome-1964']);
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content="Stories and anecdotes from cycle racing and the collection behind The Evolution of Bikes."/><title>Stories and anecdotes · The Evolution of Bikes</title><link rel="stylesheet" href={`${base}/styles/global.css`}/><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Libre+Caslon+Display&display=swap" rel="stylesheet"/></head><body>
<EnglishHeader current="stories" danishPath="/historier/"/><main><header class="archive-hero"><p class="section-label">One event. One person. One story.</p><h1>Stories and<br/><em>anecdotes</em></h1><p>Stories that can be read on their own while still belonging to the wider chapters of cycling history.</p></header><section class="story-archive">{stories.map(s=>{const isEnglish=translated.has(s.slug);return <a href={`${base}/${isEnglish?'en/stories':'historier'}/${s.slug}/`} lang={isEnglish?'en':'da'}><img src={`${base}/${s.image}`} alt=""/><div><span>{s.year}</span>{s.topics.includes('læserhistorie')&&<strong class="reader-story-badge">Our readers’ own stories</strong>}<h2>{s.title}</h2><p>{s.text}</p><b>{isEnglish?'Read the story →':'Read in Danish →'}</b></div></a>})}</section></main><EnglishFooter/></body></html>
