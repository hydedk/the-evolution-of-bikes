<EnglishHeader current="stories" danishPath={`/historier/${slug}/`}/><main><article class="track-page"><header class="track-hero"><p class="section-label">Odd moments from the races · Tour de France · 1978</p><h1>{title}</h1><p>{description}</p></header><figure class="hero-image"><OptimizedImage src={pollentierImage} alt="Michel Pollentier during the 1976 Tour de France wearing a white cycling jersey and cap" loading="eager" fetchpriority="high"/><figcaption>Michel Pollentier during the 1976 Tour de France, two years before the incident on Alpe d’Huez. Photograph: René Milanese via Wikimedia Commons, CC BY-SA 3.0.</figcaption></figure><div class="story-copy"><p class="lead">{description}</p>{sections.map(([heading,text])=><section><h2>{heading}</h2><p>{text}</p></section>)}</div><section class="period-sources"><p class="section-label">Sources</p><div><ul>{sources.map(([label,url])=><li><a href={url}>{label}</a></li>)}</ul></div></section><nav class="era-bottom-nav" aria-label="Further navigation"><a href={`${base}/en/stories/`}>← All stories</a><a href={`${base}/en/periods/1970-1979/`}>The 1970–1979 period →</a></nav></article></main><EnglishFooter/></body></html>
