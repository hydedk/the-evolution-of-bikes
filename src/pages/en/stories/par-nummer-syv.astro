const description = 'From Kay Werner Nielsen and Evan Klamer to Michael Mørkøv and Alex Rasmussen: how one race number became Denmark’s own pair in the six-day races.';
const ogImage = new URL(finish1954.src, canonical).href;
const schema = {'@context':'https://schema.org','@type':'Article',headline:title,description,inLanguage:'en',mainEntityOfPage:canonical,image:ogImage,datePublished:'2026-10-05',publisher:{'@type':'Organization',name:'The Evolution of Bikes',url:'https://teob.dk/'}};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
