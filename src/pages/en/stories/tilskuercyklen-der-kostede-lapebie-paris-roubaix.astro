---
import EnglishHeader from '../../../components/EnglishHeader.astro';
import EnglishFooter from '../../../components/EnglishFooter.astro';
import OptimizedImage from '../../../components/OptimizedImage.astro';
import RelatedDiscovery from '../../../components/RelatedDiscovery.astro';
import lapebieImage from '../../../assets/stories/lapebie-paris-roubaix-1934/roger-lapebie-cykelkontrol-1934-bnf.jpg';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const slug = 'tilskuercyklen-der-kostede-lapebie-paris-roubaix';
const canonical = `https://teob.dk/en/stories/${slug}/`;
const danish = `https://teob.dk/historier/${slug}/`;
const title = "The spectator's bicycle that cost Lapébie Paris–Roubaix";
const description = "Roger Lapébie punctured near the finish, borrowed a spectator's bicycle and crossed the line first. The rules awarded victory to Gaston Rebry.";
const image = `https://teob.dk${lapebieImage.src}`;
const sections = [
  ['Fifteen kilometres from Roubaix','On 1 April 1934, Roger Lapébie was approaching the finish of Paris–Roubaix when he punctured roughly fifteen kilometres from the line. Today a mechanic would offer a wheel. In 1934 the help was less straightforward, and the rules did not allow a rider simply to change to any bicycle he could find.'],
  ['A bicycle from the roadside',"Lapébie found a way forward. He took a spectator's bicycle and continued towards Roubaix. A later French account says the bicycle had been lying in a ditch. It is a vivid detail, but one preserved in a later retelling. What is certain is that the bicycle belonged to a spectator and that the change was forbidden."],
  ['First across the line',"The unfamiliar bicycle was good enough to carry Lapébie back into the race. Sources differ over whether he arrived alone or settled the result against Gaston Rebry. They agree on the important point: Lapébie crossed the finish line first."],
  ['The rule held',"The result did not stand. Lapébie was reported for the illegal bicycle change and disqualified. His legs had not failed him; the problem was the solution he chose after the puncture. Paris–Roubaix was already a race in which mechanics and rules could matter as much as speed."],
  ['Rebry received the victory',"Gaston Rebry was declared the winner. The Belgian had already won the race in 1931 and would win it again in 1935. The 1934 victory officially belongs to him, although the first rider into the velodrome that day was Lapébie."],
  ['The lost victory',"Lapébie later won the Tour de France in 1937. At Paris–Roubaix in 1934, however, he became the man who arrived first without receiving the victory. A puncture, a borrowed bicycle and a rule produced a result that the finish line alone could not decide."],
];
const sources = [
  ['L’Équipe: Gaston Rebry and Paris–Roubaix 1934','https://www.lequipe.fr/Cyclisme-sur-route/Actualites/Gaston-rebry-le-bouledogue-1931-1934-et-1935/1666237'],
  ["Le Monde, 19 April 1949: retrospective on Lapébie's disqualification",'https://www.lemonde.fr/archives/article/1949/04/19/paris-roubaix-se-termine-dans-la-confusion-par-la-victoire-du-faux-coppi_1933808_1819218.html'],
  ['Le Monde, 14 April 1970: the puncture and spectator bicycle','https://www.lemonde.fr/archives/article/1970/04/14/l-apprenti-coureur-et-le-champion_2648596_1819218.html'],
  ['Paris–Roubaix: official history','https://www.paris-roubaix.fr/en/history'],
  ['DirectVelo: wheel changes and the rules of Paris–Roubaix','https://www.directvelo.com/actualite/81502/directvelo'],
  ['Wikimedia Commons/BnF: Roger Lapébie at bicycle inspection, 31 March 1934','https://commons.wikimedia.org/wiki/File:31-3-34,_poin%C3%A7onnage_(des_v%C3%A9los)_de_Paris-Roubaix_(dans_la_cour_du_journal_L%27Auto,_10_rue_du_Faubourg-Montmartre),_Lap%C3%A9bie_-_btv1b53297658w.jpg'],
];
const schema = {'@context':'https://schema.org','@type':'Article',headline:title,description,inLanguage:'en',image,datePublished:'1934-04-01',mainEntityOfPage:canonical,publisher:{'@type':'Organization',name:'The Evolution of Bikes',url:'https://teob.dk/'}};
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><title>{title} · The Evolution of Bikes</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><link rel="alternate" hreflang="da" href={danish}/><link rel="alternate" hreflang="en" href={canonical}/><link rel="alternate" hreflang="x-default" href={danish}/><meta property="og:type" content="article"/><meta property="og:locale" content="en_GB"/><meta property="og:site_name" content="The Evolution of Bikes"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={image}/><meta property="og:image:alt" content="Roger Lapébie with his bicycle at inspection before Paris–Roubaix 1934"/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/><meta name="twitter:description" content={description}/><meta name="twitter:image" content={image}/><script type="application/ld+json" set:html={JSON.stringify(schema)}/><link rel="preconnect" href="https://fonts.googleapis.com"/><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Libre+Caslon+Display&display=swap" rel="stylesheet"/><link rel="stylesheet" href={`${base}/styles/global.css`}/></head><body>
<EnglishHeader current="stories" danishPath={`/historier/${slug}/`}/><main><article class="track-page"><header class="track-hero"><p class="section-label">Paris–Roubaix · 1934</p><h1>{title}</h1><p>{description}</p></header><figure class="hero-image"><OptimizedImage src={lapebieImage} alt="Roger Lapébie stands with his bicycle among riders and spectators at inspection before Paris–Roubaix 1934" loading="eager" fetchpriority="high"/><figcaption>Roger Lapébie at bicycle inspection in the courtyard of <em>L’Auto</em>, 31 March 1934. Photograph: Agence Rol / Bibliothèque nationale de France, public domain.</figcaption></figure><div class="story-copy"><p class="lead">{description}</p>{sections.map(([heading,text])=><section><h2>{heading}</h2><p>{text}</p></section>)}</div><section class="period-sources"><p class="section-label">Sources</p><div><ul>{sources.map(([label,url])=><li><a href={url} target="_blank" rel="noopener noreferrer">{label}</a></li>)}</ul></div></section><RelatedDiscovery currentSlug={slug} language="en"/><nav class="era-bottom-nav" aria-label="Further navigation"><a href={`${base}/en/stories/`}>← All stories</a><a href={`${base}/en/periods/1930-1939/`}>The 1930–1939 period →</a></nav></article></main><EnglishFooter/></body></html>
