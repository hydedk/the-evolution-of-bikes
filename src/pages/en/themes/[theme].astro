---
import EnglishHeader from '../../../components/EnglishHeader.astro'; import EnglishFooter from '../../../components/EnglishFooter.astro';
import ContentExplorer from '../../../components/ContentExplorer.astro';
import { themes, themeIds, contentForTheme, localizeContent, type ThemeId } from '../../../data/taxonomy';
export function getStaticPaths() { return themeIds.map((theme) => ({ params: { theme }, props: { theme } })); }
const { theme } = Astro.props as { theme: ThemeId }; const data=themes[theme]; const base=import.meta.env.BASE_URL.replace(/\/$/,'');
const canonical=`https://teob.dk/en/themes/${theme}/`; const danish=`https://teob.dk/tema/${theme}/`; const items=localizeContent(contentForTheme(theme),'en');
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content={`${data.enIntro} Follow the theme across periods, stories, bicycles and components.`}/><link rel="canonical" href={canonical}/><link rel="alternate" hreflang="da" href={danish}/><link rel="alternate" hreflang="en" href={canonical}/><link rel="alternate" hreflang="x-default" href={danish}/><meta property="og:type" content="website"/><meta property="og:locale" content="en_GB"/><meta property="og:site_name" content="The Evolution of Bikes"/><meta property="og:title" content={`${data.en} · Theme`}/><meta property="og:description" content={data.enIntro}/><meta property="og:url" content={canonical}/><meta property="og:image" content="https://teob.dk/images/periods/1990-1999/galibier-1993.jpg"/><meta property="og:image:alt" content="Riders on the Col du Galibier during the 1993 Tour de France"/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={`${data.en} · Theme`}/><meta name="twitter:description" content={data.enIntro}/><meta name="twitter:image" content="https://teob.dk/images/periods/1990-1999/galibier-1993.jpg"/><title>{data.en} · Theme · The Evolution of Bikes</title><link rel="stylesheet" href={`${base}/styles/global.css`}/></head><body><EnglishHeader danishPath={`/tema/${theme}/`}/><main><header class="archive-hero theme-hero"><p class="section-label">A theme across cycling history</p><h1>{data.en}</h1><p>{data.enIntro}</p><a href={`${base}/en/themes/`}>See all seven themes →</a></header><ContentExplorer items={items} language="en" initialTheme={theme}/></main><EnglishFooter/></body></html>
