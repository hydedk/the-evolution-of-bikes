---
import EnglishHeader from '../../../components/EnglishHeader.astro';
import EnglishFooter from '../../../components/EnglishFooter.astro';
import ContentExplorer from '../../../components/ContentExplorer.astro';
import { contentItems, localizeContent, themes, themeIds } from '../../../data/taxonomy';
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
---
<!doctype html><html lang="en"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content="Seven themes connect stories, periods, bicycles and components across cycling history."/><link rel="canonical" href="https://teob.dk/en/themes/"/><link rel="alternate" hreflang="da" href="https://teob.dk/tema/"/><link rel="alternate" hreflang="en" href="https://teob.dk/en/themes/"/><link rel="alternate" hreflang="x-default" href="https://teob.dk/tema/"/><title>Themes · The Evolution of Bikes</title><link rel="stylesheet" href={`${base}/styles/global.css`}/></head><body><EnglishHeader danishPath="/tema/"/><main><header class="archive-hero theme-hero"><p class="section-label">Across the periods</p><h1>Seven themes</h1><p>Articles keep their permanent addresses. The themes gather the connections and show their development in chronological order.</p></header><section class="theme-index">{themeIds.map((id,index)=>{const theme=themes[id];return <a href={`${base}/en/themes/${id}/`}><span>0{index+1}</span><h2>{theme.en}</h2><p>{theme.enIntro}</p><b>Follow the theme →</b></a>})}</section><section class="theme-search-intro"><p class="section-label">Search across the archive</p><h2>Find stories, bicycles and components</h2><p>Choose a theme, period and content type, or search for a person, race or technical detail.</p></section><ContentExplorer items={localizeContent(contentItems, 'en')} language="en" /></main><EnglishFooter/></body></html>
