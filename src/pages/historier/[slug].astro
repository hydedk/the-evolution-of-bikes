const stories = {
  'stifinderen-der-sendte-touren-over-tourmalet': {
    year: '1910', label: 'Menneskene bag · Tour de France', title: 'Stifinderen, der sendte Touren over Tourmalet',
    intro: 'Alphonse Steines kom ned fra et snedækket bjergpas med en historie, der var mere optimistisk end hans nat i Pyrenæerne. Et kort telegram var med til at ændre Tour de France.',
    image: steinesImage, alt: 'Kort over ruten i Tour de France 1910 med etaperne gennem Pyrenæerne',
    caption: 'Ruten i Tour de France 1910 førte for første gang feltet over de store pas i Pyrenæerne. Kort: Wikimedia Commons, public domain.',
    sections: [
      ['En vej, ingen kendte som løbsvej', 'Tour de France havde allerede sendt rytterne ud på lange og brutale etaper, men i 1910 ville arrangørerne længere. Alphonse Steines, som arbejdede tæt sammen med løbsdirektør Henri Desgrange, foreslog at føre løbet over Col du Tourmalet. For Desgrange lød planen tæt på vanvid: passet var en bjergvej, ikke en oplagt scene for et cykelløb.'],
      ['Undersøgelsen i sneen', 'Steines rejste selv til Pyrenæerne for at prøve ruten. De dramatiske detaljer er senere blevet fortalt i flere versioner, men kernen er sikker: turen blev langt vanskeligere end en almindelig besigtigelse. Sne og mørke gjorde passagen farlig, og lokale folk hjalp med at få ham ned. Alligevel sendte han næste morgen en kort besked til Desgrange: Tourmalet var passeret, vejen var udmærket og fuldt farbar.'],
      ['Telegrammet som arbejdsredskab', 'Ordene var ikke en nøgtern tilstandsrapport. De var et argument. Steines vidste, at Desgrange skulle overbevises, hvis bjergene skulle ind i løbet. Den officielle Tour-historie gengiver telegrammet som øjeblikket, hvor usikkerheden blev omsat til en beslutning. Det gør ikke alle senere detaljer lige sikre, men det viser Steines som andet end en hjælper: han var stifinder, producent og risikovillig redaktør på samme tid.'],
      ['Da feltet kom året efter', 'På etapen fra Luchon til Bayonne den 21. juli 1910 ventede Peyresourde, Aspin, Tourmalet og Aubisque. Octave Lapize vandt både etapen og senere Touren. Hans berømte udbrud mod arrangørerne — ofte gengivet som “I er mordere” — findes i varierende senere versioner og knyttes både til Tourmalet og Aubisque. Det sikre er, at etapen gjorde bjergene til løbets store prøve.'],
      ['En ny målestok', 'Tourmalet blev ikke bare endnu en vej på kortet. Passet ændrede forestillingen om, hvad Tour de France kunne kræve af ryttere og maskiner. Bag forandringen stod ikke kun manden, der vandt, men også manden, der først gik ud i sneen og bagefter valgte de ord, der fik løbet til at følge efter.']
    ],
    sources: [['Tour de France: The Tour to the power of 10','https://www.letour.fr/en/news/2020/the-tour-to-the-power-of-10/1283461'],['Tour de France: Por el camino','https://www.letour.fr/es/patrimonio/etapa-6/por-el-camino'],['Wikimedia Commons: Tour de France 1910 route map','https://commons.wikimedia.org/wiki/File:Tour_de_France_1910_map-fr.svg']]
  },
  'eugene-christophe-smedjen-1913': {
    year: '1913', label: 'Teknik · Tour de France', title: 'Da Eugène Christophe selv måtte smede sin forgaffel',
    intro: 'En knækket forgaffel kostede Eugène Christophe føringen i Tour de France. Reglerne gav ham ikke en ny cykel. De sendte ham til en smedje.',
    image: christopheImage, secondaryImage: christopheGalibier, alt: 'Eugène Christophe under Tour de France 1912',
    caption: 'Eugène Christophe under Tour de France 1912, året før forgaffelbruddet. Foto: Bibliothèque nationale de France/Wikimedia Commons, public domain.',
    sections: [
      ['Et brud på vej ned', 'På sjette etape af Tour de France 1913 lå Eugène Christophe godt placeret i løbet, da hans forgaffel knækkede på nedkørslen fra Tourmalet. En moderne rytter ville vente på servicebilen. Christophe måtte vende cyklen om på skulderen og gå mod Sainte-Marie-de-Campan.'],
      ['Smeden og rytteren', 'I landsbyen fandt han en smedje. Tourens princip om selvhjulpenhed betød, at reparationen skulle udføres af rytteren selv. Under opsyn varmede, rettede og samlede han forgaflen, før han igen kunne fortsætte. Det mekaniske arbejde var ikke et indslag ved siden af løbet; det var en del af konkurrencen.'],
      ['Drengen ved blæsebælgen', 'Den mest farverige version fortæller, at en syvårig dreng betjente blæsebælgen, og at Christophe derfor fik en tidsstraf for at have modtaget hjælp. Episoden er gentaget utallige gange, men den tidligste dokumentation for drengens alder og den præcise hjælp er vanskeligere at fastslå end selve forgaffelbruddet og smedjearbejdet. Derfor skal detaljen læses som en senere, stærkt overleveret del af historien.'],
      ['Tabt tid, ikke tabt navn', 'Reparationen kostede Christophe flere timer og muligheden for at vinde Touren. Han fortsatte alligevel. Seks år senere blev han den første rytter til at bære Tourens gule førertrøje, da den blev indført i 1919. Men smedjen i 1913 blev billedet, der blev ved med at hænge ved.'],
      ['Når teknik bliver skæbne', 'Historien er ikke kun en fortælling om stædighed. Den viser, hvor direkte en enkelt ståldel kunne bestemme et løbs udfald, og hvor anderledes ansvar var fordelt. Rytteren skulle både være motor, chauffør og mekaniker.']
    ],
    sources: [['Tour de France: Life in yellow','https://www.letour.fr/en/news/2019/life-in-yellow/1275993'],['Wikimedia Commons: Eugène Christophe 1912','https://commons.wikimedia.org/wiki/File:Eugene_Christophe_Tour_de_France_1912.jpg']],
  },
  'henri-desgrange-og-den-selvhjulpne-rytter': {
    year: '1903–1920', label: 'Menneskene bag · Regler', title: 'Henri Desgrange og idealet om den selvhjulpne rytter',
    intro: 'Tour de France skulle efter Henri Desgranges opfattelse afgøres af ryttere, som kunne klare vej, sult og mekanik uden at blive båret gennem løbet af andre.',
    image: '/images/periods/1900-1920/wild-west/street-race-poster.webp', alt: 'Tidlig fransk cykelløbsplakat fra pionertiden',
    caption: 'De tidlige landevejsløb blev skabt af aviser, arrangører og stærke forestillinger om den ensomme rytter. Historisk plakat, public domain.',
    sections: [
      ['Avisen havde brug for et løb', 'Henri Desgrange var tidligere banerytter og redaktør for sportsavisen L’Auto. Tour de France blev lanceret i 1903 som et journalistisk og kommercielt projekt, men løbet fik hurtigt sin egen ideologi. Desgrange ville ikke blot finde den hurtigste. Han ville finde den rytter, der kunne bære hele prøven selv.'],
      ['Hjælp var en mistanke', 'Reglerne ændrede sig fra år til år, men retningen var klar. Mad og vand skulle ofte skaffes af rytteren selv, mekaniske problemer kunne ikke uden videre løses af et hold, og udskiftning af maskinen var stærkt begrænset. Den officielle Tour-historie gengiver Desgranges regler fra 1920 som en sammenfatning: rytteren skulle stilles som en mand på træning alene og måtte hverken hjælpe andre eller modtage hjælp.'],
      ['Et ideal med en pris', 'Reglerne skabte stærke fortællinger, fordi punkteringer, brud og sult blev synlige dele af løbet. Men de var ikke neutrale. De favoriserede ryttere med penge, erfaring og adgang til bedre udstyr, selv når alle på papiret skulle klare sig selv. Samtidig kunne en arrangør gøre lidelsen til avisstof og bruge den som bevis på løbets storhed.'],
      ['Desgrange var ikke hele Touren', 'Alphonse Steines fandt vejene, journalisterne skrev dramaet frem, og ryttere og mekanikere gjorde løbet muligt. Desgrange havde alligevel den afgørende magt til at definere prøven. Hans Tour var et løb, men også en fortælling om vilje, disciplin og individualisme.'],
      ['Da idealet blev forladt', 'Med tiden blev service, holdtaktik og organiseret forplejning en fast del af sporten. Det gjorde ikke løbet let. Det flyttede blot ansvaret fra den enkelte rytters værktøjstaske til en hel organisation. De tidlige regler forklarer, hvorfor historier om knækkede gafler og vendte baghjul stadig virker så fremmede i dag.']
    ],
    sources: [['Tour de France: Sportsmen according to Desgrange','https://www.letour.fr/en/news/2020/1920-sportsmen-according-to-desgrange-2-10/1283494'],['Public Domain Review: The First Tour de France 1903','https://publicdomainreview.org/collection/the-first-tour-de-france-1903/']]
  },
  'apoteket-paa-styret': {
    year: '1890’erne–1920’erne', label: 'Kost, træning og videnskab', title: 'Da apoteket kørte med på styret',
    intro: 'Kaffe, alkohol og stærkere midler lå i samme kulturelle værktøjskasse. Før faste forbud og kontroller var grænsen mellem mad, medicin og stimulans uklar.',
    image: '/images/periods/1900-1920/wild-west/exhausted-rider.webp', alt: 'Udmattet cykelrytter hjælpes efter et tidligt langdistanceløb',
    caption: 'Langdistanceløbenes udmattelse skabte et marked for mad, drikke, tonika og stærkere midler. Historisk fotografi, public domain.',
    sections: [
      ['Ikke et moderne medicinskab', 'Når samtidens ryttere talte om noget, der kunne holde dem vågne, dæmpe smerte eller få kroppen gennem natten, brugte de ikke nødvendigvis vores skel mellem ernæring, medicin og doping. Kaffe, vin, spiritus, linimenter og forskellige stimulanser kunne optræde side om side.'],
      ['Sporene fra 1890’erne', 'Medicinhistoriske oversigter beskriver brug af blandt andet koffein, kokain og stryknin blandt udholdenhedsatleter allerede i slutningen af 1800-tallet. Dokumentationen er ujævn, og berømte dødsfald er senere blevet knyttet til doping uden sikkert bevis. Derfor kan man ikke uden videre gøre hvert rygte til en konkret Tour-hændelse.'],
      ['Ingen liste, ingen kontrol', 'Der fandtes ingen international forbudsliste som i dag og ingen laboratoriekontrol ved løbene. Et middel kunne være lovligt og almindeligt tilgængeligt, selv om det både var farligt og præstationsfremmende. Den historiske forskel er vigtig: brugen kan beskrives uden at lade som om rytterne brød regler, der endnu ikke fandtes.'],
      ['Det tydelige vidnesbyrd kom senere', 'I 1924 lagde Henri og Francis Pélissier samt Maurice Ville deres beholdning frem for journalisten Albert Londres og talte om blandt andet kokain, kloroform og piller. Francis Pélissier sagde senere, at de havde drillet en journalist, som ikke kendte sporten. Interviewet er derfor både en vigtig kilde og en kilde, der skal læses kritisk.'],
      ['Fra hemmelig blanding til regulering', 'Historien handler mindre om én mirakelkur end om en arbejdskultur. Når et løb krævede nattekørsel, kulde og udmattelse, søgte rytterne efter alt, der kunne holde dem i gang. Først langt senere blev grænsen mellem behandling og præstationsfremme gjort til et formelt regelsystem.']
    ],
    sources: [['WADA: Sport Physician’s Toolkit – history of doping','https://www.wada-ama.org/sites/default/files/resources/files/wada_sport_physician_toolkit_v2_en_0.pdf'],['NIH/PMC: Enhancement in Sport','https://pmc.ncbi.nlm.nih.gov/articles/PMC2742076/'],['NIH/PMC: Doping in sports – historical overview','https://pmc.ncbi.nlm.nih.gov/articles/PMC2219897/']]
  },
  'to-tandhjul-og-en-skruenoegle': {
    year: 'Ca. 1919', label: 'Teknik · Samlingens cykler', title: 'To tandhjul og en skruenøgle',
    intro: 'På Cycles France-Sport ligger gearskiftet ikke i et håndtag. Det sidder på hver sin side af baghjulet og kræver, at rytteren standser.',
    image: '/images/bikes/cycles-france-sport/hero.webp', alt: 'Cycles France-Sport racercykel fra omkring 1919',
    caption: 'Samlingens Cycles France-Sport, dateret til cirka 1916–1920. Foto: The Evolution of Bikes.',
    sections: [
      ['Et gear på hver side', 'Baghjulet på Cycles France-Sport har et tandhjul på hver side af navet. Det er ikke et gearskifte i moderne forstand. For at vælge den anden udveksling måtte rytteren stoppe, løsne hjulmøtrikkerne, tage kæden af, vende hjulet og spænde det hele igen.'],
      ['Værktøjet var en del af kørslen', 'Systemet gjorde skruenøglen lige så nødvendig som drikkeflasken. Kæden skulle have den rigtige spænding, hjulet skulle sidde lige, og møtrikkerne skulle spændes sikkert. Et dårligt udført skift kunne give en slap kæde eller et skævt baghjul.'],
      ['Hvorfor to tandhjul var en fordel', 'Den ene udveksling kunne vælges til flad vej, den anden til bakker. Forskellen var beskeden efter nutidens mål, men den gav rytteren et valg på en cykel uden bagskifter. Løsningen var enkel, robust og mulig at reparere langt fra et værksted.'],
      ['Cyklen som konkret kilde', 'Cycles France-Sport kan ikke dokumentere præcis, hvad alle professionelle ryttere brugte på en bestemt Tour-etape. Den kan derimod vise den mekaniske logik fra perioden: få dele, synlige funktioner og et stort ansvar hos rytteren. Dateringen til cirka 1916–1920 bygger på stel, udstyr og mærkning og skal fortsat læses som en faglig vurdering, ikke et kendt produktionsår.'],
      ['Før gearskiftet blev et greb', 'Senere flyttede gearmekanikken gradvist frem til håndtag og kabler, og til sidst ind i bremsegrebet. På denne cykel er udviklingen endnu helt fysisk. Skal vejen køres i et andet gear, må rytteren ned på knæ ved baghjulet.']
    ],
    sources: [['The Evolution of Bikes: Cycles France-Sport','https://teob.dk/cykler/cycles-france-sport/'],['Sheldon Brown: Fixed Gear Bicycles','https://www.sheldonbrown.com/fixed.html']]
  },
  'tour-de-france-1926-den-laengste': {
    year: '1926', label: 'Løb og store øjeblikke · Tour de France', title: 'Touren, der målte 5.745 kilometer',
    intro: 'Tour de France 1926 begyndte i Évian, sluttede i Paris og blev den længste udgave i løbets historie. Kun 41 af 126 startende nåede afslutningen.',
    image: tour1926Image, alt: 'Kort over ruten i Tour de France 1926',
    caption: 'Ruten i Tour de France 1926: 17 etaper og 5.745 kilometer. Kort: Wikimedia Commons, public domain.',
    sections: [
      ['Et løb på næsten seks tusind kilometer', 'Touren i 1926 bestod af 17 etaper og 5.745 kilometer. Det er fortsat den længste udgave i løbets historie. Tallene fortæller dog kun halvdelen: etaperne var få og meget lange, hviledagene begrænsede, og store dele af vejene krævede konstant opmærksomhed på både underlag og cykel.'],
      ['For første gang væk fra Paris', 'Feltet startede i Évian-les-Bains. Det var første gang, Tour de France begyndte uden for Paris. De 126 ryttere var dermed med til at ændre løbets geografi, før de overhovedet havde kørt den første kilometer. Paris var stadig målet, men ikke længere den selvfølgelige begyndelse.'],
      ['Buysse i stormen mod Luchon', 'Belgieren Lucien Buysse afgjorde løbet på den 326 kilometer lange etape fra Bayonne til Luchon. Dagen gik over Aubisque, Tourmalet, Aspin og Peyresourde i regn og kulde. Buysse vandt etapen med mere end 25 minutter til den nærmeste rival og overtog den føring, han beholdt til Paris.'],
      ['Et familieløb', 'Lucien var ikke familiens eneste Buysse i Touren. Hans bror Jules vandt åbningsetapen og bar den gule trøje i to dage. Lucien var blevet nummer tre i 1924 og nummer to i 1925; i 1926 nåede han det sidste trin og vandt samlet.'],
      ['41 nåede frem', 'Af de 126 startende fuldførte 41. Tallet skal ikke bruges som bevis på, at alle andre manglede vilje. Udstyr, sygdom, styrt, tidsgrænser og de lange løbsdage sorterede feltet. Netop derfor er 1926 en bedre indgang til årtiet end en romantisk fortælling om rå mænd: løbet var også et system, der bevidst gjorde gennemførelsen usikker.']
    ],
    sources: [['Tour de France: Paris and the 1926 Tour','https://www.letour.fr/en/heritage/stage-21/town/paris-champs-elysees'],['Tour de France: Jules Buysse and the 1926 start','https://www.letour.fr/en/news/2018/the-achievement-of-a-lifetime-jules-buysse-ii-x'],['ProCyclingStats: Tour de France 1926 start list and distance','https://www.procyclingstats.com/race/tour-de-france/1926/startlist'],['Wikimedia Commons: Tour de France 1926 route','https://commons.wikimedia.org/wiki/File:Tour_de_France_1926.png']]
  },
  'peter-schroder-vaerksted-1920': {
    year: '1920', label: 'Menneskene bag · Dansk cykelhåndværk', title: 'Da Peter Schrøder begyndte at bygge cykler på Nørrebro',
    intro: 'I 1920 begyndte Peter Schrøder at bygge cykler i en sidegade på Nørrebro. Værkstedets navn kom siden til at følge danske bane- og landevejsryttere gennem årtier.',
    image: schroderImage, alt: 'Grøn håndbygget Schrøder-racercykel fra 1965',
    caption: 'Samlingens Schrøder fra 1965 er bygget langt senere end værkstedets begyndelse, men viser den håndbyggede tradition, som navnet kom til at stå for. Foto: The Evolution of Bikes.',
    sections: [
      ['En sidegade på Nørrebro', 'Schrøder Cykler fører sin historie tilbage til 1920, hvor Peter Schrøder begyndte produktionen i København. Det var ikke begyndelsen på dansk cykelbygning, men det blev begyndelsen på et værkstedsnavn, som fik en usædvanlig lang forbindelse til dansk cykelsport.'],
      ['Rammebyggeren mellem kunde og konkurrence', 'En håndbygget racercykel opstod ikke på et samlebånd alene. Rammebyggeren valgte rør, geometri og detaljer efter rytterens størrelse og brug. Samtidig var værkstedet et sted, hvor løbserfaring blev omsat til næste reparation eller næste stel.'],
      ['Det, cyklen kan dokumentere', 'Samlingens grønne Schrøder er fra 1965 og kan derfor ikke vise præcis, hvordan en Schrøder så ud i 1920. Den dokumenterer derimod den senere værkstedstradition: Reynolds 531-rør, Nervex-muffer, Campagnolo-dropouts og et stel bygget til en bestemt kunde. Værkstedsbogen forbinder stelnummer PS 1018 B med Gert V. Nilsen og datoen 22. maj 1965.'],
      ['Fra lokalt værksted til sportsligt navn', 'Schrøder-navnet blev kendt på både landevej og bane. Det er vigtigt ikke at gøre alle senere resultater til Peter Schrøders personlige arbejde, men virksomheden viser, hvordan et lokalt værksted kunne blive en del af sportens infrastruktur: ryttere skulle ikke kun have ben og mod, men også en cykel, der passede.'],
      ['Et menneske bag mærket', 'Når cykelhistorien fortælles gennem vindere og rekordtider, forsvinder rammebyggeren let. Peter Schrøders betydning ligger netop dér: i de mange cykler, mål og reparationer, som gjorde andre menneskers løb mulige. Begyndelsen i 1920 giver derfor årtiet en dansk og håndgribelig indgang.']
    ],
    sources: [['NORD Magasinet: Schrøder Cykler','https://nord-magasinet.dk/schroeder-cykler/'],['The Evolution of Bikes: Schrøder 1965','https://teob.dk/cykler/schroder-1965/']]
  },
  'tour-1930-nationalhold-og-reklamekaravane': {
    year: '1930', label: 'Samfund og tidsånd · Tour de France', title: 'Da Touren skiftede fabrikkerne ud med nationer',
    intro: 'Henri Desgrange ville dæmpe cykelfabrikkernes indflydelse. I 1930 fik Touren nationalhold, arrangørleverede cykler og en reklamekaravane, der skulle betale regningen.',
    image: guerra1930Image, alt: 'Learco Guerra under Tour de France 1930',
    caption: 'Learco Guerra kørte for det italienske nationalhold i Tour de France 1930. Foto: Bibliothèque nationale de France/Wikimedia Commons, public domain.',
    sections: [
      ['Efter en sejr, Desgrange ikke brød sig om', 'Maurice De Waele vandt Touren i 1929 med støtte fra Alcyon-holdet. Henri Desgrange mente, at fabrikanternes aftaler og taktiske kontrol var blevet for stærke. Hans svar var ikke en lille regelændring. Året efter fjernede han fabriksholdene fra Tourens bedste kategori og lod arrangøren udtage nationalholdene.'],
      ['Én leverandør til de bedste', 'Organisationen stillede cykler til rådighed for rytterne i den såkaldte Aces-kategori. Tourens egen historik beskriver, hvordan Desgrange ville fjerne den direkte kamp mellem cykelmærkerne. Det betød ikke, at fabrikanterne forsvandt fra sporten. De betalte fortsat rytterne resten af året og kunne stadig påvirke, hvem der kom til start.'],
      ['En dyr reform', 'Når fabrikanterne ikke længere bar hele udgiften under Touren, skulle L’Auto betale for blandt andet cykler, ophold og forplejning. Reklamechefen Robert Desmarets samlede derfor virksomheder, som mod betaling fik lov at køre foran feltet og møde publikum langs ruten. Menier-chokolade, La Vache Qui Rit, Biscottes Delft og Noveltex-ure var blandt den første officielle karavanes mærker.'],
      ['Flagene kom tydeligere frem', 'Frankrig, Belgien, Italien, Spanien og Tyskland stillede med hold i nationale farver. Det gjorde konkurrencen let at aflæse for publikum og aviserne. Det gjorde også Touren til en mere direkte konkurrence mellem nationer i et Europa, hvor national politik fyldte stadig mere.'],
      ['En ordning, der blev hængende', 'André Leducq vandt Touren for Frankrig, mens Charles Pélissier tog otte etaper. Desgrange fik den sportslige succes, han ønskede, og nationalholdene kom til at præge Touren i årtier. Reklamekaravanen blev lige så sejlivet. Den begyndte som finansiering af en reform og endte som en del af løbets offentlige ansigt.']
    ],
    sources: [['Tour de France: 1930 – The Tour revolutionizes','https://www.letour.fr/en/news/2020/1930-the-tour-revolutionizes-3-10/1283535'],['Tour de France: The publicity caravan','https://www.letour.fr/en/follow-the-publicity-caravan'],['Wikimedia Commons: Learco Guerra, Tour de France 1930','https://commons.wikimedia.org/wiki/File:1930-Learco_Guerra-Tour.jpg']]
  },
  'gino-bartali-tour-1938': {
    year: '1936–1938', label: 'Periodens ryttere · Giro og Tour', title: 'Gino Bartali før krigen',
    intro: 'Gino Bartali vandt Giroen to gange og Tour de France én gang, før krigen afbrød de store løb. Hans tro og hans kølige forhold til fascismen gjorde ham vanskelig at forme som regimets helt.',
    image: bartali1936Image, alt: 'Gino Bartali efter sejren i Lombardiet Rundt 1936',
    caption: 'Gino Bartali efter sejren i Lombardiet Rundt i november 1936. Foto: Agence Meurisse/Bibliothèque nationale de France/Wikimedia Commons, public domain.',
    sections: [
      ['En ny italiensk etapeløbsrytter', 'Bartali vandt Giro d’Italia i 1936 og igen i 1937. Han var stærk i bjergene, men hans position i Italien byggede også på en genkendelig offentlig person: toscaner, katolik og alvorlig på en måde, som ikke krævede mange store armbevægelser.'],
      ['Touren i 1937 sluttede tidligt', 'Hans første Tour de France begyndte godt, men et styrt på en våd bro gjorde resten af løbet vanskeligt. Han fortsatte nogle dage og udgik siden. Nederlaget gjorde ikke hans næste forsøg mindre vigtigt. I 1938 vendte han tilbage som kaptajn for det italienske nationalhold.'],
      ['Angrebet på Izoard', 'På etapen til Briançon angreb Bartali over Col d’Izoard og overtog løbets føring. Han beholdt den til Paris og blev den anden italienske vinder af Tour de France efter Ottavio Bottecchia. Resultatet var sportsligt enkelt at registrere. Den politiske brug af det var mere kompliceret.'],
      ['En sejr, regimet gerne ville eje', 'Mussolinis Italien brugte internationale sportsresultater som tegn på national styrke. Bartalis Tour-sejr passede ind i den fortælling, men rytteren var ikke nogen lydig politisk figur. Kilderne peger på et distanceret forhold til regimet, og det er for enkelt at beskrive ham enten som fascismens helt eller som åben modstander i 1938.'],
      ['Historien fortsatte et andet sted', 'Da krigen kom, blev de store etapeløb afbrudt. Bartalis senere kurérarbejde for et netværk, der hjalp forfulgte jøder, hører til 1940’ernes historie og skal ikke lægges baglæns ind i hans Tour-sejr. I 1930’erne var han først og fremmest den rytter, som vandt to Giroer og førte den italienske cykelsport ind i Paris.']
    ],
    sources: [['Tour de France: Italy and the Tour','https://www.letour.fr/en/the-race/grands-departs/grand-depart-2024'],['Tour de France: Parc des Princes and the 1938 finish','https://www.letour.fr/en/news/2024/finish-with-a-capital-f-parc-des-princes-the-home-of-cycling-ii-iv/1316959'],['Yad Vashem: Gino Bartali, Righteous Among the Nations','https://wwv.yadvashem.org/yv/en/exhibitions/righteous-sportsmen/bartali.asp'],['Wikimedia Commons: Gino Bartali, Lombardy 1936','https://commons.wikimedia.org/wiki/File:Gino_Bartali,_vainqueur_du_Tour_de_Lombardie_en_novembre_1936.jpg']]
  },
  'circuit-de-france-1942': {
    year: '1942', label: 'Løb og samfund · Det besatte Frankrig', title: 'Touren, besættelsen gerne ville have',
    intro: 'Circuit de France blev sat i gang som et seks etaper langt erstatningsløb i det besatte Frankrig. Det lignede Touren på et kort. I praksis viste det, hvor meget der manglede.',
    image: '/images/periods/1940-1949/efterkrigsfelt-illustration.jpg', alt: 'Illustration af et cykelfelt på en slidt europæisk landevej under 1940’ernes materialemangel',
    caption: 'En nutidig illustration af et felt under 1940’ernes knappe forhold. AI-genereret illustration – ikke et dokumentarisk billede af Circuit de France. Illustration: The Evolution of Bikes.',
    sections: [
      ['Et Tour de France uden Touren', 'Tour de France blev ikke kørt under den tyske besættelse. I 1942 forsøgte sportsjournalisten Jean Leulliot og avisen La France socialiste i stedet at gennemføre Circuit de France. Løbet begyndte 28. september og sluttede 4. oktober efter seks etaper gennem både den besatte og den såkaldte frie zone.'],
      ['Et løb med politisk bagage', 'Avisen bag løbet samarbejdede med besættelsesmagten, og begivenheden kunne bruges som tegn på orden og normalitet. Det gjorde ikke hver enkelt rytter til politisk aktør. Men arrangøren, tilladelserne og omtalen kan ikke skilles fra den situation, løbet blev kørt i.'],
      ['En kalender uden brændstof og fri bevægelse', 'Transport, benzin, reservedele og mad var rationeret. Grænser og kontrolposter gjorde planlægningen vanskelig, og flere fremtrædende ryttere og hold holdt sig væk. Circuit de France blev derfor hverken Tour de France i nyt navn eller et normalt internationalt etapeløb.'],
      ['François Neuville vandt', 'Belgieren François Neuville endte som samlet vinder. Resultatet står fast, men løbets største betydning ligger ikke i klassementet. Det blev den eneste udgave. Planerne om en gentagelse i 1943 blev ikke til noget.'],
      ['Det, fraværet viste', 'Circuit de France viste, at ruten og rytterne ikke alene skaber et Tour de France. Løbet krævede også en avis, et publikum, forsyninger, bevægelsesfrihed og en form for offentlig tillid. I 1942 var alle dele til stede i begrænset form. Det var ikke nok.']
    ],
    sources: [['Hugh Dauncey: French Cycling – A Social and Cultural History','https://tile.loc.gov/storage-services/master/gdc/gdcebookspublic/20/16/44/94/98/2016449498/2016449498.pdf'],['Tour de France: 1940, the Tour that was not held','https://www.letour.fr/en/news/2020/1940-the-tour-that-wasnt-4-10/1283547']]
  },
  'gino-bartali-kurer-under-krigen': {
    year: '1943–1944', label: 'Menneskene bag · Anden Verdenskrig', title: 'Bartalis træningsture havde et andet formål',
    intro: 'Gino Bartali var kendt for at træne over lange afstande. Under den tyske besættelse af Italien gjorde netop den vane ham brugbar som kurér for et redningsnetværk.',
    image: bartaliCourierImage, alt: 'Gino Bartali efter Lombardiet Rundt i 1936',
    caption: 'Gino Bartali i 1936, før krigen afbrød de store internationale løb. Foto: Agence Meurisse/Bibliothèque nationale de France/Wikimedia Commons, public domain.',
    sections: [
      ['En kendt mand på velkendte veje', 'Efter den tyske besættelse af det nordlige og centrale Italien i september 1943 arbejdede Bartali som kurér for et netværk omkring kardinal Elia Dalla Costa og rabbiner Nathan Cassuto. Hans lange ture mellem blandt andet Firenze og Assisi lignede det, offentligheden kendte ham for: en professionel rytter på træning.'],
      ['Papirer mellem byerne', 'Yad Vashems undersøgelse dokumenterer, at Bartali transporterede falske papirer og andet materiale mellem mennesker i netværket. Kilderne beskriver forskellige gemmesteder på cyklen, og den præcise placering skal derfor ikke gøres til historiens sikre hoveddetalje. Det sikre er hans rolle som budbringer.'],
      ['Cyklen som forklaring', 'Når han blev standset, kunne Bartali pege på træningen og sit kendte navn. Ifølge vidneudsagn bad han kontrollører undlade at røre cyklen, fordi dens indstilling var afgørende for hans sport. Den forklaring virkede netop, fordi en racercykel for en professionel faktisk var et præcist arbejdsredskab.'],
      ['En del af et større netværk', 'Bartali handlede ikke alene. Præster, jødiske hjælpere, falsknere, familier og kurerer udførte hver sin del af arbejdet. Derfor bør det ofte gentagne tal på mere end 800 reddede ikke uden videre tilskrives Bartali personligt. Hans indsats var virkelig; den var også kollektiv.'],
      ['En historie, han ikke solgte', 'Efter krigen fortalte Bartali kun lidt offentligt om arbejdet. Yad Vashem anerkendte ham i 2013 som Retfærdig blandt Nationerne. Anerkendelsen hviler på vidneudsagn og hans dokumenterede rolle, ikke på behovet for at gøre én berømt rytter til hele netværkets eneste helt.']
    ],
    sources: [['Yad Vashem: Gino Bartali, Righteous Among the Nations','https://wwv.yadvashem.org/yv/en/exhibitions/righteous-sportsmen/bartali.asp'],['United States Holocaust Memorial Museum: Gino Bartali','https://encyclopedia.ushmm.org/content/en/article/gino-bartali'],['Wikimedia Commons: Gino Bartali, Lombardy 1936','https://commons.wikimedia.org/wiki/File:Gino_Bartali,_vainqueur_du_Tour_de_Lombardie_en_novembre_1936.jpg']]
  },
  'fausto-coppi-fra-krigsfange-til-comeback': {
    year: '1943–1949', label: 'Periodens ryttere · Krig og comeback', title: 'Fra krigsfange til Giro–Tour-vinder',
    intro: 'Fausto Coppi havde allerede vundet Giroen, da han blev sendt til Nordafrika og taget til fange. Da løbene vendte tilbage, begyndte også hans anden karriere.',
    image: coppiPowImage, alt: 'Fausto Coppi på toppen af Ghisallo under Lombardiet Rundt 1957',
    caption: 'Fausto Coppi på Ghisallo i 1957. Billedet er senere end historiens begivenheder, men viser rytteren, som kom til at præge efterkrigstidens cykelsport. Foto: Ukendt/Wikimedia Commons, public domain.',
    sections: [
      ['Giro-vinder før indkaldelsen', 'Coppi vandt Giro d’Italia i 1940 som 20-årig. Få dage efter løbets afslutning gik Italien ind i krigen. Hans gennembrud blev derfor ikke begyndelsen på en normal række internationale sæsoner, men på flere år med militærtjeneste, afbrudte løb og usikkerhed.'],
      ['Til Nordafrika', 'I 1943 blev Coppi sendt til Tunesien med den italienske hær. Han blev taget til fange af britiske styrker i april nær Mateur og Medjez el-Bab. I fangenskab var han først soldat og krigsfange, ikke den offentlige mesterfigur, som de italienske aviser havde bygget op.'],
      ['Tilbage gennem Italien', 'Coppi blev siden ført tilbage til Italien sammen med de allieredes fremrykning. Et bevaret brev fra november 1944 placerer ham i Caserta. Efter krigen kunne han igen stille op, men sportens kalender, hold og forsyninger skulle ligesom rytterne samles på ny.'],
      ['Sejrene kom hurtigt igen', 'I 1946 vandt Coppi Milano–Sanremo efter et langt soloridt. Han vandt Giroen i 1947 og i 1949 både Giro d’Italia og Tour de France. Dermed blev han den første rytter, der tog de to store etapeløb i samme sæson.'],
      ['Ikke et ubrudt talentforløb', 'Coppis resultater kan let komme til at ligne en lige linje fra den unge Giro-vinder til efterkrigstidens Campionissimo. Krigen skar et stort hul i den linje. Hans comeback handler derfor ikke kun om moderne træning og talent, men om en professionel karriere, der måtte begynde igen.']
    ],
    sources: [['Giro d’Italia: historical archive 1933–1947','https://archivio.giroditalia.it/eng/editions/1933-1947/'],['Federazione fra le Società Filateliche Italiane: Coppi, war and surviving correspondence','https://expo.fsfi.it/vastophil2023/exhibits/06PoloWHY2MUdW.pdf'],['Wikimedia Commons: Coppi on Ghisallo, 1957','https://commons.wikimedia.org/wiki/File:Coppi_Giro_di_Lombardia_1957.jpg']]
  },
  'jean-robic-vender-touren-1947': {
    year: '1947', label: 'Løb og store øjeblikke · Tour de France', title: 'Robic tog den gule trøje på den sidste dag',
    intro: 'Jean Robic havde ikke båret den gule trøje én eneste dag. Da Tourens sidste etape begyndte, lå han nummer tre. På vejen til Paris ændrede han hele klassementet.',
    image: robic1947Image, alt: 'Jean Robic fotograferet efter sejren i Tour de France 1947',
    caption: 'Jean Robic efter sejren i Tour de France 1947. Foto: Anefo/Nationaal Archief, CC0.',
    sections: [
      ['Touren vender tilbage', 'Tour de France blev kørt igen i 1947 efter syv års fravær. På sidste etape fra Caen til Paris førte Pierre Brambilla. René Vietto var nummer to, og Jean Robic begyndte dagen som nummer tre. Normalt var vejen mod Paris ikke stedet, hvor en samlet sejr blev vendt.'],
      ['Angrebet efter Rouen', 'Robic angreb efter Rouen og fik Édouard Fachleitner med sig. Brambilla kunne ikke lukke hullet. Da gruppen nåede Parc des Princes, havde Robic hentet mere end den tid, han manglede, og overtog førstepladsen i det endelige klassement.'],
      ['Gul på podiet, ikke på vejen', 'Han blev dermed Tour-vinder uden tidligere i løbet at have båret den gule trøje. Det er en særegen detalje, men den bør ikke skjule selve præstationen: en samlet føring blev angrebet og tabt på den sidste dag.'],
      ['En aftale på vejen', 'Senere fortællinger beskriver aftaler mellem Robic og Fachleitner om hjælp og præmiepenge. De præcise ord og beløb varierer. At de samarbejdede i angrebet er en del af løbets forløb; alle detaljer i den mundtlige handel kan ikke behandles som et samtidigt referat.'],
      ['Blykuglerne kom senere', 'Robic forbindes også med historien om en tung drikkedunk med bly til bjergnedkørsler. Den episode knyttes normalt til Touren 1953 og hører derfor ikke til forklaringen på sejren i 1947. Denne dag vandt han ikke ved at gøre sig tungere. Han vandt ved at angribe, mens løbet endnu ikke var slut.']
    ],
    sources: [['Tour de France: Robic turns the 1947 Tour on its head','https://www.letour.fr/en/news/2024/finish-with-a-capital-f-parc-des-princes-the-home-of-cycling-ii-iv/1316959'],['Wikimedia Commons: Jean Robic, Tour winner 1947','https://commons.wikimedia.org/wiki/File:Jean_Robic,_winnaar_van_de_Tour_de_France_1947,_Bestanddeelnr_902-2745.jpg']]
  },
  'campagnolo-gran-sport-parallelogram': {
    year:'1951', label:'Teknik · Gearskift', title:'Da gearskiftet endelig blev moderne',
    intro:'Gran Sport gjorde gearskiftet til en bevægelse i bagskifteren i stedet for en flytning af baghjulet. Det moderne princip var ikke nyt, men Campagnolo gjorde det til centrum i den italienske racercykel.',
    image:'/images/bikes/giame/full-bike.webp', alt:'Giamé-racercykel fra begyndelsen af 1950’erne med tidstypisk gearudstyr', caption:'Samlingens Giamé fra begyndelsen af 1950’erne viser den type lette stålcykel, som de nye bagskiftere blev udviklet til. Cyklen er ikke dokumenteret med Campagnolo Gran Sport.',
    sections:[
      ['Før hjulet kunne blive siddende','Cambio Corsa og Paris–Roubaix-gearet lod rytteren skifte under kørslen, men bagakslen skulle stadig frigøres, og hjulet flyttede sig i stellet. Det krævede både balance og mekanisk føling.'],
      ['Parallelogrammet','Gran Sport flyttede kædeføreren sidelæns gennem et leddelt parallelogram. En fjeder holdt kæden spændt, mens to pulleyhjul førte den mellem tandhjulene. Baghjulet kunne nu blive fastspændt.'],
      ['Ikke den første bagskifter','Campagnolo opfandt ikke parallelogram-princippet. Andre producenter havde tidligere udviklet beslægtede løsninger. Betydningen lå i en robust og prestigefyldt model, som blev tæt knyttet til den fine italienske racercykel.'],
      ['Et greb på skrårøret','Skiftet var stadig uden klik. Rytteren flyttede hånden til et friktionsgreb på skrårøret og fandt selv kædens stille position. Det var moderne sammenlignet med stangsystemet, men krævede øvelse.'],
      ['En form, der holdt','Gran Sport pegede frem mod årtiers bagskiftere. Materialer, antal tandhjul og betjening ændrede sig, men parallelogrammets grundidé blev stående.']
    ], sources:[['Campagnolo: company history','https://www.campagnolo.com/us-en/company/history/'],['The Evolution of Bikes: Cambio Corsa','https://teob.dk/komponenter/campagnolo-cambio-corsa/']]
  },
  'roger-walkowiak-tour-1956': {
    year:'1956', label:'Løb og store øjeblikke · Tour de France', title:'Tour-vinderen ingen havde regnet med',
    intro:'Roger Walkowiak vandt ingen etape i Touren 1956. Han vandt hele løbet, fordi favoritterne først undervurderede hans udbrud og siden ikke kunne køre ham fra.',
    image:walkowiakContextImage, alt:'Tour de France-ryttere modtager madposer under løbet i 1958', caption:'Forplejning under Tour de France 1958. Billedet viser løbets hverdag kort efter Walkowiaks sejr, men ikke Walkowiak eller Touren 1956. Foto: Nationaal Archief, ingen kendte brugsbegrænsninger.',
    sections:[
      ['Regionalholdet','Walkowiak var ikke med på Frankrigs landshold. Han kørte for Nord-Est–Centre og begyndte uden den opmærksomhed, som fulgte løbets største navne.'],
      ['Udbruddet fik plads','På syvende etape kom han med i et stort udbrud, som favoritterne lod få meget tid. Han overtog den gule trøje, mistede den igen og forblev alligevel tæt på klassementet.'],
      ['Det afgørende forsvar','I Alperne viste han, at forspringet ikke blot var en gave. Han fulgte de stærkeste, generobrede føringen fire dage før Paris og gav ikke rivalerne mulighed for at rette deres tidlige fejlvurdering.'],
      ['Ingen etapesejr','At han vandt uden en etapesejr gjorde fortællingen svær at sælge som klassisk heltedrama. Udtrykket “à la Walko” blev senere brugt om en overraskende eller heldig sejr.'],
      ['Mere end held','Et udbrud kan give tid. Det kan ikke alene forsvare den over bjerge og gennem et tre uger langt løb. Walkowiaks sejr var uventet, men ikke tilfældig.']
    ], sources:[['Tour de France: One last breakaway for Walko','https://www.letour.fr/en/news/2017/one-last-breakaway-for-walko/1263971']]
  },
  'charly-gaul-monte-bondone-1956': {
    year:'1956', label:'Løb og store øjeblikke · Giro d’Italia', title:'Da sneen knuste Giro-feltet',
    intro:'Regn blev til sne på den 242 kilometer lange etape fra Merano til Monte Bondone. Charly Gaul angreb tidligt og sluttede dagen som vinder og ny mand i lyserødt.',
    image:charlyGaulImage, alt:'Charly Gaul ved holdpræsentationen før Tour de France 1958', caption:'Charly Gaul står midt i billedet ved holdpræsentationen før Tour de France 1958. Fotografiet er taget to år efter Monte Bondone-etapen. Foto: Harry Pot/Anefo, CC0.',
    sections:[
      ['Fire pas før målet','Etapen førte over Costalunga, Rolle, Gobbera og Brocon, inden den sluttede på Monte Bondone. Kulde, regn og vind gjorde allerede de første timer til en udskillelse.'],
      ['Gaul angriber','Charly Gaul begyndte dagen som nummer elleve, mere end seksten minutter efter Pasquale Fornara. Han angreb, mens vejret blev værre, og ryttere forsvandt fra feltet.'],
      ['Sneen på Bondone','På den sidste stigning blev regnen til snestorm. Fornara blev taget ud af løbet af sin sportsdirektør af frygt for hans helbred. Gaul fortsatte gennem kulden og vandt etapen med næsten otte minutter.'],
      ['Næsten nedkølet','Ved målet var Gaul så medtaget, at hjælpere måtte få ham af cyklen og i varme. Det er vigtigt ikke at gøre nedkølingen til pynt: etapen viste, hvor lidt sikkerhedsmargin der var mellem løb og alvorlig skade.'],
      ['Fra ellevteplads til sejr','Etapen gav Gaul den lyserøde trøje, som han beholdt til Milano. Bondone blev stående som et af Giroens klareste billeder på mennesket presset til sin grænse.']
    ], sources:[['Giro d’Italia: Monte Bondone 1956','https://www.giroditalia.it/en/monte-bondone/'],['Giro d’Italia: memories from Monte Bondone','https://www.giroditalia.it/news/ricordi-dal-monte-bondone-1956-luomo-portato-ai-suoi-limiti/']]
  },
  'tour-start-amsterdam-1954': {
    year:'1954', label:'Samfund og tidsånd · Tour de France', title:'Da Touren forlod Frankrig',
    intro:'Touren var længe kommet over grænserne, men starten hørte til i Frankrig. I 1954 begyndte løbet for første gang i et andet land.',
    image:tourAmsterdamImage, alt:'Tour de France-feltet passerer tilskuere i Nederlandene i 1954', caption:'Feltet på Zandvoortselaan under Tour de Frances første Grand Départ uden for Frankrig i 1954. Foto: Nationaal Archief, ingen kendte brugsbegrænsninger.',
    sections:[
      ['Amsterdam før Paris','Den 8. juli 1954 begyndte Tour de France i Amsterdam. Det var løbets første Grand Départ uden for Frankrig, selv om ruten gennem årene ofte havde krydset landegrænser.'],
      ['En hollandsk åbningsdag','Første etape gik til Brasschaat i Belgien. Wout Wagtmans vandt og blev den første hollænder i gult efter en Tour-start på hjemmebane.'],
      ['Et europæisk løb','Efterkrigstidens Europa var stadig præget af krigens brud. Tourens start i Nederlandene kan ikke alene kaldes et forsoningsprojekt, men den viste et løb, som i stigende grad solgte sig som fælles europæisk begivenhed.'],
      ['Byerne blev medspillere','En udenlandsk start gav værtsbyen publikum, presse og international opmærksomhed. Modellen blev senere en fast del af Tourens måde at udvide sin geografi og økonomi på.'],
      ['En ny begyndelse','Amsterdam ændrede ikke selve cyklen. Byen ændrede forestillingen om, hvor Touren kunne begynde.']
    ], sources:[['Tour de France: Grands Départs','https://www.letour.fr/en/the-race/grands-departs']]
  },
  'fausto-coppi-la-bomba': {
    year:'1952', label:'Kost, træning og videnskab · Dopingshistorie', title:'Når nødvendigt betød næsten altid',
    intro:'Fausto Coppis svar om “la bomba” er blevet et af cykelsportens mest citerede dopingudsagn. Det hører til en tid, hvor brugen var kendt, men kontrollen næsten ikke fandtes.',
    image:coppiPowImage, alt:'Fausto Coppi under Lombardiet Rundt i 1957', caption:'Fausto Coppi på Ghisallo i 1957. Fotografiet er senere end interviewet. Foto: ukendt/Wikimedia Commons, fri brugsstatus registreret i projektets billedarkiv.',
    sections:[
      ['Et direkte spørgsmål','I et RAI-interview fra 1952 blev Coppi spurgt, om ryttere tog “la bomba”, feltets navn for amfetaminholdige stimulanser. Han svarede uden den afstand, som senere tiders regler skabte.'],
      ['Næsten altid','På spørgsmålet om, hvornår det var nødvendigt, lød svaret i den kendte gengivelse: praktisk taget hele tiden. Replikken er bevaret gennem senere udsendelser fra RAI og skal knyttes til dette konkrete interview.'],
      ['Et arbejdsredskab','Amfetamin kunne dæmpe træthed og sult og give en følelse af overskud. Netop derfor var det farligt: kroppens advarsler blev svagere, mens belastningen fortsatte.'],
      ['Før kontrollen','Der fandtes endnu ikke et effektivt internationalt kontrolsystem. Det betyder ikke, at brugen var ufarlig eller accepteret af alle, men at grænsen mellem medicin, stimulans og snyd blev håndteret langt mere løst.'],
      ['Et citat med en bagside','Coppis tørre svar kan lyde vittigt. Historisk er det vigtigere som et sjældent åbent vindue til en arbejdskultur, hvor rytterne pressede kroppen uden den beskyttelse, senere regler forsøgte at skabe.']
    ], sources:[['RAI: Fausto e la bomba','https://www.raiplay.it/video/2019/07/Coppi100-Fausto-e-la-bomba-592bfdb3-8643-4dd3-8e95-bb0952d21807.html'],['Wikimedia Commons: Coppi on Ghisallo, 1957','https://commons.wikimedia.org/wiki/File:Coppi_Giro_di_Lombardia_1957.jpg']]
  },
  'moser-timerekord-1984': {
    year:'1984', label:'Teknik · Banecykling', title:'Da Moser kørte 51,151 kilometer på en time',
    intro:'På fire januardage i Mexico City flyttede Francesco Moser timerekorden to gange. Skivehjul, højde og en ny måde at arbejde med luftmodstand gjorde cyklen til et laboratorium.',
    image:moserHour1984Image, alt:'Illustration af en banerytter på en aerodynamisk cykel med skivehjul i et velodrom i 1984', caption:'Tidstypisk rekonstruktion af Mosers rekordforsøg i Mexico City. AI-genereret illustration – ikke et historisk fotografi. Illustration: The Evolution of Bikes.',
    sections:[
      ['Den sorte streg','Den 19. januar 1984 kørte Francesco Moser 50,808 kilometer på en time i Mexico City. Fire dage senere gik han på banen igen og nåede 51,151 kilometer. Eddy Merckx’ rekord fra 1972 var ikke blot slået. Den var flyttet ind i en ny teknisk tid.'],
      ['Højden og kroppen','Mexico Citys tynde luft gav mindre luftmodstand, men også mindre ilt. Moser og lægen Francesco Conconi forberedte forsøget med test, træning og en langt mere systematisk tilgang end den gamle idé om blot at samle kilometer. Rekorden kom derfor fra et samspil mellem rytter, fysiologi, bane og udstyr.'],
      ['Cyklen så forkert ud','De lukkede skivehjul og den kompakte kørestilling brød med billedet af den klassiske banecykel. Cyklen var stadig bygget af stål, men formen blev bestemt af luften omkring den. Hvert fremspring, hver vinkel og rytterens placering blev en del af regnestykket.'],
      ['Mere end to hjul','Skivehjulene blev rekordens tydeligste symbol, men de kørte ikke alene. Moser var en stor rytter, banen lå højt, og forberedelsen var målrettet netop tres minutter. Teknologien gav mening, fordi hele forsøget var organiseret omkring én enkel opgave.'],
      ['Efter rekorden','Senere ændrede UCI reglerne for timerekorden og skilte forskellige typer udstyr ad i historikken. Det ændrer ikke januar 1984. Moser viste et stort publikum, at aerodynamik ikke længere var et særligt hjørne af sporten. Den kunne afgøre, hvor langt et menneske nåede på en time.']
    ], sources:[['UCI: Historical hour records','https://assets.ctfassets.net/761l7gh5x5an/052qz35QNDHZmP2Qvtx77/ef7344311538ddc6399cdcd8e4e8093f/20240816_Historique_des_records_ME.pdf'],['Cyclingnews: Francesco Moser’s hour record','https://www.cyclingnews.com/news/gallery-francesco-mosers-hour-record/']]
  },
  'look-klikpedal-hinault-1985': {
    year:'1984–1985', label:'Teknik · Tour de France', title:'Da tåremmen blev afløst af et klik',
    intro:'En fod i en tåclips sad godt fast, men den skulle også kunne komme fri. LOOK lånte låsen fra skibindingen og ændrede forbindelsen mellem rytter og cykel.',
    image:hinaultLook1985Image, alt:'Bernard Hinault i verdensmestertrøjen i 1982', caption:'Bernard Hinault i 1982, før han vandt sin femte Tour på LOOKs nye pedalsystem. Foto: Marcel Antonisse/Anefo, CC0.',
    sections:[
      ['Remmen over foden','Den klassiske racerrytter stak skoen ind i en metalclips og strammede en læderrem. Systemet holdt foden på plads, men krævede en håndbevægelse for at løsne remmen. Ved et uventet stop eller styrt kunne det være et problem.'],
      ['Skibindingen på cyklen','LOOK kendte allerede udløselige bindinger fra skisporten. PP65-pedalen brugte en klampe under skoen og en fjederbelastet lås. Rytteren trådte ned for at klikke i og drejede hælen ud for at komme fri.'],
      ['Hinault som prøveklud','Bernard Hinault brugte systemet med La Vie Claire. Under Touren i 1985 styrtede han voldsomt på etapen til Saint-Étienne, men pedalerne blev ikke historiens svage led. Han fortsatte og vandt løbet for femte gang.'],
      ['Ikke et øjeblikkeligt skifte','Feltet smed ikke alle tåclips væk på én dag. Ryttere skulle stole på fjederen, skoene skulle passe til klampen, og mekanikerne skulle lære systemet. Men sejren gav løsningen en synlighed, som en annonce aldrig kunne have købt.'],
      ['Et lille klik med stor virkning','Klikpedalen gjorde ind- og udstigning hurtigere og frigjorde foden med en fast bevægelse. Formen og materialerne blev siden forfinet, men princippet blev. En af cyklens ældste forbindelser var blevet ny.']
    ], sources:[['LOOK: 40 years of Science Meets Art','https://www.lookcycle.com/us-en/inside/news/40-years-of-science-meets-art'],['LOOK heritage','https://www.lookcycle.com/ja-en/inside/about-look-heritage'],['Wikimedia Commons: Bernard Hinault, 1982','https://commons.wikimedia.org/wiki/File:Bernard_Hinault_(1982).jpg']]
  },
  'gavia-sneetapen-1988': {
    year:'1988', label:'Løb og store øjeblikke · Giro d’Italia', title:'Da sommerfeltet kørte ind i sneen',
    intro:'Den 5. juni begyndte feltet i regn. På Passo di Gavia var vejen hvid, hænderne følelsesløse og forskellen mellem at fortsætte og at standse næsten væk.',
    image:gavia1988Image, alt:'Illustration af udmattede cykelryttere i tæt sne på et italiensk bjergpas i 1988', caption:'Tidstypisk rekonstruktion af sneetapen over Gavia i 1988. AI-genereret illustration – ikke et historisk fotografi. Illustration: The Evolution of Bikes.',
    sections:[
      ['En kort etape på papiret','Etapen fra Chiesa in Valmalenco til Bormio var 120 kilometer. Afstanden så beskeden ud, men regnen i dalen blev til sne i højden. Gavia var endnu ikke den brede, kontrollerede bjergvej, som et moderne løb helst møder.'],
      ['Van der Velde først over','Johan van der Velde nåede toppen først. På nedkørslen søgte han ly i en autocamper og mistede til sidst 47 minutter. Det var ikke et almindeligt taktisk sammenbrud. Kulden gjorde tøj, bremser og dømmekraft til dele af samme problem.'],
      ['Breukink vandt, Hampsten tog pink','Erik Breukink vandt etapen i Bormio. Andy Hampsten kom ind lige efter og overtog den lyserøde førertrøje med 15 sekunder. Han beholdt den til slut og blev den første amerikanske vinder af Giro d’Italia.'],
      ['Hjælperne langs vejen','Ekstra tøj, varme drikke og hænder fra holdfolk kunne gøre forskellen, men hjælpen var ujævnt fordelt på et bjerg med spredte ryttere. Soigneurer og mekanikere var pludselig lige så afgørende som udvekslingen på cyklen.'],
      ['Billedet der blev tilbage','Gavia 1988 huskes som heroisk, men kulden var ikke en kulisse. Den var en reel fare. Etapen blev stående, fordi den viste både rytternes vilje og grænsen for, hvad et løb kan bede dem om.']
    ], sources:[['Giro d’Italia: Gavia','https://www.giroditalia.it/en/gavia/']]
  },
  'lemond-fignon-otte-sekunder-1989': {
    year:'1989', label:'Løb og store øjeblikke · Tour de France', title:'Otte sekunder på Champs-Élysées',
    intro:'Laurent Fignon begyndte Tourens sidste dag med 50 sekunder i hånden. Efter 24,5 kilometer mod uret havde Greg LeMond vundet løbet med otte.',
    image:lemond1989Image, alt:'Greg LeMond under den afsluttende enkeltstart i Tour de France 1989', caption:'Greg LeMond under den afgørende enkeltstart til Champs-Élysées i 1989. Foto: Benjamin Werner, CC BY 2.0.',
    sections:[
      ['Et løb der stadig var åbent','Touren 1989 havde skiftet hænder flere gange. Før sidste etape førte Laurent Fignon med 50 sekunder. Normalt ville Paris have været en procession. Denne gang ventede en 24,5 kilometer lang enkeltstart fra Versailles.'],
      ['LeMond gjorde sig smal','Greg LeMond brugte aerobøjler, aerohjelm og en samlet position, som førte underarmene frem og kroppen ned. Udstyret gjorde forskellen synlig, men præstationen kom også fra pacing, træning og en rytter, der to år tidligere var blevet alvorligt såret i en jagtulykke.'],
      ['58 sekunder på vejen','LeMond kørte etapen på 26 minutter og 57 sekunder. Fignon brugte 58 sekunder mere. Det vendte et underskud på 50 sekunder til en samlet sejr på otte – den mindste margin i Tourens historie.'],
      ['Fignon var ikke gammeldags','Historien bliver for enkel, hvis Fignon reduceres til manden uden det rigtige styr. Han havde vundet Touren to gange og kørt et stærkt løb. Enkeltstarten var summen af form, position, valg og få sekunder fordelt over hele ruten.'],
      ['Da aerodynamikken fik et ansigt','Otte sekunder gav udviklingen en fortælling, alle kunne forstå. Efter Paris kunne ingen i toppen længere behandle rytterens frontareal som en detalje. Enkeltstartscyklen var blevet et redskab, der kunne flytte selve Tour-sejren.']
    ], sources:[['Tour de France: the 1989 finish','https://www.letour.fr/en/news/2024/finish-with-a-capital-f-champs-elysees-welcome-to-sprinter-heaven-iv-iv/1316968'],['ProCyclingStats: LeMond–Fignon final time trial','https://www.procyclingstats.com/key-event/fignon-lemond-in-final-time-trial-tour-1989'],['Wikimedia Commons: Greg LeMond, stage 21 TT','https://commons.wikimedia.org/wiki/File:Greg_LeMond_1989_Tour_de_France_stage_21_TT.jpg']]
  },
  'soigneuren-og-maden-i-1970erne': {
    year:'1970’erne', label:'Kost, træning og videnskab · Menneskene bag', title:'Bøf klokken fem og kaffe med cognac',
    intro:'Før geler og præcise kulhydratplaner pakkede soigneuren sandwich, frugt og tærter, fyldte dunkene og forsøgte at holde rytterne spisende gennem en lang arbejdsdag.',
    image:soigneur1970sImage, alt:'Molteni-holdet med Eddy Merckx under holdtidskørslen i Tour de France 1971', caption:'Molteni-holdet under holdtidskørslen i Tour de France 1971. Billedet viser periodens holdorganisation, men ikke en forplejningszone. Foto: Anefo · CC BY-SA 3.0 NL.',
    sections:[
      ['Før rytterne kom ned til morgenmad','Soigneuren begyndte sin arbejdsdag før rytterne. Flasker skulle fyldes, små sandwich smøres og dagens musetter fordeles. Rollen rummede langt mere end massage. Soigneuren stod også for tøj, drikke, forplejning og en stor del af den praktiske orden omkring holdet.'],
      ['Bøf og ris før solopgang','Morgenmaden kunne være tung efter nutidens mål. Bøf og ris blev betragtet som sikker næring før en lang etape og blev spist flere timer før starten. Eddy Merckx fortalte i 1977, at han i årevis havde spist bøf med ris klokken fem eller seks om morgenen, og at han efterhånden ikke kunne holde synet af menuen ud. André Dierickx huskede dage med to etaper, hvor rytterne kunne få bøf tre gange.'],
      ['Posen i vejkanten','I forplejningszonen stod soigneurerne med stofposerne løftet i skulderhøjde. Rytteren skulle finde den rigtige mand, gribe remmen uden at få posen i hjulet og hurtigt fordele indholdet i trøjelommerne. En musette kunne indeholde små sandwich, frugt, sukker, tærter eller anden mad, som kunne spises på cyklen. Indholdet varierede mellem hold, løb og ryttere; der fandtes ikke én fast opskrift for hele feltet.'],
      ['Sød kaffe og noget stærkere','Stærk, sødet kaffe var almindelig i cykelsportens forplejning, og beretninger fra perioden nævner også små blandinger af kaffe og cognac. Alkohol var hverken en præcis energiplan eller en god behandling mod kramper. Det hørte til en arbejdskultur, hvor erfaring, vane og anekdoter vejede tungere end moderne ernæringsfysiologi. Cola blev også brugt som en hurtig sukkerkilde, ofte efter at noget af kulsyren var lukket ud.'],
      ['Når posen blev misset','En tabt musette kunne være dyr, især hvis næste mulighed for mad lå langt fremme. Rytteren var ikke nødvendigvis helt uden hjælp; reglerne tillod under bestemte forhold flasker og forplejning fra holdbilen. Men i et langt løb kunne for lidt mad stadig føre til den frygtede fringale, sultkrisen hvor tempo, koncentration og dømmekraft forsvandt næsten på én gang.'],
      ['Mellem håndværk og videnskab','1970’erne var ikke et årti uden viden. Holdene lærte af erfaring, og nogle arbejdede mere systematisk end andre. Men ernæring var endnu sjældent styret af gram kulhydrat pr. time. Soigneurens vigtigste opgave var mere jordnær: at kende rytterne, få maden gjort klar og sørge for, at den faktisk blev spist. Det krævede ikke et laboratorium. Det krævede et vækkeur, en kniv og ganske mange stykker hvidt brød.']
    ], sources:[
      ['KOERS Museum: Jean-Pierre Monseré – steak as a source of strength','https://servicekoers.be/verhalen/jean-pierre-monsere-biefstuk'],
      ['KOERS Museum: La Grande Bouffe – feeding during the Tour','https://servicekoers.be/verhalen/bevoorrading-tijdens-de-tour'],
      ['KOERS Museum: Briek Schotte – bread in the musette','https://servicekoers.be/verhalen/briek-schotte-brood'],
      ['Wikimedia Commons: Molteni team, Tour de France 1971','https://commons.wikimedia.org/wiki/File:Molteni,_Team_time_trial_prologue,_1971_Tour_de_France.jpg']
    ]
  },
  'boonen-paris-roubaix-2009': {
    year:'2009', label:'Løb og store øjeblikke · Paris–Roubaix', title:'Da Roubaix-favoritterne forsvandt én efter én',
    intro:'Seks ryttere nåede samlet frem til Carrefour de l’Arbre. Få minutter senere var flere af udfordrerne væk, og Tom Boonen havde fri vej mod sin tredje sejr.',
    image:'/images/stories/boonen-roubaix-2009/boonen-roubaix-2009.jpg', alt:'Tom Boonen vinder Paris–Roubaix 2009 på velodromen i Roubaix', caption:'Tom Boonen afslutter Paris–Roubaix 2009 på velodromen. Foto: Thomas Ducroquet/Wikimedia Commons, CC BY-SA 3.0.',
    sections:[
      ['Seks mand tilbage','Efter Mons-en-Pévèle sad Tom Boonen i en stærk gruppe med Filippo Pozzato, Thor Hushovd, Juan Antonio Flecha, Leif Hoste og Johan Vansummeren. Boonen havde allerede vundet løbet to gange. De andre vidste, at de ikke med fordel kunne vente på velodromen.'],
      ['Flechas forsøg','Flecha gik ind på Carrefour de l’Arbre med tro på, at han kunne afgøre løbet. I det første sving styrtede han. Cyklen tog skade, og chancen forsvandt på få sekunder. Han beskrev senere netop 2009 som året, hvor han følte sig nærmest sejren.'],
      ['Hushovd rammer barriererne','Boonen og Hushovd kom fri, men nordmanden styrtede ved barriererne på det følgende brostensstykke. Boonen var ikke årsag til styrtene. Hans fordel var, at han stadig sad på cyklen, havde fart og vidste præcis, hvor langt der var hjem.'],
      ['Alene til Roubaix','Boonen kørte resten alene og vandt 47 sekunder foran Pozzato. Hushovd blev nummer tre. Det var belgierens tredje Roubaix-sejr efter 2005 og 2008.'],
      ['Brostenenes enkle regnskab','Løbet blev ikke kun afgjort af rå styrke. Placering, valg af linje, materiel og evnen til at holde sig oprejst sorterede en gruppe, der få kilometer tidligere så jævnbyrdig ud. Roubaix behøver sjældent hjælp til at skabe uorden.']
    ], sources:[['Paris–Roubaix: Juan Antonio Flecha om 2009','https://www.paris-roubaix.fr/en/news/2026/juan-antonio-flecha-paris-roubaix-picks-its-winners-and-sometimes-it-is-unfair-in-its-choices/4769'],['Wikimedia Commons: Boonen, Roubaix 2009','https://commons.wikimedia.org/wiki/File:Boonen_Roubaix_2009_1_(cropped).jpg']]
  },
  'operacion-puerto-2006': {
    year:'2006', label:'Samfund og tidsånd · Doping', title:'Blodposerne, der ramte Touren før starten',
    intro:'Tour-feltet stod klar i Strasbourg, da navnene fra en spansk politisag begyndte at få praktiske følger. Ivan Basso og Jan Ullrich kom aldrig til start.',
    image:'/images/periods/2000-2009/ullrich-gaillac.webp', alt:'Jan Ullrich under enkeltstarten i Tour de France 2003', caption:'Jan Ullrich i Touren 2003. Tre år senere blev han taget ud af Tour-holdet før starten efter oplysninger fra Operación Puerto. Foto: BerndtF, CC BY-SA 3.0.',
    sections:[
      ['En efterforskning i Madrid','Den spanske Guardia Civil efterforskede lægen Eufemiano Fuentes og et netværk omkring blodtransfusioner og dopingmidler. Ved aktionen i maj 2006 blev dokumenter, udstyr samt blod og plasma beslaglagt. UCI opgjorde senere materialet til 211 poser.'],
      ['Startlisten ændrede sig','Få dage før Tour de France begyndte i Strasbourg, blev sagen knyttet til en række ryttere. Favoritterne Ivan Basso og Jan Ullrich blev trukket ud af deres hold. Astana-Würth stod tilbage med for få ryttere til at starte.'],
      ['Koder, hundenavne og DNA','Efterforskningen arbejdede med kodenavne i Fuentes’ materiale. Senere retssager og DNA-sammenligninger knyttede blandt andre Basso og Ullrich til blodposer. Basso erkendte at have fået blod tappet med henblik på en senere transfusion.'],
      ['En sag på tværs af systemer','Dopingregler, spansk strafferet og adgang til politiets materiale fulgte ikke samme logik. WADA og UCI kæmpede i årevis for at få adgang til poserne og bruge dem i sportslige sager.'],
      ['Touren før første etape','Operación Puerto ændrede Touren uden en eneste kilometer. Startlisten blev renset i sidste øjeblik, men sagen løste ikke sportens problem. Den viste snarere, hvor organiseret det var blevet, og hvor vanskeligt beviserne kunne bevæge sig mellem politi, domstole og idræt.']
    ], sources:[['UCI: Operation Puerto blood bags','https://www.uci.org/pressrelease/uci-statement-on-operation-puerto-blood-bags-177532-a341/54bza669eavkjoKa3w3M3O'],['CAS: Valverde-sagen og Operación Puerto','https://www.wada-ama.org/sites/default/files/resources/files/cas_2009_a_1879_valverde_v_coni_en_0.pdf']]
  },
  'bjarne-riis-team-csc': {
    year:'2001–2009', label:'Menneskene bag cyklingen · Holdledelse', title:'Da Bjarne Riis byggede Team CSC',
    intro:'Bjarne Riis overtog et dansk hold med usikker økonomi. I løbet af årtiet blev det til en international organisation, som vandt Touren med Carlos Sastre.',
    image:'/images/periods/2000-2009/sastre-2008.webp', alt:'Carlos Sastre i gul trøje på Champs-Élysées i 2008', caption:'Carlos Sastre afslutter Tour de France 2008 i gult for Team CSC–Saxo Bank. Foto: Bjarte Hetland, CC BY 3.0.',
    sections:[
      ['Et hold skifter hænder','Efter sin aktive karriere gik Bjarne Riis ind i ledelsen af det danske hold, der havde kørt som Home–Jack & Jones og Memory Card–Jack & Jones. Med CSC som sponsor fra 2001 fik projektet en international ramme, men resultaterne kom ikke af navneskiftet alene.'],
      ['Roller og forberedelse','Riis samlede ryttere, sportsdirektører, trænere og teknikere omkring en mere fast arbejdsform. Træningsdata, udstyrsprøver og nøje planlagte løbsprogrammer blev en del af hverdagen. Det var udviklinger i hele sporten, men Team CSC gjorde dem til sin synlige identitet.'],
      ['Holdånd langt fra cyklen','Holdets overlevelsesture med den tidligere elitesoldat B.S. Christiansen blev berømte. Øvelserne var ikke cykeltræning; de var tænkt som en prøve på kommunikation, ansvar og adfærd under pres. Nogle ryttere fandt mening i dem, andre var mindre begejstrede.'],
      ['Sejren på Alpe d’Huez','I 2008 angreb Carlos Sastre på Alpe d’Huez, tog den gule trøje og beholdt den gennem enkeltstarten. Tour-sejren blev det klare sportslige højdepunkt for Riis’ hold.'],
      ['En kompliceret arv','Riis erkendte i 2007 sin egen brug af EPO som rytter i 1990’erne. Det ændrede måden, hans lederskab blev vurderet på. Team CSC-historien rummer både dygtig organisation og den mistillid, som fulgte hele periodens professionelle cykling.']
    ], sources:[['Tour de France: Carlos Sastre, 2008','https://www.letour.fr/en/rider/carlos-sastre'],['Team Saxo Bank/Tinkoff-historik, UCI holdarkiv','https://www.uci.org/']]
  },
  'carbon-og-68-kilo': {
    year:'2000–2009', label:'Cykler og tekniske nybrud', title:'Da carboncyklen ramte vægtgrænsen',
    intro:'Carbon gjorde det muligt at forme rammen friere og spare vægt. UCI’s minimum på 6,8 kilo betød, at den letteste cykel ikke nødvendigvis måtte bruges uden ballast.',
    image:'/images/periods/2000-2009/allos-2000.webp', alt:'Tour de France-feltet klatrer på Col d’Allos i 2000', caption:'Tour-feltet på Col d’Allos i 2000, mens aluminium og carbon stadig fandtes side om side. Foto: Lazz06, CC BY-SA 4.0.',
    sections:[
      ['Flere materialer på samme startlinje','Ved årtiets begyndelse kørte professionelle stadig på aluminium, carbon, titanium og enkelte stålrammer. Carbon var ikke nyt, men produktionen blev bedre, og større monocoque-dele gav designerne andre muligheder end sammenføjede metalrør.'],
      ['Formen kunne flyttes','Fibrene kunne lægges efter belastningen, og rørene behøvede ikke længere være runde. Krankbokse, kronrør og bagstel voksede i tværsnit. Aerodynamik og stivhed blev synlige salgsord, men en god konstruktion krævede fortsat kontrol med vægt, slagstyrke og køreegenskaber.'],
      ['Grænsen på 6,8 kilo','UCI’s regler satte en minimumsvægt på 6,8 kilo for den komplette cykel. Da topcykler nærmede sig grænsen, kunne mekanikere blive nødt til at kontrollere hver opsætning og i nogle tilfælde tilføje ballast. Sikkerhed og ensartet kontrol vejede tungere end jagten på det lavest mulige tal.'],
      ['Gramjagt med konsekvenser','Titaniumbolte, lette sadler, tynde laklag og nøje valgte hjul kunne spare gram. Men mekanikeren skulle også sikre, at delene holdt til bremsekraft, brosten og tre ugers løb. Den letteste løsning var ikke altid den hurtigste eller mest driftssikre.'],
      ['Den nye normal','Mod slutningen af 2000’erne var carbon blevet standard på de fleste topcykler. Udviklingen fjernede ikke håndværket. Det flyttede en stor del af det fra loddeflammen til forme, fiberretninger, testlaboratorier og en mekanikervægt ved holdbussen.']
    ], sources:[['UCI: Equipment and technical regulations','https://www.uci.org/equipment/bh2JJzw1eB0n876rX2iB1']]
  },
  'froome-finestre-2018': {
    year:'2018', label:'Løb og store øjeblikke · Giro d’Italia', title:'Da Froome angreb med 80 kilometer tilbage',
    intro:'Chris Froome begyndte 19. etape som nummer fire. På Colle delle Finestre kørte han alene og vendte et Giro-løb, der ellers så ud til at være afgjort.',
    image:'/images/periods/2010-2019/thomas-froome-2018.webp', alt:'Chris Froome og Geraint Thomas under et etapeløb i 2018', caption:'Chris Froome, her sammen med Geraint Thomas under Tour de France 2018. Billedet er et samtidigt portræt og viser ikke angrebet på Finestre. Foto: filip bossuyt · CC BY 2.0.',
    sections:[
      ['Tre minutter og 22 sekunder','Før 19. etape lå Froome nummer fire, 3 minutter og 22 sekunder efter Simon Yates. Han havde vundet på Monte Zoncolan, men havde også tabt tid og styrtet under optakten. Med to afgørende løbsdage tilbage var en kontrolleret podieplads den nærliggende mulighed.'],
      ['Angrebet på gruset','Team Sky satte tempo på Colle delle Finestre. Da vejen blev til grus, angreb Froome med omkring 80 kilometer til mål. Tom Dumoulin, Thibaut Pinot og de øvrige klassementsryttere måtte vælge mellem at samarbejde og holde egne kræfter tilbage. Yates mistede hurtigt kontakten.'],
      ['Tre bjerge alene','Finestre var ikke afslutningen. Froome skulle videre over Sestriere og op mod Jafferau. Bag ham skiftede jagtgruppen mellem samarbejde og tøven. Foran holdt han et tempo, der gjorde en satsning til en stadig mere reel føring.'],
      ['Lyserød på én dag','Froome vandt etapen 3 minutter og 23 sekunder foran Dumoulin og overtog den lyserøde trøje. Dagen efter forsvarede han føringen, og i Rom blev han den første britiske vinder af Giro d’Italia.'],
      ['Data og gammeldags risiko','Angrebet kom fra et hold, der var kendt for watt, ernæringsplaner og kontrolleret bjergtempo. Alligevel blev årtiets mest markante Giro-manøvre et langt soloforsøg med risiko for at tabe alt. Teknologien kunne måle indsatsen. Den kunne ikke køre de sidste 80 kilometer.']
    ], sources:[['Giro d’Italia: Memories from Colle delle Finestre 2018','https://www.giroditalia.it/en/news/memories-from-colle-delle-finestre-2018-chris-froomes-legendary-attack/']]
  },
  'tignes-etapen-stoppet-2019': {
    year:'2019', label:'Løb og store øjeblikke · Tour de France', title:'Da Tour-etapen sluttede uden en målstreg',
    intro:'Egan Bernal angreb på Col de l’Iseran. Længere fremme gjorde hagl og jordskred vejen mod Tignes ufremkommelig, og løbsledelsen måtte standse etapen.',
    image:'/images/periods/2010-2019/bernal-2019.webp', alt:'Egan Bernal i Tour de Frances gule trøje i 2019', caption:'Egan Bernal i den gule trøje efter den afbrudte etape mod Tignes. Foto: filip bossuyt · CC BY 2.0.',
    sections:[
      ['Angrebet på Iseran','På 19. etape angreb Bernal op mod Col de l’Iseran. Julian Alaphilippe, der bar gult, kom under pres, mens Bernal passerede toppen forrest og kørte mod nedkørslen med mulighed for at overtage løbet.'],
      ['Vejen forsvandt foran feltet','Et voldsomt uvejr ramte vejen længere fremme. Hagl dækkede asfalten, og jord og vand gjorde passagen mod Tignes ufremkommelig. Rytterne så først officials vifte dem ind til siden. Forklaringen kom bagefter.'],
      ['Tiden blev taget på toppen','Løbsledelsen brugte tiderne ved Col de l’Iseran. Der blev ikke kåret nogen etapevinder, men tidsforskellene talte i klassementet. Bernal overtog den gule trøje, mens Alaphilippes lange forsvar sluttede uden den planlagte sidste stigning.'],
      ['Et løb uden den sædvanlige afslutning','Etapeløb bygger på faste mellemregninger: en start, kontrolpunkter og en målstreg. I Tignes blev sikkerheden vigtigere end formen. Beslutningen gav et usædvanligt resultat, men alternativet var at sende feltet ind på en vej, som ikke længere var farbar.'],
      ['Bernals Tour','Dagen efter blev endnu en alpeetape forkortet på grund af vejret. Bernal beholdt føringen til Paris og blev som 22-årig den første colombianske Tour-vinder. Hans afgørende angreb sluttede ikke under en målportal, men ved en tidsregistrering på et bjergpas.']
    ], sources:[['Tour de France: Stormy conditions shorten stage 19','https://www.letour.fr/en/news/2019/stormy-conditions-shorten-stage-19-bernal-in-the-lead/1282764']]
  },
  'gilbert-flandern-rundt-2017': {
    year:'2017', label:'Løb og store øjeblikke · Flandern Rundt', title:'Da Philippe Gilbert kørte væk på Oude Kwaremont',
    intro:'Et angreb mere end 50 kilometer fra mål lignede først holdtaktik. Philippe Gilbert fortsatte alene og nåede Oudenaarde med forspringet i behold.',
    image:'/images/periods/2010-2019/wiggins-2012.webp', alt:'Professionelt landevejsfelt i 2010’erne', caption:'Det professionelle felt i 2010’erne blev stadig mere styret af radio og data. Billedet viser Tour-feltet i 2012, ikke Flandern Rundt 2017. Foto: William Morice · CC BY 2.0.',
    sections:[
      ['Quick-Step åbner løbet','Quick-Step Floors havde flere mulige vindere og brugte dem aktivt. På den anden passage af Oude Kwaremont satte holdet farten op. Gilbert kom fri sammen med en gruppe, før han fortsatte alene med mere end 50 kilometer tilbage.'],
      ['Ingen venten på finalen','En lang solotur i Flandern Rundt koster kræfter på brosten, bakker og åbne veje. Gilbert kunne have ventet på hjælp eller gemt angrebet til finalen. I stedet holdt han presset, mens jagten bag ham blev præget af rivalernes forskellige interesser.'],
      ['Sagan, Van Avermaet og styrtet','Peter Sagan, Greg Van Avermaet og Oliver Naesen var blandt de stærkeste forfølgere. På den sidste passage af Oude Kwaremont styrtede Sagan, da han kom i kontakt med en jakke over tilskuerhegnet. Van Avermaet og Naesen blev også revet med.'],
      ['Mål alene i Oudenaarde','Gilbert nåede mål alene og vandt foran Van Avermaet og Niki Terpstra. Det var hans første sejr i Flandern Rundt og endnu et monument på et resultatkort, der allerede rummede Liège–Bastogne–Liège og Lombardiet Rundt.'],
      ['Radioen bestemte ikke alt','2010’ernes løb blev ofte beskrevet som kontrollerede. Gilbert viste, at et tidligt angreb stadig kunne bryde planen op. Holdradioen kunne give afstande. Den kunne ikke få jagtgruppen til at blive enig.']
    ], sources:[['Flandern Rundt: History and winners','https://www.rondevanvlaanderen.be/en/race/men-elite/history']]
  },
  'sram-etap-traadloese-gear': {
    year:'2015', label:'Cykler og tekniske nybrud · Gear', title:'Da gearkablet forsvandt',
    intro:'SRAM RED eTap flyttede signalet mellem skiftegreb og gearmekanismer over i luften. Det ændrede både betjening, montering og udseendet på racercyklen.',
    image:'/images/bikes/scapin-k6/hero.webp', alt:'Scapin K6 carbonracercykel fra 2013 med mekanisk Campagnolo geargruppe', caption:'Samlingens Scapin K6 fra 2013 har mekanisk gear og viser udgangspunktet umiddelbart før de trådløse landevejsgrupper. Foto: The Evolution of Bikes.',
    sections:[
      ['Elektronisk var ikke længere nyt','Shimano havde allerede gjort elektronisk gearskifte til et driftssikkert værktøj i professionel cykling, og Campagnolo fulgte med EPS. Systemerne brugte ledninger mellem greb, batteri og gearmekanismer. SRAM valgte en anden vej.'],
      ['Et signal uden kabel','RED eTap blev præsenteret i 2015 som en trådløs 11-delt landevejsgruppe. Hvert skiftegreb sendte et kodet signal, og for- og bagskifter havde egne batterier. SRAM kaldte forbindelsen Airea; det var hverken almindelig Bluetooth eller ANT+.'],
      ['Venstre lettere, højre tungere','Betjeningen blev gjort enkel: venstre greb flyttede kæden til et lettere tandhjul, højre til et tungere, og begge samtidig styrede forskifteren. Løsningen fjernede flere knapper og gjorde det vanskeligt at tage fejl med kolde fingre.'],
      ['Mekanikerens nye arbejde','Uden gearkabler blev opsætningen lettere på rammer med kompliceret kabelføring. Til gengæld kom opladning, parring, batteristatus og software ind i værktøjskassen. Den mekaniske justering forsvandt ikke; den fik blot selskab af radiosignaler.'],
      ['Den rene ramme','Trådløst gear passede godt til årtiets integrerede carboncykler. Færre kabler gav konstruktørerne friere føring og et roligere udseende. På få år gik løsningen fra særpræg til en almindelig mulighed på sportslige racercykler.']
    ], sources:[['SRAM: Company history — RED eTap announced in 2015','https://www.sram.com/fr/company/about/history'],['SRAM Support: the Airea wireless protocol','https://support.sram.com/hc/en-us/articles/6086267696795-Is-the-SRAM-eTap-wireless-protocol-considered-Bluetooth-or-ANT']]
  },
  'annie-londonderry-verden-rundt': {
    year:'1894–1895', label:'Cykelkultur og hverdagsliv · Kvinder på cykel', title:'Annie Londonderry gjorde cykelturen til en forestilling',
    intro:'Annie Cohen Kopchovsky forlod Boston på en tung kvindecykel og kom tilbage femten måneder senere som Annie Londonderry. Undervejs gjorde hun reklamer, tøj og gode historier til en del af rejsen.',
    image:annieImage, alt:'Portræt af Annie Londonderry omkring 1896', caption:'Annie Cohen Kopchovsky, bedre kendt som Annie Londonderry, fotograferet i Boston omkring 1896. Studio Tourne · public domain.',
    sections:[
      ['Et navn kunne sælges','Da den 23-årige Annie Cohen Kopchovsky kørte fra Massachusetts State House i Boston den 25. juni 1894, efterlod hun mand og tre små børn. Hun tog samtidig et nyt navn. Londonderry Lithia Spring Water betalte hende for at bære firmaets navn på cyklen, og Annie Londonderry var lettere at sælge til aviserne end Annie Kopchovsky. Allerede før den første lange dag var turen derfor både rejse, reklame og offentlig optræden.'],
      ['En kvindecykel viste sig upraktisk','Hun begyndte i lang nederdel på en Columbia-cykel beregnet til kvinder. I Chicago skiftede hun til en lettere Sterling med overrør og tog bukser på. Det var en praktisk løsning, men også en offentlig markering i en tid, hvor kvinders tøj og bevægelsesfrihed blev diskuteret ivrigt. Cyklen gav kvinder en rækkevidde, de ikke behøvede at bede en kusk eller ægtemand om. Den skabte selvfølgelig også bekymrede ledere i aviserne.'],
      ['Jorden rundt – med flere transportmidler','Londonderry sejlede fra New York til Le Havre og fortsatte gennem Frankrig til Marseille. Senere gik rejsen med skib via Middelhavet og Asien til USA. Hun cyklede betydelige strækninger, men ikke hele vejen rundt om kloden, sådan som de mest begejstrede versioner senere har fortalt. Tog og dampskibe var en del af planen. Bedriften lå lige så meget i at gennemføre en international rejse alene og holde offentlighedens interesse fast.'],
      ['Historierne voksede undervejs','Hun gav interviews, holdt foredrag, solgte fotografier og bar reklameskilte. Fortællinger om jagter, krig og farlige møder ændrede sig fra by til by. Nogle detaljer kan ikke bringes til at passe sammen, men overdrivelsen var ikke en fejl ved projektet. Den var en del af hendes arbejde. Hvis publikum betalte for at høre om turen, skulle turen også være værd at høre om.'],
      ['Tilbage i Boston','Den 24. september 1895 var hun tilbage i Boston efter omtrent femten måneder. Rejsen var blevet omtalt som et væddemål om, hvorvidt en kvinde kunne klare en jordomrejse og tjene penge undervejs. Om selve væddemålet fandtes præcis som beskrevet, er usikkert. Det sikre er, at Londonderry kom hjem som en kendt person og kort efter skrev under navnet The New Woman.'],
      ['Cyklen som adgangsbillet','Hun blev ikke husket for en løbssejr eller en rekord på en velodrom. Hendes præstation var at bruge cyklen som adgang til aviser, scener, sponsorer og lande, hvor en ung immigrantkvinde ellers sjældent fik lov at definere fortællingen selv. Hun solgte sit navn, skiftede tøj, tog toget, cyklede videre og gav pressen en historie. Det var ganske moderne længe før ordet influencer blev nødvendigt.']
    ], sources:[['University of Toronto: Annie Londonderry’s Extraordinary Ride','https://wjudaism.library.utoronto.ca/index.php/wjudaism/article/download/3534/1591/5373'],['Wikimedia Commons: Annie Londonderry omkring 1896','https://commons.wikimedia.org/wiki/File:Annie_Londonderry_vers_1896.jpg']]
  },
  'tour-1947-rationering': {
    year:'1947', label:'Kost, træning og videnskab · Tour de France', title:'Da Touren vendte tilbage til et sultent Frankrig',
    intro:'Tour de France kom tilbage i 1947 efter otte års pause. Feltet skulle spise sig gennem 4.640 kilometer i et land, hvor brødrationen samme sommer blev sat ned til 200 gram om dagen.',
    image:tour1947Image, alt:'Arie Vooren kommer i mål under Tour de France 1947', caption:'Arie Vooren kommer i mål som nummer fire på en etape i Tour de France 1947. Harry Sagers/Anefo · CC BY-SA 3.0 NL.',
    sections:[
      ['Et løb vender tilbage','Den 25. juni 1947 stod Tour-feltet igen i Paris. Den seneste udgave var kørt i 1939. Siden havde besættelse, krig og mangel ændret Frankrig, mens forskellige arrangører havde forsøgt at genstarte store etapeløb. Jacques Goddet og avisen L’Équipe fik Touren tilbage på vejen med 100 ryttere, 21 etaper og 4.640 kilometer.'],
      ['Brød var stadig et regnestykke','Fred betød ikke fulde butikker. Den franske hvedehøst svigtede i 1947, og myndighederne sænkede den daglige brødration fra 300 til 250 og siden 200 gram. Rationeringskort, køer og erstatningsvarer var stadig en del af hverdagen. Tilskuerne langs vejen så derfor et løb, der krævede enorme mængder energi, midt i et samfund hvor hver skive brød blev talt.'],
      ['Rytterne skulle have særbehandling','Et etapeløb kan ikke køres på en civil dagsration. Holdene og arrangørerne måtte skaffe mad gennem hoteller, lokale forbindelser og den organiserede forplejning omkring løbet. Menuerne var stadig en blanding af periodens vaner: brød, ris eller pasta, kød, æg, frugt, sukker og stærke drikke. Præcise menuer varierede, men forskellen til hverdagen udenfor var tydelig. Et felt i arbejde fik adgang til kalorier, som mange tilskuere savnede.'],
      ['Nationalhold og en hel karavane','Touren blev kørt af nationale og regionale hold. Omkring rytterne bevægede sig mekanikere, soigneurs, journalister og reklamekaravane fra hotel til hotel. Organisationen var langt fra nutidens mobile køkkener, men den var stor nok til at skabe sin egen forsyningslinje. En glemt madpose eller et dårligt hotelmåltid kunne stadig mærkes dagen efter.'],
      ['Robic vandt på den sidste dag','Løbet fik sin afgørelse sent. Jean Robic begyndte sidste etape som nummer tre, angreb med Edouard Fachleitner og tog tid nok til at vinde Touren uden tidligere at have båret den gule trøje. Den fortælling har sin egen plads. I denne sammenhæng er pointen en anden: mens Frankrig talte rationer, brugte Touren sult, overflod og udmattelse som synligt teater langs landevejen.'],
      ['Et tegn på normalitet – næsten','Tourens tilbagekomst blev et tegn på, at den gamle kalender og den gamle sommer kunne begynde igen. Men 1947 var ikke et ubekymret genopbygningsår. Rationeringen fortsatte til 1949. Billederne af ryttere ved målstregen viser derfor ikke blot et løb, der var tilbage. De viser en stor omrejsende organisation, der igen kunne krydse landet, selv om landet endnu ikke spiste sig mæt.']
    ], sources:[['Tour de France: 1947 edition','https://www.letour.fr/en/history'],['U.S. State Department: France’s 1947 wheat and bread crisis','https://history.state.gov/historicaldocuments/frus1947v03/d268'],['Chemins de mémoire: rationing ended in France in 1949','https://www.cheminsdememoire.gouv.fr/en/node/10023'],['Wikimedia Commons: Arie Vooren, Tour 1947','https://commons.wikimedia.org/wiki/File:Arie_Vooren,_Tour_de_France_1947.jpg']]
  },
  '7-eleven-europa': {
    year:'1985–1986', label:'Samfund og tidsånd · Professionelle hold', title:'Da 7-Eleven kom til Europa',
    intro:'Et amerikansk hold med navn efter en døgnbutik kom til Giroen i 1985 og Touren året efter. De skulle lære Europas uskrevne regler, men de kom ikke kun for at se på.',
    image:sevenElevenImage, alt:'Eddy Merckx-holdcykel i 7-Elevens farver fra 1989', caption:'En bevaret Eddy Merckx-holdcykel i 7-Elevens grønne, røde og hvide farver fra 1989. Foto: PD7400-pusher · public domain.',
    sections:[
      ['Et hold fra supermarkedet','Jim Ochowicz grundlagde 7-Eleven-holdet i 1981 sammen med Eric Heiden og George Mount. Det begyndte som et amerikansk amatørprojekt med et usædvanligt navn og klare farver. Efter OL i Los Angeles i 1984 blev ambitionen større: holdet skulle være professionelt og ind i den europæiske kalender, hvor reglerne også fandtes mellem linjerne.'],
      ['Giroen som første prøve','I 1985 fik holdet invitation til Giro d’Italia. Mike Neel kom med europæisk erfaring som sportsdirektør, og Andy Hampsten blev hentet ind på en kort kontrakt. Ron Kiefel vandt en etape i Perugia, og Hampsten vandt senere i Gran Paradiso. Resultaterne gjorde mere end lange præsentationer kunne have gjort. De viste, at amerikanerne kunne afslutte arbejdet.'],
      ['Det praktiske kulturchok','Europæisk professionel cykling var hoteller, smalle veje, sene måltider, andre sprog og en fast rangorden i feltet. Amerikanerne kom med OL-baggrund, holdtøj der lignede butiksfacader og mindre respekt for den gamle orden. Historierne om for store biler, fejlede bestillinger og forbløffede mekanikere er blevet en del af holdets overlevering. Ikke alle detaljer kan kontrolleres, men mødet mellem to arbejdskulturer var reelt.'],
      ['Den første Tour','I 1986 blev 7-Eleven det første amerikansk baserede hold i Tour de France. Allerede på prologen og første etape samlede canadieren Alex Stieda bonussekunder nok til kortvarigt at tage både gul, prikket, grøn og hvid trøje. Dagen efter vandt Davis Phinney en massespurt. Holdet gik fra kuriosum til løbsaktør på et par døgn.'],
      ['Europa ændrede også holdet','7-Eleven blev mere europæisk i organisation og løbsprogram, men beholdt sit amerikanske præg. Senere kom ryttere som Andy Hampsten tilbage, og holdet vandt Giroen med ham i 1988. Cyklerne blev bygget af europæiske producenter som Eddy Merckx, mens sponsoren og meget af holdets identitet kom fra USA. Internationaliseringen gik begge veje.'],
      ['En ny type professionel cykling','7-Eleven var ikke alene årsag til sportens forandring, men holdet gjorde den synlig. Tv, internationale sponsorer og ryttere fra flere kontinenter udvidede det gamle vesteuropæiske miljø. En døgnbutik på en Merckx-ramme lød først som en mærkelig kombination. Få år senere var globale brands og multinationale hold blevet almindelige.']
    ], sources:[['Tour de France: Alex Stieda’s day in yellow','https://www.letour.fr/en/news/2019/a-day-in-yellow-alex-stieda-vii-x/1276101'],['Team history: 7-Eleven and the 1986 Tour','https://www.bikeraceinfo.com/riderhistories/7-eleven-1986.html'],['Motorola team guide 1995','https://www.bicycletourcompany.com/about_us/pdf/motorola95.pdf'],['Wikimedia Commons: 7-Eleven team bicycle','https://commons.wikimedia.org/wiki/File:1989_7-Eleven_TEAM_-_Eddy_Merckx_1-10.JPG']]
  },
  'lotus-108-boardman-1992': {
    year:'1992', label:'Menneskene bag cyklingen · Aerodynamik', title:'Cyklen uden den sædvanlige trekant',
    intro:'Mike Burrows tegnede en kulfibercykel, cykelverdenen sagde først nej, og Lotus gjorde den klar til Chris Boardmans jagt på OL-guldet i Barcelona.',
    image:lotusImage, alt:'Sort Lotus 108 banecykel udstillet på Design Museum', caption:'Lotus 108 med monocoque-ramme og ensidet forgaffel. Foto: Ged Carroll · CC BY 2.0.',
    sections:[
      ['En form uden rør','Mike Burrows arbejdede med liggecykler, aerodynamik og kompositter, da han i 1980’erne udviklede en banecykel, som ikke lignede en samling af rør. Rammen var en kulfiber-monocoque: en bærende skal formet omkring luftstrøm og belastning. Den traditionelle diamant med overrør og skrårør var væk. Det samme var den velkendte dobbeltsidede forgaffel.'],
      ['Reglerne kom i vejen','Burrows’ konstruktion blev først afvist, fordi cykelreglerne ikke tillod monocoque-formen. Da UCI ændrede reglerne omkring 1990, blev idéen relevant igen. Lotus Engineering havde erfaring med kulfiber fra motorsport og kunne udvikle og fremstille konstruktionen med de tolerancer, et olympisk projekt krævede. Burrows leverede grundideen; Lotus’ ingeniører gjorde den til en færdig konkurrencecykel.'],
      ['Boardman var den anden halvdel','En aerodynamisk cykel er kun hurtig, hvis rytteren kan holde positionen og levere kraften. Chris Boardman var kendt for omhyggelig forberedelse og en disciplineret jagt på marginaler. I 4.000 meter individuelt forfølgelsesløb skal rytteren accelerere en tung gearing, finde rytmen og holde en position, hvor hoved, skuldre, arme og ryg arbejder sammen med cyklen.'],
      ['4 minutter og 24,496 sekunder','I Barcelona nåede Boardman finalen mod Jens Lehmann. Han hentede tyskeren før distancen var kørt og sikrede Storbritanniens første olympiske cykelguld i 72 år. Tiden 4.24,496 blev stående som et tal fra den dag, men billederne af den sorte cykel gjorde mindst lige så stort indtryk. Den lignede udstyr fra et andet regelsæt.'],
      ['Lotus-navnet og cykelverdenen','Succesen skabte landevejsmodellen Lotus 110 og en kort periode, hvor mærket blev et symbol på den nye kulfiberteknik. Produktionen var dyr, og cyklerne blev aldrig almindelige. Det var heller ikke nødvendigt for at få betydning. Lotus 108 viste, at en racercykel kunne konstrueres som en samlet aerodynamisk form i stedet for som en række rør med komponenter på.'],
      ['Hvem stod bag sejren?','Historien bliver ofte forkortet til Boardman og en Lotus. Men cyklen fandtes, fordi Burrows havde holdt fast i en idé gennem regelmæssig modstand, fordi Lotus kunne industrialisere den, og fordi trænere, teknikere og rytteren fik den til at fungere på banen. Den hurtigste genstand var resultatet af mange langsomme arbejdstimer. Det plejer mekanikken at være.']
    ], sources:[['Design Museum: Lotus Type 108','https://designmuseum.org/exhibitions/cycle-revolution'],['Olympic Museum: Lotus bicycle and Mike Burrows','https://olympic-museum-artefacts.zetcom.net/en/collection/item/102185/'],['Lane Motor Museum: Lotus Type 110 and the Burrows design','https://www.lanemotormuseum.org/collection/bicycles/item/lotus-type-110tt/'],['Wikimedia Commons: Lotus 108','https://commons.wikimedia.org/wiki/File:Lotus_1_bicycle_from_1992_Barcelona_Olympics_(25555726434).jpg']]
  },
  'tourmad-i-1930erne': {
    year:'1930’erne', label:'Kost, træning og videnskab · Tour de France', title:'Da Touren selv skulle sørge for middagen',
    intro:'Da Tour de France indførte nationalhold i 1930, overtog arrangøren også ansvaret for rytternes mad og logi. Det gjorde kosten mere organiseret, men næppe mere enkel.',
    image:guerra1930Image, alt:'Learco Guerra under Tour de France 1930', caption:'Learco Guerra under Tour de France 1930, den første udgave med nationalhold og fælles forsyning organiseret af løbet. Bibliothèque nationale de France · public domain.',
    sections:[
      ['En tallerken blev pludselig arrangørens problem','Før 1930 stillede firmaholdene med ryttere, cykler, hjælpere og penge. De sørgede også for mad og hoteller. Henri Desgrange brød med systemet og erstattede firmaholdene med nationalhold. Alle fik ens gule cykler, og Tour-organisationen måtte betale for ophold, transport og forplejning. Reklamekaravanen blev indført samme år og var med til at finansiere regningen. Et nyt sportsligt system begyndte derfor i køkkenet såvel som på landevejen.'],
      ['Morgenmaden skulle kunne mærkes','En lang etape kunne vare det meste af dagen, og rytterne spiste derefter. Måltiderne byggede på den almindelige forestilling om styrke: kød, æg, brød, ris, suppe og kaffe. Det var ikke usædvanligt at begynde med en bøf eller anden varm mad. Kulhydrat fandtes selvfølgelig på tallerkenen, men ikke som et præcist antal gram pr. time. Man spiste for at blive mæt og for at have noget at arbejde med. Det gav sommetider en tung begyndelse på dagen.'],
      ['Madposen var dagens mellemregning','Undervejs blev mad og drikke rakt ud i poser. Brød, frugt, chokolade, sukker, ris eller små stykker kød kunne holde en rytter i gang mellem byerne. Hvad der lå i posen, afhang af hold, hotel og lokale muligheder. Nogle ventede længe med at spise, fordi man frygtede en tung mave. Andre spiste, når chancen bød sig. Den moderne ordre om at indtage et bestemt antal kulhydrater hvert tyvende minut lå endnu mange år fremme.'],
      ['Roger Lapébie passede ikke ind i bøfreglen','Tour-vinderen fra 1937 blev siden beskrevet som næsten vegetarisk, og det er en nyttig påmindelse om, at der aldrig fandtes én fælles menu for hele feltet. Nogle ryttere sværgede til kød, andre til ris, mælk, æg eller frugt. En succesfuld rytters vane kunne hurtigt blive kopieret, også når forklaringen på sejren lå et helt andet sted. Erfaring og overtro stod tæt på hinanden.'],
      ['Ølstop er en god historie – og siger noget sandt','Den bedst kendte episode kom på 17. etape i 1935. Historien går, at en stor del af feltet standsede ved et øludskænkningssted, mens Julien Moineau kørte videre og vandt med stort forspring. De farverige enkeltheder varierer, men alkohol ved løbene var ikke mærkeligt. Øl og vin gav væske, kalorier og et kort pusterum. Det betyder ikke, at feltet altid kørte beruset. Det betyder, at sportens grænse mellem forplejning og fornøjelse så anderledes ud.'],
      ['De første vitaminer kom ind ad sidedøren','Mod slutningen af årtiet begyndte ryttere og hold at tale mere systematisk om vitaminer og kostens betydning. I Touren 1939 blev vitaminbrug omtalt som en mulig hjælp til præstationen. Den nye interesse erstattede ikke straks gamle vaner; den lagde sig oven på dem. En rytter kunne derfor få både en vitaminpille, en stor bøf og et glas vin inden for samme døgn uden at se nogen modsætning. Videnskaben var på vej, men den rejste endnu med blandet bagage.'],
      ['Fra hotelkøkken til sportslaboratorium','1930’ernes vigtigste forandring var ikke én bestemt ret. Det var, at forplejningen blev en tydelig del af løbets organisation. Når Touren stillede holdene, måtte Touren også skaffe senge og kalorier. Soigneurs, hotelværter og hjælpere blev lige så nødvendige som gryder og madposer. Ernæringen var stadig upræcis, men den var ikke længere kun rytterens private problem. Derfra var der langt til nutidens kokke og ernæringsplaner – men retningen var sat.']
    ], sources:[['KOERS Museum: forsyning under Tour de France','https://servicekoers.be/verhalen/bevoorrading-tijdens-de-tour'],['L’Équipe: Tourens måltidshistorie','https://www.lequipe.fr/Cyclisme-sur-route/Article/La-copieuse-histoire-des-repas-du-tour-de-france/1226539'],['Tour de France 1930: nationalhold, mad og logi','https://www.bikeraceinfo.com/tdf/tdf1930.html'],['Wikimedia Commons: Learco Guerra i Touren 1930','https://commons.wikimedia.org/wiki/File:1930-Learco_Guerra-Tour.jpg']]
  },
  'faliero-masi-vigorelli': {
    year:'1949–1969', label:'Menneskene bag cyklingen · Rammebygning', title:'Skrædderen under Vigorelli',
    intro:'Faliero Masi arbejdede i et lille værksted under tribunerne på Vigorelli-banen i Milano. Her blev ryttere målt, stål skåret og berømte cykler forsynet med andre navne.',
    image:masiImage, alt:'Jacques Anquetil under Tour de France 1966', caption:'Jacques Anquetil i 1966. Ti år tidligere satte han timerekord på Vigorelli på en ramme bygget af Faliero Masi. Eric Koch/Anefo · CC BY-SA 3.0 NL.',
    sections:[
      ['Værkstedet lå under svinget','Vigorelli var ikke kun en træbane med stejle kurver. Under tribunerne fandtes omklædning, depoter og fra 1949 Faliero Masis værksted. Når rytterne trænede ovenpå, kunne Masi høre banen og se de mennesker, cyklerne skulle passe til. Han havde selv kørt løb og arbejdet som mekaniker. Det gav ham blik for, at et stel ikke blot skulle have de rigtige mål på papiret. Det skulle fungere under en bestemt krop.'],
      ['Tilnavnet var skrædderen','Masi blev kaldt il sarto, skrædderen. Sammenligningen handlede om pasform. Han målte ben, overkrop, skuldre og kørestilling og tilpassede rørvinkler og længder, så rytteren kunne arbejde naturligt. Det foregik med stållineal, vinkel, øjemål og erfaring, ikke med en laserscanner. To ryttere af samme højde behøvede ikke samme cykel. Den ene sad dybt og roligt; den anden flyttede sig konstant. Stellet måtte tage højde for begge dele.'],
      ['Anquetils cykel passede ikke til banen','Før Jacques Anquetils timerekordforsøg i 1956 viste den medbragte cykel sig ifølge Vigorellis egen historie uegnet til banens stramme sving. Masi byggede hurtigt en anden. Den 29. juni kørte Anquetil 46,159 kilometer og slog Fausto Coppis gamle rekord. Historien blev siden fortalt med værkstedets tempo som hovedpunkt. Det sikre er, at Masi byggede rekordcyklen, og at en rammebyggers lokale kendskab fik direkte betydning for verdensrekorden.'],
      ['Navnet på skrårøret var ikke altid Masi','Professionelle hold havde kontrakter med cykelmærker. Rytteren kunne derfor køre på et specialbygget Masi-stel, mens sponsorens navn stod udenpå. Praksissen var hverken unik for Masi eller nødvendigvis en stor hemmelighed i feltet. Den viser blot forskellen mellem det mærke, publikum så, og den håndværker, som havde bestemt geometrien og samlet rørene. Mekanikere kendte forskellen. De skulle passe på cyklen bagefter.'],
      ['1960’ernes vindere kom forbi','Masi byggede for Federico Bahamontes omkring Tour-sejren i 1959 og Gastone Nencini i 1960. I 1960’erne fulgte blandt andre Rik Van Looy, Antonio Maspes og senere Eddy Merckx. Det betyder ikke, at alle deres cykler eller sejre tilhører én rammebygger. Hold, producenter og sæsoner skiftede. Men værkstedet blev et knudepunkt, hvor professionelle ryttere kunne få rettet en position eller bygget et stel til en bestemt opgave.'],
      ['Stålrammen var et samarbejde','Et godt stel begyndte med gode rør, men blev afgjort i samlingerne og i valget af mål. Rør skulle skæres præcist, muffer tilpasses, lodningen varme metallet uden at ødelægge det, og bagstellet skulle stå lige. Derefter kom lakering, komponenter og rytterens første tur. Hvis cyklen føltes forkert, var tegningen ikke færdig blot fordi lakken var tør. Masi arbejdede tæt på ryttere og mekanikere, så erfaringen kunne komme tilbage til arbejdsbordet.'],
      ['Manden bag et andet navn','I dag står Masi-navnet tydeligt på samlercykler. I 1960’ernes felt kunne hans arbejde være skjult under et sponsorlogo. Det passer egentlig godt til mekanikerens og rammebyggerens rolle: præstationen skulle være synlig, personen bag behøvede ikke være det. Under Vigorelli kunne Faliero Masi gå ned ad få trin, tænde værkstedslyset og ændre et mål med nogle millimeter. Ovenpå kunne de millimeter blive til en verdensrekord eller en lidt bedre arbejdsdag.']
    ], sources:[['Velodromo Vigorelli: historie og Masis værksted','https://www.vigorelli.eu/il-vigorelli/storia'],['Velodromo Vigorelli: Anquetils rekordcykel','https://www.vigorelli.eu/vecchio_sito/storia/stcamp.html'],['Masi: historisk tidslinje','https://masibikes.com/pages/history'],['Wikimedia Commons: Jacques Anquetil, Tour 1966','https://commons.wikimedia.org/wiki/File:Jacques_Anquetil,_Tour_de_France_1966_(cropped).jpg']]
  },
  'da-fjernsynet-fandt-touren': {
    year:'1948–1959', label:'Samfund og tidsånd · Medier', title:'Da Touren flyttede ind i fjernsynet',
    intro:'Radioen havde længe givet Touren en stemme. Fjernsynet skulle først lære at følge et løb, der flyttede sig hver dag og ofte forsvandt ind mellem bjergene.',
    image:walkowiakContextImage, alt:'Ryttere og tilskuere i en forplejningszone under Tour de France 1958', caption:'Tour de France 1958 blev den første udgave, hvor bjergkørsel blev vist direkte på fjernsyn. Her passerer rytterne en forplejningszone. Nationaal Archief/Anefo · CC0.',
    sections:[
      ['En direkte udsendelse fra en fast målstreg','I 1948 blev en Tour-målgang for første gang sendt direkte på fransk fjernsyn. Det lyder beskedent nu, men opgaven passede dårligt til tidens teknik. Kamera, kontrolvogn, kabler og signalforbindelse skulle stå ét sted, mens løbet nærmede sig uden en helt præcis tidsplan. Seerne fik afslutningen, ikke hele etapen. Det meste af dagens løb måtte stadig fortælles af radioen, avisen og de korte filmoptagelser bagefter.'],
      ['Touren var et fjernsynsproblem','Et stadion kunne belyses, kabelføres og prøves på forhånd. Touren begyndte et nyt sted hver morgen. Bjerge spærrede for radiosignaler, vejene var smalle, og strøm og forbindelser skulle etableres midlertidigt. En motorcykel kunne filme tæt på rytterne, men billedet skulle videre til en modtager og derfra ud til seerne. Fjernsynets folk fulgte derfor ikke bare løbet. De byggede en ny produktionsplads hver dag.'],
      ['Bjergene kom på skærmen i 1958','I 1958 blev bjergstigninger for første gang vist direkte. Nu kunne seeren følge ansigter, rytme og afstande, mens de blev skabt, i stedet for at vente på aftenens film eller næste dags avis. Charly Gauls Tour-sejr fik dermed en anden offentlig ramme end tidligere bjergkongers. Kameraet kunne ikke være overalt, og billederne var sort-hvide og ustabile. Men stigningen var blevet til levende fælles tid.'],
      ['Helikopteren gav et nyt blik','I 1959 tog tv-produktionen helikopteren i brug. I begyndelsen var den lige så vigtig som forbindelsesled for signalet som for de billeder, vi i dag forbinder med Touren. Fra luften kunne man placere feltet i landskabet og følge vejen over en længere strækning. Samtidig kunne signaler sendes videre fra områder, hvor bjerge og afstande gjorde jordbaseret transmission vanskelig. Det var dyrt og teknisk besværligt. Det virkede tilstrækkeligt ofte til at fortsætte.'],
      ['Løbet begyndte at tænke i billeder','Fjernsynet ændrede ikke straks ruten, men det gav bestemte steder en ny værdi. En serpentinvej, en tæt menneskemængde eller et mål med plads til teknik kunne levere billeder, som blev husket. Arrangøren fik en voksende interesse i, at dramaet kunne ses. Rytterne lærte også, at et angreb ikke kun blev omtalt senere; det kunne udfolde sig foran stuerne, mens benene stadig gjorde ondt.'],
      ['Kommentatoren skulle forklare det usynlige','Kameraerne viste kun en del af feltet. Punkteringer, udbrud og taktiske bevægelser kunne ske uden for billedet. Kommentatoren måtte samle information fra løbsradio, motorcykler og målområde og samtidig forklare flimrende billeder. Fjernsynet fjernede derfor ikke fortælleren. Det gav ham flere brudstykker at holde sammen på. Den arbejdsform findes stadig, selv om antallet af kameraer og datakilder er blevet større.'],
      ['Fra begivenhed til daglig udsendelse','Ved udgangen af 1950’erne var hele Touren endnu ikke dækket direkte fra start til mål. Men grundformen var skabt: mobile kameraer, relæer, helikopter, kommentatorer og en produktion, der rejste med løbet. Touren blev ved med at være et cykelløb og en avisfortælling. Nu var det også en tilbagevendende fjernsynsbegivenhed. Det ændrede, hvem der kunne følge med – og hvad et godt øjeblik i juli skulle kunne tåle: det skulle helst kunne ses.']
    ], sources:[['UCI: TV Production Guide – første direkte Tour-målgang i 1948','https://assets.ctfassets.net/761l7gh5x5an/6CZrPOFvHrTlhFnDN1tnA5/fa6268c7bf9145076698fd5a6b3efad4/guidedeproductiontv-tvproductionguide_neutral.pdf'],['INA: tv-holdet på Tour de France 1959','https://catalogue.ina.fr/doc/TV-RADIO/DA_CAF97501623/tour-de-france-cycliste-l-equipe-de-television-sur-le-tour'],['Wikimedia Commons: Tour de France 1958','https://commons.wikimedia.org/']]
  },
  'campagnolo-cambio-corsa': {
    year:'1946', label:'Cykler og tekniske nybrud · Gearskifte', title:'Gearskiftet med det løse baghjul',
    intro:'Cambio Corsa gav rytteren flere gear uden et stop i vejkanten. Til gengæld skulle han betjene to greb, træde baglæns og løsne baghjulet, mens cyklen stadig bevægede sig.',
    image:cambioCorsaStoryImage, alt:'De to betjeningsgreb til Campagnolo Cambio Corsa på samlingens Stella Veneta', caption:'De to greb på samlingens Stella Veneta: Det lange frigør og fastlåser baghjulet, mens det korte fører kæden mellem tandhjulene. Foto: The Evolution of Bikes.',
    sections:[
      ['Højre hånd skulle helt om bag sadlen','På en moderne racercykel kan rytteren skifte gear med en lille bevægelse ved bremsegrebet. Med Cambio Corsa sad betjeningen på højre sædestag. To lange metalstænger løb op mod rytterens hånd. Den ene betjente bagakslens hurtigudløser. Den anden flyttede en gaffelformet kædefører hen over tandhjulene. Det lignede et gearsystem, men der var ingen fjederbelastet bagskifter til at optage forskellen i kædelængde. Derfor måtte selve baghjulet også flytte sig.'],
      ['Hvorfor baghjulet måtte være løst','Når kæden flyttes fra et lille til et stort tandhjul, skal den bruge en længere vej rundt. På Cambio Corsa klarede man forskellen ved at lade navet glide frem og tilbage i lange, vandrette gaffelender. Hjulets aksel havde fortandede skiver, som kunne vandre i sporene, når hurtigudløseren blev åbnet. Pedalernes og kædens træk hjalp med at finde den nye placering. Først derefter kunne rytteren spænde hjulet fast igen.'],
      ['En bestemt rækkefølge','Skiftet krævede ro og øvelse. Rytteren lettede trykket, rakte hånden tilbage og åbnede akslen med det lange greb. Med det korte greb pressede han kæden mod det ønskede tandhjul, mens han trådte baglæns. Hjulet fandt samtidig en position, der gav kæden nogenlunde rigtig spænding. Til sidst blev akslen låst. Gjorde man tingene i forkert rækkefølge eller under fuldt tråd, kunne kæden protestere, og et baghjul, som ikke var låst ordentligt, var ikke en lille fejl.'],
      ['Fremskridt uden et stop','Systemet virker besværligt, men det løste et reelt problem. Med et vendbart baghjul måtte rytteren standse, løsne begge hjulmøtrikker, tage hjulet ud og vende det. Cambio Corsa gjorde flere tandhjul tilgængelige under kørslen. På lange stigninger og skiftende terræn kunne gevinsten være betydelig. Et gearskifte var ikke længere en reparation i vejkanten, men en del af løbet. Det var blot endnu ikke blevet en ubekymret bevægelse.'],
      ['Et system fra overgangsårene','Campagnolo arbejdede allerede i 1930’erne med hurtigudløser og gearsystemer, hvor baghjulet bevægede sig. Den udgave, der blev kendt som Cambio Corsa, kom i efterkrigsårene og forbindes almindeligvis med 1946. Den hører til en kort periode, hvor racercyklen havde fået flere tandhjul, men endnu ikke den type bagskifter, som snart skulle gøre hjulets placering uafhængig af gearvalget.'],
      ['Mod var ikke kun et salgsord','Rytteren tog den ene hånd fra styret, fandt to greb bag kroppen og ændrede på baghjulets fastspænding. Det foregik på smalle dæk og ujævne veje, ofte midt i et felt. Dygtige ryttere kunne gøre det hurtigt og næsten ubesværet. For en uøvet hånd var systemet mindre tilgivende. Cambio Corsa fortæller derfor lige så meget om datidens mekaniske færdigheder som om Campagnolos opfindsomhed.'],
      ['Stella Veneta gør mekanikken synlig','På samlingens Stella Veneta kan hele bevægelsen følges uden en teknisk tegning. Grebene, stængerne, kædeføreren og de lange gaffelender ligger åbent fremme. Intet er skjult i et greb eller et elektronisk kabel. Når den ene del bevæges, kan man se, hvorfor den næste må følge med. Cyklen gør et ellers fjernt overgangskapitel meget konkret.'],
      ['Parallelogrammet lukkede kapitlet','Campagnolos Gran Sport fra omkring 1950 gjorde den fjederbelastede parallelogramskifter til det nye forbillede. Den kunne flytte kæden og holde den spændt, mens baghjulet sad fast. Cambio Corsa blev hurtigt gammeldags, men ikke betydningsløst. Det var en dristig løsning mellem to epoker: bedre end at vende hjulet i vejkanten, men stadig så krævende, at selve gearskiftet var en færdighed.']
    ], sources:[['Museo Nicolis: Bianchi 1947 med Campagnolo-gearsystem','https://www.museonicolis.com/en/bianchi-1947-ufficiale/'],['Campagnolo: virksomhedens historie','https://www.campagnolo.com/us-en/company/history/'],['The Evolution of Bikes: Campagnolo Cambio Corsa','https://teob.dk/komponenter/campagnolo-cambio-corsa/']]
  },
  'shimano-dura-ace-ax': {
    year:'1980–1983', label:'Cykler og tekniske nybrud · Aerodynamik', title:'Da selv pedalgevindet skulle være aerodynamisk',
    intro:'Shimano byggede vindtunnel og gav Dura-Ace AX glatte former. Forsøget nåede helt ned i pedalen og viste, hvor langt en samlet teknisk idé kunne presses.',
    image:duraAceAxStoryImage, alt:'Shimano 600 AX Dyna-Drive-krank og pedal på samlingens Koga-Miyata Gentsracer-Aero', caption:'Samlingens Koga-Miyata har Shimano 600 AX med Dyna-Drive. Det er den nært beslægtede 600-gruppe – ikke Dura-Ace AX – men den viser, hvordan AX-idéerne nåede ud over topgruppen. Foto: The Evolution of Bikes.',
    sections:[
      ['Aerodynamik blev et helt system','Omkring 1980 var en hurtig cykel ikke længere kun en let ramme med gode lejer. Shimano forsøgte at behandle komponentgruppen som én samlet luftstrøm. Dura-Ace AX fik afrundede og glatte former, hvor bolte, kanter og fremspring blev reduceret eller gemt. Projektet var bemærkelsesværdigt, fordi opmærksomheden ikke stoppede ved ramme og hjul. Bremser, nav, skiftegreb, krank og pedaler blev alle en del af samme tanke.'],
      ['Fra Dura-Ace til AX','Shimano lancerede navnet Dura-Ace i 1973 og fulgte med EX i 1978. AX-serien, model 7300, kom i 1980. Det japanske firma ville udfordre de europæiske topgrupper med andet end lav pris. En vindtunnel blev taget i brug, og aerodynamik blev gjort til gruppens tydelige identitet. AX stod dermed både for et teknisk forsøg og for Shimanos ønske om at blive opfattet som førende, ikke blot som efterfølger.'],
      ['Glatte dele og skjulte flader','På delene blev skarpe overgange rundet af, og flere beslag fik dækkapper eller lave profiler. Bremser og greb blev formet med vinden for øje, mens nav og skiftekomponenter fulgte samme formsprog. Den enkelte gevinst var ofte lille. Pointen var summen – og at cyklen for første gang kunne sælges som et sammenhængende aerodynamisk system fra samme producent.'],
      ['Dyna-Drive flyttede foden ned','Den mest iøjnefaldende idé var Dyna-Drive. Pedalens lejer lå ikke som normalt omkring en aksel uden for krankarmen. Konstruktionen brugte et stærkt overdimensioneret gevind, så trædefladen kunne placeres tættere på pedalaksens centrum. Foden kom en smule lavere, og Shimano kunne argumentere for både mindre frontareal og en mere direkte trædefornemmelse. Løsningen krævede særlige pedaler og krankarme og kunne derfor ikke bare blandes med almindelige dele.'],
      ['Topgruppe og lillebror','Dura-Ace AX var flagskibet, men Shimano lod idéerne vandre ned i 600 AX. Samlingens Koga-Miyata Gentsracer-Aero fra 1983 har netop Shimano 600 AX og Dyna-Drive. Cyklen dokumenterer ikke Dura-Ace-gruppen i sig selv. Den viser noget andet vigtigt: At aero-projektet blev til en familie af produkter, som også fandt vej til veludstyrede seriecykler.'],
      ['Når et system bliver sin egen begrænsning','Specialløsninger kan være elegante, men de gør reservedele og kombinationer vanskeligere. Dyna-Drive passede ikke til et almindeligt pedalgevind, og flere AX-dele levede i deres egen tekniske verden. For mekanikeren var det mindre frit end en cykel, hvor dele fra forskellige år og producenter kunne udskiftes. Den korte levetid gjorde siden AX til et fascinerende samlerområde – og til et eksempel på, at en god idé ikke altid bliver en standard.'],
      ['Skiftet blev vigtigere end formen','I 1984 fulgte Dura-Ace 7400. Her blev præcist gearskifte og senere Shimanos indekserede SIS-system mere afgørende end AX-seriens særlige formsprog. Mange af de glatte AX-dele forsvandt. Shimano opgav dog ikke at tænke cyklen som et system. Tværtimod blev kompatibilitet mellem greb, gear, kæde og tandhjul et af firmaets stærkeste kort.'],
      ['Et forsøg, der pegede fremad','Dura-Ace AX løste ikke aero-cyklen én gang for alle. Moderne vindtunneler ville måle anderledes, og nutidens komponenter har andre begrænsninger. Men gruppen gjorde spørgsmålet synligt: Hvor meget betyder hver lille del, når hastigheden stiger? I dag formes kabler, greb, klinger og pedaler igen med luftmodstand i tankerne. AX-seriens konkrete løsninger blev kortlivede. Dens måde at tænke på blev ikke.']
    ], sources:[['Shimano: Dura-Ace AX 7300','https://www.shimano.com/en/100th/history/products/14.html'],['Shimano: 600 AX','https://www.shimano.com/en/100th/history/products/17.html'],['Shimano: original servicevejledning til AX','https://si.shimano.com/en/pdfs/si/L-79/SI-L-79-AX-000-00-ENG.pdf'],['The Evolution of Bikes: Koga-Miyata Gentsracer-Aero','https://teob.dk/cykler/koga-miyata-gentsracer-aero/']]
  },
  'liege-bastogne-liege-1980': {
    year:'1980', label:'Cykelløb · Liège–Bastogne–Liège', title:'Dagen da sneen tømte Liège–Bastogne–Liège',
    intro:'174 ryttere begyndte i kulden. Kun 21 kom frem, mens Bernard Hinault kørte omtrent 80 kilometer alene og beholdt føleforstyrrelser i hænderne.',
    image:liege1980StoryImage, alt:'Bernard Hinault fotograferet under Tour de France 1982', caption:'Bernard Hinault under Tour de France 1982. Billedet er et samtidigt portræt og viser ikke sneløbet i Liège. Marcel Antonisse/Anefo, Nationaal Archief · CC0.',
    sections:[
      ['Nul grader ved starten','Den 20. april 1980 stod 174 ryttere klar til Liège–Bastogne–Liège. Temperaturen lå omkring frysepunktet. Det var ubehageligt, men ikke nødvendigvis nok til at aflyse et forårsløb i Ardennerne. Kort efter blev regnen til sne. Vejen, rytterne og følgekaravanen forsvandt gradvist i et hvidt og gråt landskab, hvor det vigtigste ikke længere var at sidde rigtigt placeret, men at kunne mærke hænderne.'],
      ['Feltet forsvandt på få timer','Inden løbet for alvor havde nået Bastogne, var omkring to tredjedele af feltet væk. Kulden trængte gennem datidens uld, handsker og regnslag. Briller duggede, sko blev våde, og hænder kunne ikke uden videre åbne en energipakke eller betjene en bremse. Nogle søgte ind i holdbiler og caféer. Andre fortsatte, fordi de stadig kunne se en gruppe foran sig.'],
      ['Hinault overvejede også at standse','Bernard Hinault var regerende Tour-vinder og en af løbets stærkeste, men kulden gjorde ikke forskel på stjerner og hjælperyttere. Han har siden fortalt, at han nærede planer om at stå af ved forplejningen. Han fortsatte i stedet. Det valg er blevet en del af løbets legende, men det var ikke et øjeblik, hvor han på forhånd vidste, at han ville vinde. Han var blot stadig på cyklen.'],
      ['Angrebet begyndte langt udefra','Rudy Pevenage og Ludo Peeters havde været fremme, da Hinault satte tempoet op med knap 100 kilometer tilbage. På Côte de la Haute-Levée skilte han sig af med de sidste ledsagere. Derfra ventede omtrent 80 kilometer alene gennem sne, smeltevand og en kulde, som gjorde det vanskeligt at spise og styre. Et langt soloangreb var også en måde at holde kroppen i arbejde på.'],
      ['Ni minutter og 24 sekunder','Hinault nåede mål i Liège med 9 minutter og 24 sekunder til Hennie Kuiper. Ronny Claes blev nummer tre. Af de 174 startende blev kun 21 noteret som fuldførende. Tallet gør dagen let at huske, men det fortæller ikke, hvordan de sidste ryttere så ud, eller hvor lidt et resultatark siger om mennesker, der blot forsøgte at komme ind i varmen.'],
      ['Hænderne betalte prisen','Efter løbet var Hinaults fingre så påvirkede af kulden, at skaderne ikke bare forsvandt efter et varmt bad. UCI beskriver, at han beholdt varige føleforstyrrelser i en finger på hver hånd. Sejren blev derfor ikke kun et bevis på hårdhed. Den blev også et eksempel på, at kroppen kan tage skade længe efter, at publikum har forladt målstregen.'],
      ['Hjælperne kunne kun gøre lidt','Soigneurer stod med varme drikke, ekstra tøj og håndklæder, men mulighederne undervejs var begrænsede. Tøj kunne blive gennemblødt, før det næste stykke nåede frem, og en frossen rytter kunne have svært ved selv at få en jakke på. Nutidens løb har mere avanceret beklædning og formelle procedurer for ekstremt vejr. I 1980 var beslutningen i højere grad spredt mellem arrangør, hold og den enkelte rytter.'],
      ['Mere end en heltefortælling','Sneløbet kaldes ofte Hinaults største klassikersejr, og hans angreb fortjener sin plads. Men historien bliver fattigere, hvis den kun handler om en mand, der var hårdere end vejret. 153 ryttere udgik, og vinderen fik en skade, han bar videre. Dagen viser både cykelsportens stædighed og dens gamle tilbøjelighed til først at spørge, om noget kunne gennemføres – og senere, hvad det kostede.']
    ], sources:[['UCI: Liège–Bastogne–Liège 1980','https://www.uci.org/article/1980-liege-bastogne-liege-hinault-s-greatest-classic-victory/7xtOJL3SHb5il6TpV5oaZW'],['ProCyclingStats: resultatet fra 1980','https://www.procyclingstats.com/race/liege-bastogne-liege/1980/result']]
  },
  'major-taylor-verdensmester': {
    year:'1899', label:'Periodens ryttere · Banecykling', title:'Major Taylor vandt også kampen om at få lov',
    intro:'Marshall “Major” Taylor blev verdensmester i sprint i 1899. Vejen dertil gik gennem rekorder, fyldte velodromer og en cykelsport, som ofte forsøgte at holde ham ude.',
    image:majorTaylorStoryImage, alt:'Marshall Major Taylor på sin banecykel omkring 1906 eller 1907', caption:'Marshall “Major” Taylor fotograferet omkring 1906–1907, nogle år efter verdensmesterskabet. Billedet blev gengivet i hans selvbiografi fra 1928 og er public domain.',
    sections:[
      ['En verdensmester på Queen’s Park','Ved verdensmesterskaberne i Montréal i 1899 vandt Marshall Walter Taylor en-mile sprinten. Han var 20 år gammel. Sejren gjorde ham til den første sorte amerikanske verdensmester i cykling og en af de tidligste sorte verdensmestre i nogen moderne sport. På resultatlisten står et enkelt løb. Bag det lå en karriere, hvor han igen og igen måtte bevise både sin fart og sin ret til overhovedet at stille til start.'],
      ['Navnet kom fra en cykelbutik','Taylor voksede op i Indianapolis og fik arbejde i en cykelbutik som dreng. Han udførte kunststykker på cyklen iført en uniform, der lignede en officers. Tilskuere og kunder begyndte at kalde ham “Major”. Optrædenen gav ham et navn og viste hans kontrol over cyklen, men det var hastigheden på banen, der åbnede den professionelle verden.'],
      ['Til Worcester med Birdie Munger','Cykelfabrikanten og tidligere rytteren Louis “Birdie” Munger så Taylors talent og blev en vigtig støtte. Taylor flyttede til Worcester i Massachusetts, hvor der var en stærk cykelindustri og bedre muligheder for træning og løb end i Indiana. Han blev professionel i 1896. Rekorder og sejre fulgte hurtigt, og hans navn begyndte at fylde i en sport, som på det tidspunkt trak store menneskemængder til indendørs og udendørs baner.'],
      ['Banecykling var stor underholdning','I 1890’erne kunne en sprintduel være en hovedbegivenhed med penge, avisdækning og tætte tribuner. Rytterne brugte taktik, langsomme indledninger og pludselige accelerationer, før de kastede cyklen mod stregen. Taylor var kompakt, eksplosiv og svær at passere. Hans berømmelse voksede, netop mens cyklen blev et symbol på bevægelse og personlig frihed. Den frihed blev ikke tilbudt alle på samme vilkår.'],
      ['Farvelinjen fulgte med på banen','Den amerikanske cykelorganisation League of American Wheelmen udelukkede sorte medlemmer i 1894. Organisationens løbsarm havde andre regler, men diskriminationen forsvandt ikke af den grund. Taylor blev afvist af baner og hoteller, fik problemer med at finde måltider på rejser og mødte arrangører og konkurrenter, som ikke ønskede en sort vinder. Racismen var ikke en sidehistorie til hans karriere. Den bestemte, hvor han kunne køre, og hvordan hver sejr blev modtaget.'],
      ['Modstanden blev fysisk','På banen kunne almindelig hård sprint blive blandet med bevidste forsøg på at lukke ham inde eller presse ham ud. Taylor blev truet og ved mindst én kendt lejlighed overfaldet af en konkurrent efter et løb. Han fortsatte, men måtte bruge energi på mere end træning og taktik. Når han vandt, slog han ikke en abstrakt fordom. Han slog konkrete ryttere i konkrete løb, mens systemet omkring dem ofte gjorde arbejdet vanskeligere for ham.'],
      ['Troen satte også en grænse','Taylor var troende baptist og ønskede ikke at køre om søndagen. Mange store arrangementer lå netop dér, og beslutningen kostede starter og indtægter. Den gjorde også hans kalender vanskeligere i Europa og Australien. Han blev amerikansk sprintmester i 1900 og vandt siden store internationale løb, men karrieren var aldrig blot en ubrudt række af tilbud. Han valgte nogle fra, og andre blev taget fra ham.'],
      ['Berømmelsen varede kortere end betydningen','Efter karrieren mistede Taylor en stor del af sin formue. Han døde i Chicago i 1932, 53 år gammel, og blev først begravet i en umærket grav. Senere generationer af ryttere og cykelklubber har trukket hans historie frem igen. Det er rimeligt at huske verdensmesteren for hans fart. Det er lige så vigtigt at se, hvor meget arbejde der lå i blot at nå startstregen. Major Taylor vandt ikke alene løbene. Han tvang en lukket sport til at registrere, at han havde vundet dem.']
    ], sources:[['UCI: VM-resultater på bane','https://assets.ctfassets.net/761l7gh5x5an/6LNcQK2kxLKAWoViX1ZWe6/9b4b56bd4b5b41727ed329aece4bbcd5/elite-track-world-championships---palmar-s.pdf'],['Major Taylor Association: biografi','https://www.majortaylorassociation.org/who.shtml'],['National Endowment for the Humanities: Major Taylor','https://www.neh.gov/article/meet-major-taylor-fastest-man-two-wheels'],['Major Taylor Association: League of American Wheelmen og farvelinjen','https://majortaylorassociation.org/LAB_text.htm'],['Wikimedia Commons: portrættet fra 1906–1907','https://commons.wikimedia.org/wiki/File:Major_Taylor,_1906-1907.jpg']]
  },
  'ugo-bianchi-let-banescykel-1948': {
    year:'1948', label:'Mekanik med konsekvenser · Banecykling', title:'Banecyklen på de påståede 3,48 kilo',
    intro:'Vægten skal efter sigende være standset ved 3,48 kilo. Det er et voldsomt lavt tal for en banecykel bygget af metal i 1948 – og netop derfor skal historien spændes efter, før man kører videre med den.',
    image:ugoBianchiStoryImage, alt:'Fausto Coppi under timerekorden på Vigorelli-banen i 1942', caption:'Fausto Coppi under timerekorden på Vigorelli i 1942. Hans Legnano-bane­cykel blev bygget af Ugo Bianchi og vejede omkring 7,5 kilo. Fotografiet viser altså ikke den omtalte 3,48-kilos cykel fra 1948. Foto: ukendt/Wikimedia Commons, public domain.',
    sections:[
      ['En vægt, man ser på en ekstra gang','På værkstedsbordet står en banecykel. Ingen bremser. Intet gearskifte. Ingen skærme eller flaskeholdere. Historien går, at den italienske mekaniker Ugo Bianchi byggede en sådan cykel i 1948, og at den vejede blot 3,480 kilo. Oplysningen er siden gengivet med Pinella De Grandi, Coppis senere mekaniker, som led i overleveringen. En samtidig vejeseddel har jeg ikke fundet. Tallet må derfor stå som en stærk værkstedshistorie, ikke som et godkendt rekordforsøg.'],
      ['Ugo Bianchi var ikke grebet ud af luften','Manden bag navnet kan vi komme tættere på. Ugo Bianchi arbejdede med Legnanos løbscykler og blev af De Grandi betragtet som en læremester. Han byggede også den Legnano-banecykel, som Fausto Coppi brugte ved sin timerekord på Vigorelli i 1942. Den bevarede cykel er et fast holdepunkt. Her møder vi en mekaniker, som kendte banens krav og arbejdede for ryttere, der kunne mærke få millimeter og et sløvt leje.'],
      ['Banen gav ham færre dele at slås med','En banecykel er et godt sted at begynde, hvis alt overflødigt skal væk. Der er fastnav, ét tandhjul og én klinge. Ingen bremser, kabler eller gearmekanisme. Hjulene kører på en jævn bane i stedet for over huller og kantsten. Det sparer dele, men fjerner ikke belastningen. Når en rytter rejser sig og accelererer, bliver styr, krank og baghjul vredet hårdt. En del, der er filet for tynd, giver ikke nødvendigvis besked først.'],
      ['Gram for gram','Vi kender ikke den omtalte cykels opbygning. Derfor bør man være varsom med præcise forklaringer. Tidens værktøjskasse er dog velkendt: tyndere rør, lette træfælge, aluminiumsdele, korte bolte og beslag, der blev bearbejdet i hånden. Hver del kunne gøres lettere. Til sidst stod mekanikeren med det mere interessante spørgsmål: Var der stadig materiale nok til rytteren, som skulle bruge den?'],
      ['Til sammenligning vejede Coppis cykel mere end det dobbelte','Coppis veldokumenterede rekordcykel fra 1942 vejede omkring 7,5 kilo. Den havde træfælge, aluminiumspedaler og en enkel baneopbygning, men den skulle holde til en hel time ved høj fart. Seks år senere skulle Bianchis ultralette cykel altså have vejet mindre end halvdelen. Det er ikke umuligt at bygge noget meget let. Spørgsmålet er, om de 3,48 kilo dækkede en komplet, køreklar cykel med pedaler, dæk og alle bolte – og om den blev brugt i et egentligt løb.'],
      ['En rekord eller et værkstedsstykke','Uden ejer, billeder og samtidig vejning ved vi ikke, om cyklen var et konkurrenceværktøj, et eksperiment eller et udstillingsstykke. Det gør en forskel. En maskine kan sagtens demonstrere, hvor langt en mekaniker kan presse materialet, uden at den er egnet til en sprinter på fuld kraft. Spørger du mig, er det netop her historien bliver bedre. Ikke ved at råbe rekord, men ved at se Ugo Bianchi stå med filen og afgøre, hvor det næste gram kunne hentes.'],
      ['Tallet bliver stående med en lille stjerne','3,48 kilo er foreløbig et overleveret tal. Ugo Bianchis arbejde for Legnano og Coppis rekordcykel er bedre belyst; 1948-maskinen er det ikke. Men fortællingen viser en vægtjagt, som var i gang længe før kulfiber og elektroniske vægte. Der blev målt, filet og prøvet. Og et sted i værkstedet har nogen måske løftet cyklen med én hånd og smilet. Mere behøver vi ikke lægge i den, før der dukker en vejeseddel op.']
    ], sources:[['Biciclette d’Epoca: Coppi Bike Story og Ugo Bianchi','https://biciclettedepoca.net/news/biciclette/coppi-bike-story-i-parte/'],['Treccani: Fausto Coppi og rekordcyklen på 7,5 kilo','https://www.treccani.it/enciclopedia/fausto-coppi_(Dizionario-Biografico)/'],['Museo del Ghisallo: samlingen og Coppis rekordcykel','https://www.museodelghisallo.it/en/museum/'],['Wikimedia Commons: Coppi på Vigorelli 1942','https://commons.wikimedia.org/wiki/File:Fausto_Coppi_-_record_dell%27ora_--_hour_record_-_1942_(1_of_2).jpg']]
  },
  'keetie-van-oosten-hage': {
    year:'1968–1979', label:'Periodens ryttere · Kvindecykling', title:'Keetie vandt næsten alt, der fandtes',
    intro:'Keetie van Oosten-Hage blev verdensmester på landevej og bane, satte timerekord og underviste ved siden af. Problemet var ikke, om hun kunne vinde. Det var, hvor hun kunne få lov at stille op.',
    image:keetieImage, alt:'Keetie van Oosten-Hage ved de hollandske mesterskaber i 1979', caption:'Keetie van Oosten-Hage ved de hollandske mesterskaber i Geulle den 23. juni 1979. Koen Suyk/Anefo, Nationaal Archief · CC0.',
    sections:[
      ['Fire søstre og cykler på bilen','Cornelia Hage voksede op i Zeeland i en familie, hvor flere søstre kørte løb. Bella begyndte først, og Keetie fulgte efter. Familien kørte fra løb til løb med cykler på bilen. De hollandske kvindeløb var ofte korte, mens konkurrencen i Belgien kunne være længere og hårdere. Det gav en praktisk uddannelse: find et løb, kom frem, kør stærkt, og tag selv meget af arbejdet omkring det.'],
      ['Imola i 1968','Ved VM i Imola i 1968 kørte hun stadig under navnet Keetie Hage. Hun var 19 år og havde få internationale sæsoner bag sig. To dage før landevejsløbet ramte hun en varebil under træning og skadede en finger. En italiensk soigneur hjalp hende tilbage og fik såret behandlet. Hun stillede til start og vandt spurten fra den lille gruppe, der var tilbage. Det blev hendes første verdensmesterskab på landevej.'],
      ['En karriere på to underlag','Hage var ikke kun landevejsrytter. Fra 1966 til 1977 vandt hun det hollandske mesterskab i individuelt forfølgelsesløb tolv år i træk. På banen blev hun verdensmester fire gange mellem 1975 og 1979. På landevejen tog hun endnu et VM i 1976 og en lang række nationale titler. Kombinationen krævede forskellige gearinger, positioner og løbsrytmer. Den passede hende tilsyneladende ganske udmærket.'],
      ['43,082 kilometer','Den 16. september 1978 kørte hun timerekord i München. Efter en time stod målingen på 43,082 kilometer. Undervejs forbedrede hun også rekorder på fem, ti og tyve kilometer. Rekorden overlevede i mere end to årtier, før Anna Wilson forbedrede den i 2000. Tallet viser hendes niveau. Det viser også, at kvindernes cykelsport havde toppræstationer længe før sporten fik et program, der svarede til dem.'],
      ['Ingen OL og ingen Tour','Kvinder fik et VM på landevej i 1958, men kvindecykling kom først på OL-programmet i 1984. Der fandtes heller ikke en stabil kvindelig udgave af Tour de France i hendes karriere. Internationale etapeløb var få, og præmiepengene små. Van Oosten-Hage har fortalt, at en kriteriesejr kunne give omtrent nok til en ny tubular. Hun beholdt derfor sit arbejde som lærer. Verdensmesteren havde et almindeligt skema ved siden af.'],
      ['Træningen måtte hun i høj grad selv finde ud af','Den daglige støtte var begrænset. Ved et VM kunne der være massage og holdledelse, men i almindelige løb var soigneurs, læger og præcise træningsplaner ikke en selvfølge. Hun beskrev senere metoden som at køre hårdt og lytte til kroppen. Først sent i karrieren mødte hun mere målrettede træningsskemaer. Det var ikke romantisk frihed. Det var en sport, som endnu ikke havde besluttet at bruge mange ressourcer på sine bedste kvinder.'],
      ['Cyklen kom i skuret','Den 20. oktober 1979 sluttede hun karrieren. Samme år var hun igen verdensmester i forfølgelsesløb. Hun stoppede altså ikke, fordi hun ikke længere kunne følge med. Hun havde vundet over 200 løb, men de store muligheder, som senere generationer fik, fandtes ikke. Hendes historie bliver derfor let til en liste af titler. Den mere interessante del er arbejdet omkring dem: lærerjobbet, familiebilen, den manglende støtte og en kalender, der var for lille til rytteren. Hun vandt næsten alt, der fandtes. Der burde have været mere.']
    ], sources:[['UCI: Keetie van Oosten-Hages karriere og VM 1968','https://www.uci.org/article/keetie-van-oosten-hage-s-imola-the-1968-uci-road-world-championships-sparked-a-superb-career/1Y8VRpV3Mz6G6lD9BfKNU1'],['KOERS Museum: portræt og interview','https://servicekoers.be/verhalen/portret-van-keetie-van-oosten-hage'],['Encyclopedie van Zeeland: timerekord og karriereafslutning','https://encyclopedievanzeeland.nl/Keetie_van_Oosten-Hage'],['Wikimedia Commons: Keetie van Oosten-Hage 1979','https://commons.wikimedia.org/wiki/File:Keetie_van_Oosten-Hage,_Bestanddeelnr_930-3297.jpg']]
  },
  'da-pulsen-kom-med-ud-paa-landevejen': {
    year:'1982–1989', label:'Kost, træning og videnskab · Pulsmåling', title:'Da pulsen kom med ud på landevejen',
    intro:'Et brystbælte mod huden og en lille modtager på håndleddet gjorde noget nyt muligt: Rytteren kunne følge hjertets arbejde uden at standse og tælle slag med fingrene.',
    image:polarHeartRateStoryImage, alt:'Illustration af en landevejsrytter i begyndelsen af 1980’erne med brystbælte og pulsmåler', caption:'Tidstypisk illustration af en tidlig trådløs pulsmåler i brug. Illustrationen er skabt til artiklen og er ikke historisk dokumentation.',
    sections:[
      ['Et tal midt på vejen','Modvinden ligger fladt over landevejen. Under trøjen sidder et smalt bælte mod brystet, og på håndleddet fylder modtageren mere end et almindeligt ur. Rytteren ser ned. Tallet fortæller ikke, hvor hurtigt cyklen kører, men hvor hårdt kroppen arbejder for at holde farten. I begyndelsen af 1980’erne var det stadig en usædvanlig oplysning at have med på turen.'],
      ['Fra skisporet til håndleddet','Historien begyndte i Finland. Polar blev grundlagt i 1977 efter arbejdet med at måle puls uden ledninger under træning. I 1982 kom Sport Tester PE2000 på markedet. Elektroder i brystbæltet registrerede hjerteslagene og sendte signalet trådløst til en modtager. Det lyder beskedent nu. Dengang betød det, at målingen kunne følge kroppen gennem hele arbejdet i stedet for kun at foregå ved et stop eller i et laboratorium.'],
      ['De første brugere var få','Udstyret blev ikke straks hvermandseje i feltet. Polar beskriver selv 1980’ernes brugere som en begrænset kreds af eliteudøvere. Et konkret tidligt eksempel er orienteringsløberen Kari Sallinen, som sammen med træner Jukka Kalliokoski brugte måleren i sommeren 1983. Cykelryttere havde den samme gevinst: en lang træningstur kunne bagefter deles op i rolige og hårde perioder, også når bakker og vind havde gjort hastigheden misvisende.'],
      ['Kilometer var ikke længere hele svaret','Den gamle træningsbog kunne fortælle, at rytteren havde kørt 180 kilometer. Pulsen kunne føje et andet spørgsmål til: Hvordan blev de kørt? Trænere begyndte at arbejde mere systematisk med intensitet, intervaller og restitution. En rolig dag kunne holdes rolig, og et hårdt interval kunne kontrolleres uden kun at stole på fornemmelsen. Det gjorde ikke træningen enkel. Det gav bare et nyt måleredskab.'],
      ['Tallet kunne også narre','Puls reagerer på mere end belastning. Varme, væskemangel, nervøsitet, sygdom og træthed kan flytte den. To ryttere med samme puls arbejder ikke nødvendigvis lige hårdt, og den samme rytter kan vise forskellige tal fra dag til dag. Derfor erstattede måleren hverken trænerens blik eller rytterens erfaring. Den skabte tværtimod et nyt håndværk: at forstå tallet i den situation, hvor det blev målt.'],
      ['Før wattmåleren','Senere kom effektmåleren og viste arbejdet direkte i watt. Pulsen viste kroppens svar på arbejdet. Forskellen er vigtig, men i 1980’erne lå watt endnu ikke på hvert styr. Den tidlige Polar-enhed gjorde laboratoriets blik transportabelt og lod rytteren tage det med ud i regnen. Den lille boks på håndleddet var ikke en facitliste. Den var begyndelsen på en mere målt træningshverdag.']
    ], sources:[['Polar: How heart rate monitors changed endurance sports','https://www.polar.com/us-en/guide/how-heart-rate-monitors-changed-endurance-sports'],['Polar: 40 years of firsts','https://www.polar.com/blog/40-years-of-incredible-firsts-polar-history/'],['Google Patents: Seppo Säynäjäkangas’ pulse transmitter','https://patents.google.com/patent/USD278746S/en'],['Polar Sport Tester: brugervejledning','https://support.polar.com/e_manuals/sport-tester/polar-sport-tester-user-manual-english.pdf']]
  },
  'peppino-drali-bianchi-ved-filebaenken': {
    year:'1946–1970’erne', label:'Menneskene bag · Rammebygning', title:'Bianchi på skrårøret, Drali ved filebænken',
    intro:'På skrårøret stod Bianchi. Ved filebænken i Milano stod Giuseppe “Peppino” Drali. Historien viser, hvor lidt et mærkenavn alene fortæller om hænderne bag et racerstel.',
    image:peppinoDraliStoryImage, alt:'Illustration af en italiensk rammebygger ved filebænken med et celeste racerstel', caption:'Tidstypisk illustration af arbejdet i et milanesisk rammeværksted. Motivet forestiller ikke Peppino Drali og er ikke historisk dokumentation.',
    sections:[
      ['Navnet og hånden','Et stel ligger i jiggen. Samlingerne er loddet, men arbejdet er langt fra færdigt. Overskydende materiale skal files væk, rørene kontrolleres, og linjerne skal mødes, så cyklen både ser rigtig ud og kører lige. Når den færdige maskine senere fik Bianchi på skrårøret, kunne kunden let tro, at hele arbejdet var foregået på den store fabrik. Nogle af de særlige stel havde en anden vej.'],
      ['Carlo og den unge Peppino','Drali-firmaets egen historie fører forbindelsen tilbage til Peppinos far, Carlo Drali, som arbejdede tæt på Bianchis løbsafdeling. Ifølge samme historie var Carlo og den unge Peppino med til at gøre en Bianchi klar til Fausto Coppi før Milano–Sanremo i 1946. Coppi vandt. Den præcise fordeling af arbejdet er vanskelig at efterprøve i samtidige kilder, men forbindelsen mellem familien Drali og Bianchis løbscykler blev langvarig.'],
      ['Da den store afdeling trak sig','Da Bianchi senere reducerede eller lukkede sin særlige løbsproduktion, forsvandt behovet for specialbyggede cykler ikke. Dralis egen historik fortæller, at Peppino i 1970’erne fik til opgave at bygge særlige Bianchi-stel til ryttere, som ikke kunne nøjes med standardmål. Bianchi leverede materialer og navn. Arbejdet blev udført i Dralis værksted. Cyklerne blev omtalt som Bianchi Specialissima, elaborata da Drali – bearbejdet af Drali.'],
      ['Et stel begyndte med en krop','Specialbygning var ikke bare at vælge en størrelse fra en tabel. Rytterens ben, overkrop, smidighed og brug af cyklen skulle omsættes til rør og vinkler. Rørene blev skåret og tilpasset, så de mødtes tæt i muffen. Efter lodningen skulle stellet rettes og samlingerne files rene. Små forskelle i overrør, kronrør og placering kunne mærkes længe efter, at lakken havde skjult håndværket.'],
      ['To identiteter på samme cykel','Var sådan en cykel en Bianchi eller en Drali? Det mest præcise svar er begge dele. Bianchi stod for mærket, materialerne og adgangen til løbsmiljøet. Drali stod for tilpasningen og udførelsen af det enkelte stel. Det var ikke usædvanligt i italiensk cykelbygning, at de synlige bogstaver og de arbejdende hænder tilhørte forskellige virksomheder. Kunden købte et kendt navn, men også en bestemt rammebyggers erfaring.'],
      ['Det, lakken ikke fortæller','Peppino Dralis historie er værd at bevare, fordi den flytter blikket fra mærkatet til værkstedet. Vi skal samtidig være åbne om kilderne: De mest detaljerede oplysninger kommer fra Drali-virksomhedens egen historik og er dermed også familie- og firmaminde. Det sikre håndværksmæssige spor står tilbage. Bag nogle Bianchi-stel fandtes en fil, en jig og en mand i Milano, hvis navn ikke stod med de største bogstaver.']
    ], sources:[['Drali Milano: virksomhedens tidslinje','https://www.dralimilano.it/en/il-brand/storia-timeline/'],['Drali Milano: historien fra cykelløbene','https://www.dralimilano.it/storia-corse/'],['Cicli Drali Milano: racing history','https://www.ciclidralimilano.it/en/storia-corse/']]
  },
  'da-pastaen-overtog-morgenbordet': {
    year:'1980’erne', label:'Kost, træning og videnskab · Løbsmad', title:'Da pastaen overtog morgenbordet',
    intro:'Bøffen forsvandt ikke fra hotelbordet på én morgen. Men i 1980’erne blev pasta, ris og søde drikke til noget, holdene kunne måle og bruge mere systematisk.',
    image:pastaCarbsStoryImage, alt:'Illustration af et cykelhold ved morgenbordet i 1980’erne med pasta, ris, brød og frugt', caption:'Tidstypisk illustration af et holdmåltid i 1980’erne. Illustrationen er skabt til artiklen og er ikke historisk dokumentation.',
    sections:[
      ['Morgenmad med to tider på samme bord','På hotellet står der stadig æg og et stykke kød til den rytter, der stoler på det gamle. Ved siden af står store fade med pasta og ris, brød, frugt og sød te. Soigneuren fylder flasker med et pulver, som opløses langsomt i vandet. 1980’ernes kostskifte lignede ikke en lukket dør mellem fortid og nutid. Det lignede et morgenbord, hvor begge dele stod fremme.'],
      ['Kulhydrat blev et arbejdsredskab','Fysiologer havde længe undersøgt muskelglykogen, men i 1980’erne blev tankegangen mere synlig i holdenes hverdag. Kulhydrat kunne lagres før arbejdet og fyldes på undervejs. Trænede cykelryttere deltog i forsøg med kulhydratrige diæter og drikke, og resultaterne gav trænere et sprog for noget, rytterne længe havde kendt praktisk: Man kører dårligt, når depoterne er tomme.'],
      ['Pastaen var let at forstå','Pasta blev periodens synlige symbol, fordi den var billig, genkendelig og nem at servere til mange. Ris, brød, kartofler og frugt udførte samme arbejde i forskellige måltider. Det betød ikke, at protein og fedt blev smidt ud af køkkenet. Men bøffen mistede rollen som det oplagte brændstof til selve etapen. Tallerkenen blev lettere at fordøje og mere koncentreret om den lange arbejdsdags energi.'],
      ['En del af maden kom i flasken','Den største ændring var måske ikke på tallerkenen, men i drikkedunken. Maltodextrin og andre kulhydratblandinger gjorde det muligt at drikke en del af energien. Et Tour-studie offentliggjort i 1989 registrerede fem rytteres kost gennem løbet: omkring 62 procent af energien kom fra kulhydrat. Andre undersøgelser fra perioden beskrev, at berigede drikke kunne levere en betydelig del af dagens energi.'],
      ['Maven havde stadig stemmeret','En formel på papir var ikke det samme som en rolig mave på et bjerg. Søde blandinger kunne blive for koncentrerede, især i varme, og en rytter kunne have svært ved at drikke nok. Smag, temperatur og vane betød meget. Derfor forsvandt musetten ikke. Små sandwiches, kager, frugt og ris kunne stadig være lettere at få ned end endnu en flaske med den samme søde opløsning.'],
      ['Fra køkkenfornemmelse til registrering','Ved årtiets slutning kunne forskere veje maden og beregne energien gennem en hel Tour. Det var et tydeligt skridt væk fra alene at stole på tradition og soigneurens øjemål. Nutidens ernæringsplaner er langt mere præcise, men deres forløber står på dette hotelbord: pasta i store fade, pulver i flaskerne og en notesbog, hvor nogen for første gang forsøger at regne på, hvad rytteren faktisk spiser.']
    ], sources:[['PubMed: Influence of selected carbohydrate drinks on cycling performance and glycogen use (1987)','https://pubmed.ncbi.nlm.nih.gov/3821453/'],['PubMed: Food and fluid intake during a 22-day cycling race (1989)','https://pubmed.ncbi.nlm.nih.gov/2535605/'],['PubMed: Tour de France simulation study, diet manipulation (1989)','https://pubmed.ncbi.nlm.nih.gov/2663742/'],['International Journal of Sport Nutrition: contemporary review of carbohydrate in cycling','https://doi.org/10.1123/ijsnem.2025-0239']]
  },
} as const;

