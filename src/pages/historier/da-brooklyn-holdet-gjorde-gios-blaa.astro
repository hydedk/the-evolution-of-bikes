<style>.blue-story{padding-top:3rem}.story-hero{max-width:1100px;margin:auto;padding:4rem 1.5rem 3rem}.story-hero h1{font:400 clamp(3.5rem,8vw,7rem)/.94 'Libre Caslon Display',serif;margin:.7rem 0 1.8rem}.story-hero em{color:#175a9b;font-weight:400}.story-hero>p:last-child{max-width:760px;font-size:1.25rem;line-height:1.65}.story-image{max-width:1180px;margin:0 auto 4rem;padding:0 1.5rem}.story-image.bike{max-width:1050px}.story-image :global(img),.archive-gallery :global(img){display:block;width:100%;height:auto}.blue-story figcaption{margin-top:.7rem;color:#625e55;font-size:.84rem;line-height:1.5}.story-copy{max-width:760px;margin:auto;padding:0 1.5rem 4rem;font-size:1.08rem;line-height:1.82}.story-copy .lead{font:1.7rem/1.45 'Libre Caslon Display',serif}.story-copy h2,.gallery-heading h2{font:400 clamp(2rem,4vw,3rem)/1.15 'Libre Caslon Display',serif;margin:3rem 0 1rem}.image-band{max-width:1180px;margin:0 auto 5rem;padding:0 1.5rem;display:grid;grid-template-columns:1.55fr .75fr;gap:1.4rem;align-items:stretch}.image-band :global(picture){height:100%}.image-band :global(img){width:100%;height:100%;object-fit:cover}.archive-gallery{max-width:1180px;margin:0 auto 5rem;padding:0 1.5rem}.gallery-heading{max-width:760px;margin-bottom:2rem}.gallery-heading h2{margin-top:.5rem}.gallery-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:2rem 1.4rem}.gallery-grid figure{margin:0}.gallery-grid :global(picture){display:block;height:380px;overflow:hidden}.gallery-grid :global(img){height:100%;object-fit:cover}.period-sources{max-width:1000px;margin:auto}@media(max-width:800px){.blue-story{padding-top:0}.story-hero{padding-top:2.5rem}.story-copy{font-size:1rem}.story-copy .lead{font-size:1.45rem}.image-band,.gallery-grid{grid-template-columns:1fr}.image-band :global(picture),.gallery-grid :global(picture){height:auto}.image-band :global(img),.gallery-grid :global(img){height:auto}}</style>
