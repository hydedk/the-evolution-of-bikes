rflow-wrap:anywhere}@media(max-width:800px){.magni-story{padding-top:0}.story-hero{padding-top:2.5rem}.story-copy{font-size:1rem}.story-copy .lead{font-size:1.45rem}.portrait-row{grid-template-columns:1fr}.portrait-row figure{max-width:430px;margin:auto}.fact-strip{grid-template-columns:1fr 1fr}.fact-strip div{min-height:145px}}@media(max-width:480px){.fact-strip{grid-template-columns:1fr}}</style>
