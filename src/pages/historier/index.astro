const base = import.meta.env.BASE_URL;
const stories = [
  { year: '1935–1937', title: 'Da gearene kom – og øl narrede feltet', text: 'Om Tourens modstand mod gear og Julien Moineaus usædvanlige udbrud mod Bordeaux.', image: 'images/stories/tour-gears-beer/drikkestation.webp', link: 'historier/da-gearene-kom-og-oel-narrede-feltet/' },
  { year: '1927', title: 'Da kulden skabte quick release', text: 'Tullio Campagnolos fastfrosne hjulskift på Croce d’Aune blev begyndelsen på en mekanisk revolution.', image: 'images/stories/campagnolo-quick-release/quick-release-detail.webp', link: 'historier/campagnolo-quick-release/' },
  { year: '1948', title: 'Stjernen der faldt fra toppen', text: 'Aldo Bini gennemførte Giro d’Italia med en brækket hånd og fandt hæder i den sorte trøje.', image: 'images/stories/aldo-bini/aldo-bini-archive.webp', link: 'historier/aldo-bini-maglia-nera-1948/' },
  { year: '1997', title: 'Da gamle cykler fandt nye veje', text: 'L’Eroica begyndte med 92 ryttere på Toscanas hvide grusveje.', image: 'images/stories/leroica/toscana-illustration.webp', link: 'historier/leroica-gamle-cykler-nye-veje/' },
  { year: '1948', title: 'Da Michelin-navnet næsten blev et problem', text: 'Historien om Stella Veneta, Ferdinando Michelin og navnet MICHE.', image: 'images/stories/michelin-navnet/michelin-aftalen.webp', link: 'historier/da-michelin-navnet-blev-et-problem/' },
];
---
<!doctype html><html lang="da"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><meta name="description" content="Historier og anekdoter fra cykelsporten og samlingen The Evolution of Bikes." /><title>Historier og anekdoter · The Evolution of Bikes</title><link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin /><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Libre+Caslon+Display&display=swap" rel="stylesheet" /><link rel="stylesheet" href={`${base}/styles/global.css`} /></head>
<body><header class="site-header"><a class="brand" href={`${base}/`} aria-label="The Evolution of Bikes, forside"><span class="brand-mark">E<span>B</span></span><span>The Evolution<br />of Bikes</span></a><nav aria-label="Hovedmenu"><a href={`${base}/#samlingen`}>Samlingen</a><a href={`${base}/historier/`} aria-current="page">Historier</a><a href={`${base}/#viden`}>Viden</a><a href={`${base}/om/`}>Om</a></nav></header>
<main><header class="archive-hero"><p class="section-label">Fra arkivet</p><h1>Historier og<br /><em>anekdoter</em></h1><p>Fortællinger om cyklerne, menneskene, teknikken og de veje, der forbinder dem.</p></header><section class="story-archive">{stories.map((story) => <a href={`${base}/${story.link}`}><img src={`${base}/${story.image}`} alt="" /><div><span>{story.year}</span><h2>{story.title}</h2><p>{story.text}</p><b>Læs historien →</b></div></a>)}</section></main>
<footer><div class="brand footer-brand"><span class="brand-mark">E<span>B</span></span><span>The Evolution<br />of Bikes</span></div><p>En personlig samling af vintagecykler,<br />historier, mærker og komponenter.</p><p class="copyright">© {new Date().getFullYear()} The Evolution of Bikes</p></footer></body></html>
