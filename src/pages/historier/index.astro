---
const base = import.meta.env.BASE_URL;
import { stories } from '../../data/stories';
---
<!doctype html><html lang="da"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><meta name="description" content="Historier og anekdoter fra cykelsporten og samlingen The Evolution of Bikes." /><title>Historier og anekdoter · The Evolution of Bikes</title><link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin /><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Libre+Caslon+Display&display=swap" rel="stylesheet" /><link rel="stylesheet" href={`${base}/styles/global.css`} /></head>
<body><header class="site-header"><a class="brand" href={`${base}/`} aria-label="The Evolution of Bikes, forside"><span class="brand-mark">E<span>B</span></span><span>The Evolution<br />of Bikes</span></a><nav aria-label="Hovedmenu"><a href={`${base}/historier/`} aria-current="page">Historier</a><a href={`${base}/perioder/`}>Perioder</a><a href={`${base}/cykler/`}>Cykler</a><a href={`${base}/komponenter/`}>Komponenter</a><a href={`${base}/om/`}>Om</a></nav></header>
<main><header class="archive-hero"><p class="section-label">Én begivenhed. Ét menneske. Én fortælling.</p><h1>Historier og<br /><em>anekdoter</em></h1><p>Selvstændige fortællinger, der kan læses hver for sig – og som samtidig hører hjemme i cykelhistoriens større kapitler.</p></header><section class="story-archive">{stories.map((story) => <a href={`${base}/historier/${story.slug}/`}><img src={`${base}/${story.image}`} alt="" /><div><span>{story.year}</span><h2>{story.title}</h2><p>{story.text}</p><b>Læs historien →</b></div></a>)}</section></main>
<footer><div class="brand footer-brand"><span class="brand-mark">E<span>B</span></span><span>The Evolution<br />of Bikes</span></div><p>En personlig samling af vintagecykler,<br />historier, mærker og komponenter.</p><p class="copyright">© {new Date().getFullYear()} The Evolution of Bikes</p></footer></body></html>
