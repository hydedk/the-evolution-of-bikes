const base = import.meta.env.BASE_URL;
const rules = [
  ['Byggeår', 'Senest 1987'],
  ['Geargreb', 'På skrårøret'],
  ['Pedaler', 'Tåclips og remme'],
  ['Bremsekabler', 'Synligt over styret'],
];
---
<!doctype html>
<html lang="da"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><meta name="description" content="Historien om L’Eroica, de toscanske grusveje og Atala Sanremo fra samlingen." /><meta property="og:type" content="article" /><meta property="og:title" content="Da gamle cykler fandt nye veje · The Evolution of Bikes" /><meta property="og:description" content="Fra 92 nostalgiske ryttere i Gaiole in Chianti til Strade Bianche." /><meta property="og:image" content="https://hydedk.github.io/the-evolution-of-bikes/images/stories/leroica/toscana-illustration.webp" /><meta name="twitter:card" content="summary_large_image" /><title>Da gamle cykler fandt nye veje · The Evolution of Bikes</title><link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin /><link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Libre+Caslon+Display&display=swap" rel="stylesheet" /><link rel="stylesheet" href={`${base}/styles/global.css`} /></head>
<body><header class="site-header"><a class="brand" href={`${base}/`} aria-label="The Evolution of Bikes, forside"><span class="brand-mark">E<span>B</span></span><span>The Evolution<br />of Bikes</span></a><nav aria-label="Hovedmenu"><a href={`${base}/#samlingen`}>Samlingen</a><a href={`${base}/historier/`} aria-current="page">Historier</a><a href={`${base}/#viden`}>Viden</a><a href={`${base}/om/`}>Om</a></nav></header>
<main><article class="eroica-page">
  <header class="eroica-hero"><p class="section-label">L’Eroica · Toscana · 1997</p><h1>Da gamle cykler<br />fandt <em>nye veje</em></h1><p>En gammel racercykel behøver ikke stå stille for at være historie. Den kan stadig køres.</p></header>
  <figure class="eroica-bike"><img src={`${base}/images/stories/leroica/atala-sanremo.webp`} alt="Rød og gul Atala Sanremo racercykel fra midten af 1980’erne" /><figcaption>Atala Sanremo · midten af 1980’erne · Campagnolo Nuovo Record.</figcaption></figure>
  <section class="eroica-opening"><p class="section-label">En lille begyndelse</p><div><p>I 1997 stillede bare 92 cyklister til start i den lille by Gaiole in Chianti i Toscana. De gjorde noget, der på det tidspunkt virkede næsten bagvendt.</p></div></section>
  <section class="eroica-story"><div class="eroica-copy"><p>Mens cykelindustrien jagtede aluminium, carbon, klikpedaler og stadig mere avancerede gearsystemer, fandt de gamle stålcykler, uldtrøjer og tåclips frem og kørte ud på Toscanas støvede hvide grusveje.</p><p>Det blev begyndelsen på L’Eroica.</p><p>Idémanden Giancarlo Brocci ønskede at genfinde noget af den cykling, han mente var ved at forsvinde: anstrengelsen, kammeratskabet og landskabet. Arrangementet var samtidig med til at sætte fokus på at bevare de gamle <em>strade bianche</em> — de hvide grusveje, der siden er blevet et symbol for området.</p></div><aside><strong>92</strong><span>ryttere ved den første<br />L’Eroica i oktober 1997</span></aside></section>
  <figure class="eroica-landscape"><img src={`${base}/images/stories/leroica/toscana-illustration.webp`} alt="Illustration af ryttere på klassiske racercykler på en hvid grusvej i Toscana" loading="lazy" /><figcaption>En nutidig illustration af L’Eroicas ånd og landskab — ikke et historisk fotografi.</figcaption></figure>
  <section class="eroica-rules"><div><p class="section-label">Bici Eroica</p><h2>Det gamle udstyr tages alvorligt</h2><p>En klassisk Bici Eroica skal som udgangspunkt være bygget senest i 1987. Årstallet markerer den periode, hvor tåclips og remme for alvor begyndte at blive afløst af moderne klikpedaler.</p></div><dl>{rules.map(([label, value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}</dl></section>
  <section class="eroica-detail-grid"><figure><img src={`${base}/images/stories/leroica/gearlevers.webp`} alt="Campagnolo geargreb monteret på Atalaens skrårør" loading="lazy" /><figcaption>Geargrebene sidder på skrårøret, som L’Eroica-reglerne foreskriver.</figcaption></figure><figure><img src={`${base}/images/stories/leroica/front-brake.webp`} alt="Gipiemme forbremse og synligt bremsekabel på Atala Sanremo" loading="lazy" /><figcaption>Synligt bremsekabel og klassisk sidepull-bremse.</figcaption></figure><figure class="detail-portrait"><img src={`${base}/images/stories/leroica/front.webp`} alt="Atala Sanremos forhjul, styr og kronrør" loading="lazy" /><figcaption>Stålstel, klassisk styr og udvendige kabler.</figcaption></figure><figure class="detail-portrait"><img src={`${base}/images/stories/leroica/frame.webp`} alt="Atala Sanremos stel og Campagnolo Nuovo Record-gear" loading="lazy" /><figcaption>Atala Sanremo med Campagnolo Nuovo Record.</figcaption></figure></section>
  <section class="collection-ready"><p class="section-label">Samlingen er næsten startklar</p><blockquote>GIOS 1975.<br />Rossin 1978.<br />Faggin 1987.</blockquote><p>Flere cykler i samlingen kunne næsten køres direkte til start — med Faggin fra 1987 lige på grænsen.</p></section>
  <section class="strade-section"><div><p class="section-label">Fra nostalgi til professionelt løb</p><h2>De hvide veje vender tilbage</h2></div><div><p>I 2007 blev et professionelt løb kørt på de samme toscanske grusveje under navnet Monte Paschi Eroica. Alexandr Kolobnev vandt den første udgave.</p><p>Løbet skiftede senere navn og kendes i dag som Strade Bianche. Et lille nostalgisk arrangement med 92 mennesker på gamle racercykler var dermed med til at bringe de hvide grusveje tilbage helt ind i moderne professionel cykelsport.</p></div></section>
  <section class="eroica-closing"><blockquote>Historie er ikke kun noget, man ser på.<br /><em>Det er også noget, man kører på.</em></blockquote></section>
  <section class="period-sources"><p class="section-label">Kilder og billednoter</p><div><p>Historien og udstyrsreglerne er kontrolleret mod L’Eroicas officielle historik og gældende regler. Forbindelsen til det professionelle løb er også beskrevet af UCI.</p><ul><li><a href="https://www.eroica.cc/en/ethos-en/">L’Eroica: historie og klassisk ethos</a></li><li><a href="https://www.eroica.cc/en/regulations-leroica/">L’Eroica: regler for historiske cykler</a></li><li><a href="https://fr.uci.org/article/les-strade-bianche-sont-l-%C3%A9quivalent-printanier-d-un-grand-%C3%A9v%C3%A9nement-m%C3%A9di%C3%A9val-d-%C3%A9t%C3%A9/3AOvPJUpp172Z9fmS5BPW3">UCI: Strade Bianches historie</a></li></ul></div></section>
  <nav class="era-bottom-nav" aria-label="Videre navigation"><a href={`${base}/historier/`}>← Alle historier</a><a href={`${base}/historier/da-michelin-navnet-blev-et-problem/`}>Næste historie →</a></nav>
</article></main><footer><div class="brand footer-brand"><span class="brand-mark">E<span>B</span></span><span>The Evolution<br />of Bikes</span></div><p>En personlig samling af vintagecykler,<br />historier, mærker og komponenter.</p><p class="copyright">© {new Date().getFullYear()} The Evolution of Bikes</p></footer></body></html>
