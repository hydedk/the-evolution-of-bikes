---
import OptimizedImage from '../../components/OptimizedImage.astro';
import RelatedDiscovery from '../../components/RelatedDiscovery.astro';
import lapebieImage from '../../assets/stories/lapebie-paris-roubaix-1934/roger-lapebie-cykelkontrol-1934-bnf.jpg';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const slug = 'tilskuercyklen-der-kostede-lapebie-paris-roubaix';
const canonical = `https://teob.dk/historier/${slug}/`;
const english = `https://teob.dk/en/stories/${slug}/`;
const title = 'Tilskuercyklen der kostede Lapébie Paris–Roubaix';
const description = 'Roger Lapébie punkterede tæt på mål, lånte en tilskuers cykel og krydsede målstregen først. Reglerne gav sejren til Gaston Rebry.';
const image = `https://teob.dk${lapebieImage.src}`;
const sections = [
  ['Femten kilometer fra Roubaix', 'Den 1. april 1934 var Roger Lapébie på vej mod afslutningen af Paris–Roubaix, da han punkterede omkring femten kilometer fra mål. I dag ville en mekaniker række et nyt hjul frem. I 1934 var hjælpen langt mindre enkel, og løbets regler tillod ikke, at rytteren bare skiftede til en tilfældig cykel.'],
  ['En cykel fra vejkanten', 'Lapébie fandt en udvej. Han overtog en tilskuers cykel og fortsatte mod Roubaix. En senere fransk gengivelse fortæller, at cyklen lå i en grøft. Detaljen er farverig, men stammer fra en senere overlevering. Det sikre er, at cyklen tilhørte en tilskuer, og at skiftet ikke var tilladt.'],
  ['Først over stregen', 'Den fremmede cykel var god nok til at bringe Lapébie tilbage i løbet. Kilderne er ikke helt enige om, hvorvidt han kom alene ind eller afgjorde det mod Gaston Rebry. De er enige om det afgørende: Lapébie krydsede målstregen først.'],
  ['Reglen stod fast', 'Resultatet blev ikke stående. Lapébie blev meldt for det ulovlige cykelskift og diskvalificeret. Det var ikke hans ben, der havde svigtet, men den løsning han havde valgt efter punkteringen. Paris–Roubaix var allerede et løb, hvor mekanik og regler kunne være lige så afgørende som fart.'],
  ['Rebry fik sejren', 'Gaston Rebry blev udnævnt som vinder. Belgieren havde allerede vundet løbet i 1931 og skulle vinde igen i 1935. Sejren i 1934 står officielt i hans navn, selv om dagens første mand på velodromen var Lapébie.'],
  ['Den tabte sejr', 'Lapébie vandt senere Tour de France i 1937. Men i Paris–Roubaix 1934 blev han manden, der nåede først frem uden at få sejren. En punktering, en fremmed cykel og en regel gav løbet et resultat, som målstregen alene ikke kunne afgøre.'],
];
const sources = [
  ['L’Équipe: Gaston Rebry og Paris–Roubaix 1934','https://www.lequipe.fr/Cyclisme-sur-route/Actualites/Gaston-rebry-le-bouledogue-1931-1934-et-1935/1666237'],
  ['Le Monde, 19. april 1949: tilbageblik på Lapébies diskvalifikation','https://www.lemonde.fr/archives/article/1949/04/19/paris-roubaix-se-termine-dans-la-confusion-par-la-victoire-du-faux-coppi_1933808_1819218.html'],
  ['Le Monde, 14. april 1970: punkteringen og tilskuercyklen','https://www.lemonde.fr/archives/article/1970/04/14/l-apprenti-coureur-et-le-champion_2648596_1819218.html'],
  ['Paris–Roubaix: officiel vinderliste','https://www.paris-roubaix.fr/en/history'],
  ['DirectVelo: hjulskifte og reglerne i Paris–Roubaix','https://www.directvelo.com/actualite/81502/directvelo'],
  ['Wikimedia Commons/BnF: Roger Lapébie ved cykelkontrollen, 31. marts 1934','https://commons.wikimedia.org/wiki/File:31-3-34,_poin%C3%A7onnage_(des_v%C3%A9los)_de_Paris-Roubaix_(dans_la_cour_du_journal_L%27Auto,_10_rue_du_Faubourg-Montmartre),_Lap%C3%A9bie_-_btv1b53297658w.jpg'],
];
const schema = {'@context':'https://schema.org','@type':'Article',headline:title,description,inLanguage:'da',image,datePublished:'1934-04-01',mainEntityOfPage:canonical,publisher:{'@type':'Organization',name:'The Evolution of Bikes',url:'https://teob.dk/'}};
---
