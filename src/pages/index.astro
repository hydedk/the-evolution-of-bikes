---
import { stories } from '../data/stories';

const base = import.meta.env.BASE_URL;
const featuredStories = stories.map((story) => ({
  slug: story.slug,
  year: story.year,
  title: story.title,
  text: story.text,
  image: `${base}/${story.image}`,
  link: `${base}/historier/${story.slug}/`,
}));
const featuredFallback = featuredStories[0];
const gateways = [
  { number: '01', label: 'Fortællingerne', title: 'Historier og anekdoter', text: 'Skæve øjeblikke, glemte ryttere og de historier, resultatlisten ikke fortæller.', image: `${base}/images/stories/aldo-bini/aldo-bini-archive.webp`, link: `${base}/historier/` },
  { number: '02', label: 'Cykelløb og kulturhistorie', title: 'Perioder', text: 'Gå på opdagelse årti for årti i løbene, menneskene, vejene og cykelkulturen.', image: `${base}/images/periods/1900-1920/wild-west/track-racing.webp`, link: `${base}/perioder/` },
  { number: '03', label: 'Det fysiske arkiv', title: 'Cykler i samlingen', text: 'Cyklerne er indgangen til deres tid, tidligere ejere og det håndværk, der har bevaret dem.', image: `${base}/images/bikes/wonder-saint-etienne/hero.webp`, link: `${base}/cykler/` },
  { number: '04', label: 'Mekanik med betydning', title: 'Komponenter', text: 'Udvalgte opfindelser og mekaniske mellemtrin, der ændrede måden, man cyklede på.', image: `${base}/images/components/campagnolo-cambio-corsa/two-levers.webp`, link: `${base}/komponenter/` },
];
---

<!doctype html>
<html lang="da">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="En personlig samling af vintagecykler, cykelhistorier, mærker og komponenter." />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="The Evolution of Bikes" />
    <meta property="og:description" content="En personlig samling af vintagecykler, cykelhistorier, mærker og komponenter." />
    <meta property="og:image" content="https://hydedk.github.io/the-evolution-of-bikes/og.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="The Evolution of Bikes" />
    <meta name="twitter:description" content="Vintagecykler, historier og godt håndværk." />
    <meta name="twitter:image" content="https://hydedk.github.io/the-evolution-of-bikes/og.png" />
    <title>The Evolution of Bikes</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Libre+Caslon+Display&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href={`${import.meta.env.BASE_URL}/styles/global.css`} />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={import.meta.env.BASE_URL} aria-label="The Evolution of Bikes, forside">
        <span class="brand-mark">E<span>B</span></span>
        <span>The Evolution<br />of Bikes</span>
      </a>
      <nav aria-label="Hovedmenu">
        <a href={`${base}/historier/`}>Historier</a>
        <a href={`${base}/perioder/`}>Perioder</a>
        <a href={`${base}/cykler/`}>Cykler</a>
        <a href={`${base}/komponenter/`}>Komponenter</a>
        <a href={`${base}/om/`}>Om</a>
      </nav>
    </header>

    <main>
      <section class="hero">
        <p class="eyebrow">Vintagecykling fortalt gennem cyklerne, løbene og menneskene</p>
        <h1>Kom for cyklerne.<br /><em>Bliv for historierne.</em></h1>
        <p class="hero-copy">Et levende arkiv over cyklingens kultur – fra håndbyggede stålstel og dristig mekanik til rytterne, hjælperne og de øjeblikke, resultatlisten ikke viser.</p>
        <a class="button" href="#fire-indgange">Vælg din indgang <span aria-hidden="true">↓</span></a>
        <div class="wheel" aria-hidden="true"><div class="wheel-hub"></div></div>
      </section>

      <section class="home-gateways" id="fire-indgange" aria-label="Hjemmesidens fire hovedindgange">
        <header><p class="section-label">Fire veje ind i arkivet</p><h2>Hvad er du nysgerrig på?</h2></header>
        <div>
          {gateways.map((item) => (
            <a class="home-gateway" href={item.link}>
              <img src={item.image} alt="" loading="lazy" />
              <span class="home-gateway-number">{item.number}</span><p>{item.label}</p><h3>{item.title}</h3><b>{item.text}</b><i>Gå på opdagelse →</i>
            </a>
          ))}
        </div>
      </section>

      <section class="featured-bike" data-random-story>
        <div class="featured-bike-image">
          <img src={featuredFallback.image} alt={featuredFallback.title} loading="lazy" data-random-story-image />
        </div>
        <div class="featured-bike-copy">
          <p class="section-label">Tilfældig historie fra arkivet</p>
          <p class="featured-year" data-random-story-year>{featuredFallback.year}</p>
          <h2 data-random-story-title>{featuredFallback.title}</h2>
          <p data-random-story-text>{featuredFallback.text}</p>
          <a class="text-link" href={featuredFallback.link} data-random-story-link>Læs historien <span aria-hidden="true">→</span></a>
        </div>
      </section>

      <script define:vars={{ featuredStories }}>
        const section = document.querySelector('[data-random-story]');
        if (section && featuredStories.length > 1) {
          const storageKey = 'eob-last-featured-story';
          let previousSlug = null;
          try { previousSlug = localStorage.getItem(storageKey); } catch {}

          const choices = featuredStories.filter((story) => story.slug !== previousSlug);
          const story = choices[Math.floor(Math.random() * choices.length)];

          section.querySelector('[data-random-story-image]').src = story.image;
          section.querySelector('[data-random-story-image]').alt = story.title;
          section.querySelector('[data-random-story-year]').textContent = story.year;
          section.querySelector('[data-random-story-title]').textContent = story.title;
          section.querySelector('[data-random-story-text]').textContent = story.text;
          section.querySelector('[data-random-story-link]').href = story.link;

          try { localStorage.setItem(storageKey, story.slug); } catch {}
        }
      </script>

      <section class="story">
        <p class="section-label">Fra arkivet</p>
        <blockquote>“Det interessante er ikke kun, hvor gammel en cykel er — men hvilke veje den har kørt, og hvem der har passet på den.”</blockquote>
        <a href="https://velovintagehyde.blogspot.com/">Besøg det tidligere arkiv på Velo Vintage Hyde <span aria-hidden="true">→</span></a>
      </section>
    </main>

    <footer id="om">
      <div class="brand footer-brand"><span class="brand-mark">E<span>B</span></span><span>The Evolution<br />of Bikes</span></div>
      <p>En personlig samling af vintagecykler,<br />historier, mærker og komponenter.</p>
      <p class="copyright">© {new Date().getFullYear()} The Evolution of Bikes</p>
    </footer>
  </body>
</html>
