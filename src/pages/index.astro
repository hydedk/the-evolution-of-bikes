---
import { stories } from '../data/stories';
import { bikes } from '../data/bikes';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const featuredStories = stories.map((story) => ({
  slug: story.slug,
  year: story.year,
  title: story.title,
  text: story.text,
  image: typeof story.image === 'string' ? `${base}/${story.image}` : story.image.src,
  link: `${base}/historier/${story.slug}/`,
}));
const featuredFallback = featuredStories[0];
const heroItems = featuredStories.map((item) => ({ ...item, label: 'Historie fra arkivet', action: 'Læs historien' }));
const heroFallback = heroItems[0];
const latestStories = featuredStories.slice(0, 3);
const featuredBike = bikes.find((bike) => bike.slug === 'asmussen-super-prestige') ?? bikes[0];
const themes = [
  { label: 'Løbenes skæve øjeblikke', text: 'Fejlkørsler, mærkelige regler og afgørelser, der ikke kunne ses på målfotoet.', image: featuredStories.find((story) => story.slug === 'paris-roubaix-1949-to-vindere')?.image, link: `${base}/historier/?tema=race` },
  { label: 'Menneskene uden for podiet', text: 'Ryttere, mekanikere og hjælpere, som fik løbet til at fortsætte.', image: featuredStories.find((story) => story.slug === 'christine-lueber-tour-2015')?.image, link: `${base}/historier/?tema=people` },
  { label: 'Mekanik med konsekvenser', text: 'De opfindelser, fejl og værkstedsløsninger, der ændrede måden, man cyklede på.', image: featuredStories.find((story) => story.slug === 'colnago-magni-pedalarm-1955')?.image, link: `${base}/historier/?tema=mechanics` },
];
const periods = [
  ['1890', 'Pionertiden', '1900-1920'], ['1920', 'Nye løb', '1920-1930'], ['1930', 'Mellemkrigstid', '1930-1939'],
  ['1940', 'Krig og genstart', '1940-1949'], ['1950', 'Helte og hold', '1950-1959'], ['1960', 'Fart og forandring', '1960-1969'],
  ['1970', 'Stål og store løb', '1970-1979'], ['1980', 'Aerodynamik', '1980-1989'], ['1990', 'Nye materialer', '1990-1999'],
  ['2000', 'Moderne cykling', '2000-2009'], ['2010', 'Nye fortællinger', '2010-2019'],
];
const gateways = [
  { number: '01', label: 'Fortællingerne', title: 'Historier', text: 'Skæve øjeblikke, glemte ryttere og mekanik, der fik konsekvenser.', image: `${base}/images/stories/aldo-bini/aldo-bini-archive.webp`, link: `${base}/historier/` },
  { number: '02', label: 'Det fysiske arkiv', title: 'Cykler', text: 'Cyklerne i samlingen, deres tidligere ejere og det håndværk, der har bevaret dem.', image: `${base}/images/bikes/wonder-saint-etienne/hero.webp`, link: `${base}/cykler/` },
  { number: '03', label: 'Den lange linje', title: 'Perioder', text: 'Gå på opdagelse årti for årti i løbene, menneskene, vejene og cykelkulturen.', image: `${base}/images/periods/1900-1920/wild-west/track-racing.webp`, link: `${base}/perioder/` },
];
---

<!doctype html>
<html lang="da">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="En personlig samling af vintagecykler, cykelhistorier, mærker og komponenter." />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="The Evolution of Bikes" />
    <meta property="og:description" content="En personlig samling af vintagecykler, cykelhistorier, mærker og komponenter." />
    <meta property="og:image" content="https://teob.dk/og.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="The Evolution of Bikes" />
    <meta name="twitter:description" content="Vintagecykler, historier og godt håndværk." />
    <meta name="twitter:image" content="https://teob.dk/og.png" />
    <title>The Evolution of Bikes</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Libre+Caslon+Display&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href={`${base}/styles/global.css`} />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={`${base}/`} aria-label="The Evolution of Bikes, forside">
        <span class="brand-mark">E<span>B</span></span>
        <span>The Evolution<br />of Bikes</span>
      </a>
      <nav aria-label="Hovedmenu">
        <a href={`${base}/historier/`}>Historier</a>
        <a href={`${base}/cykler/`}>Cykler</a>
        <a href={`${base}/perioder/`}>Perioder</a>
        <a href={`${base}/om/`}>Om</a>
      </nav><div class="header-tools"><strong aria-current="page">DA</strong><span aria-hidden="true">/</span><a class="language-switch" href={`${base}/en/`} lang="en" hreflang="en">EN</a><a class="header-story-link" href={`${base}/fortael-din-historie/`}>Fortæl din historie</a></div>
    </header>

    <main>
      <section class="hero home-hero">
        <div class="home-hero-copy">
          <p class="eyebrow">Vintagecykling fortalt gennem cyklerne, løbene og menneskene</p>
          <h1>Kom for cyklerne.<br /><em>Bliv for historierne.</em></h1>
          <p class="hero-copy">Et levende arkiv over cyklingens kultur – fra håndbyggede stålstel og dristig mekanik til rytterne, hjælperne og de øjeblikke, resultatlisten ikke viser.</p>
          <div class="home-hero-actions">
            <a class="button" href={heroFallback.link} data-random-hero-button>{heroFallback.action} <span aria-hidden="true">→</span></a>
            <a class="home-hero-archive-link" href={`${base}/historier/`}>Se alle historier</a>
          </div>
        </div>
        <a class="home-hero-feature" href={heroFallback.link} aria-label={`${heroFallback.action}: ${heroFallback.title}`} data-random-hero-card>
          <img src={heroFallback.image} alt="" data-random-hero-image />
          <span class="home-hero-feature-shade" aria-hidden="true"></span>
          <span class="home-hero-feature-copy">
            <small data-random-hero-label>{heroFallback.label} · {heroFallback.year}</small>
            <strong data-random-hero-title>{heroFallback.title}</strong>
            <i data-random-hero-action>{heroFallback.action} <span aria-hidden="true">→</span></i>
          </span>
        </a>
      </section>

      <section class="home-gateways" id="tre-indgange" aria-label="Hjemmesidens tre hovedindgange">
        <header><p class="section-label">Tre veje ind</p><h2>Hvor vil du begynde?</h2></header>
        <div>
          {gateways.map((item) => (
            <a class="home-gateway" href={item.link}>
              <img src={item.image} alt="" loading="lazy" />
              <span class="home-gateway-number">{item.number}</span><p>{item.label}</p><h3>{item.title}</h3><b>{item.text}</b><i>Gå på opdagelse →</i>
            </a>
          ))}
        </div>
      </section>

      <section class="home-latest" aria-labelledby="latest-title">
        <header><p class="section-label">Nyt at læse</p><h2 id="latest-title">De seneste historier</h2><a href={`${base}/historier/`}>Se alle historier →</a></header>
        <div class="home-card-grid">
          {latestStories.map((story) => (
            <a class="home-story-card" href={story.link}>
              <span class="home-story-card-image"><img src={story.image} alt="" loading="lazy" /></span>
              <small>{story.year}</small><h3>{story.title}</h3><p>{story.text}</p><i>Læs historien →</i>
            </a>
          ))}
        </div>
      </section>

      <section class="home-themes" aria-labelledby="themes-title">
        <header><p class="section-label">Tre slags fortællinger</p><h2 id="themes-title">Find din vej ind i historierne</h2></header>
        <div>
          {themes.map((theme) => (
            <a class="home-theme" href={theme.link}>
              {theme.image && <img src={theme.image} alt="" loading="lazy" />}
              <span><h3>{theme.label}</h3><p>{theme.text}</p><i>Se temaet →</i></span>
            </a>
          ))}
        </div>
      </section>

      <section class="home-bike-feature">
        <div><img src={`${base}/${featuredBike.image}`} alt={featuredBike.title} loading="lazy" /></div>
        <div><p class="section-label">En cykel fra samlingen</p><p class="home-bike-year">{featuredBike.year} · {featuredBike.place}</p><h2>{featuredBike.title}</h2><p>{featuredBike.text}</p><a class="text-link" href={`${base}/cykler/${featuredBike.slug}/`}>Se cyklen →</a><a class="quiet-link" href={`${base}/cykler/`}>Se alle cykler</a></div>
      </section>

      <section class="home-timeline" aria-labelledby="timeline-title">
        <header><p class="section-label">Rejs gennem tiden</p><h2 id="timeline-title">Cykelhistorien årti for årti</h2><a href={`${base}/perioder/`}>Se alle perioder →</a></header>
        <div class="home-timeline-track">
          {periods.map(([year, label, slug]) => <a href={`${base}/perioder/${slug}/`}><strong>{year}</strong><span>{label}</span></a>)}
        </div>
      </section>

      <section class="featured-bike" data-random-story>
        <div class="featured-bike-image">
          <img src={featuredFallback.image} alt={featuredFallback.title} loading="lazy" data-random-story-image />
        </div>
        <div class="featured-bike-copy">
          <p class="section-label">Tilfældig historie fra arkivet</p>
          <p class="featured-year" data-random-story-year>{featuredFallback.year}</p>
          <h2 data-random-story-title>{featuredFallback.title}</h2>
          <p data-random-story-text>{featuredFallback.text}</p>
          <a class="text-link" href={featuredFallback.link} data-random-story-link>Læs historien <span aria-hidden="true">→</span></a>
        </div>
      </section>

      <script define:vars={{ featuredStories }}>
        const section = document.querySelector('[data-random-story]');
        if (section && featuredStories.length > 1) {
          const storageKey = 'eob-last-featured-story';
          let previousSlug = null;
          try { previousSlug = localStorage.getItem(storageKey); } catch {}

          const choices = featuredStories.filter((story) => story.slug !== previousSlug);
          const story = choices[Math.floor(Math.random() * choices.length)];

          section.querySelector('[data-random-story-image]').src = story.image;
          section.querySelector('[data-random-story-image]').alt = story.title;
          section.querySelector('[data-random-story-year]').textContent = story.year;
          section.querySelector('[data-random-story-title]').textContent = story.title;
          section.querySelector('[data-random-story-text]').textContent = story.text;
          section.querySelector('[data-random-story-link]').href = story.link;

          try { localStorage.setItem(storageKey, story.slug); } catch {}
        }
      </script>

      <section class="newsletter" id="nyhedsbrev" aria-labelledby="newsletter-title">
        <div class="newsletter-copy">
          <p class="section-label">Nyt fra arkivet</p>
          <h2 id="newsletter-title">Cykelhistorier<br /><em>i din indbakke</em></h2>
          <p>Et roligt nyhedsbrev med nye fortællinger, cykler fra samlingen og andre fund fra arkivet.</p>
        </div>
        <form class="newsletter-form" method="POST" action="https://d8a86a3c.sibforms.com/serve/MUIFADT4GimLPx-wUsPWGgzKniP3fmzWsIS3HGOXDetusA5iI6foT2aohA8UlGqsNu2d0333p3yeqd9dkDi9hinLAE1AcLHf8YkXVeVB78XyU2tMlBmS73zjH1jUSVzhKUE5i0x-T1W00SLk0Vy0qLacrlE2xGPCim7_RlC5-uBsXMIKTkT3ueUSUoVpnsCnLtj6eqhf6y2x8PHxvA==" target="newsletter-response">
          <label for="newsletter-email">Din e-mailadresse</label>
          <div class="newsletter-field-row">
            <input id="newsletter-email" name="EMAIL" type="email" autocomplete="email" required placeholder="navn@eksempel.dk" />
            <button type="submit">Tilmeld <span aria-hidden="true">→</span></button>
          </div>
          <label class="newsletter-consent">
            <input type="checkbox" name="OPT_IN" value="1" required />
            <span>Jeg accepterer at modtage nyhedsbreve fra The Evolution of Bikes og har læst <a href={`${base}/privatliv/`}>privatlivspolitikken</a>.</span>
          </label>
          <p class="newsletter-note">Du kan altid afmelde dig via linket nederst i nyhedsbrevet. Tilmeldingen håndteres af Brevo.</p>
          <input class="newsletter-honeypot" type="text" name="email_address_check" value="" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <input type="hidden" name="locale" value="da" />
          <input type="hidden" name="html_type" value="simple" />
          <p class="newsletter-status" role="status" aria-live="polite" hidden></p>
        </form>
        <iframe class="newsletter-response" name="newsletter-response" title="Svar fra nyhedsbrevstilmelding" hidden></iframe>
      </section>

      <script define:vars={{ heroItems }}>
        const heroCard = document.querySelector('[data-random-hero-card]');
        const heroButton = document.querySelector('[data-random-hero-button]');
        if (heroCard && heroButton && heroItems.length > 1) {
          const item = heroItems[Math.floor(Math.random() * heroItems.length)];
          heroCard.href = item.link;
          heroCard.setAttribute('aria-label', `${item.action}: ${item.title}`);
          heroButton.href = item.link;
          heroButton.firstChild.textContent = `${item.action} `;
          heroCard.querySelector('[data-random-hero-image]').src = item.image;
          heroCard.querySelector('[data-random-hero-label]').textContent = `${item.label} · ${item.year}`;
          heroCard.querySelector('[data-random-hero-title]').textContent = item.title;
          heroCard.querySelector('[data-random-hero-action]').firstChild.textContent = `${item.action} `;
        }
      </script>

      <script>
        const newsletterForm = document.querySelector('.newsletter-form');
        const newsletterFrame = document.querySelector('.newsletter-response');
        const newsletterStatus = document.querySelector('.newsletter-status');
        let newsletterSubmitted = false;

        newsletterForm?.addEventListener('submit', () => {
          newsletterSubmitted = true;
          if (newsletterStatus instanceof HTMLElement) {
            newsletterStatus.hidden = false;
            newsletterStatus.textContent = 'Sender din tilmelding …';
          }
        });

        newsletterFrame?.addEventListener('load', () => {
          if (!newsletterSubmitted || !(newsletterStatus instanceof HTMLElement)) return;
          newsletterStatus.textContent = 'Tak. Tjek din indbakke og bekræft tilmeldingen via linket i e-mailen.';
          newsletterForm?.reset();
          newsletterSubmitted = false;
        });
      </script>

      <section class="story">
        <p class="section-label">Fra arkivet</p>
        <blockquote>“Det interessante er ikke kun, hvor gammel en cykel er — men hvilke veje den har kørt, hvor den kommer fra, og hvem der har kørt på den!”</blockquote>
      </section>
    </main>

    <footer id="om">
      <div class="brand footer-brand"><span class="brand-mark">E<span>B</span></span><span>The Evolution<br />of Bikes</span></div>
      <p>En personlig samling af vintagecykler,<br />historier, mærker og komponenter.</p>
      <p class="copyright">© {new Date().getFullYear()} The Evolution of Bikes</p>
    </footer>
  </body>
</html>
