---
import OptimizedImage from '../../components/OptimizedImage.astro';
import PeriodStructure from '../../components/PeriodStructure.astro';
import { storiesForPeriod } from '../../data/stories';
import hero from '../../assets/stories/paris-brest-paris-1891/depart-le-petit-journal-1891.jpg';
import terront from '../../assets/stories/paris-brest-paris-1891/terront-le-petit-journal-1891.jpg';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const relatedStories = storiesForPeriod('1800-1899');
