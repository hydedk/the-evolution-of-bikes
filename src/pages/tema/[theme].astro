---
import ContentExplorer from '../../components/ContentExplorer.astro';
import { themes, themeIds, contentForTheme, localizeContent, type ThemeId } from '../../data/taxonomy';
export function getStaticPaths() { return themeIds.map((theme) => ({ params: { theme }, props: { theme } })); }
const { theme } = Astro.props as { theme: ThemeId };
const data = themes[theme]; const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonical = `https://teob.dk/tema/${theme}/`; const english = `https://teob.dk/en/themes/${theme}/`;
const items = localizeContent(contentForTheme(theme), 'da');
---
<!doctype html><html lang="da"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content={`${data.daIntro} Følg temaet på tværs af perioder, historier, cykler og komponenter.`}/><link rel="canonical" href={canonical}/><link rel="alternate" hreflang="da" href={canonical}/><link rel="alternate" hreflang="en" href={english}/><link rel="alternate" hreflang="x-default" href={canonical}/><meta property="og:type" content="website"/><meta property="og:locale" content="da_DK"/><meta property="og:site_name" content="The Evolution of Bikes"/><meta property="og:title" content={`${data.da} · Tema`}/><meta property="og:description" content={data.daIntro}/><meta property="og:url" content={canonical}/><meta property="og:image" content="https://teob.dk/images/periods/1990-1999/galibier-1993.jpg"/><meta property="og:image:alt" content="Ryttere på Col du Galibier under Tour de France 1993"/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={`${data.da} · Tema`}/><meta name="twitter:description" content={data.daIntro}/><meta name="twitter:image" content="https://teob.dk/images/periods/1990-1999/galibier-1993.jpg"/><title>{data.da} · Tema · The Evolution of Bikes</title><link rel="stylesheet" href={`${base}/styles/global.css`}/></head><body>
<header class="site-header"><a class="brand" href={`${base}/`}><span class="brand-mark">E<span>B</span></span><span>The Evolution<br/>of Bikes</span></a><nav aria-label="Hovedmenu"><a href={`${base}/historier/`}>Historier</a><a href={`${base}/perioder/`}>Perioder</a><a href={`${base}/cykler/`}>Cykler</a><a href={`${base}/om/`}>Om</a></nav><div class="header-tools"><strong>DA</strong><span>/</span><a class="language-switch" href={`${base}/en/themes/${theme}/`} lang="en">EN</a></div></header>
<main><header class="archive-hero theme-hero"><p class="section-label">Tema gennem hele cykelhistorien</p><h1>{data.da}</h1><p>{data.daIntro}</p><a href={`${base}/tema/`}>Se alle syv temaer →</a></header><ContentExplorer items={items} language="da" initialTheme={theme} /></main>
<footer><div class="brand footer-brand"><span class="brand-mark">E<span>B</span></span><span>The Evolution<br/>of Bikes</span></div><p>Kom for cyklerne. Bliv for historierne.</p></footer></body></html>
