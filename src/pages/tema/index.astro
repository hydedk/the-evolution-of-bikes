---
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import ContentExplorer from '../../components/ContentExplorer.astro';
import { contentItems, localizeContent, themes, themeIds } from '../../data/taxonomy';
const base=import.meta.env.BASE_URL.replace(/\/$/,'');
---
<!doctype html><html lang="da"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content="Syv temaer forbinder historier, perioder, cykler og komponenter på tværs af cykelhistorien."/><link rel="canonical" href="https://teob.dk/tema/"/><link rel="alternate" hreflang="da" href="https://teob.dk/tema/"/><link rel="alternate" hreflang="en" href="https://teob.dk/en/themes/"/><link rel="alternate" hreflang="x-default" href="https://teob.dk/tema/"/><title>Temaer · The Evolution of Bikes</title><link rel="stylesheet" href={`${base}/styles/global.css`}/></head><body><SiteHeader lang="da" translations={{ en: `/en/themes/` }} /><main><header class="archive-hero theme-hero"><p class="section-label">På tværs af perioderne</p><h1>Syv temaer</h1><p>Artiklerne beholder deres faste adresser. Temaerne samler forbindelserne og viser udviklingen kronologisk.</p></header><section class="theme-index">{themeIds.map((id,index)=>{const theme=themes[id];return <a href={`${base}/tema/${id}/`}><span>0{index+1}</span><h2>{theme.da}</h2><p>{theme.daIntro}</p><b>Følg temaet →</b></a>})}</section><section class="theme-search-intro"><p class="section-label">Søg på tværs</p><h2>Find historier, cykler og komponenter</h2><p>Vælg tema, periode og indholdstype, eller søg efter et navn, et løb eller en teknisk detalje.</p></section><ContentExplorer items={localizeContent(contentItems, 'da')} language="da" /></main><SiteFooter lang="da" /></body></html>
